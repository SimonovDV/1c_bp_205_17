&НаСервере
Функция ВидДоговораЯвляетсяСПоставщикомПоНомеруСтроки(НомерСтроки)
	Возврат ТабДоговороы[НомерСтроки].ВидДоговора = Строка(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);	
КонецФункции

&НаКлиенте
Процедура ТабДоговороыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)  
	Если НЕ ВидДоговораЯвляетсяСПоставщикомПоНомеруСтроки(ВыбраннаяСтрока) Тогда                    
		ДополнительныеПараметры = Новый Структура("ВыбраннаяСтрока",ВыбраннаяСтрока);
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораНебходимостьСменыВидаДоговора",ЭтотОбъект,ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение,
		    "Выбранный вами договор не является договором с поставщиком."+Символы.ПС+"Вы действительно желаете изменить вид договора ?",
		    РежимДиалогаВопрос.ДаНет,
		    0, // таймаут в секундах
		    КодВозвратаДиалога.Да, // (необ.) кнопка по умолчанию
		    "Изменить вид договора ?" // (необ.) заголовок
		);    
	Иначе
		ДополнительныеПараметры = Новый Структура("ДоговорКонтрагента,Основание,НомерЗаявки,СуммаОплат,ДатаПлатежа",ТабДоговороы[ВыбраннаяСтрока].Договор,Основание,НомерЗаявки,ТабДоговороы[ВыбраннаяСтрока].СуммаОплат,ТабДоговороы[ВыбраннаяСтрока].МинДатаПлатежа);
		Форма = ПолучитьФорму("ОбщаяФорма.ЭТ_СозданиеПоступлениеУслуг",ДополнительныеПараметры);
    	Форма.Открыть();				
		//ЭтаФорма.Закрыть();
	КонецЕсли;
		
	ТабДоговороыВыборНаСервере();
КонецПроцедуры

&НаСервере
Функция КодЗаявкиСБ()
	Возврат КодЗаявкиСБ;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораНебходимостьСменыВидаДоговора(Результат, Параметры) ЭКСПОРТ
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если НЕ УстановитьВидДоговора(ТабДоговороы[Параметры.ВыбраннаяСтрока].Договор) Тогда
			ПоказатьПредупреждение(,"Не могу сменить вид договора",,"Ошибка");
		Иначе              
			ДополнительныеПараметры = Новый Структура("ДоговорКонтрагента,Основание,НомерЗаявки,СуммаОплат",ТабДоговороы[Параметры.ВыбраннаяСтрока].Договор,Основание,НомерЗаявки,ТабДоговороы[Параметры.ВыбраннаяСтрока].СуммаОплат);
			Форма = ПолучитьФорму("ОбщаяФорма.ЭТ_СозданиеПоступлениеУслуг",ДополнительныеПараметры);
	    	Форма.Открыть();				
			//ЭтаФорма.Закрыть();
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры


&НаСервере
Функция УстановитьВидДоговора(ДоговорСсылка) 
	СписокДокументов = Новый ТаблицаЗначений;
	СписокДокументов.Колонки.Добавить("Дата");
	СписокДокументов.Колонки.Добавить("Документ");
	
	СостояниеМодуляЭТ = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВыключитьМодуль",Ложь);
	ЭТ_ОбщийМодуль2.СохранитьНастройку("ВыключитьМодуль",Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|    СвязанныеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|    КритерийОтбора.СвязанныеДокументы(&ДоговорСсылка) КАК СвязанныеДокументы
		|ГДЕ
		|    СвязанныеДокументы.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("ДоговорСсылка", ДоговорСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовСтрока = СписокДокументов.Добавить();
		НовСтрока.Дата = ВыборкаДетальныеЗаписи.Ссылка.Дата;
		НовСтрока.Документ = ВыборкаДетальныеЗаписи.Ссылка;
		Док = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЦикла;

	Попытка
		//Чиним договор
		Договор = ДоговорСсылка.ПолучитьОбъект();
		Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Получить(1);
		Договор.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;	
	
	//Проводим документы обратно
	СписокДокументов.Сортировать("Дата", Новый СравнениеЗначений);
	Для Каждого СледДокумент Из СписокДокументов Цикл
    	Док = СледДокумент.Документ.ПолучитьОбъект();
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	

	Договор = ДоговорСсылка.ПолучитьОбъект();
	Если Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Получить(1) Тогда
		КВозврату = Истина;
	Иначе
		КВозврату = Ложь;
	КонецЕсли;

	ЭТ_ОбщийМодуль2.СохранитьНастройку("ВыключитьМодуль",СостояниеМодуляЭТ);
	Возврат КВозврату;	
КонецФункции

