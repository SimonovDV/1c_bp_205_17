&НаСервере
Процедура ПриОткрытииНаСервере()  	
	ШаблонЗаявкаСтруктура = ЭТ_ОбщийМодуль2.ПолучитьШаблонПоискаЗаявки(Основание.ДоговорКонтрагента.Номер);
	ШаблонПоискаЗаявкаНомерЗагружено = ШаблонЗаявкаСтруктура.Номер;
	ШаблонПоискаНомерЗаявки = ШаблонЗаявкаСтруктура.Номер; 
	ДатаЗакрытияРасчетныхДокументов = ЭТ_ОбщийМодуль2.ПолучитьДатуЗакрытияРасчетныхДокументов();
	НомерЗаявки = ШаблонПоискаНомерЗаявки;
	Заявка = ЭТ_ОбщийМодуль2.ПолучитьЗаявкуПоНомеру(ШаблонПоискаНомерЗаявки);        	
	КодЗаявкиСБ = ?(Заявка.Свойство("id"),Заявка.id,0);
	Если Заявка.Количество()>0 Тогда 
		Если Заявка.Свойство("reservation_number") Тогда
			ШаблонПоискаНомерБрони = СокрЛП(Заявка.reservation_number);
			НомерБрони = ШаблонПоискаНомерБрони;
			Элементы.НомерБрони.Видимость = СтрДлина(ШаблонПоискаНомерБрони)>0;
		Иначе
			Элементы.НомерБрони.Видимость = Ложь;
		КонецЕсли;
		Если Заявка.Свойство("manager_surname") И Заявка.Свойство("manager_name") И Заявка.Свойство("manager_sname") Тогда
			ФИОМенеджера = СокрЛП(СокрЛП(Заявка.manager_surname) + " " + СокрЛП(Заявка.manager_name) + " " + СокрЛП(Заявка.manager_sname));
			МенеджерВЗаявке = ФИОМенеджера;
			Элементы.МенеджерВЗаявке.Видимость = СтрДлина(ФИОМенеджера)>0;
		Иначе
			Элементы.МенеджерВЗаявке.Видимость = Ложь;
		КонецЕсли;		
		Если Заявка.Свойство("supplier_name") Тогда
			ТуроператорВЗаявке = Заявка.supplier_name;
			ТуроператорВЗаявке = СокрЛП(СтрЗаменить(ТуроператорВЗаявке,"&quot;",""));
			Элементы.ТуроператорВЗаявке.Видимость = СтрДлина(ТуроператорВЗаявке)>0;
		Иначе
			Элементы.ТуроператорВЗаявке.Видимость = Ложь;
		КонецЕсли;
		Если Заявка.Свойство("services") Тогда
			ПартнерыВЗаявке.Очистить();
			Для Каждого СледУслуги Из Заявка.services Цикл
				Партнер_ИНН = ?(СледУслуги.Свойство("partner_inn"),СледУслуги.partner_inn,"");
				Партнер_Наименование = ?(СледУслуги.Свойство("partner_name"),СледУслуги.partner_name,"");
				Партнер_Наименование = СтрЗаменить(Партнер_Наименование,"&quot;","");
				Партнер_Оплачено = ?(СледУслуги.Свойство("price_netto"),?(СледУслуги.price_netto=Неопределено,0,СледУслуги.price_netto),0);
				Если Партнер_Оплачено>0 Тогда
					новСтрока = ПартнерыВЗаявке.Добавить();
					новСтрока.ИНН = Партнер_ИНН;
					новСтрока.Наименование = Партнер_Наименование;
					новСтрока.Оплачено = Партнер_Оплачено;
				КонецЕсли;
			КонецЦикла;			
			Элементы.ПартнерыВЗаявке.Видимость = ПартнерыВЗаявке.Количество()>0;
		Иначе
			Элементы.ПартнерыВЗаявке.Видимость = Ложь;
		КонецЕсли;
		
	
	
	КонецЕсли;	
КонецПроцедуры

