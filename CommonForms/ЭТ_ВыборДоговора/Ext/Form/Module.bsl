&НаСервере
Функция ПоискЗаявкаНаСервере(НомерДоговора,ЭтоБрнь=Ложь)    	
	Если СтрДлина(СокрЛП(НомерДоговора))<1 Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	ШаблонПоиска = ЭТ_ОбщийМодуль2.ПолучитьШаблонПоискаЗаявки(НомерДоговора);

	Запрос = Новый Запрос;
	ЗапросДоговор = Новый Запрос;
	
	
	парВидОперации = Новый Массив;
	парВидОперации.Добавить(
		Перечисления["ВидыОперацийСписаниеДенежныхСредств"]["ОплатаПоставщику"]
	);	
	Запрос.УстановитьПараметр("ВидОперации", парВидОперации);                 
	
	Договоры = Новый Массив;                                                  
	

	Родитель = Новый Массив;                                                  
	КаталогПартнеров = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПартнеров",Справочники.Контрагенты.ПустаяСсылка());
	КаталогПоставщиков = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПоставщиков",Справочники.Контрагенты.ПустаяСсылка());	
	Если Не КаталогПартнеров.Пустая() И Не КаталогПоставщиков.Пустая() Тогда
		Родитель.Добавить(КаталогПартнеров);
		Родитель.Добавить(КаталогПоставщиков);
	КонецЕсли;
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.УстановитьПараметр("РодительКоличество", Родитель.Количество());    
	Запрос.УстановитьПараметр("ДатаЗапрета", ЭТ_ОбщийМодуль2.ПолучитьДатуЗакрытияРасчетныхДокументов());    
		 


	
	ВидДоговора = Новый Массив;
	ВидДоговора.Добавить(Перечисления["ВидыДоговоровКонтрагентов"]["СПоставщиком"]);
	ВидДоговора.Добавить(Перечисления["ВидыДоговоровКонтрагентов"]["СКомитентом"]);	
	
	ЗапросДоговор.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Если ЭтоБрнь Тогда                
		ФорматНомерДоговора = СтрЗаменить(СтрЗаменить(СокрЛП(НомерДоговора),"  ","")," ","%");
		ЗапросДоговор.УстановитьПараметр("НомерДоговора", "%"+ФорматНомерДоговора+"%");
	Иначе
		ЗапросДоговор.УстановитьПараметр("НомерДоговора", "%"+ШаблонПоиска.ПрефиксПоиск+"%"+ШаблонПоиска.Номер+"%");
	КонецЕсли;
	ЗапросДоговор.Текст = 
		"ВЫБРАТЬ
| 			ДоговорыКонтрагентов.Ссылка КАК Ссылка           
| 		ИЗ
| 			Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
| 		ГДЕ
| 			ДоговорыКонтрагентов.Наименование ПОДОБНО &НомерДоговора
| 			И ДоговорыКонтрагентов.ВидДоговора В (&ВидДоговора)	
|";
	Запрос.УстановитьПараметр("Договоры", ЗапросДоговор.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	
	Запрос.Текст = 
		"ВЫБРАТЬ
| 	Хозрасчетный.Регистратор.ДоговорКонтрагента КАК Договор,
| 	СУММА(Хозрасчетный.Сумма) КАК Сумма,
| 	МИНИМУМ(Хозрасчетный.Регистратор.Дата) КАК МинДатаПлатежа
| ПОМЕСТИТЬ ВыбДоговор
| ИЗ
| 	РегистрБухгалтерии.Хозрасчетный КАК Хозрасчетный
| ГДЕ
| 	(Хозрасчетный.Регистратор.Контрагент.Родитель В (&Родитель) ИЛИ (&РодительКоличество = 0))
| 	И Хозрасчетный.Регистратор.ВидОперации В (&ВидОперации)
| 	И Хозрасчетный.Регистратор.ДоговорКонтрагента В (&Договоры)
| СГРУППИРОВАТЬ ПО
| 	Хозрасчетный.Регистратор.ДоговорКонтрагента
| ;
| 
| ВЫБРАТЬ
| 	Договор КАК Договор,
| 	Договор.Владелец КАК Контрагент,
| 	Договор.Владелец.ИНН КАК КонтрагентИНН,
| 	Договор.ВидДоговора КАК ВидДоговора,
| 	Сумма КАК СуммаОплат,
| 	МинДатаПлатежа КАК МинДатаПлатежа,
|	ВЫБОР
|		КОГДА(МинДатаПлатежа<&ДатаЗапрета) ТОГДА Истина
|		ИНАЧЕ Ложь
|	КОНЕЦ КАК ЕстьОграничения
| ИЗ ВЫБДОГОВОР";
	

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	//Корректировка запрета             
	Для Каждого СтрокаТЧ Из РезультатЗапроса Цикл
    	ИндСтроки = РезультатЗапроса.Индекс(СтрокаТЧ);
		РезультатЗапроса[ИндСтроки].ЕстьОграничения = 
			?(
				РезультатЗапроса[ИндСтроки].ЕстьОграничения 
				ИЛИ ДатыЗапретаИзмененияБП.ЗапрещеноРедактированиеПериода(
					РезультатЗапроса[ИндСтроки].МинДатаПлатежа,
					РезультатЗапроса[ИндСтроки].Договор.Организация
				),Истина,Ложь
			);
	КонецЦикла;
	
	
	Если РезультатЗапроса.Количество()>0 Тогда	
		ЭтаФорма.ТабДоговороы.Загрузить(РезультатЗапроса);
	КонецЕсли;
	Возврат РезультатЗапроса.Количество();

КонецФункции          

&НаКлиенте
Процедура ПоискЗаявка(Команда)
	Если СтрДлина(СокрЛП(ЭтаФорма.ШаблонПоискаНомерЗаявки))<1 Тогда
		ПоказатьПредупреждение(,"Стпрка с номером заявки пустая, введите номер заявки и повторите поиск",,"Введите номер заявки");			
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ТабДоговороы.Очистить();	                      
	Если ПоискЗаявкаНаСервере(ЭтаФорма.ШаблонПоискаНомерЗаявки)<1 Тогда
		Если СтрДлина(СокрЛП(ЭтаФорма.ШаблонПоискаНомерБрони))>0 Тогда    
			   Оповещение = Новый ОписаниеОповещения("ПослеОтветаПоискПоНомеруБрони",ЭтотОбъект);
			   ПоказатьВопрос(Оповещение,
			        "Поиск договора поставщика по номеру договора не принес результата.",
			        РежимДиалогаВопрос.ДаНет,
			        0, // таймаут в секундах
			        КодВозвратаДиалога.Да, // (необ.) кнопка по умолчанию
			        "Выполнить поиск по номеру брони ?" // (необ.) заголовок
			    );    
		Иначе
			ПоказатьПредупреждение(,"Договор поставщика не найден, попробуйте поменять условия и повторить поиск.",,"Пустой результат запроса");	
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПослеОтветаПоискПоНомеруБрони(Результат, Параметры) ЭКСПОРТ
	Если Результат = КодВозвратаДиалога.Да Тогда
		Элементы.Группа6.ТекущаяСтраница = Элементы.Группа5;
        ПоискБронь(ЭтаФорма);
	КонецЕсли;
КонецПроцедуры
	
&НаКлиенте
Процедура ПоискБронь(Команда)    
	Если СтрДлина(СокрЛП(ЭтаФорма.ШаблонПоискаНомерБрони))<1 Тогда
		ПоказатьПредупреждение(,"Стпрка с номером брони пустая, введите номер брони и повторите поиск",,"Введите номер брони");			
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ТабДоговороы.Очистить();	                      
	Если ПоискЗаявкаНаСервере(ЭтаФорма.ШаблонПоискаНомерБрони,Истина)<1 Тогда
		ПоказатьПредупреждение(,"Договор поставщика не найден, попробуйте поменять условия и повторить поиск.",,"Пустой результат запроса");	
	КонецЕсли;
КонецПроцедуры

