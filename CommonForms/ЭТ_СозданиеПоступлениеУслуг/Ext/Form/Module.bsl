	КВозврату.Вставить("СчетУчетаРасчетовСКонтрагентом",Основание.СчетУчетаРасчетовСКонтрагентом);
	КВозврату.Вставить("СчетУчетаРасчетовПоАвансам",Основание.СчетУчетаРасчетовПоАвансам);   
	КВозврату.Вставить("ВалютаДокумента",Основание.ВалютаДокумента);         
	//КВозврату.Вставить("Ответственный",ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	КВозврату.Вставить("КратностьВзаиморасчетов",Основание.КратностьВзаиморасчетов);
	КВозврату.Вставить("КурсВзаиморасчетов",Основание.КурсВзаиморасчетов);
	КВозврату.Вставить("НДСВключенВСтоимость",Основание.СуммаВключаетНДС);
	КВозврату.Вставить("СуммаВключаетНДС",Основание.СуммаВключаетНДС);
	КВозврату.Вставить("СуммаДокумента",Основание.СуммаДокумента);
	КВозврату.Вставить("СчетУчетаРасчетовСКомиссионером",Основание.СчетУчетаРасчетовСКонтрагентом);       
	КВозврату.Вставить("Дата",ДатаПлатежа);  
