&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)     
	Договор = Параметры.ДоговорКонтрагента;
	Основание = Параметры.Основание;    
	ДатаПлатежа = Параметры.ДатаПлатежа;
	СуммаОплат =  Параметры.СуммаОплат;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицу()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Ссылка КАК Документ
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.ДоговорКонтрагента = &ДоговорКонтрагента
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПоступлениеТоваровУслуг.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Договор);
	
	РезультатЗапроса = Запрос.Выполнить();
	ДокументыПоступления.Загрузить(РезультатЗапроса.Выгрузить());
КонецПроцедуры
	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗаполнитьТаблицу();
	Если ДокументыПоступления.Количество()<1 Тогда
		Элементы.Группа1.Видимость = Ложь;
	Иначе
		Элементы.Группа1.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры


&НаСервере
Функция ЗаполнитьДокумент()   
	
	
	
	
	
	КВозврату = Новый Структура;
	КВозврату.Вставить("ВидОперации",Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Услуги);  
	КВозврату.Вставить("Организация",Основание.Организация);
	КВозврату.Вставить("Склад",Основание.Склад);//Справочники.Склады.НайтиПоНаименованию("Основной склад");
	КВозврату.Вставить("Контрагент",Договор.Владелец);
	КВозврату.Вставить("ДоговорКонтрагента",Договор);
	КВозврату.Вставить("СпособЗачетаАвансов",Перечисления.СпособыЗачетаАвансов.Автоматически);
