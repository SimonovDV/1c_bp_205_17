&НаСервере
Функция УстановитьВидДоговора(ДоговорСсылка) 
	СписокДокументов = Новый ТаблицаЗначений;
	СписокДокументов.Колонки.Добавить("Дата");
	СписокДокументов.Колонки.Добавить("Документ");
	
	СостояниеМодуляЭТ = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВыключитьМодуль",Ложь);
	ЭТ_ОбщийМодуль2.СохранитьНастройку("ВыключитьМодуль",Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|    СвязанныеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|    КритерийОтбора.СвязанныеДокументы(&ДоговорСсылка) КАК СвязанныеДокументы
		|ГДЕ
		|    СвязанныеДокументы.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("ДоговорСсылка", ДоговорСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовСтрока = СписокДокументов.Добавить();
		НовСтрока.Дата = ВыборкаДетальныеЗаписи.Ссылка.Дата;
		НовСтрока.Документ = ВыборкаДетальныеЗаписи.Ссылка;
		Док = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЦикла;

	Попытка
		//Чиним договор
		Договор = ДоговорСсылка.ПолучитьОбъект();
		Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Получить(1);
		Договор.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;	
	
	//Проводим документы обратно
	СписокДокументов.Сортировать("Дата", Новый СравнениеЗначений);
	Для Каждого СледДокумент Из СписокДокументов Цикл
    	Док = СледДокумент.Документ.ПолучитьОбъект();
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	

	Договор = ДоговорСсылка.ПолучитьОбъект();
	Если Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Получить(1) Тогда
		КВозврату = Истина;
	Иначе
		КВозврату = Ложь;
	КонецЕсли;

	ЭТ_ОбщийМодуль2.СохранитьНастройку("ВыключитьМодуль",СостояниеМодуляЭТ);
	Возврат КВозврату;	
КонецФункции


&НаСервере
Функция СоздатьДоговорНаСервере()
	Префикс = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Префикс","ЭТ18-");
	НомерЗаявкиИзОснования = ЭТ_ОбщийМодуль2.ПолучитьКодИзСтроки(Основание,Префикс);
	
	ШаблонЗаявкаСтруктура = ЭТ_ОбщийМодуль2.ПолучитьШаблонПоискаЗаявки(НомерЗаявкиИзОснования);
	ШаблонПоискаЗаявкаНомерЗагружено = ШаблонЗаявкаСтруктура.Номер;
	
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Владелец
		|	И (ДоговорыКонтрагентов.Номер ПОДОБНО &Номер
		|	ИЛИ ДоговорыКонтрагентов.Наименование ПОДОБНО &Номер)";
	
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.УстановитьПараметр("Номер", "%"+Префикс+"%"+ШаблонПоискаЗаявкаНомерЗагружено+"%");	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
		Прервать;		
	КонецЦикла;  
	
	НовыйДоговорДок = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	НовыйДоговорДок.Владелец = Контрагент;
	НовыйДоговорДок.Номер = ШаблонЗаявкаСтруктура.ПрефиксПоиск+"-"+ШаблонПоискаЗаявкаНомерЗагружено;
	НаименованиеДоговора = НовыйДоговорДок.Номер;
	КаталогПоставщиков = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПоставщиков",Ложь);
	КаталогЗаказчиков  = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогЗаказчиков",Ложь);     
	КаталогПартнеров = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПартнеров",Ложь);     
	Если НЕ(КаталогПоставщиков=Ложь) И Контрагент.Родитель = КаталогПоставщиков Тогда
		НовыйДоговорДок.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов["СПоставщиком"];
		НаименованиеДоговора = СокрЛП(СокрЛП(НомерБрони) + " ("+НаименованиеДоговора+")");
	ИначеЕсли НЕ(КаталогПартнеров=Ложь) И Контрагент.Родитель = КаталогПартнеров Тогда
		НовыйДоговорДок.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов["СПоставщиком"];
		НаименованиеДоговора = СокрЛП(СокрЛП(НомерБрони) + " ("+НаименованиеДоговора+")");
	ИначеЕсли НЕ(КаталогПоставщиков=Ложь) И Контрагент.Родитель = КаталогПоставщиков Тогда
		НовыйДоговорДок.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов["СПокупателем"];    
	ИначеЕсли СуммаПоступило>СуммаСписано Тогда	
		НовыйДоговорДок.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов["СПокупателем"];    
	Иначе
		НовыйДоговорДок.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов["СПоставщиком"];		
		НаименованиеДоговора = СокрЛП(СокрЛП(НомерБрони) + " ("+НаименованиеДоговора+")");
	КонецЕсли;         
	НовыйДоговорДок.Дата = ТекущаяДата();
	НовыйДоговорДок.Наименование = НаименованиеДоговора+" от "+	Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	НовыйДоговорДок.Записать();
	Возврат НовыйДоговорДок.Ссылка;
КонецФункции


&НаКлиенте
Процедура СоздатьДоговор(Команда)                	
	КВозврату = новый Структура;	
	КВозврату.Вставить("Договор",СоздатьДоговорНаСервере());
	ЭтаФорма.Закрыть(КВозврату);	
КонецПроцедуры

