			Форма = ПолучитьФорму("ОбщаяФорма.ЭТ_СозданиеПоступлениеУслуг",ДополнительныеПараметры);
	    	Форма.Открыть();				
			//ЭтаФорма.Закрыть();
		КонецЕсли;		
	КонецЕсли;
