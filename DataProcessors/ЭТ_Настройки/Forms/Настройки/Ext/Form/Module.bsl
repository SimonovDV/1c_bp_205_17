//ПриОткрытии(Отказ)
//при открытии на форме определяет структуры элементов
&НаКлиенте
Процедура ПриОткрытии(Отказ)   
	Если СтрНайти(нрег(ПользователиКлиентСервер.ТекущийПользователь()),нрег("уралфинанс"))>0 Тогда      
		Отказ = Истина;
		Предупреждение("Вам запрещено менять настройки");
		Возврат;
	КонецЕсли;
	Элементы.Организация.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Организации");
	Элементы.СчетОрганизации.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета");
	Элементы.КаталогПартнеров.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");	
	Элементы.КаталогПоставщиков.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");	
	Элементы.ВидДоговораТО.ОграничениеТипа  = Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов");	
	Элементы.ВидДоговораПоставщик.ОграничениеТипа  = Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов");	
	Элементы.ВидДоговораКлиент.ОграничениеТипа  = Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов");	
	Элементы.СтатьяДвиженияДенежныхСредств.ОграничениеТипа  = Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств");	
	Элементы.СтатьяДвиженияДенежныхСредствКлиент.ОграничениеТипа  = Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств");	
	ЭтаФорма.Элементы.ТекущийЕмайл.Заголовок = "Персональные уведомления на почту: ["+ТекущийЕмайлНаСервере()+"] справочник сотрудников или справочник физических лиц";
	ЭтаФорма.Элементы.ТекущийЕмайл.Видимость = Истина;
	ПолучитьВсеНастройки();
	ПриОткрытииНаСервере();
	Если ЭтоАдминистратор() Тогда
		ЭтаФорма.Элементы.Группа3.Видимость = Истина;
	Иначе
		ЭтаФорма.Элементы.Группа3.Видимость = Ложь;		
	КонецЕсли;
	
	ЭтаФорма.Элементы.НаименованиеУслугиТипУслуги.СписокВыбора.Очистить();
	ЭтаФорма.Элементы.НаименованиеУслугиТипУслуги.РежимВыбораИзСписка = Истина;
	//ЭтаФорма.Элементы.НаименованиеУслугиТипУслуги.
	
	Для Каждого Метаданное из ПолучитьТипыУслуг() Цикл
   		ЭтаФорма.Элементы.НаименованиеУслугиТипУслуги.СписокВыбора.Добавить(Метаданное.Значение, Метаданное.Представление);
	КонецЦикла;


	//ЭтаФорма.Элементы.РеализацияСодержаниеУслуги.СписокВыбора.ЗагрузитьЗначения(ЭТ_ОбщийМодуль2.ТипыУслуг());
КонецПроцедуры

