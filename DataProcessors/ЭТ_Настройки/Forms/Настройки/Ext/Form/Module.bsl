//ЗаполнитьСписокВалют()
//Получает в СБ список валют и заполняет данным списком элемет формы ВалютаДокументов
&НаСервере
Процедура ЗаполнитьСписокВалют()
	Элементы.ВалютаДокументов.СписокВыбора.Очистить();
	Для Каждого СледЭлемент Из ЭТ_ОбщийМодуль2.Сurrency() Цикл
		Элементы.ВалютаДокументов.СписокВыбора.Добавить(СледЭлемент.id,СледЭлемент.name);
	КонецЦикла;
КонецПроцедуры

//ЗаполнитьПользовательЮОН()
//получает в СБ список менеджеров и заполняет им элемент формы ПользовательЮОН
&НаСервере
Процедура ЗаполнитьПользовательЮОН()
	Элементы.ПользовательЮОН.СписокВыбора.Очистить();
	Для Каждого СледЭлемент Из ЭТ_ОбщийМодуль2.Manager() Цикл
		ИмяЭлемента="";
		Если СледЭлемент.Свойство("u_surname") Тогда ИмяЭлемента=СокрЛП(СокрЛП(ИмяЭлемента)+" "+СокрЛП(СледЭлемент.u_surname)) КонецЕсли;
		Если СледЭлемент.Свойство("u_name") Тогда ИмяЭлемента=СокрЛП(СокрЛП(ИмяЭлемента)+" "+СокрЛП(СледЭлемент.u_name)) КонецЕсли;
		Если СледЭлемент.Свойство("u_email") Тогда ИмяЭлемента=СокрЛП(СокрЛП(ИмяЭлемента)+" "+СокрЛП(СледЭлемент.u_email)) КонецЕсли;		
		Элементы.ПользовательЮОН.СписокВыбора.Добавить(СледЭлемент.u_id,ИмяЭлемента);
	КонецЦикла;
КонецПроцедуры

//ЗаполнитьТипТО()
//получает из СБ тип партнера и заполняет им элемекнт формы ТуроператорыТипТО
&НаСервере
Процедура ЗаполнитьТипТО()
	Элементы.ТуроператорыТипТО.СписокВыбора.Очистить();
	Для Каждого СледЭлемент Из ЭТ_ОбщийМодуль2.SupplierType() Цикл
		Элементы.ТуроператорыТипТО.СписокВыбора.Добавить(СледЭлемент.id,СледЭлемент.name);
	КонецЦикла;
КонецПроцедуры


//ЗаполнитьСписокКасс()
//получает из СБ список касс и заполняет им  элементы формы
//-КассаТО
//-КассаКлиентНал
//-КассаКлиентБезнал
//-КассаКлиентКарта
//-ВидыОплатЮОНКассаЮОН
&НаСервере
Процедура ЗаполнитьСписокКасс()
	Элементы.КассаТО.СписокВыбора.Очистить();
	Элементы.КассаКлиентНал.СписокВыбора.Очистить();
	Элементы.КассаКлиентБезнал.СписокВыбора.Очистить();
	Элементы.КассаКлиентКарта.СписокВыбора.Очистить();
	Элементы.ВидыОплатЮОНКассаЮОН.СписокВыбора.Очистить();
	Для Каждого СледКасса Из ЭТ_ОбщийМодуль2.Сash() Цикл
		Элементы.КассаТО.СписокВыбора.Добавить(СледКасса.id,СледКасса.name);
		Элементы.КассаКлиентНал.СписокВыбора.Добавить(СледКасса.id,СледКасса.name);
		Элементы.КассаКлиентБезнал.СписокВыбора.Добавить(СледКасса.id,СледКасса.name);
		Элементы.КассаКлиентКарта.СписокВыбора.Добавить(СледКасса.id,СледКасса.name);
		Элементы.ВидыОплатЮОНКассаЮОН.СписокВыбора.Добавить(СледКасса.name+" ["+Строка(СледКасса.id)+"] ");		
	КонецЦикла;
КонецПроцедуры

//СохранитьНастройку(КлючНастроек,Настройки)
//сохраняет конкретную настройку пользователя (КлючНастроек, Настройки)
&НаСервере
Процедура СохранитьНастройку(КлючНастроек,Настройки)	
	КлючОбъекта  = "ЭТ";
    ИмяПользователя = ИмяПользователя();      	
    ХранилищеОбщихНастроек.Сохранить(КлючОбъекта,  КлючНастроек, Настройки, , ИмяПользователя);
КонецПроцедуры

//ПолучитьНастройку(КлючНастроек)
//получает конкретную настройку пользователя (КлючНастроек)
&НаСервере
Функция ПолучитьНастройку(КлючНастроек)
	КлючОбъекта  = "ЭТ";
    ИмяПользователя = ИмяПользователя();
	Настройки = Неопределено;
    Попытка
        Настройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта,КлючНастроек,,ИмяПользователя);
    Исключение
        Настройки = Неопределено;
    КонецПопытки;

	Возврат Настройки;
КонецФункции

