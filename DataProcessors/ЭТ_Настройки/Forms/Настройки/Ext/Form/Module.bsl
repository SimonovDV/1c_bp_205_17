//ПриОткрытииНаСервере()
//при открытии окна формирует его содержимое
&НаСервере
Процедура ПриОткрытииНаСервере()
	ЗаполнитьСписокКасс();
	ЗаполнитьСписокВалют();
	ЗаполнитьПользовательЮОН();
	ЗаполнитьТипТО();
	ЭквайрингТипУслуги();
	Заполнить_РеализацияКодПакетнойУслуги();
	ТабВидовОплат = ПолучитьНастройку("ВидыОплатЮОН");
	Если Строка(ТипЗнч(ТабВидовОплат)) = "Таблица значений" Тогда
		Объект.ВидыОплатЮОН.Загрузить(ТабВидовОплат)
	КонецЕсли;
	ПлатежкаОснование = ПолучитьНастройку("ПлатежкаОснование");
	Если Строка(ТипЗнч(ПлатежкаОснование)) = "Таблица значений" Тогда
		Объект.ПлатежкаОснование.Загрузить(ПлатежкаОснование)
	КонецЕсли;
	НаименованиеУслуги = ПолучитьНастройку("НаименованиеУслуги");
	Если Строка(ТипЗнч(НаименованиеУслуги)) = "Таблица значений" Тогда
		Объект.НаименованиеУслуги.Загрузить(НаименованиеУслуги)
	КонецЕсли;
	
КонецПроцедуры

//ЭтоАдминистратор()
//определяет ли пользователь администратором
&НаСервере
Функция ЭтоАдминистратор()
	КВозврату = Ложь;
	Если РольДоступна("АдминистраторСистемы") или РольДоступна("Администрирование") Тогда
		КВозврату = Истина;
	КонецЕсли;	
	Возврат КВозврату;
КонецФункции

