&НаКлиенте
Процедура ЭТ_ФормированиеДанных(Результат, Данные) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЭТ_ЗагрузитьИзЮОНВместоНаСервере(Данные.Заявка);  
		Дог = Объект.ДоговорКонтрагента;            	
		Если Не Дог.Пустая() Тогда
			КонтрагентПриИзменении();
			Объект.ДоговорКонтрагента = Дог;
			ДоговорКонтрагентаПриИзменении(Элементы.ДоговорКонтрагента);
			ЭТ_ДоговорКонтрагентаПриИзмененииПосле(Элементы.ДоговорКонтрагента);
		КонецЕсли;	
    КонецЕсли;	
КонецПроцедуры



//Осуществляет загрузку заявки из Ю-он, проц. на клиенте
&НаКлиенте
Процедура ЭТ_ЗагрузитьИзЮОНВместо(Команда)
	ДанныеЗаявки = ПолучитьДанныеЗаявки(СтрокаПоиска);
	Если ДанныеЗаявки.Результат = Ложь Тогда       
		Если ДанныеЗаявки.Заявка.Количество()<1 Тогда
			ПоказатьПредупреждение(,ДанныеЗаявки.Сообщение,,"Внимание!");
		Иначе
			ОписаниеОповещения = Новый ОписаниеОповещения("ЭТ_ФормированиеДанных",ЭтотОбъект,ДанныеЗаявки);
			ТекстВопроса = ДанныеЗаявки.Сообщение + Символы.ПС + Символы.ПС + " Продолжить формирование документа ?";
			ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ДаНет,,,"Продолжить формирование документа ?",);
		КонецЕсли;
	Иначе
		ЭТ_ФормированиеДанных(КодВозвратаДиалога.Да,ДанныеЗаявки);
	КонецЕсли;	
КонецПроцедуры

// ТаблицаУслугСоздать() Экспорт
// Создает структуру таблицы услуг для внутреннего взаимодействия, расчетов
// и сопоставления данных Ю-ОН с платежными документами 1С.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с заранее определенным составом колонок.
//
// Состав таблицы:
//   Базовые поля услуг:
//   - Услуга
//   - Содержание
//   - ИНН
//   - ВОплатах
//   - СуммаСтоимости
//   - Договор
//   - Шаблон
//   - Данные
//   - Оплачено_ЮОН
//   - Оплачено_1С
//
//   Поля для обогащения данными из 1С:
//   - ДоговорКонтрагента
//   - ДокументСсылка
//   - ДокументТип
//   - Дт
//   - Кт
//   - ОбратняяОперация
//   - СубконтоДт2
//   - СубконтоКт2
//   - СуммаДокумента
//
Функция ТаблицаУслугСоздать() Экспорт
	
	ТаблицаУслуг = Новый ТаблицаЗначений;
	
	////////////////////////////////////////////////////////////////////////////////
	// Базовые поля таблицы услуг.
	////////////////////////////////////////////////////////////////////////////////
	
	ТаблицаУслуг.Колонки.Добавить("КодУслуги", Новый ОписаниеТипов("Строка"));
	ТаблицаУслуг.Колонки.Добавить("НомерБрони", Новый ОписаниеТипов("Строка"));
	ТаблицаУслуг.Колонки.Добавить("Услуга", Новый ОписаниеТипов("Строка"));
	ТаблицаУслуг.Колонки.Добавить("Содержание");
	ТаблицаУслуг.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка"));
	ТаблицаУслуг.Колонки.Добавить("ВОплатах", Новый ОписаниеТипов("Число"));
	ТаблицаУслуг.Колонки.Добавить("СуммаСтоимости", Новый ОписаниеТипов("Число"));
	ТаблицаУслуг.Колонки.Добавить("СуммаКлиента", Новый ОписаниеТипов("Число"));
	ТаблицаУслуг.Колонки.Добавить("Договор", Новый ОписаниеТипов("Строка"));
	ТаблицаУслуг.Колонки.Добавить("Шаблон", Новый ОписаниеТипов("Строка"));
	ТаблицаУслуг.Колонки.Добавить("Данные");
	ТаблицаУслуг.Колонки.Добавить("АгентскиеУслуги", Новый ОписаниеТипов("Булево"));
	ТаблицаУслуг.Колонки.Добавить("НаименованиеПартнера", Новый ОписаниеТипов("Строка"));
	
	////////////////////////////////////////////////////////////////////////////////
	// Поля из данных 1С для сопоставления и анализа.
	////////////////////////////////////////////////////////////////////////////////
	
	ТаблицаУслуг.Колонки.Добавить("ДоговорКонтрагента",Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));	
	ТаблицаУслуг.Колонки.Добавить("ДокументСсылка",Новый ОписаниеТипов("ДокументСсылка.СписаниеСРасчетногоСчета"));	
	ТаблицаУслуг.Колонки.Добавить("ДокументТип",Новый ОписаниеТипов("Тип"));
	ТаблицаУслуг.Колонки.Добавить("Дт",Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	ТаблицаУслуг.Колонки.Добавить("Кт",Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));	
	ТаблицаУслуг.Колонки.Добавить("ОбратняяОперация",Новый ОписаниеТипов("Число"));
	ТаблицаУслуг.Колонки.Добавить("СубконтоДт2",Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТаблицаУслуг.Колонки.Добавить("СубконтоКт2",Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));
	ТаблицаУслуг.Колонки.Добавить("СуммаДокумента",Новый ОписаниеТипов("Число"));
	ТаблицаУслуг.Колонки.Добавить("Активность",Новый ОписаниеТипов("Булево"));
	

	Возврат ТаблицаУслуг;
	
КонецФункции                 


// ТаблицаУслугДобавить(ТаблицаУслуг, Параметры) Экспорт
// Добавляет услугу в таблицу или обновляет существующую, агрегируя по ИНН.
//
// Параметры:
//   ТаблицаУслуг - ТаблицаЗначений - таблица услуг (создана ТаблицаУслугСоздать)
//   Параметры    - Структура - параметры добавления услуги:
//     * КодУслуги             - Строка, Неопределено - код услуги (по умолчанию "")
//     * Услуга                - Строка, Неопределено - наименование услуги (по умолчанию "")
//     * Содержание            - Произвольный - описание услуги (по умолчанию "")
//     * ИНН                   - Строка, Неопределено - ИНН поставщика (по умолчанию "")
//     * НаименованиеПартнера  - Строка, Неопределено - наименование партнера (по умолчанию "")
//     * СуммаСтоимости        - Число, Строка, Неопределено - сумма по услуге (по умолчанию 0)
//     * СуммаКлиента          - Число, Строка, Неопределено - сумма клиента (по умолчанию 0)
//     * Шаблон                - Строка, Неопределено - шаблон описания (по умолчанию "")
//     * НомерБрони            - Строка, Неопределено - номер брони на услуге (по умолчанию "")
//
// Возвращаемое значение:
//   ТаблицаЗначений - обновлённая таблица услуг
//
// Логика поиска (по приоритету):
//   0. Ищет по ключу ИНН + НомерБрони (нормализованные: без пробелов/непечатаемых, верхний регистр).
//   1. Ищет по ключу Услуга + ИНН (точное совпадение).
//   2. Если не найдено — ищет по ИНН (агрегация по поставщику).
//   3. Если не найдено — добавляет новую строку.
//   При обновлении: если старая строка была без оплаты (сумма=0), а новая с оплатой,
//   обновляет услугу, содержание и шаблон.
//
// Пример вызова:
//   Параметры = Новый Структура;
//   Параметры.Вставить("Услуга", "Проживание");
//   Параметры.Вставить("ИНН", "7707083893");
//   Параметры.Вставить("НомерБрони", "ABC-123");
//   Параметры.Вставить("СуммаСтоимости", 15000);
//   Параметры.Вставить("СуммаКлиента", 18000);
//   ТаблицаУслуг = ТаблицаУслугДобавить(ТаблицаУслуг, Параметры);
//
Функция ТаблицаУслугДобавить(ТаблицаУслуг, Параметры) Экспорт      
	
	МояОрганизация = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Организация", Справочники.Организации.ПустаяСсылка());
	МойИНН = ?(МояОрганизация.Пустая(), "", МояОрганизация.ИНН);
	
	////////////////////////////////////////////////////////////////////////////////
	// Получение параметров из структуры с значениями по умолчанию
	////////////////////////////////////////////////////////////////////////////////
	
	КодУслуги = "";
	Параметры.Свойство("КодУслуги", КодУслуги);
	
	Услуга = "";
	Параметры.Свойство("Услуга", Услуга);
	
	Содержание = "";
	Параметры.Свойство("Содержание", Содержание);
	
	ИНН = "";
	Параметры.Свойство("ИНН", ИНН);
	
	НаименованиеПартнера = "";
	Параметры.Свойство("НаименованиеПартнера", НаименованиеПартнера);
	
	СуммаСтоимости = 0;
	Параметры.Свойство("СуммаСтоимости", СуммаСтоимости);
	
	СуммаКлиента = 0;
	Параметры.Свойство("СуммаКлиента", СуммаКлиента);
	
	вхШаблон = "";
	Параметры.Свойство("Шаблон", вхШаблон);
	
	НомерБрони = "";
	Параметры.Свойство("НомерБрони", НомерБрони);
	
	////////////////////////////////////////////////////////////////////////////////
	// Нормализация параметров
	////////////////////////////////////////////////////////////////////////////////
	
	Если КодУслуги = Неопределено Тогда
		КодУслуги = "";
	Иначе
		КодУслуги = СокрЛП(КодУслуги);
	КонецЕсли;
	
	Если Услуга = Неопределено Тогда
		Услуга = "";
	КонецЕсли;
	
	Если Содержание = Неопределено Тогда
		Содержание = "";
	КонецЕсли;
	
	Если ИНН = Неопределено Тогда
		ИНН = "";
	Иначе
		ИНН = СокрЛП(ИНН);
	КонецЕсли;
	
	Если НаименованиеПартнера = Неопределено Тогда
		НаименованиеПартнера = "";
	КонецЕсли;
	
	Если вхШаблон = Неопределено Тогда
		вхШаблон = "";
	КонецЕсли;
	
	Если НомерБрони = Неопределено Тогда
		НомерБрони = "";
	Иначе
		НомерБрони = СокрЛП(НомерБрони);
	КонецЕсли;
	
	// Нормализация СуммаСтоимости
	Если СуммаСтоимости = Неопределено Тогда
		СуммаСтоимости = 0;
	ИначеЕсли ТипЗнч(СуммаСтоимости) <> Тип("Число") Тогда
		Попытка
			СуммаСтоимости = Число(СуммаСтоимости);
		Исключение
			СуммаСтоимости = 0;
		КонецПопытки;
	КонецЕсли;
	
	// Нормализация СуммаКлиента
	Если СуммаКлиента = Неопределено Тогда
		СуммаКлиента = 0;
	ИначеЕсли ТипЗнч(СуммаКлиента) <> Тип("Число") Тогда
		Попытка
			СуммаКлиента = Число(СуммаКлиента);
		Исключение
			СуммаКлиента = 0;
		КонецПопытки;
	КонецЕсли;
	
	ВОплатах = (СуммаСтоимости <> 0);
	
	////////////////////////////////////////////////////////////////////////////////
	// Подготовка нормализованных ключей для поиска
	////////////////////////////////////////////////////////////////////////////////
	
	// Нормализованный ИНН: удалить пробелы и непечатаемые символы, верхний регистр
	ИНННормализованный = НормализоватьКлючПоиска(ИНН);
	МойИНННормализованный = НормализоватьКлючПоиска(МойИНН);
	
	// Нормализованный КодУслуги: удалить пробелы и непечатаемые символы, верхний регистр
	КодУслугиНормализованный = НормализоватьКлючПоиска(КодУслуги);
	
	// Нормализованный НомерБрони: удалить пробелы и непечатаемые символы, верхний регистр
	НомерБрониНормализованный = НормализоватьКлючПоиска(НомерБрони);
	
	////////////////////////////////////////////////////////////////////////////////
	// 0. НАИВЫСШИЙ ПРИОРИТЕТ: собственные услуги (ИНН = МойИНН)
	//    Поиск по композитному ключу ИНН + КодУслуги
	//    (оба ключа нормализованы: без пробелов/непечатаемых, верхний регистр)
	////////////////////////////////////////////////////////////////////////////////
	
	Если НЕ ПустаяСтрока(МойИНННормализованный)
		И ИНННормализованный = МойИНННормализованный
		И НЕ ПустаяСтрока(КодУслугиНормализованный) Тогда
		
		Для Каждого СтрокаУслуг Из ТаблицаУслуг Цикл
			
			// Нормализуем ИНН и КодУслуги из строки таблицы для сравнения
			ИННСтрокиНормализованный = НормализоватьКлючПоиска(СтрокаУслуг.ИНН);
			КодУслугиСтрокиНормализованный = НормализоватьКлючПоиска(СтрокаУслуг.КодУслуги);
			
			Если ИННСтрокиНормализованный = МойИНННормализованный
				И КодУслугиСтрокиНормализованный = КодУслугиНормализованный Тогда
				
				// Найдена строка собственной услуги по ИНН + КодУслуги — обновляем суммы
				СтрокаУслуг.СуммаСтоимости =
					?(СтрокаУслуг.СуммаСтоимости = Неопределено, 0, СтрокаУслуг.СуммаСтоимости)
					+ СуммаСтоимости;
				
				СтрокаУслуг.СуммаКлиента =
					?(СтрокаУслуг.СуммаКлиента = Неопределено, 0, СтрокаУслуг.СуммаКлиента)
					+ СуммаКлиента;
				
				// Если была без оплаты, а сейчас с оплатой — обновляем описание
				Если СтрокаУслуг.ВОплатах = Ложь И ВОплатах = Истина Тогда
					СтрокаУслуг.Содержание = Содержание;
					СтрокаУслуг.Шаблон = вхШаблон;
					СтрокаУслуг.ВОплатах = Истина;
				КонецЕсли;
				
				Возврат ТаблицаУслуг;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////////
	// 1. ПРИОРИТЕТ: ищем по композитному ключу ИНН + НомерБрони
	//    (оба ключа нормализованы: без пробелов/непечатаемых, верхний регистр)
	////////////////////////////////////////////////////////////////////////////////
	
	Если НЕ ПустаяСтрока(ИНННормализованный) 
		И НЕ ПустаяСтрока(НомерБрониНормализованный) Тогда
		
		Для Каждого СтрокаУслуг Из ТаблицаУслуг Цикл
			
			// Нормализуем ИНН и НомерБрони из строки таблицы для сравнения
			ИННСтрокиНормализованный = НормализоватьКлючПоиска(СтрокаУслуг.ИНН);
			НомерБрониСтрокиНормализованный = НормализоватьКлючПоиска(
				?(СтрокаУслуг.Свойство("НомерБрони"), СтрокаУслуг.НомерБрони, "")
			);
			
			Если ИННСтрокиНормализованный = ИНННормализованный
				И НомерБрониСтрокиНормализованный = НомерБрониНормализованный Тогда
				
				// Найдена строка по ИНН + НомерБрони — обновляем суммы
				СтрокаУслуг.СуммаСтоимости =
					?(СтрокаУслуг.СуммаСтоимости = Неопределено, 0, СтрокаУслуг.СуммаСтоимости)
					+ СуммаСтоимости;
				
				СтрокаУслуг.СуммаКлиента =
					?(СтрокаУслуг.СуммаКлиента = Неопределено, 0, СтрокаУслуг.СуммаКлиента)
					+ СуммаКлиента;
				
				// Если была без оплаты, а сейчас с оплатой — обновляем описание
				Если СтрокаУслуг.ВОплатах = Ложь И ВОплатах = Истина Тогда
					СтрокаУслуг.Содержание = Содержание;
					СтрокаУслуг.Шаблон = вхШаблон;
					СтрокаУслуг.ВОплатах = Истина;
				КонецЕсли;
				
				Возврат ТаблицаУслуг;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////////
	// 2. ПРИОРИТЕТ: ищем по композитному ключу Услуга + ИНН (точное совпадение)
	////////////////////////////////////////////////////////////////////////////////
	
	Для Каждого СтрокаУслуг Из ТаблицаУслуг Цикл
		
		Если СтрокаУслуг.Услуга = Услуга
			И СокрЛП(СтрокаУслуг.ИНН) = ИНН Тогда
			
			СтрокаУслуг.СуммаСтоимости =
				?(СтрокаУслуг.СуммаСтоимости = Неопределено, 0, СтрокаУслуг.СуммаСтоимости)
				+ СуммаСтоимости;
			
			СтрокаУслуг.СуммаКлиента =
				?(СтрокаУслуг.СуммаКлиента = Неопределено, 0, СтрокаУслуг.СуммаКлиента)
				+ СуммаКлиента;
			
			Если СтрокаУслуг.ВОплатах = Ложь И ВОплатах = Истина Тогда
				СтрокаУслуг.Содержание = Содержание;
				СтрокаУслуг.Шаблон = вхШаблон;
				СтрокаУслуг.ВОплатах = Истина;
			КонецЕсли;
			
			Возврат ТаблицаУслуг;
			
		КонецЕсли;
		
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////////
	// 3. ПРИОРИТЕТ: если не найдено по Услуга + ИНН, ищем первую строку по ИНН
	//    (агрегация по поставщику)
	////////////////////////////////////////////////////////////////////////////////
	
	Для Каждого СтрокаУслуг Из ТаблицаУслуг Цикл
		
		Если СокрЛП(СтрокаУслуг.ИНН) = ИНН Тогда
			
			СтрокаУслуг.СуммаСтоимости =
				?(СтрокаУслуг.СуммаСтоимости = Неопределено, 0, СтрокаУслуг.СуммаСтоимости)
				+ СуммаСтоимости;
			
			СтрокаУслуг.СуммаКлиента =
				?(СтрокаУслуг.СуммаКлиента = Неопределено, 0, СтрокаУслуг.СуммаКлиента)
				+ СуммаКлиента;
			
			Если СтрокаУслуг.ВОплатах = Ложь И ВОплатах = Истина Тогда
				СтрокаУслуг.Услуга = Услуга;
				СтрокаУслуг.Содержание = Содержание;
				СтрокаУслуг.Шаблон = вхШаблон;
				СтрокаУслуг.ВОплатах = Истина;
			КонецЕсли;
			
			Возврат ТаблицаУслуг;
			
		КонецЕсли;
		
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////////
	// 4. Если строка не найдена, добавляем новую
	////////////////////////////////////////////////////////////////////////////////
	
	НоваяСтрока = ТаблицаУслуг.Добавить();
	НоваяСтрока.КодУслуги = КодУслуги;
	НоваяСтрока.Услуга = Услуга;
	НоваяСтрока.Содержание = Содержание;
	НоваяСтрока.ИНН = ИНН;
	НоваяСтрока.НаименованиеПартнера = НаименованиеПартнера;
	НоваяСтрока.ВОплатах = ВОплатах;
	НоваяСтрока.СуммаСтоимости = СуммаСтоимости;
	НоваяСтрока.СуммаКлиента = СуммаКлиента;
	НоваяСтрока.Шаблон = вхШаблон;
	
	// Проверяем наличие колонки НомерБрони в таблице
	Попытка
		НоваяСтрока.НомерБрони = НомерБрони;
	Исключение
		// Колонка НомерБрони отсутствует в таблице — игнорируем
	КонецПопытки;
	
	Возврат ТаблицаУслуг;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ: Нормализация ключа поиска
////////////////////////////////////////////////////////////////////////////////

// НормализоватьКлючПоиска(Ключ)
// Удаляет все пробелы, непечатаемые символы и приводит к верхнему регистру.
//
// Параметры:
//   Ключ - Строка - исходная строка
//
// Возвращаемое значение:
//   Строка - нормализованная строка (без пробелов/непечатаемых, верхний регистр)
//
Функция НормализоватьКлючПоиска(Знач Ключ)
	
	Если ТипЗнч(Ключ) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	// Можно попробовать использовать функцию из БСП, если доступна:
	// Например: СтроковыеФункцииКлиентСервер.УдалитьНедопустимыеСимволы(Ключ)
	// Или: ЭТ_ОбщийМодуль2.УдалитьНепечатаемыеСимволы(Ключ)
	//
	// Если таких функций нет, используем ручную обработку:
	
	Результат = "";
	
	Для Индекс = 1 По СтрДлина(Ключ) Цикл
		Символ = Сред(Ключ, Индекс, 1);
		КодСимвола = КодСимвола(Символ);
		
		// Пропускаем непечатаемые символы (коды 0-31 и 127)
		// и все пробельные символы (код 32 — обычный пробел, 160 — неразрывный и т.д.)
		Если КодСимвола > 32 И КодСимвола <> 127 И КодСимвола <> 160 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	// Приводим к верхнему регистру
	Возврат ВРег(Результат);
	
КонецФункции


//Получает услугу из таблицы услуг, по ИНН Поставщика
Функция ТаблицаУслугПолучитьУслугу(ТаблицаУслуг,ИНН)
	Услуга = "";
	Содержание = "";
	Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	НСтрока = ТаблицаУслуг.Найти(СокрЛП(ИНН),"ИНН");
	Если НЕ ТипЗнч(НСтрока) = Тип("НеОпределено") Тогда
		Услуга = НСтрока.Услуга;        
		Номенклатура = ЭТ_ОбщийМодуль2.ПолучитьНоменклатуруПоУслуге(Услуга, Истина);
		Шаблон = ?(СтрДлина(СокрЛП(Номенклатура.Описание))>0,Номенклатура.Описание,НСтрока.Шаблон);
		Содержание = НСтрока.Содержание;
	Иначе
		Для Каждого СледСтрока Из ТаблицаУслуг Цикл
			Если (СледСтрока.ВОплатах=Истина) И (СледСтрока.СуммаСтоимости>0) И (СтрДлина(СокрЛП(Услуга))<1) Тогда
				Услуга = СледСтрока.Услуга;
				Номенклатура = ЭТ_ОбщийМодуль2.ПолучитьНоменклатуруПоУслуге(Услуга, Истина);
				Шаблон = Номенклатура.Описание;
				Если СтрДлина(СокрЛП(Номенклатура.Описание))>0 Тогда
					Содержание = Номенклатура.Описание;
				Иначе
					Содержание = СледСтрока.Содержание;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("Услуга,Содержание,Номенклатура,Шаблон",Услуга,Содержание,Номенклатура,Шаблон);
КонецФункции

&НаСервере
Функция ПолучитьЗаявку(Знач НомерЗаявки)
	КВозврату = Новый Структура;
	Префикс = СокрЛП(ЭТ_ОбщийМодуль2.ПолучитьНастройку("Префикс","ЭТ18-")); 
	СтрокаПоиска = ВРег(СокрЛП(ЭтаФорма.СтрокаПоиска)); 
	Если СтрНайти(СтрокаПоиска,ВРег(Префикс))=0 Тогда
		СтрокаПоиска = Префикс + СтрокаПоиска;
	КонецЕсли;
	НомерЗаявки = ЭТ_ОбщийМодуль2.ПолучитьКодИзСтроки(СтрокаПоиска,Префикс);
	КВозврату = ЭТ_ОбщийМодуль2.ПолучитьЗаявкуПоНомеру(НомерЗаявки);
	Возврат  КВозврату;
КонецФункции

// ТаблицаУслугПолучитьДанные(ДоговорКонтрагента) Экспорт
// Загружает данные заявки из Ю-ОН и формирует таблицу услуг по договору контрагента
// с последующим обогащением данными из платежных документов 1С.
//
// Параметры:
//   ДоговорКонтрагента - СправочникСсылка.ДоговорыКонтрагентов / СправочникОбъект.ДоговорыКонтрагентов
//                        Используется для определения номера заявки и формирования структуры параметров
//                        из реквизитов договора.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица услуг, созданная функцией ТаблицаУслугСоздать() и заполненная строками
//                     через ТаблицаУслугДобавить(). Содержит объединенные данные из Ю-ОН и 1С.
//                     Дополнена колонками из платежных документов 1С.
//
// Логика работы:
//
//   ЭТАП 1. ФОРМИРОВАНИЕ СТРУКТУРЫ ДОГОВОРА
//   1.1. До обработки услуг формируется структура реквизитов договора из метаданных:
//        - реквизиты со значением типа Булево пропускаются;
//        - значения типов Строка и Число сохраняются как есть;
//        - значения всех остальных типов приводятся к строке через Строка();
//        - пустые и неопределенные значения сохраняются как пустая строка.
//
//   ЭТАП 2. ПОЛУЧЕНИЕ ЗАЯВКИ ИЗ Ю-ОН
//   2.1. По номеру договора определяется номер заявки Ю-ОН (удаляется дата из номера).
//   2.2. Получается заявка через ПолучитьЗаявку(Номер).
//   2.3. Если заявка не найдена или не содержит коллекции services, возвращается пустая таблица.
//
//   ЭТАП 3. ОБРАБОТКА УСЛУГ ИЗ Ю-ОН
//   3.1. Для каждой услуги из коллекции services определяется:
//        - тип услуги (service_type);
//        - ИНН партнера услуги (приоритет: partner_inn → partner_id → supplier_inn → supplier_id);
//        - сумма в оплатах (price_netto × rate_netto);
//        - содержание услуги через ПолучитьСодержаниеУслуги().
//   3.2. Структура договора сливается со структурой содержания услуги:
//        - если содержание услуги не является структурой, оно оборачивается в структуру
//          с ключом "Содержание";
//        - сначала копируются все ключи из СтруктураДоговора;
//        - затем копируются/перезаписываются ключи из СтруктураСодержания
//          (приоритет у содержания услуги).
//   3.3. Объединенная структура передается в ТаблицаУслугДобавить() как параметр Содержание.
//
//   ЭТАП 4. ПОЛУЧЕНИЕ ПЛАТЕЖНЫХ ДОКУМЕНТОВ ИЗ 1С
//   4.1. Получается таблица платежных документов по номеру заявки и виду договора "ТО"
//        через ЭТ_ОбщийМодуль2.ПолучитьПлатежныеДокументыПоЗаявке().
//   4.2. Создается копия таблицы услуг Ю-ОН как основа результата.
//   4.3. Добавляются недостающие колонки из таблицы платежных документов 1С.
//
//   ЭТАП 5. СОПОСТАВЛЕНИЕ ДАННЫХ Ю-ОН И 1С ПО ИНН
//   5.1. Создается индекс данных 1С — соответствие с ключами вида "ИНН" и "ИНН_Договор".
//   5.2. Для каждой строки из таблицы Ю-ОН ищется соответствие в индексе:
//        - сначала поиск по ключу "ИНН_Договор" (если договор заполнен);
//        - затем поиск по ключу "ИНН".
//   5.3. Если соответствие найдено:
//        - данные 1С перезаписывают данные Ю-ОН (приоритет у 1С);
//        - строка 1С помечается как использованная.
//
//   ЭТАП 6. ДОБАВЛЕНИЕ НЕИСПОЛЬЗОВАННЫХ СТРОК ИЗ 1С
//   6.1. Строки из 1С, которые не нашли пары в Ю-ОН, добавляются в конец результирующей таблицы.
//
//   ЭТАП 7. АНАЛИЗ РАСХОЖДЕНИЙ
//   7.1. Вызывается АнализироватьРасхожденияДанных() — сравнивает СуммаСтоимости (Ю-ОН)
//        и СуммаДокумента (1С), выводит отчет через Сообщить().
//
// Особенности:
//   - при конфликте ключей при слиянии структур приоритет отдается данным содержания услуги;
//   - при сопоставлении строк приоритет отдается данным 1С (они перезаписывают Ю-ОН);
//   - для получения реквизитов договора используется объект метаданных справочника;
//   - функция рассчитана на то, что объект заявки содержит коллекцию services
//     и свойства supplier_id / supplier_inn;
//   - параметр Содержание в ТаблицаУслугДобавить() теперь является структурой, а не строкой.
//
// Пример:
//   ТаблицаУслуг = ТаблицаУслугПолучитьДанные(ДоговорКонтрагента);
//
Функция ТаблицаУслугПолучитьДанные(ДоговорКонтрагента) Экспорт

	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 1. ФОРМИРОВАНИЕ СТРУКТУРЫ ДОГОВОРА
	////////////////////////////////////////////////////////////////////////////////
	
	МассивПартнеровВЗаявке = Новый Массив;
	ТаблицаУслуг = ТаблицаУслугСоздать();
	
	// Формируем структуру реквизитов договора один раз до цикла по услугам.
	СтруктураДоговора = Новый Структура;
	
	Попытка
		Для Каждого РеквизитМетаданных Из Метаданные.Справочники.ДоговорыКонтрагентов.Реквизиты Цикл
			
			ИмяРеквизита = РеквизитМетаданных.Имя;
			
			// Безопасное чтение значения реквизита.
			Попытка
				ЗначениеРеквизита = ДоговорКонтрагента[ИмяРеквизита];
			Исключение
				Продолжить;
			КонецПопытки;
			
			// Пропускаем булевы реквизиты.
			Если ТипЗнч(ЗначениеРеквизита) = Тип("Булево") Тогда
				Продолжить;
			КонецЕсли;
			
			// Неопределено → пустая строка.
			Если ЗначениеРеквизита = Неопределено Тогда
				СтруктураДоговора.Вставить(ИмяРеквизита, "");
				Продолжить;
			КонецЕсли;
			
			ТипРеквизита = ТипЗнч(ЗначениеРеквизита);
			
			// Строки и числа сохраняем как есть, остальное приводим к строке.
			Если ТипРеквизита = Тип("Строка")
				Или ТипРеквизита = Тип("Число") Тогда
				
				СтруктураДоговора.Вставить(ИмяРеквизита, ЗначениеРеквизита);
				
			Иначе
				СтруктураДоговора.Вставить(ИмяРеквизита, Строка(ЗначениеРеквизита));
			КонецЕсли;
			
		КонецЦикла;
	Исключение
		// Если по каким-то причинам доступ к метаданным/реквизитам не удался,
		// продолжаем работу с пустой структурой договора.
		СтруктураДоговора = Новый Структура;
	КонецПопытки;
	
	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 2. ПОЛУЧЕНИЕ ЗАЯВКИ ИЗ Ю-ОН
	////////////////////////////////////////////////////////////////////////////////
	
	// Номер заявки определяем по номеру договора (удаляем дату).
	Попытка
		НомерДоговора = ДоговорКонтрагента.Номер;
	Исключение
		НомерДоговора = Строка(ДоговорКонтрагента);
	КонецПопытки;
	
	СледНомер = СокрЛП(ЭТ_ОбщийМодуль2.УдалитьДатуИзСтроки(НомерДоговора));
	СледЭлемент = ПолучитьЗаявку(СледНомер);
	ПартнерОпределен = Ложь;
	
	// Если заявка не найдена, возвращаем пустую таблицу.
	Если СледЭлемент = Неопределено Тогда
		Возврат ТаблицаУслуг;
	КонецЕсли;
	
	// Если в заявке нет коллекции services, возвращаем пустую таблицу.
	Если НЕ СледЭлемент.Свойство("services") Тогда
		Возврат ТаблицаУслуг;
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 3. ОБРАБОТКА УСЛУГ ИЗ Ю-ОН
	////////////////////////////////////////////////////////////////////////////////
	
	Для Каждого СледУслуга Из СледЭлемент.services Цикл
		
		Услуга = "";
		Содержание = "";
		ИНН = "";          
		НаименованиеПартнера = "";
		ВОплатах = 0; // Сумма в оплатах (price_netto × rate_netto).
		СуммаКлиента = 0; 
		КодУслуги = 0;
		НомерБрони = "";

		// Определяем тип услуги.
		Если СледУслуга.Свойство("id") Тогда
			КодУслуги = СледУслуга.id;
		КонецЕсли;     

		// Определяем НомерБрони из extended_fields
		Если СледУслуга.Свойство("extended_fields") И ТипЗнч(СледУслуга.extended_fields) = Тип("Массив") Тогда
			Для Каждого ПолеРасширения Из СледУслуга.extended_fields Цикл
				Если ТипЗнч(ПолеРасширения) = Тип("Структура") 
					И ПолеРасширения.Свойство("id") 
					И ПолеРасширения.Свойство("value") Тогда
					
					Если ПолеРасширения.id = 123070 Тогда
						НомерБрони = ПолеРасширения.value;
						Прервать;
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Определяем тип услуги.
		Если СледУслуга.Свойство("service_type") Тогда
			Услуга = СледУслуга.service_type;
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
		// Определяем наименование партнера услуги.
		////////////////////////////////////////////////////////////////////////////////
		
		// Приоритет 1: partner_name у самой услуги.
		Если СледУслуга.Свойство("partner_name") Тогда
			НаименованиеПартнера = СокрЛП(СледУслуга.partner_name);
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
		// Определяем ИНН партнера услуги (каскадный поиск с приоритетом).
		////////////////////////////////////////////////////////////////////////////////
		
		// Приоритет 1: partner_inn (прямое указание ИНН).
		Если СледУслуга.Свойство("partner_inn") И СтрДлина(ИНН) < 1 Тогда
			ИНН = СокрЛП(СледУслуга.partner_inn);
		КонецЕсли;
		
		// Приоритет 2: partner_id → запрос Supplier(id) → inn и name.
		Если СледУслуга.Свойство("partner_id") И СтрДлина(ИНН) < 1 Тогда
			Если ?(СледУслуга.partner_id <> Неопределено, СледУслуга.partner_id, 0) > 0 Тогда
				Партнер = ЭТ_ОбщийМодуль2.Supplier(Новый Структура("id", СледУслуга.partner_id));
				Если Партнер.Количество() > 0 Тогда
					ИНН = "";
					Если Партнер.Свойство("inn") Тогда
						ИНН = СокрЛП(Партнер.inn);
					КонецЕсли;
					
					Если СтрДлина(НаименованиеПартнера) < 1 И Партнер.Свойство("name") Тогда
						НаименованиеПартнера = СокрЛП(Партнер.name);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Приоритет 3: если partner_id пустой, берем supplier_inn или supplier_id заявки.
		Если СледУслуга.Свойство("partner_id") И СтрДлина(ИНН) < 1 Тогда
			Если СтрДлина(СокрЛП(СледУслуга.partner_id)) < 1 Тогда
				
				// Приоритет 3.1: supplier_inn.
				Если СледЭлемент.Свойство("supplier_inn") И СтрДлина(ИНН) < 1 Тогда
					ИНН = СокрЛП(СледЭлемент.supplier_inn);
				КонецЕсли;
				
				// Приоритет 3.2: supplier_id → запрос Supplier(id) → inn и name.
				Если СледЭлемент.Свойство("supplier_id") И СтрДлина(ИНН) < 1 Тогда
					Партнер = ЭТ_ОбщийМодуль2.Supplier(Новый Структура("id", СледЭлемент.supplier_id));
					Если Партнер.Количество() > 0 Тогда
						ИНН = "";
						Если Партнер.Свойство("inn") Тогда
							ИНН = СокрЛП(Партнер.inn);
						КонецЕсли;
						
						Если СтрДлина(НаименованиеПартнера) < 1 И Партнер.Свойство("name") Тогда
							НаименованиеПартнера = СокрЛП(Партнер.name);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
		// Определяем сумму в оплатах (price_netto × rate_netto).
		////////////////////////////////////////////////////////////////////////////////
		
		Если СледУслуга.Свойство("price_netto") Тогда
			ВОплатах = ?(ТипЗнч(СледУслуга.price_netto) = Тип("Число"), СледУслуга.price_netto, 0);
		КонецЕсли;
		
		// Если есть курс, умножаем.
		Если СледУслуга.Свойство("rate_netto") Тогда
			Если СледУслуга.rate_netto > 1 Тогда
				ВОплатах = ВОплатах * СледУслуга.rate_netto;
			КонецЕсли;
		КонецЕсли;     
		
		
		////////////////////////////////////////////////////////////////////////////////
		// Определяем сумму клиента (price × rate).
		////////////////////////////////////////////////////////////////////////////////
		
		Если СледУслуга.Свойство("price") Тогда
			СуммаКлиента = ?(ТипЗнч(СледУслуга.price) = Тип("Число"), СледУслуга.price, 0);
		КонецЕсли;
		
		// Если есть курс, умножаем.
		Если СледУслуга.Свойство("rate") Тогда
			Если СледУслуга.rate > 1 Тогда
				СуммаКлиента = СуммаКлиента * СледУслуга.rate;
			КонецЕсли;
		КонецЕсли;     
		
		
		
		////////////////////////////////////////////////////////////////////////////////
		// Получаем содержание услуги через ПолучитьСодержаниеУслуги().
		////////////////////////////////////////////////////////////////////////////////
		
		Содержание = ПолучитьСодержаниеУслуги(
			СледЭлемент,
			СледУслуга,
			ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияСодержаниеУслуги", 0)
		);
		
		// Если ПолучитьСодержаниеУслуги вернула не структуру,
		// оборачиваем результат в структуру с ключом "Содержание".
		Если ТипЗнч(Содержание) <> Тип("Структура") Тогда
			СтруктураСодержания = Новый Структура;
			СтруктураСодержания.Вставить("Содержание", Содержание);
		Иначе
			СтруктураСодержания = Содержание;
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
		// Сливаем структуру договора и структуру содержания услуги.
		// Приоритет у структуры содержания услуги (она перезаписывает ключи договора).
		////////////////////////////////////////////////////////////////////////////////
		
		ИтоговоеСодержание = Новый Структура;

		// Сначала копируем все ключи из структуры договора.
		Для Каждого ЭлементСтруктуры Из СтруктураДоговора Цикл
			ИтоговоеСодержание.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		КонецЦикла;

		// Затем копируем/перезаписываем ключи из структуры содержания услуги.
		Для Каждого ЭлементСтруктуры Из СтруктураСодержания Цикл
			ИтоговоеСодержание.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		КонецЦикла;

		////////////////////////////////////////////////////////////////////////////////
		// Добавляем услугу в таблицу.
		// Параметр Содержание теперь является структурой, а не строкой.
		////////////////////////////////////////////////////////////////////////////////
		
		//ТаблицаУслуг = ТаблицаУслугДобавить(
		//	ТаблицаУслуг,
		//	КодУслуги,
		//	Услуга,
		//	ИтоговоеСодержание,
		//	ИНН,
		//	НаименованиеПартнера,
		//	ВОплатах,   
		//	СуммаКлиента,
		//	"{описание}" // Шаблон по умолчанию.
		//);
		
		
		ТаблицаУслуг = ТаблицаУслугДобавить(ТаблицаУслуг, 
			Новый Структура("КодУслуги, Услуга, Содержание, ИНН, НаименованиеПартнера, СуммаСтоимости, СуммаКлиента, Шаблон, НомерБрони",
				КодУслуги, 
				Услуга, 
				ИтоговоеСодержание, 
				ИНН, 
				НаименованиеПартнера, 
				ВОплатах, 
				СуммаКлиента, 
				"{описание}",
				НомерБрони
			)
		);                      
		
		ЗаполнениеПроход = Истина;
		
	КонецЦикла;
	
	
        
	
	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 4. ПОЛУЧЕНИЕ ПЛАТЕЖНЫХ ДОКУМЕНТОВ ИЗ 1С
	////////////////////////////////////////////////////////////////////////////////

	ПлатежныеДокументы = ЭТ_ОбщийМодуль2.ПолучитьПлатежныеДокументыПоЗаявке(
		СокрЛП(ЭТ_ОбщийМодуль2.УдалитьДатуИзСтроки(ДоговорКонтрагента.Номер)),
		ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораТО", Null)
	);

	ТаблицаПлатежныеДокументыИсходная = ПлатежныеДокументы.Выгрузить();

	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 4.1. ГРУППИРОВКА ПЛАТЕЖНЫХ ДОКУМЕНТОВ ПО ДОГОВОРУ РАСЧЕТОВ
	// Прямая операция: Дт = 76.05
	// Возврат: Кт = 76.05
	// Для возврата ищем группу по СубконтоКт2 = СубконтоДт2 прямой операции.
	// Сумма возврата учитывается со знаком минус.
	////////////////////////////////////////////////////////////////////////////////

	ТаблицаПлатежныеДокументы = ТаблицаПлатежныеДокументыИсходная.Скопировать();
	ТаблицаПлатежныеДокументы.Очистить();

	ИндексГруппировки = Новый Соответствие;

	Для Каждого ИсходнаяСтрока Из ТаблицаПлатежныеДокументыИсходная Цикл
		
		ЭтоПрямаяОперация = Ложь;
		ЭтоВозврат = Ложь;
		КлючГруппы = Неопределено;
		ЗнакСуммы = 1;
		
		Если Строка(ИсходнаяСтрока.Дт) = "76.05" Тогда
			ЭтоПрямаяОперация = Истина;
			КлючГруппы = ИсходнаяСтрока.СубконтоДт2;
			ЗнакСуммы = 1;
		ИначеЕсли Строка(ИсходнаяСтрока.Кт) = "76.05" Тогда
			ЭтоВозврат = Истина;
			КлючГруппы = ИсходнаяСтрока.СубконтоКт2;
			ЗнакСуммы = -1;
		Иначе
			// Если операция не относится к нужной схеме, группируем по договору как запасной вариант.
			КлючГруппы = ИсходнаяСтрока.ДоговорКонтрагента;
			ЗнакСуммы = 1;
		КонецЕсли;
		
		СуммаСтроки = ?(
			ТипЗнч(ИсходнаяСтрока.СуммаДокумента) = Тип("Число"),
			ИсходнаяСтрока.СуммаДокумента,
			0
		) * ЗнакСуммы;
		
		Если ИндексГруппировки[КлючГруппы] = Неопределено Тогда
			
			НоваяСтрока = ТаблицаПлатежныеДокументы.Добавить();
			
			Для Каждого Колонка Из ТаблицаПлатежныеДокументыИсходная.Колонки Цикл
				
				ИмяКолонки = Колонка.Имя;
				
				Если ИмяКолонки = "СуммаДокумента" Тогда
					НоваяСтрока[ИмяКолонки] = СуммаСтроки;
				ИначеЕсли ИмяКолонки = "Активность" Тогда
					Продолжить;
				ИначеЕсли ИмяКолонки = "Выб" Тогда
					Продолжить;
				ИначеЕсли ЭтоВозврат И ИмяКолонки = "ДоговорКонтрагента" Тогда
					// Для возврата в итоговой строке договор берем из ключа группы,
					// то есть из связанной прямой операции.
					НоваяСтрока[ИмяКолонки] = КлючГруппы;
				ИначеЕсли ЭтоВозврат И ИмяКолонки = "СубконтоДт2" Тогда
					НоваяСтрока[ИмяКолонки] = КлючГруппы;
				Иначе
					НоваяСтрока[ИмяКолонки] = ИсходнаяСтрока[ИмяКолонки];
				КонецЕсли;
				
			КонецЦикла;
			
			ИндексГруппировки.Вставить(КлючГруппы, НоваяСтрока);
			
		Иначе
			
			СтрокаГруппы = ИндексГруппировки[КлючГруппы];
			СтрокаГруппы.СуммаДокумента = СтрокаГруппы.СуммаДокумента + СуммаСтроки;
			
		КонецЕсли;
		
	КонецЦикла;

	// Поля, которые не участвуют в группировке, обрабатываем после нее.
	Если ТаблицаПлатежныеДокументы.Колонки.Найти("Активность") <> Неопределено Тогда
		Для Каждого СтрокаПлатежа Из ТаблицаПлатежныеДокументы Цикл
			СтрокаПлатежа.Активность = Ложь;
		КонецЦикла;
	КонецЕсли;

	Если ТаблицаПлатежныеДокументы.Колонки.Найти("Выб") = Неопределено Тогда
		ТаблицаПлатежныеДокументы.Колонки.Добавить("Выб", Новый ОписаниеТипов("Булево"));
	КонецЕсли;

	Для Каждого СтрокаПлатежа Из ТаблицаПлатежныеДокументы Цикл
		СтрокаПлатежа.Выб = Ложь;
	КонецЦикла;
	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 5. СОПОСТАВЛЕНИЕ ДАННЫХ Ю-ОН И 1С ПО ИНН
	////////////////////////////////////////////////////////////////////////////////

	// Создаем индекс данных 1С для быстрого поиска по ИНН.
	// Ключ: ИНН контрагента.
	// Значение: массив строк таблицы ТаблицаПлатежныеДокументы с данным ИНН.
	ИндексДанных1С = Новый Соответствие;

	Для Каждого Строка1С Из ТаблицаПлатежныеДокументы Цикл
		
		ИНН = "";
		
		Если Строка1С.ДоговорКонтрагента <> Неопределено Тогда
			Если Строка1С.ДоговорКонтрагента.Владелец <> Неопределено Тогда
				ИНН = СокрЛП(Строка1С.ДоговорКонтрагента.Владелец.ИНН);
			КонецЕсли;
		КонецЕсли;
		
		Если ПустаяСтрока(ИНН) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИндексДанных1С[ИНН] = Неопределено Тогда
			ИндексДанных1С.Вставить(ИНН, Новый Массив);
		КонецЕсли;
		
		ИндексДанных1С[ИНН].Добавить(Строка1С);
		
	КонецЦикла;

	// Обрабатываем строки таблицы услуг (данные из Ю-ОН).
	Для Каждого СтрокаУслуги Из ТаблицаУслуг Цикл
		
		ИННCRM = СокрЛП(СтрокаУслуги.ИНН);
		ДоговорCRM = ВРег(СокрЛП(СтрокаУслуги.Договор));
		
		СуммаCRM = 0;
		Если ТипЗнч(СтрокаУслуги.СуммаСтоимости) = Тип("Число") Тогда
			СуммаCRM = СтрокаУслуги.СуммаСтоимости;
		ИначеЕсли ТипЗнч(СтрокаУслуги.СуммаСтоимости) = Тип("Строка") Тогда
			Попытка
				СуммаCRM = Число(СтрЗаменить(СтрЗаменить(СтрокаУслуги.СуммаСтоимости, " ", ""), ",", "."));
			Исключение
				СуммаCRM = 0;
			КонецПопытки;
		КонецЕсли;
		
		Если ПустаяСтрока(ИННCRM) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок1С = ИндексДанных1С[ИННCRM];
		
		Если МассивСтрок1С = Неопределено ИЛИ МассивСтрок1С.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НайденнаяСтрока1С = Неопределено;
		
		// ПРИОРИТЕТ 1: Если поле Договор заполнено, ищем по ИНН + вхождение Договора в Наименование.
		Если НЕ ПустаяСтрока(ДоговорCRM) Тогда
			
			Для Каждого Строка1С Из МассивСтрок1С Цикл
				
				Если Строка1С.Выб = Истина Тогда
					Продолжить;
				КонецЕсли;
				
				НаименованиеДоговора = "";
				Если Строка1С.ДоговорКонтрагента <> Неопределено Тогда
					НаименованиеДоговора = ВРег(СокрЛП(Строка1С.ДоговорКонтрагента.Наименование));
				КонецЕсли;
				
				Если Найти(НаименованиеДоговора, ДоговорCRM) > 0 Тогда
					НайденнаяСтрока1С = Строка1С;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// ПРИОРИТЕТ 2: Если строка не найдена, ищем по ИНН + СуммаСтоимости = СуммаДокумента.
		Если НайденнаяСтрока1С = Неопределено Тогда
			
			Для Каждого Строка1С Из МассивСтрок1С Цикл
				
				Если Строка1С.Выб = Истина Тогда
					Продолжить;
				КонецЕсли;
				
				Сумма1С = ?(ТипЗнч(Строка1С.СуммаДокумента) = Тип("Число"), Строка1С.СуммаДокумента, 0);
				
				Если СуммаCRM = Сумма1С Тогда
					НайденнаяСтрока1С = Строка1С;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// ПРИОРИТЕТ 3: Если строка все еще не найдена, берем первую доступную строку по ИНН.
		Если НайденнаяСтрока1С = Неопределено Тогда
			
			Для Каждого Строка1С Из МассивСтрок1С Цикл
				
				Если Строка1С.Выб = Истина Тогда
					Продолжить;
				КонецЕсли;
				
				НайденнаяСтрока1С = Строка1С;
				Прервать;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// Если подходящая строка 1С найдена, заполняем поля в строке услуги.
		Если НайденнаяСтрока1С <> Неопределено Тогда
			
			Попытка
				СтрокаУслуги.Активность = НайденнаяСтрока1С.Активность;
			Исключение
				СтрокаУслуги.Активность = Ложь;
			КонецПопытки;
			
			Попытка
				СтрокаУслуги.ДоговорКонтрагента = НайденнаяСтрока1С.ДоговорКонтрагента;
			Исключение
			КонецПопытки;
			
			Попытка
				СтрокаУслуги.Дт = НайденнаяСтрока1С.Дт;
			Исключение
			КонецПопытки;
			
			Попытка
				СтрокаУслуги.Кт = НайденнаяСтрока1С.Кт;
			Исключение
			КонецПопытки;
			
			Попытка
				СтрокаУслуги.ОбратняяОперация = НайденнаяСтрока1С.ОбратняяОперация;
			Исключение
				СтрокаУслуги.ОбратняяОперация = 0;
			КонецПопытки;
			
			Попытка
				СтрокаУслуги.СубконтоДт2 = НайденнаяСтрока1С.СубконтоДт2;
			Исключение
			КонецПопытки;
			
			Попытка
				СтрокаУслуги.СубконтоКт2 = НайденнаяСтрока1С.СубконтоКт2;
			Исключение
			КонецПопытки;
			
			Попытка
				СтрокаУслуги.СуммаДокумента = НайденнаяСтрока1С.СуммаДокумента;
			Исключение
				СтрокаУслуги.СуммаДокумента = 0;
			КонецПопытки;
			
			НайденнаяСтрока1С.Выб = Истина;
			
		КонецЕсли;
		
	КонецЦикла;

	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 6. ДОБАВЛЕНИЕ НЕИСПОЛЬЗОВАННЫХ СТРОК ИЗ 1С
	////////////////////////////////////////////////////////////////////////////////

	// Добавляем строки из ТаблицаПлатежныеДокументы, которые не нашли пары в таблице услуг.
	Для Каждого Строка1С Из ТаблицаПлатежныеДокументы Цикл
		
		// Если строка уже была использована при сопоставлении, пропускаем.
		Если Строка1С.Выб = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если Строка1С.СуммаДокумента < 0 Тогда
			
			НаименованиеКонтрагента = "";
			ИННКонтрагента = "";
			НаименованиеДоговора = "";
			НомерДоговора1С = "";
			ДатаДоговора1С = "";
			СуммаПереплаты = -Строка1С.СуммаДокумента;
			
			Если Строка1С.ДоговорКонтрагента <> Неопределено Тогда
				
				Попытка
					НаименованиеДоговора = СокрЛП(Строка(Строка1С.ДоговорКонтрагента));
				Исключение
				КонецПопытки;
				
				Попытка
					НомерДоговора1С = СокрЛП(Строка(Строка1С.ДоговорКонтрагента.Номер));
				Исключение
				КонецПопытки;
				
				Попытка
					Если Строка1С.ДоговорКонтрагента.Дата <> Неопределено Тогда
						ДатаДоговора1С = Формат(Строка1С.ДоговорКонтрагента.Дата, "ДФ=dd.MM.yyyy");
					КонецЕсли;
				Исключение
				КонецПопытки;
				
				Если Строка1С.ДоговорКонтрагента.Владелец <> Неопределено Тогда
					
					Попытка
						НаименованиеКонтрагента = СокрЛП(Строка(Строка1С.ДоговорКонтрагента.Владелец));
					Исключение
					КонецПопытки;
					
					Попытка
						ИННКонтрагента = СокрЛП(Строка1С.ДоговорКонтрагента.Владелец.ИНН);
					Исключение
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Сообщить(
				"Обнаружена переплата поставщику. "
				+ "Контрагент: " + ?(ПустаяСтрока(НаименованиеКонтрагента), "<не указан>", НаименованиеКонтрагента)
				+ ", ИНН: " + ?(ПустаяСтрока(ИННКонтрагента), "<не указан>", ИННКонтрагента)
				+ ", Договор: " + ?(ПустаяСтрока(НаименованиеДоговора), "<не указан>", НаименованиеДоговора)
				+ ?(ПустаяСтрока(НомерДоговора1С), "", ", Номер: " + НомерДоговора1С)
				+ ?(ПустаяСтрока(ДатаДоговора1С), "", ", Дата: " + ДатаДоговора1С)
				+ ", Сумма переплаты: " + Формат(СуммаПереплаты, "ЧДЦ=2; ЧРД=.; ЧГ=0")
			);
			
			Продолжить;
			
		КонецЕсли;
		
		Если Строка1С.СуммаДокумента = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Добавляем новую строку в таблицу услуг.
		НоваяСтрока = ТаблицаУслуг.Добавить();
		
		// Извлекаем ИНН из данных 1С и заполняем в новую строку.
		Если Строка1С.ДоговорКонтрагента <> Неопределено
			И Строка1С.ДоговорКонтрагента.Владелец <> Неопределено Тогда
			НоваяСтрока.ИНН = СокрЛП(Строка1С.ДоговорКонтрагента.Владелец.ИНН); 
			
			Если НЕ ПустаяСтрока(НоваяСтрока.ИНН) Тогда
				Попытка
					СтруктураПоиска = Новый Структура("inn", НоваяСтрока.ИНН);
					ДанныеПоставщика = ЭТ_ОбщийМодуль2.Supplier(СтруктураПоиска);
					Если ДанныеПоставщика <> Неопределено
						И ДанныеПоставщика.Количество() > 0
						И ДанныеПоставщика.Свойство("name") Тогда
						НоваяСтрока.НаименованиеПартнера = СокрЛП(ДанныеПоставщика.name);
					КонецЕсли;
				Исключение
					НоваяСтрока.НаименованиеПартнера = "";
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
		
		// Заполняем поля из данных 1С.
		Попытка
			НоваяСтрока.Активность = Строка1С.Активность;
		Исключение
			НоваяСтрока.Активность = Ложь;
		КонецПопытки;
		
		Попытка
			НоваяСтрока.ДоговорКонтрагента = Строка1С.ДоговорКонтрагента;
		Исключение
		КонецПопытки;
		
		Попытка
			НоваяСтрока.Дт = Строка1С.Дт;
		Исключение
		КонецПопытки;
		
		Попытка
			НоваяСтрока.Кт = Строка1С.Кт;
		Исключение
		КонецПопытки;
		
		Попытка
			НоваяСтрока.ОбратняяОперация = Строка1С.ОбратняяОперация;
		Исключение
			НоваяСтрока.ОбратняяОперация = 0;
		КонецПопытки;
		
		Попытка
			НоваяСтрока.СубконтоДт2 = Строка1С.СубконтоДт2;
		Исключение
		КонецПопытки;
		
		Попытка
			НоваяСтрока.СубконтоКт2 = Строка1С.СубконтоКт2;
		Исключение
		КонецПопытки;
		
		Попытка
			НоваяСтрока.СуммаДокумента = Строка1С.СуммаДокумента;
		Исключение
			НоваяСтрока.СуммаДокумента = 0;
		КонецПопытки;
		
	КонецЦикла;	
	

	// Возвращаем результат.
	Возврат ТаблицаУслуг;
	
КонецФункции


// Процедура заполнения недостающих данных
&НаСервере
Процедура ЗаполнитьНедостающиеДанные(СтрокаПриемник, СтрокаИсточник)
    
    Для Каждого Колонка Из СтрокаПриемник.Владелец().Колонки Цикл
        // Пропускаем суммовые поля
        Если Колонка.Имя = "СуммаДокумента" 
            ИЛИ Колонка.Имя = "СуммаСтоимости" Тогда
            Продолжить;
        КонецЕсли;
        
        // Заполняем только пустые поля
        Если НЕ ЗначениеЗаполнено(СтрокаПриемник[Колонка.Имя]) Тогда
            Попытка
                СтрокаПриемник[Колонка.Имя] = СтрокаИсточник[Колонка.Имя];
            Исключение
                // Игнорируем ошибки несовпадения типов или отсутствия колонки
            КонецПопытки;
        КонецЕсли;
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Функция СтруктураИзДоговора(ДоговорКонтрагента) Экспорт
    
    СтруктураДоговора = Новый Структура;
    Описание = Новый ОписаниеТипов;
    
    // Перебираем все реквизиты договора через Метаданные
    ОбъектМетаданных = Метаданные.Справочники.ДоговорыКонтрагентов;
    
    Для Каждого Рекв Из ОбъектМетаданных.Реквизиты Цикл
        
        Имя = Рекв.Имя;
        Значение = ДоговорКонтрагента[Имя];
        
        // Пропускаем булево
        Если ТипЗнч(Значение) = Тип("Булево") Тогда
            Продолжить;
        КонецЕсли;
        
        // Приводим к строке всё, что не Строка и не Число
        ТипЗначения = ТипЗнч(Значение);
        Если (ТипЗначения <> Тип("Строка")) 
           И (ТипЗначения <> Тип("Число")) Тогда
            
            // Обрабатываем Неопределено/Пустые ссылки аккуратно
            Если Значение = Неопределено Тогда
                СтрокаЗначения = "";
            Иначе
                СтрокаЗначения = Строка(Значение);
            КонецЕсли;
            
            Значение = СтрокаЗначения;
        КонецЕсли;
        
        СтруктураДоговора.Вставить(Имя, Значение);
        
    КонецЦикла;
    
    Возврат СтруктураДоговора;
    
КонецФункции

&НаСервере
Процедура АнализироватьРасхожденияДанных(ТаблицаУслуг)
	
	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 1. ИНИЦИАЛИЗАЦИЯ И ПОДГОТОВКА ДАННЫХ
	////////////////////////////////////////////////////////////////////////////////
	
	ОбщаяСуммаЮОН = 0;
	ОбщаяСумма1С = 0;
	КоличествоСтрокВсего = ТаблицаУслуг.Количество();
	
	МассивРасхождений = Новый Массив;
	МассивНеСопоставленоЮОН = Новый Массив;
	МассивНеСопоставлено1С = Новый Массив;
	МассивНеоплаченныеУслуги = Новый Массив;
	МассивДубликатов = Новый Массив;
	
	ИндексПоИНН = Новый Соответствие;
	
	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 2. АНАЛИЗ КАЖДОЙ СТРОКИ ТАБЛИЦЫ
	////////////////////////////////////////////////////////////////////////////////
	
	Для Каждого Строка Из ТаблицаУслуг Цикл
		
		СуммаЮОН = ?(Строка.СуммаСтоимости = Неопределено, 0, Строка.СуммаСтоимости);
		Сумма1С = ?(Строка.СуммаДокумента = Неопределено, 0, Строка.СуммаДокумента);
		
		ОбщаяСуммаЮОН = ОбщаяСуммаЮОН + СуммаЮОН;
		ОбщаяСумма1С = ОбщаяСумма1С + Сумма1С;
		
		Услуга = СокрЛП(Строка.Услуга);
		Если ПустаяСтрока(Услуга) Тогда
			Услуга = "<не указана>";
		КонецЕсли;
		
		ИННЮОН = СокрЛП(Строка.ИНН);
		
		////////////////////////////////////////////////////////////////////////////////
		// Контрагент Ю-ОН — берём из НаименованиеПартнера, если заполнено.
		// Запрос Supplier(inn) только если НаименованиеПартнера пустое.
		////////////////////////////////////////////////////////////////////////////////
		
		НаименованиеКонтрагентаЮОН = "";
		ПредставлениеКонтрагентаЮОН = "<не определен>";
		
		// Приоритет 1: НаименованиеПартнера из таблицы услуг.
		НаименованиеКонтрагентаЮОН = СокрЛП(Строка.НаименованиеПартнера);
				
		// Приоритет 2: запрос Supplier(inn), только если НаименованиеПартнера пустое.
		Если ПустаяСтрока(НаименованиеКонтрагентаЮОН) И НЕ ПустаяСтрока(ИННЮОН) Тогда
			Попытка
				СтруктураПоиска = Новый Структура("inn", ИННЮОН);
				ДанныеПоставщика = ЭТ_ОбщийМодуль2.Supplier(СтруктураПоиска);
				Если ДанныеПоставщика <> Неопределено
					И ДанныеПоставщика.Количество() > 0
					И ДанныеПоставщика.Свойство("name") Тогда
					НаименованиеКонтрагентаЮОН = СокрЛП(ДанныеПоставщика.name);
				КонецЕсли;
			Исключение
				НаименованиеКонтрагентаЮОН = "";
			КонецПопытки;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(НаименованиеКонтрагентаЮОН) Тогда
			ПредставлениеКонтрагентаЮОН = НаименованиеКонтрагентаЮОН;
			Если НЕ ПустаяСтрока(ИННЮОН) Тогда
				ПредставлениеКонтрагентаЮОН = ПредставлениеКонтрагентаЮОН + " (ИНН: " + ИННЮОН + ")";
			КонецЕсли;
		ИначеЕсли НЕ ПустаяСтрока(ИННЮОН) Тогда
			ПредставлениеКонтрагентаЮОН = "ИНН: " + ИННЮОН;
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
		// Контрагент 1С
		////////////////////////////////////////////////////////////////////////////////
		
		Контрагент1С = "";
		ИНН1С = "";
		ПредставлениеКонтрагента1С = "<не определен>";
		
		Если Строка.ДоговорКонтрагента <> Неопределено Тогда
			Попытка
				Если Строка.ДоговорКонтрагента.Владелец <> Неопределено Тогда
					Контрагент1С = Строка(Строка.ДоговорКонтрагента.Владелец);
					Попытка
						ИНН1С = СокрЛП(Строка.ДоговорКонтрагента.Владелец.ИНН);
					Исключение
						ИНН1С = "";
					КонецПопытки;
				КонецЕсли;
			Исключение
				Контрагент1С = "";
				ИНН1С = "";
			КонецПопытки;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(Контрагент1С) Тогда
			ПредставлениеКонтрагента1С = Контрагент1С;
			Если НЕ ПустаяСтрока(ИНН1С) Тогда
				ПредставлениеКонтрагента1С = ПредставлениеКонтрагента1С + " (ИНН: " + ИНН1С + ")";
			КонецЕсли;
		ИначеЕсли НЕ ПустаяСтрока(ИНН1С) Тогда
			ПредставлениеКонтрагента1С = "ИНН: " + ИНН1С;
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
		// КАТЕГОРИЗАЦИЯ СТРОКИ
		////////////////////////////////////////////////////////////////////////////////
		
		Если СуммаЮОН = 0 И Сумма1С = 0 И НЕ ПустаяСтрока(Услуга) И Услуга <> "<не указана>" Тогда
			
			СтруктураНеоплаченной = Новый Структура;
			СтруктураНеоплаченной.Вставить("Услуга", Услуга);
			СтруктураНеоплаченной.Вставить("КонтрагентЮОН", ПредставлениеКонтрагентаЮОН);
			СтруктураНеоплаченной.Вставить("Контрагент1С", ПредставлениеКонтрагента1С);
			СтруктураНеоплаченной.Вставить("ИННЮОН", ИННЮОН);
			СтруктураНеоплаченной.Вставить("ИНН1С", ИНН1С);
			МассивНеоплаченныеУслуги.Добавить(СтруктураНеоплаченной);
			
		ИначеЕсли СуммаЮОН > 0 И Сумма1С = 0 Тогда
			
			СтруктураНеСопоставлено = Новый Структура;
			СтруктураНеСопоставлено.Вставить("Услуга", Услуга);
			СтруктураНеСопоставлено.Вставить("КонтрагентЮОН", ПредставлениеКонтрагентаЮОН);
			СтруктураНеСопоставлено.Вставить("ИННЮОН", ИННЮОН);
			СтруктураНеСопоставлено.Вставить("СуммаЮОН", СуммаЮОН);
			МассивНеСопоставленоЮОН.Добавить(СтруктураНеСопоставлено);
			
		ИначеЕсли СуммаЮОН = 0 И Сумма1С > 0 Тогда
			
			СтруктураНеСопоставлено = Новый Структура;
			СтруктураНеСопоставлено.Вставить("Контрагент1С", ПредставлениеКонтрагента1С);
			СтруктураНеСопоставлено.Вставить("ИНН1С", ИНН1С);
			СтруктураНеСопоставлено.Вставить("Сумма1С", Сумма1С);
			
			ДокументСсылка = "";
			Если Строка.ДоговорКонтрагента <> Неопределено Тогда
				ДокументСсылка = Строка(Строка.ДоговорКонтрагента);
			КонецЕсли;
			СтруктураНеСопоставлено.Вставить("Документ", ДокументСсылка);
			
			МассивНеСопоставлено1С.Добавить(СтруктураНеСопоставлено);
			
		ИначеЕсли СуммаЮОН <> Сумма1С Тогда
			
			СтруктураРасхождения = Новый Структура;
			СтруктураРасхождения.Вставить("Услуга", Услуга);
			СтруктураРасхождения.Вставить("КонтрагентЮОН", ПредставлениеКонтрагентаЮОН);
			СтруктураРасхождения.Вставить("Контрагент1С", ПредставлениеКонтрагента1С);
			СтруктураРасхождения.Вставить("ИННЮОН", ИННЮОН);
			СтруктураРасхождения.Вставить("ИНН1С", ИНН1С);
			СтруктураРасхождения.Вставить("СуммаЮОН", СуммаЮОН);
			СтруктураРасхождения.Вставить("Сумма1С", Сумма1С);
			СтруктураРасхождения.Вставить("Разница", Сумма1С - СуммаЮОН);
			МассивРасхождений.Добавить(СтруктураРасхождения);
			
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
		// ПОИСК ДУБЛИКАТОВ ПО ИНН
		////////////////////////////////////////////////////////////////////////////////
		
		КлючИНН = "";
		Если НЕ ПустаяСтрока(ИННЮОН) Тогда
			КлючИНН = ИННЮОН;
		ИначеЕсли НЕ ПустаяСтрока(ИНН1С) Тогда
			КлючИНН = ИНН1С;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(КлючИНН) Тогда
			Если ИндексПоИНН[КлючИНН] = Неопределено Тогда
				ИндексПоИНН.Вставить(КлючИНН, Новый Массив);
			КонецЕсли;
			
			СтруктураСтроки = Новый Структура;
			СтруктураСтроки.Вставить("Услуга", Услуга);
			СтруктураСтроки.Вставить("КонтрагентЮОН", ПредставлениеКонтрагентаЮОН);
			СтруктураСтроки.Вставить("Контрагент1С", ПредставлениеКонтрагента1С);
			СтруктураСтроки.Вставить("СуммаЮОН", СуммаЮОН);
			СтруктураСтроки.Вставить("Сумма1С", Сумма1С);
			
			ИндексПоИНН[КлючИНН].Добавить(СтруктураСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 3. АНАЛИЗ ДУБЛИКАТОВ
	////////////////////////////////////////////////////////////////////////////////
	
	Для Каждого ЭлементИндекса Из ИндексПоИНН Цикл
		ИНН = ЭлементИндекса.Ключ;
		МассивСтрок = ЭлементИндекса.Значение;
		
		Если МассивСтрок.Количество() > 1 Тогда
			СтруктураДубликата = Новый Структура;
			СтруктураДубликата.Вставить("ИНН", ИНН);
			СтруктураДубликата.Вставить("Количество", МассивСтрок.Количество());
			СтруктураДубликата.Вставить("Строки", МассивСтрок);
			МассивДубликатов.Добавить(СтруктураДубликата);
		КонецЕсли;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////////
	// ЭТАП 4. ФОРМИРОВАНИЕ ИТОГОВОГО ОТЧЕТА
	////////////////////////////////////////////////////////////////////////////////

	Сообщение = "";

	Сообщение = Сообщение + "═══════════════════════════════════════════════════════════════════════════" + Символы.ПС;
	Сообщение = Сообщение + "                          АНАЛИЗ РАСХОЖДЕНИЙ ДАННЫХ                        " + Символы.ПС;
	Сообщение = Сообщение + "═══════════════════════════════════════════════════════════════════════════" + Символы.ПС;
	Сообщение = Сообщение + Символы.ПС;

	ОбщаяРазница = ОбщаяСумма1С - ОбщаяСуммаЮОН;

	Сообщение = Сообщение + "1. ОБЩАЯ СТАТИСТИКА" + Символы.ПС;
	Сообщение = Сообщение + Символы.ПС;
	Сообщение = Сообщение + "   Всего строк в таблице:      " + Формат(КоличествоСтрокВсего, "ЧГ=") + Символы.ПС;
	Сообщение = Сообщение + Символы.ПС;
	Сообщение = Сообщение + "   Общая сумма по данным Ю-ОН: " + Формат(ОбщаяСуммаЮОН, "ЧДЦ=2; ЧРД=' '; ЧГ=3,0; ЧН=0,00") + " руб." + Символы.ПС;
	Сообщение = Сообщение + "   Общая сумма по данным 1С:   " + Формат(ОбщаяСумма1С, "ЧДЦ=2; ЧРД=' '; ЧГ=3,0; ЧН=0,00") + " руб." + Символы.ПС;
	Сообщение = Сообщение + Символы.ПС;

	Если ОбщаяРазница = 0 Тогда
		Сообщение = Сообщение + "   Итог: Суммы СОВПАДАЮТ" + Символы.ПС;
	Иначе
		Сообщение = Сообщение + "   Итог: РАСХОЖДЕНИЕ на сумму " + Формат(ОбщаяРазница, "ЧДЦ=2; ЧРД=' '; ЧГ=3,0; ЧН=0,00") + " руб.";
		Если ОбщаяРазница > 0 Тогда
			Сообщение = Сообщение + " (1С больше, чем Ю-ОН)";
		Иначе
			Сообщение = Сообщение + " (Ю-ОН больше, чем 1С)";
		КонецЕсли;
		Сообщение = Сообщение + Символы.ПС;
	КонецЕсли;

	Сообщение = Сообщение + Символы.ПС;
	Сообщение = Сообщение + "───────────────────────────────────────────────────────────────────────────" + Символы.ПС;
	Сообщение = Сообщение + Символы.ПС;

	Если МассивРасхождений.Количество() > 0 Тогда
		
		Сообщение = Сообщение + "2. РАСХОЖДЕНИЯ ПО СУММАМ" + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		Сообщение = Сообщение + "   Найдено расхождений: " + Формат(МассивРасхождений.Количество(), "ЧГ=") + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		
		НомерСтроки = 0;
		Для Каждого Расхождение Из МассивРасхождений Цикл
			НомерСтроки = НомерСтроки + 1;
			
			Сообщение = Сообщение + "   " + Формат(НомерСтроки, "ЧЦ=3; ЧВН=") + ". Услуга:         " + Расхождение.Услуга + Символы.ПС;
			Сообщение = Сообщение + "        Контрагент Ю-ОН: " + Расхождение.КонтрагентЮОН + Символы.ПС;
			Сообщение = Сообщение + "        По Ю-ОН:        " + Формат(Расхождение.СуммаЮОН, "ЧДЦ=2; ЧРД=' '; ЧГ=3,0; ЧН=0,00") + " руб." + Символы.ПС;
			Сообщение = Сообщение + "        Контрагент 1С:  " + Расхождение.Контрагент1С + Символы.ПС;
			Сообщение = Сообщение + "        По 1С:          " + Формат(Расхождение.Сумма1С, "ЧДЦ=2; ЧРД=' '; ЧГ=3,0; ЧН=0,00") + " руб." + Символы.ПС;
			Сообщение = Сообщение + "        Разница:        " + Формат(Расхождение.Разница, "ЧДЦ=2; ЧРД=' '; ЧГ=3,0; ЧН=0,00") + " руб.";
			
			Если Расхождение.Разница > 0 Тогда
				Сообщение = Сообщение + " (переплата в 1С)";
			Иначе
				Сообщение = Сообщение + " (недоплата в 1С)";
			КонецЕсли;
			
			Сообщение = Сообщение + Символы.ПС + Символы.ПС;
		КонецЦикла;
		
		Сообщение = Сообщение + "───────────────────────────────────────────────────────────────────────────" + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		
	КонецЕсли;

	Если МассивНеСопоставленоЮОН.Количество() > 0 Тогда
		
		Сообщение = Сообщение + "3. УСЛУГИ Ю-ОН БЕЗ ОПЛАТ В 1С" + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		Сообщение = Сообщение + "   Найдено несопоставленных услуг: " + Формат(МассивНеСопоставленоЮОН.Количество(), "ЧГ=") + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		
		НомерСтроки = 0;
		Для Каждого НеСопоставлено Из МассивНеСопоставленоЮОН Цикл
			НомерСтроки = НомерСтроки + 1;
			
			Сообщение = Сообщение + "   " + Формат(НомерСтроки, "ЧЦ=3; ЧВН=") + ". Услуга:         " + НеСопоставлено.Услуга + Символы.ПС;
			Сообщение = Сообщение + "        Контрагент Ю-ОН: " + НеСопоставлено.КонтрагентЮОН + Символы.ПС;
			Сообщение = Сообщение + "        Сумма Ю-ОН:     " + Формат(НеСопоставлено.СуммаЮОН, "ЧДЦ=2; ЧРД=' '; ЧГ=3,0; ЧН=0,00") + " руб." + Символы.ПС;
			Сообщение = Сообщение + Символы.ПС;
		КонецЦикла;
		
		Сообщение = Сообщение + "───────────────────────────────────────────────────────────────────────────" + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		
	КонецЕсли;

	Если МассивНеСопоставлено1С.Количество() > 0 Тогда
		
		Сообщение = Сообщение + "4. ПЛАТЕЖИ 1С БЕЗ УСЛУГ Ю-ОН" + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		Сообщение = Сообщение + "   Найдено несопоставленных платежей: " + Формат(МассивНеСопоставлено1С.Количество(), "ЧГ=") + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		
		НомерСтроки = 0;
		Для Каждого НеСопоставлено Из МассивНеСопоставлено1С Цикл
			НомерСтроки = НомерСтроки + 1;
			
			Сообщение = Сообщение + "   " + Формат(НомерСтроки, "ЧЦ=3; ЧВН=") + ". Контрагент 1С:  " + НеСопоставлено.Контрагент1С + Символы.ПС;
			Сообщение = Сообщение + "        Документ:       " + НеСопоставлено.Документ + Символы.ПС;
			Сообщение = Сообщение + "        Сумма 1С:       " + Формат(НеСопоставлено.Сумма1С, "ЧДЦ=2; ЧРД=' '; ЧГ=3,0; ЧН=0,00") + " руб." + Символы.ПС;
			Сообщение = Сообщение + Символы.ПС;
		КонецЦикла;
		
		Сообщение = Сообщение + "───────────────────────────────────────────────────────────────────────────" + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		
	КонецЕсли;

	Если МассивНеоплаченныеУслуги.Количество() > 0 Тогда
		
		Сообщение = Сообщение + "5. НЕОПЛАЧЕННЫЕ УСЛУГИ" + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		Сообщение = Сообщение + "   Найдено неоплаченных услуг: " + Формат(МассивНеоплаченныеУслуги.Количество(), "ЧГ=") + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		
		НомерСтроки = 0;
		Для Каждого Неоплаченная Из МассивНеоплаченныеУслуги Цикл
			НомерСтроки = НомерСтроки + 1;
			
			Сообщение = Сообщение + "   " + Формат(НомерСтроки, "ЧЦ=3; ЧВН=") + ". " + Неоплаченная.Услуга + Символы.ПС;
			Сообщение = Сообщение + "        Контрагент Ю-ОН: " + Неоплаченная.КонтрагентЮОН + Символы.ПС;
			Сообщение = Сообщение + "        Контрагент 1С:  " + Неоплаченная.Контрагент1С + Символы.ПС;
		КонецЦикла;
		
		Сообщение = Сообщение + Символы.ПС;
		Сообщение = Сообщение + "───────────────────────────────────────────────────────────────────────────" + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		
	КонецЕсли;

	Если МассивДубликатов.Количество() > 0 Тогда
		
		Сообщение = Сообщение + "6. ДУБЛИКАТЫ ПО ИНН" + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		Сообщение = Сообщение + "   Найдено групп с дубликатами: " + Формат(МассивДубликатов.Количество(), "ЧГ=") + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		
		НомерГруппы = 0;
		Для Каждого Дубликат Из МассивДубликатов Цикл
			НомерГруппы = НомерГруппы + 1;
			
			Сообщение = Сообщение + "   Группа " + Формат(НомерГруппы, "ЧГ=") + ". ИНН: " + Дубликат.ИНН + " (строк в группе: " + Формат(Дубликат.Количество, "ЧГ=") + ")" + Символы.ПС;
			Сообщение = Сообщение + Символы.ПС;
			
			НомерСтроки = 0;
			Для Каждого СтрокаГруппы Из Дубликат.Строки Цикл
				НомерСтроки = НомерСтроки + 1;
				
				Сообщение = Сообщение + "        " + Формат(НомерСтроки, "ЧЦ=2; ЧВН=") + ". " + СтрокаГруппы.Услуга + Символы.ПС;
				Сообщение = Сообщение + "            Контрагент Ю-ОН: " + СтрокаГруппы.КонтрагентЮОН + Символы.ПС;
				Сообщение = Сообщение + "            Ю-ОН:           " + Формат(СтрокаГруппы.СуммаЮОН, "ЧДЦ=2; ЧРД=' '; ЧГ=3,0; ЧН=0,00") + " руб." + Символы.ПС;
				Сообщение = Сообщение + "            Контрагент 1С:  " + СтрокаГруппы.Контрагент1С + Символы.ПС;
				Сообщение = Сообщение + "            1С:             " + Формат(СтрокаГруппы.Сумма1С, "ЧДЦ=2; ЧРД=' '; ЧГ=3,0; ЧН=0,00") + " руб." + Символы.ПС;
				Сообщение = Сообщение + Символы.ПС;
			КонецЦикла;
			
		КонецЦикла;
		
		Сообщение = Сообщение + "───────────────────────────────────────────────────────────────────────────" + Символы.ПС;
		Сообщение = Сообщение + Символы.ПС;
		
	КонецЕсли;

	Сообщение = Сообщение + "═══════════════════════════════════════════════════════════════════════════" + Символы.ПС;
	Сообщение = Сообщение + "                            АНАЛИЗ ЗАВЕРШЕН                                " + Символы.ПС;
	Сообщение = Сообщение + "═══════════════════════════════════════════════════════════════════════════" + Символы.ПС;

	Сообщить(Сообщение);
	
КонецПроцедуры


// Формирование табличных частей "АгентскиеУслуги" и "Услуги" документа на основании данных из системы U-On
// Алгоритм: Поиск заявки в U-On, сбор платежей и услуг, сопоставление партнеров по ИНН, расчет комиссий
&НаСервере
Процедура ПолучитьТабличнуюЧасть()   
	
	МояОрганизация = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Организация", Справочники.Организации.ПустаяСсылка());
	МойИНН = ?(МояОрганизация.Пустая(), "", МояОрганизация.ИНН);	
	
	// 1. ПОДГОТОВИТЕЛЬНЫЙ ЭТАП - получение исходных данных и очистка табличных частей
	// Получение прейскуанта услуг для договора (используется только в первом сценарии)
	
	ТаблицаУслуг = ТаблицаУслугПолучитьДанные(Объект.ДоговорКонтрагента);     
	
	ТаблицаУслуг.Колонки.Добавить("Выб", Новый ОписаниеТипов("Булево"));    
	ТаблицаУслуг.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));    
	
	

	// Очистка табличных частей документа перед заполнением
	Объект.АгентскиеУслуги.Очистить();
	Объект.Услуги.Очистить();          
	
	// 2. ПОИСК ПЛАТЕЖЕЙ ПО ЗАЯВКЕ В 1С
	// Поиск оплат по номеру заявки (удаляется дата из номера договора) для договоров ТО (туроператоров)
	//ПлатежныеДокументы = ЭТ_ОбщийМодуль2.ПолучитьПлатежныеДокументыПоЗаявке(
	//	СокрЛП(ЭТ_ОбщийМодуль2.УдалитьДатуИзСтроки(Объект.ДоговорКонтрагента.Номер)),
	//	ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораТО", Null)		
	//);  
	
	
	
	//ПлатежныеДокументы = ЭТ_ОбщийМодуль2.ПолучитьПлатежныеДокументыПоЗаявке(
	//	СокрЛП(ЭТ_ОбщийМодуль2.УдалитьДатуИзСтроки(Объект.ДоговорКонтрагента.Номер)),
	//	Объект.ДоговорКонтрагента.ВидДоговора		
	//);  
	
	
	
		
	// Выгрузка результатов в таблицу значений для обработки
	//ПлатежныеДокументы = ПлатежныеДокументы.Выгрузить();	
	
	ПлатежныеДокументы = ТаблицаУслуг;
	
	//Заявка = ЭТ_ОбщийМодуль2.ПолучитьЗаявку(Объект.ДоговорКонтрагента.Номер);
	//Если Заявка.Свойство("services") Тогда
	//	УслугиВЗаявке = Заявка.services;
	//Иначе
	//	УслугиВЗаявке = Новый Массив;		
	//КонецЕсли;
	
	
	//// Формирование массива договоров ТО, найденных в платежных документах
	//МасДоговорКонтрагента = Новый Массив;
	//Для Каждого СледСтрока Из ПлатежныеДокументы Цикл
	//	Если НЕ (СледСтрока.ДоговорКонтрагента = Null) Тогда
	//		МасДоговорКонтрагента.Добавить(СледСтрока.ДоговорКонтрагента); 
	//	КонецЕсли;			
	//КонецЦикла;
	
	
	//анализ услуг, подготовка данных для агентстских услуг
	
	
	СуммаКомиссий = 0;  
	СуммаУслуг = 0;   
	
	УслугаВознагражденияКонтрагент = ЭТ_ОбщийМодуль2.ПолучитьДопСведениеОбъекта(Объект.ДоговорКонтрагента.Владелец,"УслугаВознаграждения",Неопределено);
	УслугаВознагражденияДоговор = ЭТ_ОбщийМодуль2.ПолучитьДопСведениеОбъекта(Объект.ДоговорКонтрагента,"УслугаВознаграждения",Неопределено);
	
	УслугаВознаграждения = ?(
		УслугаВознагражденияДоговор = Неопределено,
		УслугаВознагражденияКонтрагент,
		УслугаВознагражденияДоговор
	);
	
	КаталогПартнеров = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПартнеров", Неопределено);   
	КаталогПоставщиков = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПоставщиков", Неопределено);   
	


	// 3. ОСНОВНОЙ АЛГОРИТМ - два сценария в зависимости от найденных данных
	
	// СЦЕНАРИЙ 1: Если в 1С найдены платежи по договорам ТО (прямая работа через 1С)
		
	// Обработка каждого уникального договора ТО (туроператора)
	//Для Каждого СледДоговор Из ЭТ_ОбщийМодуль2.УдалитьДублиИзМассива(МасДоговорКонтрагента) Цикл 
	Для Каждого СледДоговор Из ТаблицаУслуг Цикл 
			
		Если НЕ СледДоговор.ДоговорКонтрагента = Неопределено Тогда                                                      
			КонтрагентТуроператор = Ложь;
			КонтрагентПоставщик = Ложь;
			Если НЕ КаталогПартнеров = Неопределено Тогда
				Если СледДоговор.ДоговорКонтрагента.Владелец.Родитель = КаталогПартнеров Тогда
					КонтрагентТуроператор = Истина;
				ИначеЕсли СледДоговор.ДоговорКонтрагента.Владелец.Родитель = КаталогПоставщиков Тогда
					КонтрагентПоставщик = Истина;
				КонецЕсли;
			КонецЕсли;                                                                                           

			ВидДоговораТуроператор = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораТО", Неопределено);
			ВидДоговораПоставщик = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораПоставщик", Неопределено);
			Если НЕ ВидДоговораТуроператор = Неопределено Тогда
				Если  СледДоговор.ДоговорКонтрагента.ВидДоговора = ВидДоговораТуроператор Тогда
					КонтрагентТуроператор = Истина;
				ИначеЕсли  СледДоговор.ДоговорКонтрагента.ВидДоговора = ВидДоговораПоставщик Тогда  
					КонтрагентПоставщик = Истина;
				КонецЕсли;
			КонецЕсли;
			
				
			Если КонтрагентТуроператор = Истина Тогда
			
				// Получение суммы всех оплат по данному договору ТО
				СуммаОплатПоДогоору = ЭТ_ОбщийМодуль2.ПолучитьСуммуОплатПоДогоору(СледДоговор.ДоговорКонтрагента);
				
				// Поиск услуги в прейскуранте по ИНН владельца договора (туроператора)
				СтруктураУслуги = ТаблицаУслугПолучитьУслугу(ТаблицаУслуг, СледДоговор.ДоговорКонтрагента.Владелец.ИНН);
				
				// Добавление строки агентской услуги в документ
				НовСтрока = Объект.АгентскиеУслуги.Добавить();
				НовСтрока.Номенклатура = СтруктураУслуги.Номенклатура;
				
				// Определение наименования: если НаименованиеПолное пустое, используем Наименование
				НаименованиеНоменклатуры = ?(
					СтрДлина(СокрЛП(СтруктураУслуги.Номенклатура.НаименованиеПолное)) > 0,
					СтруктураУслуги.Номенклатура.НаименованиеПолное,
					СтруктураУслуги.Номенклатура.Наименование
				);
				
				НовСтрока.Содержание = СокрЛП(НаименованиеНоменклатуры + " " + ЭТ_ОбщийМодуль2.ЗаменитьПараметрыВШаблоне(СтруктураУслуги.Шаблон,СтруктураУслуги.Содержание));
				НовСтрока.Количество = 1;
				НовСтрока.Контрагент = СледДоговор.ДоговорКонтрагента.Владелец;  // Туроператор
				НовСтрока.ДоговорКонтрагента = СледДоговор.ДоговорКонтрагента;   // Договор с туроператором
				
				// Получение телефона владельца по ИНН (не используется дальше, возможно для проверок)
				ТелефонВладельца = ЭТ_ОбщийМодуль2.ТелефонПоИНН(СледДоговор.ДоговорКонтрагента.Владелец.ИНН);
				
				Комиссия = 0;

				Цена = СуммаОплатПоДогоору;
				КомиссияОбъект = РегистрыСведений.ЭТ_КомиссияТО.ПолучитьСуммуКомиссииТО(СледДоговор.ДоговорКонтрагента, Цена);
				Сообщить(КомиссияОбъект.Сообщение);    
				Если Не КомиссияОбъект.СуммаКомиссии = Неопределено  Тогда
					Комиссия = КомиссияОбъект.СуммаКомиссии;                                             
				Иначе
					Комиссия = 0;
				КонецЕсли;
				НовСтрока.Цена = КомиссияОбъект.СуммаНоменклатуры;
				НовСтрока.Цена = НовСтрока.Цена+Комиссия;
				
				// Заполнение финансовых реквизитов строки агентской услуги
				НовСтрока.Сумма = НовСтрока.Цена * НовСтрока.Количество;
				НовСтрока.СчетРасчетов = ПланыСчетов.Хозрасчетный.НайтиПоКоду(ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияСчетРасчетовТО"));
				НовСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
				НовСтрока.СуммаНДС = 0;   
				СледДоговор.Выб = Истина;     
				СледДоговор.Вид = "А";
				
			ИначеЕсли  КонтрагентПоставщик = Истина Тогда   
				СуммаОплатПоДогоору = ЭТ_ОбщийМодуль2.ПолучитьСуммуОплатПоДогоору(СледДоговор.ДоговорКонтрагента);
				СтруктураУслуги = ТаблицаУслугПолучитьУслугу(ТаблицаУслуг, СледДоговор.ДоговорКонтрагента.Владелец.ИНН);
				НалогНДС = ЭТ_ОбщийМодуль2.ПолучитьСуммуНДС(СуммаОплатПоДогоору,Объект.Дата,Объект.Организация);				
				СледДоговор.Выб = Истина;     
				СледДоговор.Вид = "П";
				
				НовСтрока = Объект.Услуги.Добавить();
				НовСтрока.Номенклатура = СтруктураУслуги.Номенклатура;
				
				// Определение наименования: если НаименованиеПолное пустое, используем Наименование
				НаименованиеНоменклатуры = ?(
					СтрДлина(СокрЛП(СтруктураУслуги.Номенклатура.НаименованиеПолное)) > 0,
					СтруктураУслуги.Номенклатура.НаименованиеПолное,
					СтруктураУслуги.Номенклатура.Наименование
				);
				
				НовСтрока.Содержание = СокрЛП(НаименованиеНоменклатуры + " " + ЭТ_ОбщийМодуль2.ЗаменитьПараметрыВШаблоне(СтруктураУслуги.Шаблон,СтруктураУслуги.Содержание));
				НовСтрока.Цена = (СуммаОплатПоДогоору);
				НовСтрока.Сумма = НовСтрока.Цена;
				НовСтрока.Количество = 1;
				НовСтрока.Субконто = ?(СтруктураУслуги.Номенклатура.НоменклатурнаяГруппа = Неопределено, ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияУслугиСубконто"), СтруктураУслуги.Номенклатура.НоменклатурнаяГруппа);
				НовСтрока.СчетДоходов = ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияСчетДоходовВУслугах");
				НовСтрока.СчетРасходов = ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияСчетРасходовВУслугах");
				НовСтрока.СчетУчетаНДСПоРеализации = ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияСчетУчетаНДСВУслугах");
				НовСтрока.СтавкаНДС = НалогНДС.ВидСтавки;
				НовСтрока.СуммаНДС = НалогНДС.Сумма;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;      



	// Расчет общей суммы агентских услуг
	СуммаОплатТО = ТаблицаУслуг.Итог("СуммаДокумента");

	// Получение платежей клиента
	ДокументыОплатыКлиент = ЭТ_ОбщийМодуль2.ПолучитьПлатежныеДокументыПоЗаявке(
		Объект.ДоговорКонтрагента,
		ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораКлиент")).Выбрать();
	СуммаОплатКлиента = 0;

	// Расчет общей суммы оплат клиента
	Пока ДокументыОплатыКлиент.Следующий() Цикл
		СуммаОплатКлиента = СуммаОплатКлиента + ДокументыОплатыКлиент.СуммаДокумента; 
	КонецЦикла;

	Если (СуммаОплатКлиента - СуммаОплатТО) > 0 Тогда
		НалогНДС = ЭТ_ОбщийМодуль2.ПолучитьСуммуНДС((СуммаОплатКлиента - СуммаОплатТО), Объект.Дата, Объект.Организация);
		
		// Добавление строки "Наших услуг"
		НовСтрока = Объект.Услуги.Добавить();
		НовСтрока.Цена = (СуммаОплатКлиента - СуммаОплатТО);
		НовСтрока.Сумма = НовСтрока.Цена;
		НовСтрока.Количество = 1;
		НовСтрока.Номенклатура = ?(
			УслугаВознаграждения = Неопределено,
			ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияНоменклатураВУслугах"),
			УслугаВознаграждения
		);
		
		// Определение наименования: если НаименованиеПолное пустое, используем Наименование
		НаименованиеНоменклатуры = ?(
			СтрДлина(СокрЛП(НовСтрока.Номенклатура.НаименованиеПолное)) > 0,
			НовСтрока.Номенклатура.НаименованиеПолное,
			НовСтрока.Номенклатура.Наименование
		);
		
		НовСтрока.Субконто = ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияУслугиСубконто");
		НовСтрока.Содержание = СокрЛП(НаименованиеНоменклатуры);
		НовСтрока.СчетДоходов = ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияСчетДоходовВУслугах");
		НовСтрока.СчетРасходов = ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияСчетРасходовВУслугах");
		НовСтрока.СчетУчетаНДСПоРеализации = ЭТ_ОбщийМодуль2.ПолучитьНастройку("РеализацияСчетУчетаНДСВУслугах");
		НовСтрока.СтавкаНДС = НалогНДС.ВидСтавки;
		НовСтрока.СуммаНДС = НалогНДС.Сумма;
		НовСтрока.Субконто = ?(
			НовСтрока.Номенклатура.НоменклатурнаяГруппа = Неопределено, 
			Справочники.НоменклатурныеГруппы.НайтиПоНаименованию("Агентское вознаграждение"), 
			НовСтрока.Номенклатура.НоменклатурнаяГруппа
		);
	КонецЕсли;

КонецПроцедуры



// Возвращает структуру с понятными пользовательскими данными по услуге U-ON,
// договору с клиентом, договору с заказчиком, брони и туристам.
//
// Технические поля (id, коды, внутренние идентификаторы и подобные значения)
// в результат не включаются.
// Ключи структуры формируются только на кириллице в нижнем регистре,
// без пробелов, допустимы символы: а-я, 0-9, "-".
//
// Параметры:
// СледЭлемент - Структура - данные элемента заявки U-ON.
// СледУслуга - Структура - данные услуги U-ON.
// ФорматПредставления - Число - резервный параметр, оставлен для совместимости.
//
// Возвращаемое значение:
// Структура. Возможные ключи результата:
//
// описание
// - Краткое описание услуги одной строкой.
// - Формируется из доступных значений: вид услуги, страна, курорт, отель, питание.
//
// услуга-вид
// - Вид услуги.
// - Например: "Пакетный тур".
//
// услуга-страна
// - Страна оказания услуги.
//
// услуга-курорт
// - Город или курорт по услуге.
//
// услуга-отель
// - Название отеля.
//
// услуга-категория-номера
// - Категория или тип номера.
//
// услуга-размещение
// - Вариант размещения туристов.
//
// услуга-питание
// - Тип питания.
//
// услуга-дата-начала
// - Дата начала услуги.
// - Формат значения: дд.мм.гггг.
//
// услуга-дата-окончания
// - Дата окончания услуги.
// - Формат значения: дд.мм.гггг.
//
// услуга-сумма-клиенту
// - Стоимость услуги для клиента.
//
// услуга-сумма-заказчику
// - Стоимость услуги у заказчика.
//
// услуга-валюта
// - Валюта суммы по услуге.
//
// договор-с-клиентом-клиент
// - ФИО клиента без лишних пробелов.
//
// договор-с-клиентом-телефон
// - Контактный телефон клиента.
//
// договор-с-клиентом-элпочта
// - Электронная почта клиента.
//
// договор-с-клиентом-сумма
// - Сумма по договору с клиентом.
//
// договор-с-клиентом-срок-оплаты
// - Срок оплаты клиентом.
// - Формат значения: дд.мм.гггг.
//
// договор-с-заказчиком-заказчик
// - Наименование заказчика или поставщика.
//
// договор-с-заказчиком-сумма
// - Сумма по договору с заказчиком.
//
// договор-с-заказчиком-срок-оплаты
// - Срок оплаты заказчику.
// - Формат значения: дд.мм.гггг.
//
// бронь-у-заказчика-номер
// - Номер брони у заказчика.
//
// бронь-у-заказчика-статус
// - Статус брони.
//
// бронь-у-заказчика-дата-начала
// - Дата начала поездки.
// - Формат значения: дд.мм.гггг.
//
// бронь-у-заказчика-дата-окончания
// - Дата окончания поездки.
// - Формат значения: дд.мм.гггг.
//
// бронь-у-заказчика-вид-поездки
// - Вид поездки.
//
// бронь-у-заказчика-источник
// - Источник получения заявки.
//
// бронь-у-заказчика-офис
// - Офис оформления заявки.
//
// бронь-у-заказчика-менеджер
// - Менеджер, ведущий заявку.
//
// количество-туристов
// - Количество туристов в заявке.
// - Если туристов нет, возвращается 0.
//
// турист
// - Первый турист в заявке.
// - Значение — строка ФИО без лишних пробелов.
//
// турист-0
// - Первый турист в заявке.
// - Дублирует ключ "турист".
//
// турист-1, турист-2, турист-3 и т.д.
// - Туристы по порядку в заявке.
// - Значение — строка ФИО без лишних пробелов.
//
Функция ПолучитьСодержаниеУслуги(СледЭлемент, СледУслуга, ФорматПредставления = 0) Экспорт

	Результат = Новый Структура;
	Описание = "";

	////////////////////////////////////////////////////////////////////////////////
	// Локальные служебные переменные.
	////////////////////////////////////////////////////////////////////////////////

	ФиоКлиента = "";
	ФиоМенеджера = "";
	ФиоТуриста = "";
	КоличествоТуристов = 0;
	ИмяКлючаТуриста = "";
	Турист = Неопределено;
	НомерТуриста = 0;
	ЗначениеДаты = Неопределено;
	СтрокаДаты = "";

	////////////////////////////////////////////////////////////////////////////////
	// Формируем краткое описание услуги.
	////////////////////////////////////////////////////////////////////////////////

	ЧастиОписания = Новый Массив;

	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("country");
	ИменаПолей.Добавить("city");
	ИменаПолей.Добавить("hotel");
	ИменаПолей.Добавить("hotel_type");
	ИменаПолей.Добавить("hotel_place");
	ИменаПолей.Добавить("nutrition");
	ИменаПолей.Добавить("course");
	

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Если СледУслуга.Свойство(ИмяПоля) Тогда
			ЗначениеПоля = СокрЛП(СледУслуга[ИмяПоля]);
			Если НЕ ПустаяСтрока(ЗначениеПоля) Тогда
				ЧастиОписания.Добавить(ЗначениеПоля);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Результат.Вставить("описание", СтрСоединить(ЧастиОписания, ", "));


	////////////////////////////////////////////////////////////////////////////////
	// Услуга.
	////////////////////////////////////////////////////////////////////////////////

	Если СледУслуга.Свойство("service_type") И НЕ ПустаяСтрока(СокрЛП(СледУслуга.service_type)) Тогда
		Результат.Вставить("услуга_вид", СокрЛП(СледУслуга.service_type));
	КонецЕсли;

	Если СледУслуга.Свойство("country") И НЕ ПустаяСтрока(СокрЛП(СледУслуга.country)) Тогда
		Результат.Вставить("услуга_страна", СокрЛП(СледУслуга.country));
	КонецЕсли;

	Если СледУслуга.Свойство("city") И НЕ ПустаяСтрока(СокрЛП(СледУслуга.city)) Тогда
		Результат.Вставить("услуга_курорт", СокрЛП(СледУслуга.city));
	КонецЕсли;

	Если СледУслуга.Свойство("hotel") И НЕ ПустаяСтрока(СокрЛП(СледУслуга.hotel)) Тогда
		Результат.Вставить("услуга_отель", СокрЛП(СледУслуга.hotel));
	КонецЕсли;

	Если СледУслуга.Свойство("hotel_type") И НЕ ПустаяСтрока(СокрЛП(СледУслуга.hotel_type)) Тогда
		Результат.Вставить("услуга_категория_номера", СокрЛП(СледУслуга.hotel_type));
	КонецЕсли;

	Если СледУслуга.Свойство("hotel_place") И НЕ ПустаяСтрока(СокрЛП(СледУслуга.hotel_place)) Тогда
		Результат.Вставить("услуга_размещение", СокрЛП(СледУслуга.hotel_place));
	КонецЕсли;

	Если СледУслуга.Свойство("nutrition") И НЕ ПустаяСтрока(СокрЛП(СледУслуга.nutrition)) Тогда
		Результат.Вставить("услуга_питание", СокрЛП(СледУслуга.nutrition));
	КонецЕсли;

	Если СледУслуга.Свойство("date_begin") И НЕ ПустаяСтрока(СокрЛП(СледУслуга.date_begin)) Тогда
		СтрокаДаты = СокрЛП(СледУслуга.date_begin);
		Попытка
			ЗначениеДаты = Дата(Лев(СтрокаДаты, 4), Сред(СтрокаДаты, 6, 2), Сред(СтрокаДаты, 9, 2));
			Результат.Вставить("услуга_дата_начала", Формат(ЗначениеДаты, "ДФ=dd.MM.yyyy"));
		Исключение
		КонецПопытки;
	КонецЕсли;

	Если СледУслуга.Свойство("date_end") И НЕ ПустаяСтрока(СокрЛП(СледУслуга.date_end)) Тогда
		СтрокаДаты = СокрЛП(СледУслуга.date_end);
		Попытка
			ЗначениеДаты = Дата(Лев(СтрокаДаты, 4), Сред(СтрокаДаты, 6, 2), Сред(СтрокаДаты, 9, 2));
			Результат.Вставить("услуга_дата_окончания", Формат(ЗначениеДаты, "ДФ=dd.MM.yyyy"));
		Исключение
		КонецПопытки;
	КонецЕсли;

	Если СледУслуга.Свойство("price") Тогда
		Результат.Вставить("услуга_сумма_клиенту", СледУслуга.price);
	КонецЕсли;

	Если СледУслуга.Свойство("price_netto") Тогда
		Результат.Вставить("услуга_сумма_заказчику", СледУслуга.price_netto);
	КонецЕсли;

	Если СледУслуга.Свойство("currency") И НЕ ПустаяСтрока(СокрЛП(СледУслуга.currency)) Тогда
		Результат.Вставить("услуга_валюта", СокрЛП(СледУслуга.currency));
	КонецЕсли;

	////////////////////////////////////////////////////////////////////////////////
	// Договор с клиентом.
	////////////////////////////////////////////////////////////////////////////////

	Если СледЭлемент.Свойство("client_surname") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.client_surname)) Тогда
		ФиоКлиента = ФиоКлиента + СокрЛП(СледЭлемент.client_surname);
	КонецЕсли;

	Если СледЭлемент.Свойство("client_name") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.client_name)) Тогда
		ФиоКлиента = ФиоКлиента + ?(СтрДлина(СокрЛП(ФиоКлиента)) > 0, " ", "") + СокрЛП(СледЭлемент.client_name);
	КонецЕсли;

	Если СледЭлемент.Свойство("client_sname") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.client_sname)) Тогда
		ФиоКлиента = ФиоКлиента + ?(СтрДлина(СокрЛП(ФиоКлиента)) > 0, " ", "") + СокрЛП(СледЭлемент.client_sname);
	КонецЕсли;

	ФиоКлиента = СокрЛП(ФиоКлиента);

	Если НЕ ПустаяСтрока(ФиоКлиента) Тогда
		Результат.Вставить("договор_с_клиентом_клиент", ФиоКлиента);
	КонецЕсли;

	Если СледЭлемент.Свойство("client_phone_mobile") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.client_phone_mobile)) Тогда
		Результат.Вставить("договор_с_клиентом_телефон", СокрЛП(СледЭлемент.client_phone_mobile));
	ИначеЕсли СледЭлемент.Свойство("client_phone") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.client_phone)) Тогда
		Результат.Вставить("договор_с_клиентом_телефон", СокрЛП(СледЭлемент.client_phone));
	КонецЕсли;

	Если СледЭлемент.Свойство("client_email") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.client_email)) Тогда
		Результат.Вставить("договор_с_клиентом_элпочта", СокрЛП(СледЭлемент.client_email));
	КонецЕсли;

	Если СледЭлемент.Свойство("calc_client") Тогда
		Результат.Вставить("договор_с_клиентом_сумма", СледЭлемент.calc_client);
	КонецЕсли;

	Если СледЭлемент.Свойство("payment_deadline_client") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.payment_deadline_client)) Тогда
		СтрокаДаты = СокрЛП(СледЭлемент.payment_deadline_client);
		Попытка
			ЗначениеДаты = Дата(Лев(СтрокаДаты, 4), Сред(СтрокаДаты, 6, 2), Сред(СтрокаДаты, 9, 2));
			Результат.Вставить("договор_с_клиентом_срок_оплаты", Формат(ЗначениеДаты, "ДФ=dd.MM.yyyy"));
		Исключение
		КонецПопытки;
	КонецЕсли;

	////////////////////////////////////////////////////////////////////////////////
	// Договор с заказчиком.
	////////////////////////////////////////////////////////////////////////////////

	Если СледЭлемент.Свойство("supplier_name_official") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.supplier_name_official)) Тогда
		Результат.Вставить("договор_с_заказчиком_заказчик", СокрЛП(СледЭлемент.supplier_name_official));
	ИначеЕсли СледЭлемент.Свойство("supplier_name") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.supplier_name)) Тогда
		Результат.Вставить("договор_с_заказчиком_заказчик", СокрЛП(СледЭлемент.supplier_name));
	КонецЕсли;

	Если СледЭлемент.Свойство("calc_partner") Тогда
		Результат.Вставить("договор_с_заказчиком_сумма", СледЭлемент.calc_partner);
	КонецЕсли;

	Если СледЭлемент.Свойство("payment_deadline_partner") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.payment_deadline_partner)) Тогда
		СтрокаДаты = СокрЛП(СледЭлемент.payment_deadline_partner);
		Попытка
			ЗначениеДаты = Дата(Лев(СтрокаДаты, 4), Сред(СтрокаДаты, 6, 2), Сред(СтрокаДаты, 9, 2));
			Результат.Вставить("договор_с_заказчиком_срок_оплаты", Формат(ЗначениеДаты, "ДФ=dd.MM.yyyy"));
		Исключение
		КонецПопытки;
	КонецЕсли;

	////////////////////////////////////////////////////////////////////////////////
	// Бронь у заказчика.
	////////////////////////////////////////////////////////////////////////////////

	Если СледЭлемент.Свойство("reservation_number") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.reservation_number)) Тогда
		Результат.Вставить("бронь_у_заказчика_номер", СокрЛП(СледЭлемент.reservation_number));
	КонецЕсли;

	Если СледЭлемент.Свойство("status") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.status)) Тогда
		Результат.Вставить("бронь_у_заказчика_статус", СокрЛП(СледЭлемент.status));
	КонецЕсли;

	Если СледЭлемент.Свойство("date_begin") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.date_begin)) Тогда
		СтрокаДаты = СокрЛП(СледЭлемент.date_begin);
		Попытка
			ЗначениеДаты = Дата(Лев(СтрокаДаты, 4), Сред(СтрокаДаты, 6, 2), Сред(СтрокаДаты, 9, 2));
			Результат.Вставить("бронь_у_заказчика_дата_начала", Формат(ЗначениеДаты, "ДФ=dd.MM.yyyy"));
		Исключение
		КонецПопытки;
	КонецЕсли;

	Если СледЭлемент.Свойство("date_end") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.date_end)) Тогда
		СтрокаДаты = СокрЛП(СледЭлемент.date_end);
		Попытка
			ЗначениеДаты = Дата(Лев(СтрокаДаты, 4), Сред(СтрокаДаты, 6, 2), Сред(СтрокаДаты, 9, 2));
			Результат.Вставить("бронь_у_заказчика_дата_окончания", Формат(ЗначениеДаты, "ДФ=dd.MM.yyyy"));
		Исключение
		КонецПопытки;
	КонецЕсли;

	Если СледЭлемент.Свойство("travel_type") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.travel_type)) Тогда
		Результат.Вставить("бронь_у_заказчика_вид_поездки", СокрЛП(СледЭлемент.travel_type));
	КонецЕсли;

	Если СледЭлемент.Свойство("source") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.source)) Тогда
		Результат.Вставить("бронь_у_заказчика_источник", СокрЛП(СледЭлемент.source));
	КонецЕсли;

	Если СледЭлемент.Свойство("office_name") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.office_name)) Тогда
		Результат.Вставить("бронь_у_заказчика_офис", СокрЛП(СледЭлемент.office_name));
	КонецЕсли;

	Если СледЭлемент.Свойство("manager_surname") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.manager_surname)) Тогда
		ФиоМенеджера = ФиоМенеджера + СокрЛП(СледЭлемент.manager_surname);
	КонецЕсли;

	Если СледЭлемент.Свойство("manager_name") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.manager_name)) Тогда
		ФиоМенеджера = ФиоМенеджера + ?(СтрДлина(СокрЛП(ФиоМенеджера)) > 0, " ", "") + СокрЛП(СледЭлемент.manager_name);
	КонецЕсли;

	Если СледЭлемент.Свойство("manager_sname") И НЕ ПустаяСтрока(СокрЛП(СледЭлемент.manager_sname)) Тогда
		ФиоМенеджера = ФиоМенеджера + ?(СтрДлина(СокрЛП(ФиоМенеджера)) > 0, " ", "") + СокрЛП(СледЭлемент.manager_sname);
	КонецЕсли;

	ФиоМенеджера = СокрЛП(ФиоМенеджера);

	Если НЕ ПустаяСтрока(ФиоМенеджера) Тогда
		Результат.Вставить("бронь_у_заказчика_менеджер", ФиоМенеджера);
	КонецЕсли;

	////////////////////////////////////////////////////////////////////////////////
	// Туристы.
	////////////////////////////////////////////////////////////////////////////////

	Результат.Вставить("количество_туристов", 0);

	Если СледЭлемент.Свойство("tourists") И ТипЗнч(СледЭлемент.tourists) = Тип("Массив") Тогда

		КоличествоТуристов = СледЭлемент.tourists.Количество();
		Результат.Вставить("количество_туристов", КоличествоТуристов);

		Для НомерТуриста = 0 По СледЭлемент.tourists.Количество() - 1 Цикл

			Турист = СледЭлемент.tourists[НомерТуриста];
			ФиоТуриста = "";

			Если Турист.Свойство("u_surname") И НЕ ПустаяСтрока(СокрЛП(Турист.u_surname)) Тогда
				ФиоТуриста = ФиоТуриста + СокрЛП(Турист.u_surname);
			КонецЕсли;

			Если Турист.Свойство("u_name") И НЕ ПустаяСтрока(СокрЛП(Турист.u_name)) Тогда
				ФиоТуриста = ФиоТуриста + ?(СтрДлина(СокрЛП(ФиоТуриста)) > 0, " ", "") + СокрЛП(Турист.u_name);
			КонецЕсли;

			Если Турист.Свойство("u_sname") И НЕ ПустаяСтрока(СокрЛП(Турист.u_sname)) Тогда
				ФиоТуриста = ФиоТуриста + ?(СтрДлина(СокрЛП(ФиоТуриста)) > 0, " ", "") + СокрЛП(Турист.u_sname);
			КонецЕсли;

			ФиоТуриста = СокрЛП(ФиоТуриста);

			Если НЕ ПустаяСтрока(ФиоТуриста) Тогда

				Если НомерТуриста = 0 Тогда
					Результат.Вставить("турист", ФиоТуриста);
					Результат.Вставить("турист_0", ФиоТуриста);
				КонецЕсли;

				ИмяКлючаТуриста = "турист_" + Строка(НомерТуриста + 1);
				Результат.Вставить(ИмяКлючаТуриста, ФиоТуриста);

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;


	Возврат Результат;
КонецФункции

