	ОткрытьЗначение(Док);
КонецПроцедуры

//возвращает сумму оплат по договору, данные 1С
&НаСервере
Функция СуммаОплатПоДоговору(Договор)
	КВозврату = 0;
	Если НЕ Договор.Пустая() Тогда
		Запрос = Новый Запрос("
			|ВЫБРАТЬ
			|   ВложЗапрос.Договор,
			|	СУММА(ВложЗапрос.СуммаДокумента) КАК СуммаДокумента
			|ИЗ(
			|	ВЫБРАТЬ РАЗЛИЧНЫЕ
			|		ТабРасшифровкаПлатежа.ДоговорКонтрагента КАК Договор,
			|		ПриходныйКассовыйОрдер.СуммаДокумента КАК СуммаДокумента
			|	ИЗ
			|		Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ТабРасшифровкаПлатежа
			|		ПО ПриходныйКассовыйОрдер.Ссылка = ТабРасшифровкаПлатежа.Ссылка
			|	ГДЕ
			|		ТабРасшифровкаПлатежа.ДоговорКонтрагента = &ВыбДоговорКонтрагента
			|	
			|	ОБЪЕДИНИТЬ
			|	ВЫБРАТЬ РАЗЛИЧНЫЕ
			|		ТабРасшифровкаПлатежа.ДоговорКонтрагента КАК Договор,
			|		ПоступлениеНаРасчетныйСчет.СуммаДокумента КАК СуммаДокумента
			|	ИЗ
			|		Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаРасчетныйСчет.РасшифровкаПлатежа КАК ТабРасшифровкаПлатежа
			|		ПО ПоступлениеНаРасчетныйСчет.Ссылка = ТабРасшифровкаПлатежа.Ссылка
			|	ГДЕ
			|		ТабРасшифровкаПлатежа.ДоговорКонтрагента = &ВыбДоговорКонтрагента
			|	
			|	ОБЪЕДИНИТЬ
			|	ВЫБРАТЬ РАЗЛИЧНЫЕ
			|		ТабРасшифровкаПлатежа.ДоговорКонтрагента КАК Договор,
			|		ОплатаПлатежнойКартой.СуммаДокумента КАК СуммаДокумента
			|	ИЗ
			|		Документ.ОплатаПлатежнойКартой КАК ОплатаПлатежнойКартой
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОплатаПлатежнойКартой.РасшифровкаПлатежа КАК ТабРасшифровкаПлатежа
			|		ПО ОплатаПлатежнойКартой.Ссылка = ТабРасшифровкаПлатежа.Ссылка
			|	ГДЕ
			|		ТабРасшифровкаПлатежа.ДоговорКонтрагента = &ВыбДоговорКонтрагента
			|	
			|	ОБЪЕДИНИТЬ
			|	ВЫБРАТЬ РАЗЛИЧНЫЕ
			|		ТабРасшифровкаПлатежа.ДоговорКонтрагента КАК Договор,
			|		-1 * РасходныйКассовыйОрдер.СуммаДокумента КАК СуммаДокумента
			|	ИЗ
			|		Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК ТабРасшифровкаПлатежа
			|		ПО РасходныйКассовыйОрдер.Ссылка = ТабРасшифровкаПлатежа.Ссылка
			|	ГДЕ
			|		ТабРасшифровкаПлатежа.ДоговорКонтрагента = &ВыбДоговорКонтрагента
			|	
			|	ОБЪЕДИНИТЬ
			|	ВЫБРАТЬ РАЗЛИЧНЫЕ
			|		ТабРасшифровкаПлатежа.ДоговорКонтрагента КАК Договор,
			|		-1 * СписаниеСРасчетногоСчета.СуммаДокумента КАК СуммаДокумента
			|	ИЗ
			|		Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеСРасчетногоСчета.РасшифровкаПлатежа КАК ТабРасшифровкаПлатежа
			|		ПО СписаниеСРасчетногоСчета.Ссылка = ТабРасшифровкаПлатежа.Ссылка
			|	ГДЕ
			|		ТабРасшифровкаПлатежа.ДоговорКонтрагента = &ВыбДоговорКонтрагента
			|	) КАК ВложЗапрос
			|СГРУППИРОВАТЬ ПО ВложЗапрос.Договор
			|"); 
		
		Запрос.УстановитьПараметр("ВыбДоговорКонтрагента", Договор);
		Результат = Запрос.Выполнить().Выбрать(); 
		
		Пока Результат.Следующий() Цикл
			КВозврату = Результат.СуммаДокумента;
		КонецЦикла;  	
	КонецЕсли;	
	Возврат КВозврату;	
КонецФункции

//Выполняется при открытии формы проц. на сервере
&НаСервере
Процедура ЭТ_ПриОткрытииПослеНаСервере()
	ЭТ_СуммаНаКнопке(); 
	Для Каждого СледСтрока Из Объект.Услуги Цикл
		Ставка = 0;
		Если СледСтрока.СтавкаНДС = Перечисления.СтавкиНДС["НДС22"] Тогда
			Ставка = 22;
		ИначеЕсли СледСтрока.СтавкаНДС = Перечисления.СтавкиНДС["НДС5"] Тогда			
			Ставка = 5;
		ИначеЕсли СледСтрока.СтавкаНДС = Перечисления.СтавкиНДС["НДС7"] Тогда			
			Ставка = 7;
		Иначе
			Ставка = 0;			
		КонецЕсли;
		
		Если Ставка>0 Тогда
			Если СледСтрока.СуммаНДС <> ((СледСтрока.Сумма/(100+Ставка))*Ставка) Тогда
				Сообщить("В строке "+СледСтрока.НомерСтроки + " не верно расчитан налог НДС, должно быть: " + Формат(((СледСтрока.Сумма/(100+Ставка))*Ставка),"ЧДЦ=2; ЧРГ=; ЧГ=3,0"));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

//Выполняется при открытии формы проц. на клиенте
&НаКлиенте
