//Возвращает дату заезда по договору
Функция ЭТ_ДатаЗаездаПоДоговору(Договор)	
	ТекущийПрефикс = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Префикс");
	//получаем заявку
	ВариантыНомера = Новый Массив;
	ВариантыНомера.Добавить(Договор.Номер);
	ВариантыНомера.Добавить(ТекущийПрефикс+Договор.Номер);
	ВариантыНомера.Добавить(СокрЛП(ТекущийПрефикс)+СокрЛП(Договор.Номер));	
	ВариантыНомера.Добавить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(Договор.Номер),"-"," - "),"  "," "),"  "," "));				
	Проход = Ложь;
	Для Каждого ВариантНомера Из ВариантыНомера Цикл
		Парам = Новый Структура;
		Парам.Вставить("r_id_internal",ВариантНомера);	
		МассивДанных = ЭТ_ОбщийМодуль2.RequestSearch(Парам);
		Для Каждого СледЭлемент Из МассивДанных Цикл
			Если  НЕ Проход Тогда Возврат ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВДату(СледЭлемент.date_begin); КонецЕсли;
			Прервать;			 
		КонецЦикла;
	КонецЦикла;
	Возврат "";	
КонецФункции

//Возвращает дату последнего платежа по договору
Функция ЭТ_ДатаПоследнейОплатыПоДоговору(ДоговорКонтрагента)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ 
		|	МАКСИМУМ(ВложЗапрос.ДатаДокумента) КАК ДатаДокумента
		|ИЗ (
		|	ВЫБРАТЬ
		|		СписаниеСРасчетногоСчета.Дата КАК ДатаДокумента,
		|		СписаниеСРасчетногоСчета.ДоговорКонтрагента.Ссылка КАК ДоговорКонтрагентаСсылка
		|	ИЗ
		|		Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
		|	ГДЕ
		|		НЕ ПометкаУдаления
		|		И Проведен
		|		И СписаниеСРасчетногоСчета.ДоговорКонтрагента = &ДоговорКонтрагентаСсылка
		|		И СписаниеСРасчетногоСчета.ДоговорКонтрагента.ВидДоговора = &ВидДоговора
		|		И СписаниеСРасчетногоСчета.Организация = &Организация
		|		И &ТипПлатежа = 1
		|	ОБЪЕДИНИТЬ
		|	ВЫБРАТЬ
		|		РасходныйКассовыйОрдер.Дата КАК ДатаДокумента,
		|		РасходныйКассовыйОрдер.ДоговорКонтрагента.Ссылка КАК ДоговорКонтрагентаСсылка
		|	ИЗ
		|		Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
		|	ГДЕ
		|		НЕ ПометкаУдаления
		|		И Проведен
		|		И РасходныйКассовыйОрдер.ДоговорКонтрагента = &ДоговорКонтрагентаСсылка
		|		И РасходныйКассовыйОрдер.ДоговорКонтрагента.ВидДоговора = &ВидДоговора
		|		И РасходныйКассовыйОрдер.Организация = &Организация		
		|		И &ТипПлатежа = 1
		|	ОБЪЕДИНИТЬ
		|	ВЫБРАТЬ
		|		ПриходныйКассовыйОрдер.Дата КАК ДатаДокумента,
		|		ПриходныйКассовыйОрдер.ДоговорКонтрагента.Ссылка КАК ДоговорКонтрагентаСсылка
		|	ИЗ
		|		Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
		|	ГДЕ
		|		НЕ ПометкаУдаления
		|		И Проведен
		|		И ПриходныйКассовыйОрдер.ДоговорКонтрагента = &ДоговорКонтрагентаСсылка
		|		И ПриходныйКассовыйОрдер.ДоговорКонтрагента.ВидДоговора = &ВидДоговора
		|		И ПриходныйКассовыйОрдер.Организация = &Организация		
		|		И &ТипПлатежа = 2
		|	ОБЪЕДИНИТЬ
		|	ВЫБРАТЬ
		|		ПоступлениеНаРасчетныйСчет.Дата КАК ДатаДокумента,
		|		ПоступлениеНаРасчетныйСчет.ДоговорКонтрагента.Ссылка КАК ДоговорКонтрагентаСсылка
		|	ИЗ
		|		Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
		|	ГДЕ
		|		НЕ ПометкаУдаления
		|		И Проведен
		|		И ПоступлениеНаРасчетныйСчет.ДоговорКонтрагента = &ДоговорКонтрагентаСсылка
		|		И ПоступлениеНаРасчетныйСчет.ДоговорКонтрагента.ВидДоговора = &ВидДоговора
		|		И ПоступлениеНаРасчетныйСчет.Организация = &Организация
		|		И &ТипПлатежа = 2
		|	ОБЪЕДИНИТЬ
		|	ВЫБРАТЬ
		|		ОплатаПлатежнойКартой.Дата КАК ДатаДокумента,
		|		ОплатаПлатежнойКартой.ДоговорКонтрагента КАК ДоговорКонтрагента
		|	ИЗ
		|		Документ.ОплатаПлатежнойКартой КАК ОплатаПлатежнойКартой
		|	ГДЕ
		|		НЕ ПометкаУдаления
		|		И Проведен
		|		И ОплатаПлатежнойКартой.ДоговорКонтрагента = &ДоговорКонтрагентаСсылка
		|		И ОплатаПлатежнойКартой.ДоговорКонтрагента.ВидДоговора = &ВидДоговора
		|		И ОплатаПлатежнойКартой.Организация = &Организация
		|		И &ТипПлатежа = 2
		|
		|      ) КАК ВложЗапрос
		|СГРУППИРОВАТЬ ПО
		|	ВложЗапрос.ДоговорКонтрагентаСсылка";
	Запрос.УстановитьПараметр("ДоговорКонтрагентаСсылка",ДоговорКонтрагента);			
	Запрос.УстановитьПараметр("Организация", ЭТ_ОбщийМодуль2.ПолучитьНастройку("Организация"));
	Запрос.УстановитьПараметр("ВидДоговора", ДоговорКонтрагента.ВидДоговора);
	
	Если ДоговорКонтрагента.ВидДоговора = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораТО") Тогда
		Запрос.УстановитьПараметр("ТипПлатежа", 1);
	Иначе
		Запрос.УстановитьПараметр("ТипПлатежа", 2);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();	
	Пока РезультатЗапроса.Следующий() Цикл
		Возврат РезультатЗапроса.ДатаДокумента;
		Прервать;
	КонецЦикла;
	Возврат NULL;	
КонецФункции


