Функция ЭТ_ПолучитьСуммуОплат()
	Док=ЭТ_ОбщийМодуль2.ПолучитьПлатежныеДокументыПоЗаявке(Объект.ДоговорКонтрагента.Ссылка,ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораКлиент",Null)).Выбрать();
	Сумма = 0;	
	Пока Док.Следующий() Цикл 
		Если НЕ(СтрНайти(Строка(Док.Кт),"62.")=Ложь) Тогда
			Сумма = Сумма + Макс(Док.СуммаДокумента, -Док.СуммаДокумента);	
		Иначе
			Сумма = Сумма - Макс(Док.СуммаДокумента, -Док.СуммаДокумента);		
		КонецЕсли;		
	КонецЦикла;  
	Возврат Сумма;
КонецФункции

//Отображает сумму оплат на кнопке Оплаты
&НаСервере
Процедура ЭТ_СуммаНаКнопке()
	Сумма = ЭТ_ПолучитьСуммуОплат();	
	Если Сумма>0 Тогда
		Элементы.ЭТ_ОткрытьОкноОплат.Заголовок = "Сумма оплат: "+Формат(Сумма,"ЧДЦ=2; ЧРД=.; ЧРГ=' '")+" руб.";
	Иначе
		Элементы.ЭТ_ОткрытьОкноОплат.Заголовок = "Сумма оплат: 0 руб.";
	КонецЕсли;
КонецПроцедуры

