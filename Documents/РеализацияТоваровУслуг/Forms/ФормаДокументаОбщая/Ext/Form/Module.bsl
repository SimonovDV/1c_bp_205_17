//Из таблицы услуг получает данные по наменклатуре
&НаСервере
Функция ЭТ_АгентскиеУслугиНоменклатураПолучитьДанные(Услуга,Поле)
	ТаблицаУслуг = ТаблицаУслугПолучитьДанные(Объект.ДоговорКонтрагента);
	СтруктураУслуги = ТаблицаУслугПолучитьУслугу(ТаблицаУслуг,Объект.ДоговорКонтрагента.Владелец.ИНН);
	ЕстьПоле = Ложь;
	Для Каждого Колонка Из ТаблицаУслуг.Колонки Цикл
		Если Колонка.Имя = Поле Тогда ЕстьПоле = Истина; КонецЕсли;	        
	КонецЦикла; 		
	
	Если НЕ ЕстьПоле Тогда Возврат ""; КонецЕсли;
	
	Для Каждого СледУслуга ИЗ ТаблицаУслуг Цикл
		Если НРег(СтрЗаменить(СледУслуга.Услуга," ",""))=НРег(СтрЗаменить(Услуга," ","")) Тогда
        	Возврат СледУслуга[Поле];
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

//Меняет содержание документа, при изменении его данных на форме
&НаКлиенте
