&НаСервере
Функция ПроверкаДатыЗаявки(СледЗаявка)
	КВозврату = "";
	ЭтоПоставщик = ЭТ_ОбщийМодуль2.КонтрагентЯвляетсяПоставщиком(СледЗаявка.supplier_inn,Неопределено);           
	КаталогПартнеровСп = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПартнеров");     
	КаталогПоставщиковСп = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПоставщиков");     

	ТребуетсяСообщение = Ложь;
	СообщениеДата = "";

	ВидПоставщика = "";
	НаименованиеПоставщикаБП = "";     

	НаименованиеПоставщикаСБ = СледЗаявка.supplier_name;
	ИННПоставщика = СледЗаявка.supplier_inn;  
	ДатаНачалаТура = ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВДату(СледЗаявка.date_begin);
	ДатаОкончанияТура = ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВДату(СледЗаявка.date_end);
	
	Если СтрДлина(СокрЛП(ИННПоставщика))>0 Тогда
		Контрагент = ЭТ_ОбщийМодуль2.ПолучитьКонтрагента_1С(Новый Структура("inn",ИННПоставщика),Ложь);
		Если НЕ Контрагент.Пустая() Тогда
			НаименованиеПоставщикаБП = Контрагент.Наименование;
		КонецЕсли;		  
	КонецЕсли;
		
	НаименованиеПоставщика = ?(СтрДлина(СокрЛП(НаименованиеПоставщикаБП))>0,НаименованиеПоставщикаБП,СледЗаявка.supplier_name);
	
	Если ЭтоПоставщик = Неопределено Тогда
		КВозврату = "";
	ИначеЕсли ЭтоПоставщик = Истина Тогда		
		Если СтрДлина(СокрЛП(СледЗаявка.date_end))>9 Тогда
			ВидПоставщика = "Поставщики";
			Если ДатаНачалаТура > ТекущаяДата() Тогда				
				ТребуетсяСообщение = Истина;         
				СообщениеДата = "Дата окончания тура меньше текущей даты.";
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ЭтоПоставщик = Ложь Тогда
		Если СтрДлина(СокрЛП(СледЗаявка.date_begin))>9 Тогда
			ВидПоставщика = "Туроператоры";
			Если ДатаНачалаТура > ТекущаяДата() Тогда
				ТребуетсяСообщение = Истина;
				СообщениеДата = "Дата начала тура больше текущей даты.";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;		
	Если ТребуетсяСообщение = Истина Тогда
		КВозврату = "В заявке "+СледЗаявка.id_internal+" в качестве ТО указан "+НаименованиеПоставщика+Символы.ПС
		+ "Данный поставщик входит в группу " + ВидПоставщика+Символы.ПС
		+Символы.ПС+СообщениеДата;			
	КонецЕсли;

	Возврат КВозврату;
КонецФункции


&НаСервере
Функция ПроверкаРасчетовЗаявки(СледЗаявка)
	КВозврату = "";
	Если СледЗаявка.calc_price_netto - СледЗаявка.calc_decrease Тогда
		КВозврату = КВозврату + ?(СтрДлина(СокрЛП(КВозврату))>0,Символы.ПС,"") + "Себестоимость заявки и сумма оплат ТО расходятся (Ю-ОН)";
	КонецЕсли;
	Если СледЗаявка.calc_price - СледЗаявка.calc_client Тогда
		КВозврату = КВозврату + ?(СтрДлина(СокрЛП(КВозврату))>0,Символы.ПС,"") + "Стоимость заявки и сумма оплат клиента расходятся (Ю-ОН)";
	КонецЕсли;
	Возврат КВозврату;
КонецФункции



&НаСервере
Функция ПолучитьДанныеЗаявки(СтрокаПоиска)             
	// Получаем заявку
	Результат = Ложь;
	Заявка = Новый Массив;
	Сообщение = "";
	//ТекущийПрефикс = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Префикс");
	Объект.Организация = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Организация");

	СледЗаявка = ЭТ_ОбщийМодуль2.ПолучитьЗаявкуПоНомеру(СтрокаПоиска);
	
	СтопСтатусыЗаявки = Новый СписокЗначений;
	СтопСтатусыЗаявки.Добавить("14");
	СтопСтатусыЗаявки.Добавить("99");
	СтатусДоговора = "Договор не найден";

	Результат = Ложь;
	Заявка = Новый Массив;
	Сообщение = "Не могу найти заявку.";
	
	Если СледЗаявка.Свойство("id_internal") И СледЗаявка.Свойство("status_id") Тогда
		Если СтопСтатусыЗаявки.НайтиПоЗначению(СледЗаявка.status_id) = Неопределено Тогда
			Сообщение = "";
			Сообщение = Сообщение + ?(СтрДлина(СокрЛП(Сообщение))>0,Символы.ПС,"")+ПроверкаДатыЗаявки(СледЗаявка); 
			Сообщение = Сообщение + ?(СтрДлина(СокрЛП(Сообщение))>0,Символы.ПС,"")+ПроверкаРасчетовЗаявки(СледЗаявка); 
			Результат = СтрДлина(СокрЛП(Сообщение))<1;
			Заявка = СледЗаявка;
		ИначеЕсли Не СтопСтатусыЗаявки.НайтиПоЗначению(СледЗаявка.status_id) = Неопределено Тогда
			Результат = Ложь;
			Заявка = Новый Массив;
			Сообщение = "Договор имеет ограниченный статус";
		КонецЕсли;	
	КонецЕсли;				
	
	
	Возврат Новый Структура("Результат,Заявка,Сообщение",Результат,Заявка,Сообщение);
КонецФункции


