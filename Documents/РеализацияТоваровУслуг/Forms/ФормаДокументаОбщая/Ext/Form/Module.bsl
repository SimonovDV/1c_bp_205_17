&НаКлиенте
Процедура ЭТ_КомандаВидУслугиВместо(Команда)
	
	ТекстВопроса = 
		"Будет выполнена смена вида реализации на ""Услуги""." + Символы.ПС
		+ "Все строки из табличной части ""АгентскиеУслуги"" будут перенесены в ""Услуги""." + Символы.ПС + Символы.ПС
		+ "Продолжить?";
	
	Оповещение = Новый ОписаниеОповещения("ЭТ_КомандаВидУслугиВместоЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭТ_КомандаВидУслугиВместоЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьВидУслуги();
	ПеренестиВсеВУслуги(Неопределено);
	
	ПоказатьПредупреждение(
		,
		"Произведена смена вида реализации на Услуги." + Символы.ПС
		+ "Все строки перенесены в табличную часть ""Услуги""." + Символы.ПС
		+ "Необходимо закрыть и открыть документ.",
		,
		"Выполнено!");
	
КонецПроцедуры




&НаКлиенте
Процедура ПеренестиВсеВУслуги(Команда)
	
	Если Объект.АгентскиеУслуги.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В табличной части АгентскиеУслуги нет строк.'"));
		Возврат;
	КонецЕсли;
	
	Индекс = Объект.АгентскиеУслуги.Количество() - 1;
	
	Пока Индекс >= 0 Цикл
		
		ТекущаяСтрока = Объект.АгентскиеУслуги[Индекс];
		
		НоваяСтрока = Объект.Услуги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		// Заполняем счета учета
		ПараметрыЗаполненияСчетовУчета = РеализацияТоваровУслугФормыКлиентСервер.НачатьЗаполнениеСчетовУчета(
			"Услуги.Номенклатура",
			Объект,
			НоваяСтрока);
		
		ИзмененныеРеквизиты = СчетаУчетаВДокументахКлиент.ЗаполнитьПриИзменении(ПараметрыЗаполненияСчетовУчета);
		Если ИзмененныеРеквизиты.Свойство("СчетДоходов") И ЗначениеЗаполнено(НоваяСтрока.СчетДоходов) Тогда
			НоваяСтрока.СчетДоходовВедетсяУчетПоНоменклатурнымГруппам =
				БухгалтерскийУчетВызовСервераПовтИсп.НаСчетеВедетсяУчетПоНоменклатурнымГруппам(НоваяСтрока.СчетДоходов);
		КонецЕсли;
		
		Объект.АгентскиеУслуги.Удалить(ТекущаяСтрока);
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
КонецПроцедуры

