//ЭТ_ОбработкаПроведения(Отказ, Режим)	
//Если счет расчетов 76.09, то добавляем платеж в СБ
&После("ОбработкаПроведения")
Процедура ЭТ_ОбработкаПроведения(Отказ, Режим)	
	Если Отказ Тогда Возврат; КонецЕсли;
	Если ЭТ_ОбщийМодуль2.НуженОбмен(ЭтотОбъект.Организация) = Ложь Тогда Возврат; КонецЕсли;
	Если (ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВыключитьМодуль",Ложь) = Истина) Тогда Сообщить("Документ не проведен в U-ON!"); Возврат; КонецЕсли;
	МассивПапок = Новый Массив;
	МассивПапок.Добавить(ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПартнеров"));
	МассивПапок.Добавить(ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПоставщиков"));	
	Если МассивПапок.Найти(ЭтотОбъект.Контрагент.Родитель) = Неопределено Тогда Возврат; КонецЕсли;
		
	ПараметрыПроведения = Документы.СписаниеСРасчетногоСчета.ПодготовитьПараметрыПроведения(Ссылка, Отказ);
	Док = ПараметрыПроведения.ДокументСсылка.ПолучитьОбъект();
	//Если НЕ ЭТ_ОбщийМодуль2.РеестрПрохождения(Док.Метаданные().ПолноеИмя() +"."+ Док.Номер,60) Тогда Возврат;	КонецЕсли;
	ОтличноеПроведение = Истина;
	Если ЭтотОбъект.РасшифровкаПлатежа.Количество()>0 Тогда
		Если ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.05")
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.05")
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.01")
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.01.1")
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.01.2")
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.02")
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.02.1")
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.02.2")
		Тогда
			Если (ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийСписаниеДенежныхСредств.ОплатаПоставщику) Тогда
				Если НЕ ЭТ_ОбщийМодуль2.ДобавитьПлатежТО(ЭтотОбъект.Ссылка) Тогда ОтличноеПроведение = Ложь; КонецЕсли;	
			КонецЕсли;
		ИначеЕсли (ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01") 
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01.1") 
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01.2") 
			)
			И (ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02")
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02.1")
			ИЛИ ЭтотОбъект.РасшифровкаПлатежа[0].СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02.2")			
			) Тогда
				Если НЕ ЭТ_ОбщийМодуль2.ДобавитьВозвратКлиенту(ЭтотОбъект.Ссылка) Тогда ОтличноеПроведение = Ложь; КонецЕсли;	

			
		КонецЕсли;
	КонецЕсли;
	//Если (НЕ ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийСписаниеДенежныхСредств.ОплатаПоставщику) ИЛИ (НЕ СчетТО) Тогда Возврат; КонецЕсли;
	
	
	
	
	Если ОтличноеПроведение = Ложь И НЕ ЭТ_ОбщийМодуль2.ПолучитьНастройку("РазрешитьПроведениеБезСБ") Тогда Отказ = Истина;  Сообщить("Не могу выполнить данныю операцию в СБ U-ON"); Возврат; КонецЕсли;
	Если НЕ ((ЭтотОбъект.СтатьяДвиженияДенежныхСредств = ЭТ_ОбщийМодуль2.ПолучитьНастройку("СтатьяДвиженияДенежныхСредствКлиент")) И (ЭтотОбъект.СтатьяДвиженияДенежныхСредств = ЭТ_ОбщийМодуль2.ПолучитьНастройку("СтатьяДвиженияДенежныхСредств"))) тогда
		Возврат;	
	КонецЕсли;	
КонецПроцедуры

//ЭТ_ОбработкаУдаленияПроведения(Отказ)
//При отмене проведения, если вид операции ОплатаПоставщику, то пытаемся найти и удалить данный платеж из СБ
&После("ОбработкаУдаленияПроведения")
Процедура ЭТ_ОбработкаУдаленияПроведения(Отказ)
	Если Отказ Тогда Возврат; КонецЕсли;
	Если ЭТ_ОбщийМодуль2.НуженОбмен(ЭтотОбъект.Организация) = Ложь Тогда Возврат; КонецЕсли;
	Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВыключитьМодуль",Ложь) = Истина Тогда Сообщить("Модуль интеграции с U-ON отключен!"); Возврат; КонецЕсли;		
	ОтличноеПроведение = Истина;
	ПараметрыПроведения = Документы.СписаниеСРасчетногоСчета.ПодготовитьПараметрыПроведения(Ссылка, Отказ);
	
	Если ПараметрыПроведения.Свойство("ДокументСсылка") Тогда
		Если ЭтотОбъект.ВидОперации=Перечисления.ВидыОперацийСписаниеДенежныхСредств.ОплатаПоставщику Тогда
			Если НЕ ЭТ_ОбщийМодуль2.УдалитьПлатежТО(ЭтотОбъект.Ссылка) Тогда
				ОтличноеПроведение = Ложь;
			КонецЕсли;		
		ИначеЕсли ЭтотОбъект.ВидОперации=Перечисления.ВидыОперацийСписаниеДенежныхСредств.ВозвратПокупателю Тогда
			Если НЕ ЭТ_ОбщийМодуль2.УдалитьВозвратКлиенту(ЭтотОбъект.Ссылка) Тогда
				ОтличноеПроведение = Ложь;
			КонецЕсли;					
		КонецЕсли;	
	КонецЕсли;
	//Если ОтличноеПроведение = Ложь И НЕ ЭТ_ОбщийМодуль2.ПолучитьНастройку("РазрешитьПроведениеБезСБ") Тогда Отказ = Истина; Сообщить("Не могу выполнить данныю операцию в СБ U-ON"); Возврат; КонецЕсли;
	Если ОтличноеПроведение = Ложь Тогда Сообщить("Не могу выполнить данныю операцию в СБ U-ON"); КонецЕсли;
КонецПроцедуры