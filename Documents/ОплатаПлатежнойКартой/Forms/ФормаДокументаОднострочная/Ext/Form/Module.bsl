//ЭТ_ЗаполнитьСБВместо(Команда)
//реакция на нажатие кнопки Заполнить на панели заполнения из СБ
//поиск клиента, поиск договора, заполнение формы
&НаКлиенте
Процедура ЭТ_ЗаполнитьСБВместо(Команда)
	Объект.Организация = ПолучитьНастройку("Организация");
	ТекущийПрефикс = ПолучитьНастройку("Префикс");
	МассивНомеров = Новый Массив;
	РасшифровкаПлатежаСтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
	Для Каждого ВариантНомера Из ПолучитьВариантыНомера(ЭтаФорма.СтрокаПоиска) Цикл
		Парам = Новый Структура;
		Парам.Вставить("r_id_internal",ВариантНомера);	
		МассивДанных = ПолучитьМассивЗаявок(Парам);
		Если МассивДанных.Количество()>0 Тогда		
			Для Каждого СледЭлемент Из МассивДанных Цикл
				МассивНомеров.Добавить(СледЭлемент.id);
			КонецЦикла;
		КонецЕсли;		
	КонецЦикла;
	Для Каждого СледЗаявкаНомер Из ЭТ_ОбщийМодуль2.УдалитьДублиИзМассива(МассивНомеров) Цикл
		ДанныеЗаявки = 	ПолучитьДанныеЗаявки(СледЗаявкаНомер);
		Если ДанныеЗаявки.Количество()>0 Тогда
			Для Каждого СледЗаявка Из ДанныеЗаявки Цикл
				//Проверяем наличие договора
				Если СледЗаявка.Свойство("id_internal") Тогда
					НайденДоговор = НайтиДоговорПокупателя(СледЗаявка.id_internal,Ложь);
					Если НЕ НайденДоговор = Ложь Тогда
						Контрагент = ПолучитьКонтрагентаПоДоговору(НайденДоговор,СледЗаявка.client_email);
						РасшифровкаПлатежаДоговорКонтрагента=НайденДоговор;
					Иначе
						СозданДоговор = СоздатьДоговорПокупателя(СледЗаявка);
						Контрагент = ПолучитьКонтрагентаПоДоговору(СозданДоговор,СледЗаявка.client_email);
						//Сообщить(Контрагент);
						РасшифровкаПлатежаДоговорКонтрагента=СозданДоговор;
					КонецЕсли;     
					Если СледЗаявка.supplier_inn = ПолучитьИННОрганизации(Объект.Организация) Тогда
						ОтражениеАванса = ПолучитьНастройку("ОтражениеАвансаПоставщики","Доход УСН"); //"Доход УСН";             
						Сообщить("Наша компания является туроператором");
						//ПоказатьПредупреждение(,"Наша компания является туроператором",,"Предупреждение");
					Иначе
						ОтражениеАванса = ПолучитьНастройку("ОтражениеАвансаАгенты","Доход комитента"); //"Доход комитента";
					КонецЕсли;
					ЗаполнитьФормуПКО(Новый Структура("Контрагент, РасшифровкаПлатежаДоговорКонтрагента",Контрагент, РасшифровкаПлатежаДоговорКонтрагента));
					РасшифровкаПлатежаОтражениеАвансаПредставление = ОтражениеАванса;
				КонецЕсли;
				ЭтаФорма.РасшифровкаПлатежаСпособПогашенияЗадолженности = ПредопределенноеЗначение("Перечисление.СпособыПогашенияЗадолженности.Автоматически");
			КонецЦикла;
		КонецЕсли;		
	КонецЦикла;
	ВидОплатыПриИзмененииНаСервере();
	ЭтаФорма.Элементы.ПанельПоискаСБ.Видимость = Ложь;
КонецПроцедуры

