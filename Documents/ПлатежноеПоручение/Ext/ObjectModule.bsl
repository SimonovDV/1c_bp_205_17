
&После("ОбработкаПроведения")
Процедура ЭТ_ОбработкаПроведения(Отказ, РежимПроведения)  
	Если ЭтотОбъект.ЭТ_СуммаКомиссии>0 тогда
		РегКомиссияТО = РегистрыСведений.ЭТ_КомиссияТО.СоздатьМенеджерЗаписи();
		
		РегКомиссияТО.ДоговорТО = ЭтотОбъект.ДоговорКонтрагента;
		РегКомиссияТО.СуммаКомиссии = ЭтотОбъект.ЭТ_СуммаКомиссии;
		РегКомиссияТО.Записать(Истина);
	КонецЕсли;
КонецПроцедуры
