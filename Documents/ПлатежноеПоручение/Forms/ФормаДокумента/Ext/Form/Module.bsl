&НаСервере
Функция ПолучитьЗаявку(Знач НомерЗаявки)
	КВозврату = Новый Структура;
	Префикс = СокрЛП(ЭТ_ОбщийМодуль2.ПолучитьНастройку("Префикс","ЭТ18-")); 
	СтрокаПоиска = ВРег(СокрЛП(ЭтаФорма.СтрокаПоиска)); 
	Если СтрНайти(СтрокаПоиска,ВРег(Префикс))=0 Тогда
		СтрокаПоиска = Префикс + СтрокаПоиска;
	КонецЕсли;
	НомерЗаявки = ЭТ_ОбщийМодуль2.ПолучитьКодИзСтроки(СтрокаПоиска,Префикс);
	КВозврату = ЭТ_ОбщийМодуль2.ПолучитьЗаявкуПоНомеру(НомерЗаявки);
	Возврат  КВозврату;
КонецФункции

//ЭТ_ЗаполнитьСБВместо(Команда)
//рекация на нажатие кнопки Заполнить на панеле поиска СБ
&НаКлиенте
Процедура ЭТ_ЗаполнитьСБВместо(Команда)
	Объект.Организация = ПолучитьНастройку("Организация");
	СледЗаявка = ПолучитьЗаявку(ЭтаФорма.СтрокаПоиска);


				//Проверяем наличие договора
				Если СледЗаявка.Свойство("id_internal") Тогда
					//Вычислим количество поставщиков
					ЭтаФорма.ТаблицаПоставщиков.Очистить();
					Для Каждого СледУслуга Из СледЗаявка.services Цикл    
						price_netto = ?(СледУслуга.Свойство("price_netto"),СледУслуга.price_netto,0);						
						Если ?(price_netto = Неопределено,0,price_netto) >0 Тогда
							ИНН = ?(СледУслуга.Свойство("partner_inn"),СледУслуга.partner_inn,"");
							Стоимость = ?(СледУслуга.Свойство("price_netto"),СледУслуга.price_netto,0);
							НайтиСтр = ЭтаФорма.ТаблицаПоставщиков.НайтиСтроки(Новый Структура("ИНН",ИНН));
							Если НайтиСтр.Количество()>0 Тогда
								Стр = НайтиСтр[0];
							Иначе
								Стр = ЭтаФорма.ТаблицаПоставщиков.Добавить();
							КонецЕсли;
							Если СтрДлина(Стр.Наименование)<1 Тогда 
								Наименование = ПолучитьНаименованиеКонтрагентаПоИНН(ИНН,?(СледУслуга.Свойство("partner_name"),СледУслуга.partner_name,""));
							КонецЕсли;							
							Стр.ИНН = ИНН;
							Стр.Наименование = Наименование;
							Стр.Стоимость = Формат(Стоимость,"ЧДЦ=2; ЧРД=; ЧРГ=; ЧГ=");
							//Стр.Стоимость = Число(Стр.Стоимость + Число(СтрЗаменить(Стоимость,",",".")));
							Стр.Заявка = СледЗаявка;
						КонецЕсли;
					КонецЦикла;	
				КонецЕсли;       
	
	Если ЭтаФорма.ТаблицаПоставщиков.Количество() = 1 Тогда
		ЭтаФорма.Элементы.ГруппаПоставщиков.Видимость = Ложь;
		ЭТ_СформироватьПлатежкуПоСтроке(0);
	ИначеЕсли ЭтаФорма.ТаблицаПоставщиков.Количество() >0 Тогда
		ЭтаФорма.Элементы.ГруппаПоставщиков.Видимость = Истина;		
	КонецЕсли;
КонецПроцедуры



