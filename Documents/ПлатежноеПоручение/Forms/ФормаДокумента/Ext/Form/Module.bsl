//ЭТ_НазначениеПлатежаПослеНаСервере()
//генерирует строку с основанием платежа, созгасно заданному в настройках шаблону
&НаСервере
Процедура ЭТ_НазначениеПлатежаПослеНаСервере() Экспорт
	//получаем данные шаблонов,
	//ищем нашу компанию
	//если находим - формируем шаблон и производим замену
	СтруктураДанных =  Новый Структура;
	СтруктураДанных.Вставить("бронь",СокрЛП(Объект.ДоговорКонтрагента.Номер));
	СтруктураДанных.Вставить("сумма",Объект.СуммаДокумента);
	СтруктураДанных.Вставить("номерсчета",Объект.Номер);
	СтруктураДанных.Вставить("датасчета",Объект.Дата);
	Шаблон = Эт_ОбщийМодуль2.ОснованиеПлатежаПоШаблону(
		Объект.Контрагент.Код,
		СтруктураДанных
	);
	Если СтрДлина(СокрЛП(Шаблон))>0 Тогда Объект.НазначениеПлатежа = Шаблон; КонецЕсли;
КонецПроцедуры

//ЭТ_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)
//см. ЭТ_НазначениеПлатежаПослеНаСервере() - генерация строки оснований платежа
&НаКлиенте
Процедура ЭТ_НазначениеПлатежаПосле(Команда)
	ЭТ_НазначениеПлатежаПослеНаСервере();                       
КонецПроцедуры

&НаКлиенте
Процедура ЭТ_СформироватьПлатежкуПоСтроке(НомерСтроки)
	КодСтрокиУслуги = НомерСтроки;
	НайденДоговор = НайтиДоговорТО(СокрЛП(ЭтаФорма.ТаблицаПоставщиков[КодСтрокиУслуги].Заявка.id_internal),ЭтаФорма.ТаблицаПоставщиков[КодСтрокиУслуги].ИНН,ПолучитьНомерБрони(ЭтаФорма.ТаблицаПоставщиков[КодСтрокиУслуги].Заявка.reservation_number),Ложь);
	Если НЕ НайденДоговор = Ложь Тогда
		Контрагент = ПолучитьКонтрагентаПоДоговору(НайденДоговор);
		ДоговорКонтрагента=НайденДоговор;
	Иначе
		СозданДоговор = СоздатьДоговорТО(ЭтаФорма.ТаблицаПоставщиков[КодСтрокиУслуги].Заявка,ЭтаФорма.ТаблицаПоставщиков[КодСтрокиУслуги].ИНН);
		Если НЕ СозданДоговор.Пустая() Тогда
			Контрагент = ПолучитьКонтрагентаПоДоговору(СозданДоговор);
			ДоговорКонтрагента=СозданДоговор;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьФормуДокумента(Новый Структура("Контрагент, ДоговорКонтрагента, Заявка",Контрагент, ДоговорКонтрагента,ЭтаФорма.ТаблицаПоставщиков[КодСтрокиУслуги].Заявка));		
	//ТекущийЭлемент = ЭтаФорма.Элементы.СуммаДокумента;
	ЭтаФорма.Элементы.ГруппаПоставщиков.Видимость = Ложь;
	ЭтаФорма.Элементы.ПанельПоискаСБ.Видимость = Ложь;
	ЭтаФорма.СуммаКомиссии = ПолучитьСуммуКомиссииТО();
	ЭТ_НазначениеПлатежаПослеНаСервере();		
КонецПроцедуры

