//ЗаполнитьФормуДокумента(Парам)
//на основании присланной структуры параметров из СБ заполняет форму документа
&НаКлиенте
Процедура ЗаполнитьФормуДокумента(Парам)
	Если НЕ Парам.Контрагент = Неопределено Тогда
		Объект.Контрагент = Парам.Контрагент;
		КонтрагентПриИзменении(ЭтаФорма.Элементы.Контрагент);
		КонтрагентОбработкаВыбора(ЭтаФорма.Элементы.Контрагент, Парам.Контрагент, Ложь);		
		ЭтаФорма.Объект.ДоговорКонтрагента = Парам.ДоговорКонтрагента;
		ЭтаФорма.Элементы.ДоговорКонтрагента.СписокВыбора.Добавить(Парам.ДоговорКонтрагента);
		Объект.СтатьяДвиженияДенежныхСредств = ПолучитьНастройку("СтатьяДвиженияДенежныхСредств");
		Объект.СтавкаНДС = БезНДС();
		Объект.ВидПлатежа = "Электронно";
		Объект.ОчередностьПлатежа = Объект.ОчередностьПлатежа;
		Если Парам.Заявка.Свойство("reservation_number") Тогда
			НомерСчета = ПолучитьНомерСчета(Парам.Заявка.reservation_number);
			ДатаСчета = ПолучитьДатуСчета(Парам.Заявка.reservation_number);
			НомерБрони = ПолучитьНомерБрони(Парам.Заявка.reservation_number);
			ДатаБрони = ПолучитьДатуБрони(Парам.Заявка.reservation_number);
		Иначе
			НомерСчета = "";
			НомерБрони = "";
			ДатаСчета = "";
			ДатаБрони = "";
		КонецЕсли;
		НазначениеПлатежа = "Оплата по ";
		Если СтрДлина(СокрЛП(НомерБрони))>0 Тогда
			НазначениеПлатежа = НазначениеПлатежа + "заявке "+НомерБрони+" ";
		КонецЕсли;
		Если СтрДлина(СокрЛП(НомерСчета))>0 Тогда
			Если СтрДлина(СокрЛП(НомерБрони))>0 Тогда
				НазначениеПлатежа = СокрЛП(НазначениеПлатежа) + ", ";
			КонецЕсли;			
			НазначениеПлатежа = НазначениеПлатежа + "счету № " + НомерСчета+" ";
			Если СтрДлина(СокрЛП(ДатаСчета))>0 Тогда
				НазначениеПлатежа = НазначениеПлатежа + "от "+Формат(ДатаСчета, "ДЛФ=Д")+" ";			
			КонецЕсли;		
		КонецЕсли;                                                                                                		
		НазначениеПлатежа = НазначениеПлатежа + "за тур.услуги ";
		
		ДатаЗаезда = КонвертацияДатыИзЮниксВДату(Парам.Заявка.date_begin);		
		Если СтрДлина(СокрЛП(ДатаЗаезда))>0 Тогда
			НазначениеПлатежа = НазначениеПлатежа + "от "+Лев(СокрЛП(ДатаЗаезда),10)+" ";
		КонецЕсли;
		//
		Если Парам.Заявка.Свойство("id_internal") Тогда
			Если СтрДлина(СокрЛП(Парам.Заявка.id_internal))>0 Тогда
				НазначениеПлатежа = НазначениеПлатежа + "("+СокрЛП(Парам.Заявка.id_internal)+") ";
			КонецЕсли;
		КонецЕсли;
		
		Если Парам.Заявка.Свойство("calc_price_netto") Тогда
			Если СтрДлина(СокрЛП(Парам.Заявка.calc_price_netto))>0 Тогда				
				НазначениеПлатежа = НазначениеПлатежа + "Сумма "+Формат(Парам.Заявка.calc_price_netto,"ЧДЦ=2; ЧРД='-'; ЧГ=0")+" Без налога (НДС)";
				Объект.СуммаДокумента = Парам.Заявка.calc_price_netto;
			КонецЕсли;
		КонецЕсли;
		Объект.НазначениеПлатежа = НазначениеПлатежа;
		Объект.СчетКонтрагента = ПолучитьРасчетныйСчетКонтрагента(Парам.Контрагент);
		ЭтаФорма.Состояние = Подготовлено();
	КонецЕсли;
КонецПроцедуры


//НайтиДоговорТО(НомерЗаявки,НомерБрони,ПоУмолчанию = Ложь)
//По присланному номеру заявки и номеру брони осуществляет поиск ссылки на договор контрагента
//новый договор не создает
//возвращает ссылку
&НаСервере
Функция НайтиДоговорТО(НомерЗаявки,ИНН,НомерБрони,ПоУмолчанию = Ложь)
	ВидДоговораТО = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораТО");
	Запрос = Новый Запрос(" 
		|ВЫБРАТЬ 
		|	Ссылка, 
		|	Наименование 
		|ИЗ 
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	Не ПометкаУдаления		
		|	И (
		|		ДоговорыКонтрагентов.Номер ПОДОБНО  &НомерЗаявки
		|	)		
		|	И ДоговорыКонтрагентов.Владелец.ИНН = &ИНН
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора 
		|"); 
	Запрос.УстановитьПараметр("НомерЗаявки", "%"+СокрЛП(НомерЗаявки)+"%");	
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговораТО);		
	Запрос.УстановитьПараметр("НомерБрони", "%"+СокрЛП(НомерБрони)+"%");		
	Запрос.УстановитьПараметр("ИНН", ИНН);		
	Результат = Запрос.Выполнить().Выбрать(); 
	Пока Результат.Следующий() Цикл 		
		Возврат Результат.Ссылка;
		Прервать;
	КонецЦикла;  
	Возврат Ложь;
КонецФункции


//ВернутьКонтрагентаПоЗаявке(Заявка)
//на основании номера заявки возвращает контрагента в 1С 
&НаСервере
Функция ВернутьКонтрагентаПоЗаявке(Заявка)
	//Получаем заявку
	Заказчик = ЭТ_ОбщийМодуль2.User(Новый Структура("id",Заявка.client_id));
	
	Если Заказчик.Количество()<1 Тогда 
		Сообщить("В заявке U-ON не выбран контрагент.");
		Возврат Справочники.Контрагенты.СоздатьЭлемент();
	КонецЕсли;
	
	Запрос = Новый Запрос(" 
		|ВЫБРАТЬ 
		|	Ссылка, 
		|	Наименование
		|ИЗ 
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Не ПометкаУдаления		
		|	И ((Контрагенты.ИНН = &ИНН И Контрагенты.ИНН<>"""")
		|	ИЛИ (ВЫРАЗИТЬ(Контрагенты.Комментарий КАК СТРОКА(1000)) ПОДОБНО &ПаспортПолный И ВЫРАЗИТЬ(Контрагенты.Комментарий КАК СТРОКА(1000))<>"""" И &ПаспортПолный<>"""")
		|	ИЛИ ((Контрагенты.ДокументУдостоверяющийЛичность ПОДОБНО &ПаспортПолный ИЛИ Контрагенты.ДокументУдостоверяющийЛичность ПОДОБНО &ПаспортНомер) И (Контрагенты.ДокументУдостоверяющийЛичность ПОДОБНО &ПаспортДата) И (Контрагенты.ДокументУдостоверяющийЛичность<>"""") И (&ПаспортНомер<>""""))
		|	ИЛИ (Контрагенты.НаименованиеПолное ПОДОБНО &Фамилия И Контрагенты.НаименованиеПолное ПОДОБНО &Имя И Контрагенты.НаименованиеПолное ПОДОБНО &Отчество И ВЫРАЗИТЬ(Контрагенты.Комментарий КАК СТРОКА(1000)) ПОДОБНО &ДатаРождения И Контрагенты.НаименованиеПолное<>"""" И ВЫРАЗИТЬ(Контрагенты.Комментарий КАК СТРОКА(1000))<>"""")
		|	)
		|"); 
	Если Заказчик.Свойство("u_inn") Тогда Запрос.УстановитьПараметр("ИНН", Заказчик.u_inn);	Иначе Запрос.УстановитьПараметр("ИНН", ""); КонецЕсли;
	Если Заказчик.Свойство("ПаспортПолный") Тогда Запрос.УстановитьПараметр("ПаспортПолный", "%"+Заказчик.u_passport_number+"%"); Иначе Запрос.УстановитьПараметр("ПаспортПолный", ""); КонецЕсли;
	Если Заказчик.Свойство("ПаспортНомер") Тогда Запрос.УстановитьПараметр("ПаспортНомер", "%"+Прав(Заказчик.u_passport_number,6)+"%"); Иначе Запрос.УстановитьПараметр("ПаспортНомер", ""); КонецЕсли;
	Если Заказчик.Свойство("ПаспортДата") Тогда Запрос.УстановитьПараметр("ПаспортДата", "%"+ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заказчик.u_passport_date)+"%"); Иначе Запрос.УстановитьПараметр("ПаспортДата", "%"); КонецЕсли;
	Если Заказчик.Свойство("Фамилия") Тогда Запрос.УстановитьПараметр("Фамилия", "%"+Заказчик.u_surname+"%"); Иначе Запрос.УстановитьПараметр("Фамилия", ""); КонецЕсли;
	Если Заказчик.Свойство("Имя") Тогда Запрос.УстановитьПараметр("Имя", "%"+Заказчик.u_name+"%"); Иначе  Запрос.УстановитьПараметр("Имя", ""); КонецЕсли;
	Если Заказчик.Свойство("Отчество") Тогда Запрос.УстановитьПараметр("Отчество", "%"+Заказчик.u_sname+"%"); Иначе Запрос.УстановитьПараметр("Отчество", ""); КонецЕсли;
	Если Заказчик.Свойство("ДатаРождения") Тогда Запрос.УстановитьПараметр("ДатаРождения", ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заказчик.u_birthday)); Иначе Запрос.УстановитьПараметр("ДатаРождения", ""); КонецЕсли;
	
	Результат = Запрос.Выполнить().Выбрать();
	НайденКонтрагент = Справочники.Контрагенты.ПустаяСсылка();	
	Пока Результат.Следующий() Цикл 
		НайденКонтрагент = Результат.Ссылка;
		Прервать;
	КонецЦикла;  
	
	Если НайденКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		НайденКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		//Физик или Юрик
		u_company = "";
		Если Заказчик.Свойство("u_company") Тогда u_company = СокрЛП(Заказчик.u_company); КонецЕсли;
		Если СтрДлина(u_company)>0 Тогда
			//заполняем юрика
			НайденКонтрагент.Наименование = Заказчик.u_company;
			НайденКонтрагент.НаименованиеПолное = Заказчик.u_company;
			НайденКонтрагент.ЮридическоеФизическоеЛицо =  Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
			НайденКонтрагент.ИНН =  Заказчик.u_inn;			
		Иначе
			//заполняем физика
			НайденКонтрагент.Наименование = Заказчик.u_surname+" "+Заказчик.u_name+" "+Заказчик.u_sname;
			НайденКонтрагент.НаименованиеПолное = Заказчик.u_surname+" "+Заказчик.u_name+" "+Заказчик.u_sname;
			НайденКонтрагент.ЮридическоеФизическоеЛицо =  Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
			НайденКонтрагент.ИНН =  Заказчик.u_inn;
			
			Паспорт = "";
			Если СтрДлина(Заказчик.u_passport_number)>0 Тогда 
				Если СтрДлина(Паспорт)>0 Тогда Паспорт = Паспорт+" "; КонецЕсли;				
				Паспорт = Паспорт+Заказчик.u_passport_number;
			КонецЕсли;
			Если СтрДлина(Заказчик.u_passport_taken)>0 Тогда 
				Если СтрДлина(Паспорт)>0 Тогда Паспорт = Паспорт+" "; КонецЕсли;				
				Паспорт = Паспорт+"выдан "+Заказчик.u_passport_taken;
			КонецЕсли;
			Если СтрДлина(Заказчик.u_passport_date)>0 Тогда 				
				Если СтрДлина(Паспорт)>0 Тогда Паспорт = Паспорт+" "; КонецЕсли;
				Паспорт = Паспорт+ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заказчик.u_passport_date);
			КонецЕсли;
			Если СтрДлина(Паспорт)>0 Тогда 
				НайденКонтрагент.ДокументУдостоверяющийЛичность = Паспорт;
			КонецЕсли;
			
			ДатаРождения = "";			
			Если СтрДлина(Заказчик.u_birthday)>0 Тогда 
				ДатаРождения = ДатаРождения+ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заказчик.u_birthday);
			КонецЕсли;
			
			НайденКонтрагент.Комментарий = "";
			Если СтрДлина(Паспорт)>0 Тогда Если СтрДлина(НайденКонтрагент.Комментарий)>0 Тогда НайденКонтрагент.Комментарий = НайденКонтрагент.Комментарий+" "; КонецЕсли; НайденКонтрагент.Комментарий = НайденКонтрагент.Комментарий+Паспорт; КонецЕсли;
			Если СтрДлина(ДатаРождения)>0 Тогда Если СтрДлина(НайденКонтрагент.Комментарий)>0 Тогда НайденКонтрагент.Комментарий = НайденКонтрагент.Комментарий+" "; КонецЕсли; НайденКонтрагент.Комментарий = НайденКонтрагент.Комментарий+" д.р. "+ДатаРождения; КонецЕсли;
		КонецЕсли;
		НайденКонтрагент.ДополнительнаяИнформация = "";
		Если СтрДлина(Заказчик.address)>0 Тогда
			Если СтрДлина(НайденКонтрагент.ДополнительнаяИнформация)>0 Тогда НайденКонтрагент.ДополнительнаяИнформация = НайденКонтрагент.ДополнительнаяИнформация+" "; КонецЕсли;				
			НайденКонтрагент.ДополнительнаяИнформация =  НайденКонтрагент.ДополнительнаяИнформация+"Адрес: "+Заказчик.address;
			НоваяСтрока=НайденКонтрагент.КонтактнаяИнформация.Добавить();
			НоваяСтрока.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
			НоваяСтрока.Вид = Перечисления.ВидыКонтактныхЛиц.ЛичныйКонтакт;
			НоваяСтрока.Представление = СокрЛП(Заказчик.address);				
		КонецЕсли;
		
		Если СтрДлина(Заказчик.u_phone_mobile)>0 ИЛИ СтрДлина(Заказчик.u_phone)>0 Тогда
			Телефоны = Новый Массив(2);
			СчетМассив = 0;
			Если СтрДлина(Заказчик.u_phone_mobile)>0 Тогда
				Телефоны[СчетМассив] = Заказчик.u_phone_mobile;
			КонецЕсли;
			Если СтрДлина(Заказчик.u_phone)>0 Тогда
				Телефоны[СчетМассив] = Заказчик.u_phone;
			КонецЕсли;				
			Если Телефоны.Количество()>0 Тогда
				Если СтрДлина(НайденКонтрагент.ДополнительнаяИнформация)>0 Тогда НайденКонтрагент.ДополнительнаяИнформация = НайденКонтрагент.ДополнительнаяИнформация+" "; КонецЕсли;				
				НайденКонтрагент.ДополнительнаяИнформация =  НайденКонтрагент.ДополнительнаяИнформация+"Телефоны: "+СокрЛП(СтрСоединить(Телефоны,", "));					
				НоваяСтрока=НайденКонтрагент.КонтактнаяИнформация.Добавить();
				НоваяСтрока.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				НоваяСтрока.Вид = Перечисления.ВидыКонтактныхЛиц.ЛичныйКонтакт;
				НоваяСтрока.Представление = СокрЛП(СтрСоединить(Телефоны,", "));
				НоваяСтрока.НомерТелефона = Телефоны[0];
			КонецЕсли;				
		КонецЕсли;
		
		Если СтрДлина(Заказчик.u_email)>0 Тогда
			Если СтрДлина(НайденКонтрагент.ДополнительнаяИнформация)>0 Тогда НайденКонтрагент.ДополнительнаяИнформация = НайденКонтрагент.ДополнительнаяИнформация+" "; КонецЕсли;				
			НайденКонтрагент.ДополнительнаяИнформация =  НайденКонтрагент.ДополнительнаяИнформация+"Эл.почта: "+Заказчик.u_email;
			НоваяСтрока=НайденКонтрагент.КонтактнаяИнформация.Добавить();
			НоваяСтрока.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
			НоваяСтрока.Вид = Перечисления.ВидыКонтактныхЛиц.ЛичныйКонтакт;
			НоваяСтрока.АдресЭП = Заказчик.u_email;
			НоваяСтрока.Представление = СокрЛП(Заказчик.u_email);			
		КонецЕсли;
		КаталогЗаказчиков = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогЗаказчиков");
		НайденКонтрагент.Родитель = КаталогЗаказчиков;
		НайденКонтрагент.Записать();
	КонецЕсли;
	Возврат НайденКонтрагент;
КонецФункции



