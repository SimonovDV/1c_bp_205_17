КонецФункции

&НаСервере
Функция ПолучитьЗаявку(НомерЗаявки)
	КВозврату = Новый Структура;
	Префикс = СокрЛП(ЭТ_ОбщийМодуль2.ПолучитьНастройку("Префикс","ЭТ18-")); 
	СтрокаПоиска = ВРег(СокрЛП(ЭтаФорма.СтрокаПоиска)); 
	Если СтрНайти(СтрокаПоиска,ВРег(Префикс))=0 Тогда
		СтрокаПоиска = Префикс + СтрокаПоиска;
	КонецЕсли;
	НомерЗаявки = ЭТ_ОбщийМодуль2.ПолучитьКодИзСтроки(СтрокаПоиска,Префикс);
	КВозврату = ЭТ_ОбщийМодуль2.ПолучитьЗаявкуПоНомеру(НомерЗаявки);
	Возврат  КВозврату;
КонецФункции


//ЭТ_ЗаполнитьСБВместо(Команда)
//вот наш герой, заполняет форму по клику на кнопку Заполнить из панели "из U-ON"
//нового контрагента не создает, а вот договор за контрагентом, в случае его отсутствия создает
&НаКлиенте
Процедура ЭТ_ЗаполнитьСБВместо(Команда)
	СледЗаявка = ПолучитьЗаявку(ЭтаФорма.СтрокаПоиска);
	Если СледЗаявка.Свойство("id_internal") Тогда
		НайденДоговор = НайтиДоговорПокупателя(СледЗаявка,Ложь);
		Если НЕ НайденДоговор = Ложь Тогда
			Контрагент = ПолучитьКонтрагентаПоДоговору(НайденДоговор);
			РасшифровкаПлатежаДоговорКонтрагента = НайденДоговор;
		Иначе
			СозданДоговор = СоздатьДоговорПокупателя(СледЗаявка);
			Контрагент = ПолучитьКонтрагентаПоДоговору(СозданДоговор);
			РасшифровкаПлатежаДоговорКонтрагента = СозданДоговор;
		КонецЕсли;          
		
		Если СледЗаявка.supplier_inn = ПолучитьИННОрганизации(Объект.Организация) Тогда
			//ОтражениеАванса = "Доход УСН";             
			ОтражениеАванса = ПолучитьНастройку("ОтражениеАвансаПоставщики","Доход УСН"); //"Доход УСН";             
			Сообщить("Наша компания является туроператором");
			//ПоказатьПредупреждение(,"Наша компания является туроператором",,"Предупреждение");
		Иначе
			//ОтражениеАванса = "Доход комитента";
			ОтражениеАванса = ПолучитьНастройку("ОтражениеАвансаАгенты","Доход комитента");
		КонецЕсли;
		
		ЗаполнитьФормуПКО(Новый Структура("Контрагент, РасшифровкаПлатежаДоговорКонтрагента",Контрагент, РасшифровкаПлатежаДоговорКонтрагента));
		РасшифровкаПлатежаОтражениеАвансаПредставление = ОтражениеАванса;
	КонецЕсли;
	ЭтаФорма.Элементы.ПанельПоискаСБ.Видимость = Ложь;
	ТекущийЭлемент = ЭтаФорма.Элементы.СуммаДокумента;
КонецПроцедуры

&НаСервере
Функция ЭтоНовыйОбъект()
	Возврат Объект.Ссылка.Пустая();
КонецФункции

&НаКлиенте
Процедура ЭТ_ПриОткрытииПосле(Отказ)
	Если ЭтоНовыйОбъект() Тогда
		УстановитьбезДоходКомитента();
		РасшифровкаПлатежаОтражениеАвансаПредставлениеПриИзменении(ЭтаФорма.Элементы.РасшифровкаПлатежаОтражениеАвансаПредставление);
		УстановитьбезНДС();
		РасшифровкаПлатежаСтавкаНДСПриИзменении(ЭтаФорма.Элементы.РасшифровкаПлатежаСтавкаНДС);
	КонецЕсли;	
КонецПроцедуры


&НаСервере
Процедура УстановитьбезНДС()
	ЭтотОбъект.РасшифровкаПлатежаСтавкаНДС = Перечисления.СтавкиНДС["БезНДС"];
КонецПроцедуры
	
&НаСервере
Процедура УстановитьбезДоходКомитента()
	ЭтотОбъект.РасшифровкаПлатежаОтражениеАвансаПредставление = Перечисления.ПорядокОтраженияАвансов["ДоходКомитента"];
КонецПроцедуры
	

