
&Вместо("СформироватьСуммуПрописью")
Функция ЭТ_СформироватьСуммуПрописью(Сумма, Валюта)
	Если Сумма = Null Тогда
		Возврат "";
	КонецЕсли;
	
	Если Валюта.ПараметрыПрописи = "" Тогда
		Возврат ФорматСумм(Сумма);
	Иначе
		Возврат ЧислоПрописью(Сумма, ,Валюта.ПараметрыПрописи);
	КонецЕсли;
КонецФункции


