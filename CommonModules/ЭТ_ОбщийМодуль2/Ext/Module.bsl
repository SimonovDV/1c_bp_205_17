			НЕ ТипЗнч(ВыборкаХранилища.Настройки) = Тип("Строка")
			) Тогда
			Сообщить("["+ВыборкаХранилища.КлючНастроек+"] ["+ВыборкаХранилища.Настройки+"] ["+ТипЗнч(ВыборкаХранилища.Настройки)+"]");
