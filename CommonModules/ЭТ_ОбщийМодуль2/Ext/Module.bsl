//RequestSearch(Параметры) Экспорт
//https://api.u-on.ru/{key}/request/search.{_format} Получение данных заявок по фильтрам / Get requests data by filters
&НаСервере
Функция RequestSearch(ВхПараметры) Экспорт
		//date_create_from	datetime	false		Дата создания заявки (от) / Create date of request (from)
		//date_create_to	datetime	false		Дата создания заявки (до) / Create date of request (till)
		//date_begin_from	datetime	false		Дата начала заявки (от) / Start date of request (from)
		//date_begin_to	datetime	false		Дата начала заявки (до) / Start date of request (till)
		//date_end_from	datetime	false		Дата окончания заявки (от) / End date of request (from)
		//date_end_to	datetime	false		Дата окончания заявки (до) / End date of request (till)
		//r_id_system	string	false		Системный ID заявки / Request's system ID
		//r_id_internal	string	false		Внутренний ID заявки / Request's internal ID
		//manager_ids	string	false		ID менеджеров (через запятую) / Manager IDs (delimited by comma)
		//client_ids	string	false		ID клиентов (через запятую) / Client IDs (delimited by comma)
		//source_ids	string	false		ID источников (через запятую) / Source IDs (delimited by comma)
		//status_ids	string	false		ID статусов (через запятую) / Status IDs (delimited by comma)
		//service_type_ids	string	false		ID типов услуг внутри заявки (через запятую) / Service type IDs inside request (delimited by comma)
		//calc_price_from	float	false		Стоимость для клиента (от) / The cost for the client (from)
		//calc_price_to	float	false		Стоимость для клиента (до) / The cost for the client (till)
		//calc_price_netto_from	float	false		Себестоимость для клиента (от) / Netto cost for the client (from)
		//calc_price_netto_to	float	false		Себестоимость для клиента (до) / Netto cost for the client (till)	
		КВозврату = Новый Структура;
		СписокКлючей = Новый СписокЗначений;
		СписокКлючей = СоздатьСписокКлючей("page date_create_from date_create_to date_begin_from date_begin_to date_end_from date_end_to r_id_system r_id_internal manager_ids client_ids source_ids status_ids service_type_ids calc_price_from calc_price_to calc_price_netto_from calc_price_netto_to");
		СтруктураПараметров = Новый Структура;
		КоличествоПараметров = 0;
		Для Каждого Ключ Из СписокКлючей Цикл
			Если ?(ВхПараметры.Свойство(Ключ.Значение),СтрДлина(СокрЛП(Ключ.Значение)),0)>0 Тогда
				Если СтрНайти(Ключ.Значение,"id") И СтрДлина(ВхПараметры[Ключ.Значение])>0 И СокрЛП(ВхПараметры[Ключ.Значение])<>"0" Тогда
					СтруктураПараметров.Вставить(Ключ,ВхПараметры[Ключ.Значение]); 
					КоличествоПараметров = КоличествоПараметров + 1;
				ИначеЕсли НЕ СтрНайти(Ключ.Значение,"id") И СтрДлина(ВхПараметры[Ключ.Значение])>0 Тогда
					СтруктураПараметров.Вставить(Ключ,ВхПараметры[Ключ.Значение]); 
					Если НЕ(Ключ.Значение = "page") Тогда
						КоличествоПараметров = КоличествоПараметров + 1;
					КонецЕсли					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если КоличествоПараметров<1 Тогда	Возврат Новый Структура;	КонецЕсли; //если передана только страница, то выходим
		
		Если СтруктураПараметров.Свойство("page") Тогда
			ДанныеЗапроса = ЭТ_СоединениеЮОН.ОпроавитьПостЗапрос("/request/search",СтруктураПараметров);			
			Возврат ?(ДанныеЗапроса.Свойство("requests"),ДанныеЗапроса.requests,Новый Структура);
		Иначе
			Страница = 1;
			КВозврату = Новый Массив;                                             			
			УсловиеПродолжить = Истина;
			Пока УсловиеПродолжить Цикл				
				СтруктураПараметров.Вставить("page",Страница);
				ДанныеЗапроса = ЭТ_СоединениеЮОН.ОпроавитьПостЗапрос("/request/search",СтруктураПараметров);				
				Если НЕ ТипЗнч(ДанныеЗапроса) = Тип("Булево") Тогда
					Если ДанныеЗапроса.Свойство("requests") Тогда
						Если ДанныеЗапроса.requests.Количество()>0 Тогда
							ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КВозврату,ДанныеЗапроса.requests);
						Иначе
							УсловиеПродолжить = Ложь;						
						КонецЕсли;
					КонецЕсли;			
				Иначе
					УсловиеПродолжить = Ложь;						
				КонецЕсли;
				Страница = Страница + 1;
			КонецЦикла;			
			Если КВозврату.Количество()<1 Тогда
				КВозврату = Новый Структура;
			КонецЕсли;			
		КонецЕсли;
		Возврат КВозврату;
КонецФункции

