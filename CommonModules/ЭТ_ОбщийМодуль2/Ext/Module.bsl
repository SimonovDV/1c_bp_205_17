				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если МасЗаявок.Количество()<1 Тогда 
			Возврат Ложь;
		Иначе
			Для Каждого СледПлатежка ИЗ МасЗаявок Цикл
