//ПолучитьКонтрагента_1С(Партнер,Создавать = Ложь) Экспорт
//в справочнике контрагентов находит партнера, сравнение идет по ИНН, можно передать id
&НаСервере
Функция ПолучитьКонтрагента_1С(Партнер,Создавать = Ложь) Экспорт
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	ИННПартнера = "";
	Если Партнер.Свойство("inn") Тогда
		Если СтрДлина(СокрЛП(Партнер.inn))>0 Тогда
			ИННПартнера = Партнер.inn;
		КонецЕсли;
	КонецЕсли;
	Если СтрДлина(СокрЛП(ИННПартнера))<1 Тогда
		Если Партнер.Свойство("id") Тогда
			Если Партнер.id>0 Тогда
				Парам = Новый Структура("id",Партнер.id);
				ПартнерСБ = ЭТ_ОбщийМодуль2.Supplier(Парам);
				Если ПартнерСБ.Количество()>0 Тогда
					Для Каждого СледПартнер Из ПартнерСБ Цикл
						Если СледПартнер.Свойство("id") И СледПартнер.Свойство("inn") Тогда
							Если СледПартнер.id = Партнер.id Тогда
								ИННПартнера = СокрЛП(СледПартнер.inn);
								Прервать;
							КонецЕсли;							
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	Если СтрДлина(СокрЛП(ИННПартнера))<1 Тогда 
		Если Партнер.Свойство("name") Тогда
			Если СтрДлина(СокрЛП(Партнер.name))>0 Тогда
				ИННПартнера =  СокрЛП(ЭТ_ОбщийМодуль2.ИННизНазвания(Партнер.name));
			КонецЕсли;				
		КонецЕсли;
	КонецЕсли;
	Если СтрДлина(СокрЛП(ИННПартнера))>0 Тогда
		Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН",ИННПартнера);
		Если (Контрагент = Справочники.Контрагенты.ПустаяСсылка()) и (Создавать = Истина) Тогда 
			НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
			НовыйКонтрагент.ИНН = Партнер.inn;
			НовыйКонтрагент.Наименование = Партнер.name;
			НовыйКонтрагент.НаименованиеПолное = Партнер.name;
			Если Партнер.Свойство("Родитель") Тогда
				Если НЕ Партнер.Родитель = Справочники.Контрагенты.ПустаяСсылка() Тогда
						НовыйКонтрагент.Родитель = Партнер.Родитель;
				КонецЕсли;
			КонецЕсли;
			НовыйКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
			НовыйКонтрагент.Записать();
			Сообщение = "Создан новый контрагент "+НовыйКонтрагент.Наименование+" ИНН:"+НовыйКонтрагент.ИНН;
			Сообщить(Сообщение,СтатусСообщения.Информация);
			Контрагент = НовыйКонтрагент;
		КонецЕсли;
	КонецЕсли;
	Возврат Контрагент;
КонецФункции

//СравнитьИНН(ЗаявкаИНН,ПлатежкаИНН) Экспорт
//функция сравнения ИНН, на тек.момент простое сравнение, предусмотрена для расширения функции сравнения
Функция СравнитьИНН(ЗаявкаИНН,ПлатежкаИНН) Экспорт
	Возврат СокрЛП(ЗаявкаИНН)=СокрЛП(ПлатежкаИНН);
КонецФункции

//СинонимИНН(ИНН,Поле=0) Экспорт
//находит синоним ИНН из таблицы в настройках
&НаСервере
Функция СинонимИНН(ИНН,Поле=0) Экспорт
	//0-заявка
	//1-платежка
	ТаблицаИНН = Новый ТаблицаЗначений;
	ТаблицаИНН.Колонки.Добавить("поле_0",Тип("Строка"));
	ТаблицаИНН.Колонки.Добавить("поле_1",Тип("Строка"));
	СписокИтого = Новый Массив;
	СписокИтого.Добавить(ИНН);
	ПолеПоискаЧисло = Поле;
	Если ПолеПоискаЧисло = 0 Тогда
		ПолеВыдачиЧисло = 1;
	Иначе
		ПолеВыдачиЧисло = 0;
	КонецЕсли;
	ПолеПоиска = "поле_"+СокрЛП(Строка(ПолеПоискаЧисло));
	ПолеВыдачи = "поле_"+СокрЛП(Строка(ПолеВыдачиЧисло));
	СтруктураПоиска = Новый Структура(ПолеПоиска,ИНН);
	Для Каждого ТекСтрока Из ТаблицаИНН.НайтиСтроки(СтруктураПоиска) Цикл
		СписокИтого.Добавить(СокрЛП(ТекСтрока[ПолеВыдачи]));		
	КонецЦикла;
	Возврат СписокИтого;
КонецФункции

//ОпределитьКассуПоРасчетномуСчету(РасчетныйСчет,Создавать=Ложь) Экспорт
//по расчетному счету определяет кассу в СБ
&НаСервере
Функция ОпределитьКассуПоРасчетномуСчету(РасчетныйСчет,Создавать=Ложь) Экспорт
	//получаем список касс
	КодКассы=0;
	Для Каждого СледКасса Из Сash() Цикл
		Если КодКассы<1 Тогда
			Если СледКасса.Свойство("name") Тогда
				Если СтрНайти(СледКасса.name,СокрЛП(РасчетныйСчет))>0 Тогда
					Если СледКасса.Свойство("id") Тогда 
						КодКассы = СледКасса.id;
					КонецЕсли;				
				КонецЕсли;			
			КонецЕсли;		
		КонецЕсли;			
	КонецЦикла;
	Если КодКассы<1 И Создавать=Истина Тогда
		//получаем банк кассы
		Запрос = Новый Запрос(" 
				|ВЫБРАТЬ 
				|	Ссылка, 
				|	Банк.Наименование КАК БанкНаименование,
				|	НомерСчета
				|ИЗ 
				|	Справочник.БанковскиеСчета КАК БанковскиеСчета
				|ГДЕ
				|	БанковскиеСчета.НомерСчета ПОДОБНО &НомерСчета
				|   И Не ПометкаУдаления
				|"); 
			Запрос.УстановитьПараметр("НомерСчета", "%"+СокрЛП(РасчетныйСчет)+"%");	
			Результат = Запрос.Выполнить().Выбрать();
			НайденДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
			Пока Результат.Следующий() Цикл 
				Если КодКассы<1 Тогда
					КодКассы = СashCreate(Новый Структура("name, name_en",Результат.БанкНаименование+" ("+Результат.НомерСчета+")"));
				 	Прервать;
				КонецЕсли;
			КонецЦикла;  
	КонецЕсли;
	Возврат КодКассы;	
КонецФункции

//ОпределитьКассуРасчета(ВидОплаты,ПоУмолчанию=Неопределено) Экспорт
//по виду оплаты определяет кассу расчета
&НаСервере
Функция ОпределитьКассуРасчета(ВидОплаты,ПоУмолчанию=Неопределено) Экспорт
	Если ПоУмолчанию=Неопределено Тогда
		ПоУмолчанию= Новый Структура("КассаЮОН,ПроцентКомиссии,ВРасходы",0,0,0);
	КонецЕсли;
	КВозврату = ПоУмолчанию;	
	ТаблицаВидовОплат = ПолучитьНастройку("ВидыОплатЮОН", Новый ТаблицаЗначений);
	//ТаблицаВидовОплат = Новый ТаблицаЗначений;
	КВозвратуСтрока = ТаблицаВидовОплат.Найти(ВидОплаты,"ВидОплаты");
	Если НЕ КВозвратуСтрока = Неопределено Тогда
		ЧислоСтрокой = СокрЛП(ОставитьТолькоЦифры(ВырезатьИзСтроки(КВозвратуСтрока["КассаЮОН"],"[","]")[0]));
		Если СтрДлина(ЧислоСтрокой)>0 Тогда
			КВозврату.КассаЮОН = Число(ЧислоСтрокой);
			КВозврату.ПроцентКомиссии = КВозвратуСтрока["ПроцентКомиссии"];
			КВозврату.ВРасходы = КВозвратуСтрока["ВРасходы"];
		КонецЕсли;
	КонецЕсли;
	Возврат КВозврату;
КонецФункции

//СоздатьЗаказчикаПоЗаявке(Заявка) Экспорт
//по структуре присланной Заявке создает контрагента (заказчика) в 1С, предварительно выполняет поиск, и если контрагент есть, то вернет ссылку
//сравнение идет по ИНН, Паспорту, Названию
//поиск ведется по договорам
&НаСервере
Функция СоздатьЗаказчикаПоЗаявке(Заявка) Экспорт
	//Получаем заявку
	Заказчик = ЭТ_ОбщийМодуль2.User(Новый Структура("id",Заявка.client_id));
	Запрос = Новый Запрос(" 
		|ВЫБРАТЬ 
		|	Ссылка, 
		|	Наименование
		|ИЗ 
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	(Контрагенты.ИНН ПОДОБНО &ИНН И Контрагенты.ИНН<>"""" И НЕ(&ИНН ПОДОБНО &ИНН_Деф))
		|	ИЛИ((&ИНН ПОДОБНО &ИНН_Деф) И (
		|		(ВЫРАЗИТЬ(Контрагенты.Комментарий КАК СТРОКА(1000)) ПОДОБНО &ПаспортПолный И ВЫРАЗИТЬ(Контрагенты.Комментарий КАК СТРОКА(1000))<>"""")
		|		ИЛИ ((Контрагенты.ДокументУдостоверяющийЛичность ПОДОБНО &ПаспортПолный ИЛИ Контрагенты.ДокументУдостоверяющийЛичность ПОДОБНО &ПаспортНомер) И (Контрагенты.ДокументУдостоверяющийЛичность ПОДОБНО &ПаспортДата) И Контрагенты.ДокументУдостоверяющийЛичность<>"""")
		|		ИЛИ (
		|			Контрагенты.НаименованиеПолное ПОДОБНО &ФИОЗаказчика 
		|			)
		|		))
		|"); 
	
//		|		(ДоговорыКонтрагентов.Владелец.ИНН ПОДОБНО &ИНН И НЕ(&ИНН ПОДОБНО &ИНН_Деф))
//		|		ИЛИ ((&ИНН ПОДОБНО &ИНН_Деф) И (

//		|	ИЛИ (Контрагенты.НаименованиеПолное ПОДОБНО &Фамилия И Контрагенты.НаименованиеПолное ПОДОБНО &Имя И Контрагенты.НаименованиеПолное ПОДОБНО &Отчество И ВЫРАЗИТЬ(Контрагенты.Комментарий КАК СТРОКА(1000)) ПОДОБНО &ДатаРождения И Контрагенты.НаименованиеПолное<>"""" И ВЫРАЗИТЬ(Контрагенты.Комментарий КАК СТРОКА(1000))<>"""")
		
	Запрос.УстановитьПараметр("ВидДоговора",ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораКлиент"));
	ИНН = СтрФальш();
	ИНН_Деф = ИНН;	
	Если Заказчик.Свойство("u_inn") Тогда Если СтрДлина(Заказчик.u_inn)>0 Тогда ИНН = СокрЛП(Заказчик.u_inn); КонецЕсли; КонецЕсли;
	Запрос.УстановитьПараметр("ИНН", ИНН);	
	Запрос.УстановитьПараметр("ИНН_Деф", ИНН_Деф);	
	
	
	ПаспЗАказчик = СтрФальш(); 
	Если Заказчик.Свойство("u_passport_number") Тогда Если СтрДлина(Заказчик.u_passport_number)>0 Тогда ПаспЗАказчик = Заказчик.u_passport_number; КонецЕсли; КонецЕсли;
	Запрос.УстановитьПараметр("ПаспортПолный", "%"+ПаспЗАказчик+"%");
	Запрос.УстановитьПараметр("ПаспортНомер", "%"+Прав(ПаспЗАказчик,6)+"%");
	
	ПаспДатаЗаказчик = СтрФальш(); 
	Если Заказчик.Свойство("u_passport_date") Тогда Если СтрДлина(Заказчик.u_passport_date)>0 Тогда ПаспДатаЗаказчик = ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заказчик.u_passport_date); КонецЕсли; КонецЕсли;
	Запрос.УстановитьПараметр("ПаспортДата", "%"+ПаспДатаЗаказчик+"%");
	
	ФИОЗаказчика = "";
	Если Заказчик.Свойство("u_surname") Тогда Если СтрДлина(Заказчик.u_surname)>0 Тогда ФИОЗаказчика = ФИОЗаказчика + " "+Заказчик.u_surname; КонецЕсли; КонецЕсли;
	Если Заказчик.Свойство("u_name") Тогда Если СтрДлина(Заказчик.u_name)>0 Тогда ФИОЗаказчика = ФИОЗаказчика + " "+Заказчик.u_name; КонецЕсли; КонецЕсли;
	Если Заказчик.Свойство("u_sname") Тогда Если СтрДлина(Заказчик.u_sname)>0 Тогда ФИОЗаказчика = ФИОЗаказчика + " "+Заказчик.u_sname; КонецЕсли; КонецЕсли;
	
	Пока СтрНайти(ФИОЗаказчика,"  ") Цикл 
		ФИОЗаказчика = СтрЗаменить(ФИОЗаказчика,"  "," ");		
	КонецЦикла;
	
	ФИОЗаказчика = СокрЛП(ФИОЗаказчика);
	Если СтрДлина(СокрЛП(ФИОЗаказчика))>0 Тогда
		ФИОЗаказчика = СтрЗаменить(ФИОЗаказчика," ","%");
	    ФИОЗаказчика = "%"+ФИОЗаказчика+"%";
	Иначе
		ФИОЗаказчика = СтрФальш();
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ФИОЗаказчика", ФИОЗаказчика);
	
	
	//Если  Заказчик.Свойство("u_inn") Тогда Запрос.УстановитьПараметр("ИНН", Заказчик.u_inn); Иначе Запрос.УстановитьПараметр("ИНН", ""); КонецЕсли;
	//Если  Заказчик.Свойство("u_passport_number") Тогда Запрос.УстановитьПараметр("ПаспортПолный", "%"+Заказчик.u_passport_number+"%"); Иначе Запрос.УстановитьПараметр("ПаспортПолный", ""); КонецЕсли;
	//Если  Заказчик.Свойство("u_passport_number") Тогда Запрос.УстановитьПараметр("ПаспортНомер", "%"+Прав(Заказчик.u_passport_number,6)+"%"); Иначе  Запрос.УстановитьПараметр("ПаспортНомер", ""); КонецЕсли;
	//Если  Заказчик.Свойство("u_passport_date") Тогда Запрос.УстановитьПараметр("ПаспортДата", "%"+ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заказчик.u_passport_date)+"%"); Иначе Запрос.УстановитьПараметр("ПаспортДата", ""); КонецЕсли;
	//Если  Заказчик.Свойство("u_surname") Тогда Запрос.УстановитьПараметр("Фамилия", "%"+Заказчик.u_surname+"%"); Иначе Запрос.УстановитьПараметр("Фамилия", ""); КонецЕсли;
	//Если  Заказчик.Свойство("u_name") Тогда Запрос.УстановитьПараметр("Имя", "%"+Заказчик.u_name+"%"); Иначе Запрос.УстановитьПараметр("Имя", ""); КонецЕсли;
	//Если  Заказчик.Свойство("u_sname") Тогда Запрос.УстановитьПараметр("Отчество", "%"+Заказчик.u_sname+"%");  Иначе   Запрос.УстановитьПараметр("Отчество", "");  КонецЕсли;
	//Если  Заказчик.Свойство("u_birthday") Тогда Запрос.УстановитьПараметр("ДатаРождения", ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заказчик.u_birthday)); Иначе Запрос.УстановитьПараметр("ДатаРождения", ""); КонецЕсли;
	
	Результат = Запрос.Выполнить().Выбрать();
	НайденКонтрагент = Справочники.Контрагенты.ПустаяСсылка();	
	Пока Результат.Следующий() Цикл 
		НайденКонтрагент = Результат.Ссылка;
		Прервать;
	КонецЦикла;  
	
	Если НайденКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		НайденКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		//Физик или Юрик
		Если СтрДлина(СокрЛП(?(Заказчик.Свойство("u_company"),Заказчик.u_company,0)))>0 Тогда
			//заполняем юрика
			НайденКонтрагент.Наименование = Заказчик.u_company;
			НайденКонтрагент.НаименованиеПолное = Заказчик.u_company;
			НайденКонтрагент.ЮридическоеФизическоеЛицо =  Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
			Если Заказчик.u_inn<>СтрФальш() Тогда НайденКонтрагент.ИНН =  Заказчик.u_inn;	КонецЕсли;
		Иначе
			//заполняем физика
			НайденКонтрагент.Наименование = Заказчик.u_surname+" "+Заказчик.u_name+" "+Заказчик.u_sname;
			НайденКонтрагент.НаименованиеПолное = Заказчик.u_surname+" "+Заказчик.u_name+" "+Заказчик.u_sname;
			НайденКонтрагент.ЮридическоеФизическоеЛицо =  Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
			Если Заказчик.u_inn<>СтрФальш() Тогда НайденКонтрагент.ИНН =  Заказчик.u_inn;	КонецЕсли;
			
			Паспорт = "";
			Если СтрДлина(Заказчик.u_passport_number)>0 Тогда 
				Если СтрДлина(Паспорт)>0 Тогда Паспорт = Паспорт+" "; КонецЕсли;				
				Паспорт = Паспорт+Заказчик.u_passport_number;
			КонецЕсли;
			Если СтрДлина(Заказчик.u_passport_taken)>0 Тогда 
				Если СтрДлина(Паспорт)>0 Тогда Паспорт = Паспорт+" "; КонецЕсли;				
				Паспорт = Паспорт+"выдан "+Заказчик.u_passport_taken;
			КонецЕсли;
			Если СтрДлина(Заказчик.u_passport_date)>0 Тогда 				
				Если СтрДлина(Паспорт)>0 Тогда Паспорт = Паспорт+" "; КонецЕсли;
				Паспорт = Паспорт+ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заказчик.u_passport_date);
			КонецЕсли;
			Если СтрДлина(Паспорт)>0 Тогда 
				НайденКонтрагент.ДокументУдостоверяющийЛичность = Паспорт;
			КонецЕсли;
			
			ДатаРождения = "";			
			Если СтрДлина(Заказчик.u_birthday)>0 Тогда 
				ДатаРождения = ДатаРождения+ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заказчик.u_birthday);
			КонецЕсли;
			
			НайденКонтрагент.Комментарий = "";
			Если СтрДлина(Паспорт)>0 Тогда Если СтрДлина(НайденКонтрагент.Комментарий)>0 Тогда НайденКонтрагент.Комментарий = НайденКонтрагент.Комментарий+" "; КонецЕсли; НайденКонтрагент.Комментарий = НайденКонтрагент.Комментарий+Паспорт; КонецЕсли;
			Если СтрДлина(ДатаРождения)>0 Тогда Если СтрДлина(НайденКонтрагент.Комментарий)>0 Тогда НайденКонтрагент.Комментарий = НайденКонтрагент.Комментарий+" "; КонецЕсли; НайденКонтрагент.Комментарий = НайденКонтрагент.Комментарий+" д.р. "+ДатаРождения; КонецЕсли;
		КонецЕсли;
		
		
		НайденКонтрагент.ДополнительнаяИнформация = "";
		Если СтрДлина(Заказчик.address)>0 Тогда
			Если СтрДлина(НайденКонтрагент.ДополнительнаяИнформация)>0 Тогда НайденКонтрагент.ДополнительнаяИнформация = НайденКонтрагент.ДополнительнаяИнформация+" "; КонецЕсли;				
			НайденКонтрагент.ДополнительнаяИнформация =  НайденКонтрагент.ДополнительнаяИнформация+"Адрес: "+Заказчик.address;
			НоваяСтрока=НайденКонтрагент.КонтактнаяИнформация.Добавить();
			НоваяСтрока.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
			НоваяСтрока.Вид = Перечисления.ВидыКонтактныхЛиц.ЛичныйКонтакт;
			НоваяСтрока.Представление = СокрЛП(Заказчик.address);				
		КонецЕсли;
		
		Если СтрДлина(Заказчик.u_phone_mobile)>0 ИЛИ СтрДлина(Заказчик.u_phone)>0 Тогда
			Телефоны = Новый Массив(2);
			СчетМассив = 0;
			Если СтрДлина(Заказчик.u_phone_mobile)>0 Тогда
				Телефоны[СчетМассив] = Заказчик.u_phone_mobile;
			КонецЕсли;
			Если СтрДлина(Заказчик.u_phone)>0 Тогда
				Телефоны[СчетМассив] = Заказчик.u_phone;
			КонецЕсли;				
			Если Телефоны.Количество()>0 Тогда
				Если СтрДлина(НайденКонтрагент.ДополнительнаяИнформация)>0 Тогда НайденКонтрагент.ДополнительнаяИнформация = НайденКонтрагент.ДополнительнаяИнформация+" "; КонецЕсли;				
				НайденКонтрагент.ДополнительнаяИнформация =  НайденКонтрагент.ДополнительнаяИнформация+"Телефоны: "+СокрЛП(СтрСоединить(Телефоны,", "));					
				НоваяСтрока=НайденКонтрагент.КонтактнаяИнформация.Добавить();
				НоваяСтрока.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				НоваяСтрока.Вид = Перечисления.ВидыКонтактныхЛиц.ЛичныйКонтакт;
				НоваяСтрока.Представление = СокрЛП(СтрСоединить(Телефоны,", "));
				НоваяСтрока.НомерТелефона = Телефоны[0];
			КонецЕсли;				
		КонецЕсли;
		
		
		Если СтрДлина(Заказчик.u_email)>0 Тогда
			Если СтрДлина(НайденКонтрагент.ДополнительнаяИнформация)>0 Тогда НайденКонтрагент.ДополнительнаяИнформация = НайденКонтрагент.ДополнительнаяИнформация+" "; КонецЕсли;				
			НайденКонтрагент.ДополнительнаяИнформация =  НайденКонтрагент.ДополнительнаяИнформация+"Эл.почта: "+Заказчик.u_email;
			НоваяСтрока=НайденКонтрагент.КонтактнаяИнформация.Добавить();
			НоваяСтрока.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
			НоваяСтрока.Вид = Перечисления.ВидыКонтактныхЛиц.ЛичныйКонтакт;
			НоваяСтрока.АдресЭП = Заказчик.u_email;
			НоваяСтрока.Представление = СокрЛП(Заказчик.u_email);			
		КонецЕсли;
		КаталогЗаказчиков = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогЗаказчиков");
		НайденКонтрагент.Родитель = КаталогЗаказчиков;
		НайденКонтрагент.Записать();
	КонецЕсли;
	Возврат НайденКонтрагент;
КонецФункции


//ПолучитьЗаказчикаПоЗаявке(Заявка,Создавать=Ложь) Экспорт
//по переданной структуре заявки возвращает заказчика, 
//сравнение идет по ИНН, Паспорту, Названию
//поиск ведется по договорам
&НаСервере
Функция ПолучитьЗаказчикаПоЗаявке(Заявка,Создавать=Ложь) Экспорт
	Заказчик = ЭТ_ОбщийМодуль2.User(Новый Структура("id",Заявка.client_id));
	Запрос = Новый Запрос;
	ТекстЗапроса = " 
		|ВЫБРАТЬ 
		|	ДоговорыКонтрагентов.Владелец КАК Контрагент,
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ 
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	(ВЫБРАТЬ 
		|		КОЛИЧЕСТВО(КолДог.Ссылка) КАК КолвоДоговор,
		|		КолДог.Владелец КАК Контрагент
		|	ИЗ 
		|		Справочник.ДоговорыКонтрагентов КАК КолДог
		|	ГДЕ
		|		НЕ КолДог.ПометкаУдаления				
		|	СГРУППИРОВАТЬ ПО КолДог.Владелец
		|	) КАК Колво
		|ПО Колво.Контрагент = ДоговорыКонтрагентов.Владелец
		|ГДЕ
		|	(
		|		(ДоговорыКонтрагентов.Владелец.ИНН ПОДОБНО &ИНН И НЕ(&ИНН ПОДОБНО &ИНН_Деф))
		|		ИЛИ ((&ИНН ПОДОБНО &ИНН_Деф) И (
		|				ВЫРАЗИТЬ(ДоговорыКонтрагентов.Владелец.Комментарий КАК СТРОКА(1000)) ПОДОБНО &ПаспортПолный
		|				ИЛИ ДоговорыКонтрагентов.Владелец.ДокументУдостоверяющийЛичность ПОДОБНО &ПаспортПолный 
		|				ИЛИ (
		|					ДоговорыКонтрагентов.Владелец.ДокументУдостоверяющийЛичность ПОДОБНО &ПаспортНомер 
		|					И ДоговорыКонтрагентов.Владелец.ДокументУдостоверяющийЛичность ПОДОБНО &ПаспортДата
		|					)
		|				ИЛИ (
		|					ДоговорыКонтрагентов.Владелец.НаименованиеПолное ПОДОБНО &ФИОЗаказчика 
		|					)
		|				))
		|	)
		|	И ДоговорыКонтрагентов.Номер ПОДОБНО &ДоговорКонтрагентаПрефикс И ДоговорыКонтрагентов.Номер ПОДОБНО &ДоговорКонтрагентаНомер
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора 
		|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления";
	Если Заказчик.Свойство("u_kpp") Тогда 
		Если СтрДлина(СокрЛП(Заказчик.u_kpp))>0 Тогда 
				Запрос.УстановитьПараметр("КПП", Заказчик.u_kpp);	
				ТекстЗапроса = ТекстЗапроса + "
		|	И ДоговорыКонтрагентов.Владелец.КПП = &КПП ";
		КонецЕсли; 
	КонецЕсли;                                
	ТекстЗапроса = ТекстЗапроса + "
		|УПОРЯДОЧИТЬ ПО Колво.КолвоДоговор УБЫВ, ДоговорыКонтрагентов.Владелец.Код ВОЗР 
		|";
	Запрос.Текст = ТекстЗапроса;       

	

	МасНом = СтрРазделить(СтрЗаменить(СокрЛП(Заявка.id_internal),"-"," ")," ",Ложь);
	Префикс = СтрФальш();
	Номер = СтрФальш();
	Если МасНом.Количество()>0 Тогда Префикс = СокрЛП(МасНом[0]); КонецЕсли;
	Если МасНом.Количество()>=1 Тогда Номер = СокрЛП(МасНом[1]); КонецЕсли;		
	СтрокаНомера1 = "%"+СокрЛП(Префикс)+"[ -]%";
	СтрокаНомера2 = "%[- ]"+СокрЛП(Номер)+"";
	Запрос.УстановитьПараметр("ДоговорКонтрагентаПрефикс", СтрокаНомера1);		
	Запрос.УстановитьПараметр("ДоговорКонтрагентаНомер", СтрокаНомера2);		
	
	Запрос.УстановитьПараметр("ВидДоговора",ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораКлиент"));
	ИНН = СтрФальш();
	ИНН_Деф = ИНН;
	Если Заказчик.Свойство("u_inn") Тогда Если СтрДлина(Заказчик.u_inn)>0 Тогда ИНН = СокрЛП(Заказчик.u_inn); КонецЕсли; КонецЕсли;
	Запрос.УстановитьПараметр("ИНН", ИНН);	
	Запрос.УстановитьПараметр("ИНН_Деф", ИНН_Деф);	
	
	ПаспЗАказчик = СтрФальш(); 
	Если Заказчик.Свойство("u_passport_number") Тогда Если СтрДлина(Заказчик.u_passport_number)>0 Тогда ПаспЗАказчик = Заказчик.u_passport_number; КонецЕсли; КонецЕсли;
	Запрос.УстановитьПараметр("ПаспортПолный", "%"+ПаспЗАказчик+"%");
	Запрос.УстановитьПараметр("ПаспортНомер", "%"+Прав(ПаспЗАказчик,6)+"%");
	
	ПаспДатаЗаказчик = СтрФальш(); 
	Если Заказчик.Свойство("u_passport_date") Тогда Если СтрДлина(Заказчик.u_passport_date)>0 Тогда ПаспДатаЗаказчик = ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заказчик.u_passport_date); КонецЕсли; КонецЕсли;
	Запрос.УстановитьПараметр("ПаспортДата", "%"+ПаспДатаЗаказчик+"%");
	
	ФИОЗаказчика = "";
	Если Заказчик.Свойство("u_surname") Тогда Если СтрДлина(Заказчик.u_surname)>0 Тогда ФИОЗаказчика = ФИОЗаказчика + " "+Заказчик.u_surname; КонецЕсли; КонецЕсли;
	Если Заказчик.Свойство("u_name") Тогда Если СтрДлина(Заказчик.u_name)>0 Тогда ФИОЗаказчика = ФИОЗаказчика + " "+Заказчик.u_name; КонецЕсли; КонецЕсли;
	Если Заказчик.Свойство("u_sname") Тогда Если СтрДлина(Заказчик.u_sname)>0 Тогда ФИОЗаказчика = ФИОЗаказчика + " "+Заказчик.u_sname; КонецЕсли; КонецЕсли;
	
	Пока СтрНайти(ФИОЗаказчика,"  ") Цикл 
		ФИОЗаказчика = СтрЗаменить(ФИОЗаказчика,"  "," ");		
	КонецЦикла;
	
	ФИОЗаказчика = СокрЛП(ФИОЗаказчика);
	Если СтрДлина(СокрЛП(ФИОЗаказчика))>0 Тогда
		ФИОЗаказчика = СтрЗаменить(ФИОЗаказчика," ","%");
	    ФИОЗаказчика = "%"+ФИОЗаказчика+"%";
	Иначе
		ФИОЗаказчика = СтрФальш();
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ФИОЗаказчика", ФИОЗаказчика);
	НайденКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл 
		НайденКонтрагент = Результат.Контрагент;
		Прервать;
	КонецЦикла;
	
	Если НайденКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		НайденКонтрагент = СоздатьЗаказчикаПоЗаявке(Заявка);
	КонецЕсли;
	
	Возврат НайденКонтрагент;
КонецФункции


//ПолучитьКонтрагентаПоДоговору(Договор)
//возвращает владельца договора, мелочь а приятно
//оставлено для совместимости, ранее был другой алгоритм
&НаСервере
Функция ПолучитьКонтрагентаПоДоговору(Договор)
	Возврат Договор.Владелец;
КонецФункции

//ПолучитьНоменклатуруПоУслуге(Услуга,Создавать = Ложь) Экспорт
//Услуга - по присланной структуре услуи получает номенклатуру в справочнике 1С
&НаСервере
Функция ПолучитьНоменклатуруПоУслуге(Услуга,Создавать = Ложь) Экспорт
	//Поиск номенклатуры по наименованию
	НайденНоменклатура = Справочники.Номенклатура.ПустаяСсылка();	
	Запрос = Новый Запрос(" 
			|ВЫБРАТЬ 
			|	Ссылка, 
			|	Наименование
			|ИЗ 
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Наименование ПОДОБНО &Наименование
			|"); 
	Запрос.УстановитьПараметр("Наименование", "%"+СокрЛП(Услуга)+"%");			
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл 
		НайденНоменклатура = Результат.Ссылка;
		Прервать;
	КонецЦикла;  
	Если Создавать И  НайденНоменклатура.Пустая() Тогда
		НайденНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
		НайденНоменклатура.Наименование = Услуга;
		НайденНоменклатура.Записать();
	КонецЕсли;		
	Возврат НайденНоменклатура;
КонецФункции

//СоздатьДоговорТуроператора(Заявка) Экспорт
//по присланной структуре заявки создает договор за ТО (поиск ТО по ИНН)
&НаСервере
Функция СоздатьДоговорТуроператора(Заявка,ИНН) Экспорт
	//Получаем заявку
	//Заявка = ЭТ_ОбщийМодуль2.Request(Новый Структура("id",КодЗаявки));
	Туроператор = ЭТ_ОбщийМодуль2.Supplier(Новый Структура("id",Заявка.supplier_id));
	Исполнитель = ЭТ_ОбщийМодуль2.Supplier(Новый Структура("inn",ИНН));
	//Контрагент = ПолучитьКонтрагента_1С(Исполнитель[0],Истина);
	Контрагент = ПолучитьКонтрагента_1С(Исполнитель,Истина);
	КаталогПартнеров = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПартнеров", Неопределено);          
	Исполнитель = Справочники.Контрагенты.ПустаяСсылка();
	
	//нужно искать инн исполнителя ТО по заявке
	МояОрганизация = ПолучитьНастройку("Организация",Справочники.Организации.ПустаяСсылка());
	//Если (Исполнитель.Родитель <> КаталогПартнеров) ИЛИ Исполнитель.ИНН =  МояОрганизация.ИНН Тогда
	Если ?(Туроператор.Свойство("inn"),Туроператор.inn,"###") =  МояОрганизация.ИНН Тогда
		ВидДоговораТО = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораПоставщик",Перечисления.ВидыДоговоровКонтрагентов.ПустаяСсылка());          	
	Иначе
		ВидДоговораТО = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораТО",Перечисления.ВидыДоговоровКонтрагентов.ПустаяСсылка());
	КонецЕсли;
	
	ВидДоговораКлиент = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораКлиент",Перечисления.ВидыДоговоровКонтрагентов.ПустаяСсылка());
	Запрос = Новый Запрос(" 
		|ВЫБРАТЬ 
		|	Ссылка, 
		|	Наименование
		|ИЗ 
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Контрагент
		|	И (
		|		ДоговорыКонтрагентов.Номер = &НомерЗаявки
		|		ИЛИ ДоговорыКонтрагентов.Наименование ПОДОБНО &НомерЗаявкиЧасть
		|	)
		|   И ДоговорыКонтрагентов.Владелец.ИНН = &ИНН
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
		|");
	Запрос.УстановитьПараметр("Контрагент", Контрагент.Ссылка);	
	Запрос.УстановитьПараметр("НомерЗаявки", СокрЛП(Заявка.id_internal));
	Запрос.УстановитьПараметр("НомерЗаявкиЧасть", "%"+СокрЛП(Заявка.id_internal)+"%");
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговораТО);
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Результат = Запрос.Выполнить().Выбрать();
	НайденДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Пока Результат.Следующий() Цикл 
		НайденДоговор = Результат.Ссылка;
		Прервать;
	КонецЦикла;  
	
	Если НайденДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда
		НомерБрони = УдалитьДатуИзСтроки(ПолучитьНомерБрони(Заявка.reservation_number));
		НайденДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НайденДоговор.Владелец = Контрагент.Ссылка;
		НайденДоговор.Организация = ПолучитьНастройку("Организация",Справочники.Организации.ПустаяСсылка());
		НайденДоговор.Номер = НомерБрони;
		//НайденДоговор.Дата = Дата(ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(Заявка.dat));
		ДатаЗ = Заявка.dat;
		НайденДоговор.Дата = ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВДату(ДатаЗ);
		ДатаЗ = Заявка.dat;
		НайденДоговор.Наименование = НомерБрони + "("+УдалитьДатуИзСтроки(СокрЛП(Заявка.id_internal))+")"; //СокрЛП(Заявка.id_internal)+" от "+ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(ДатаЗ);
		НайденДоговор.ВидДоговора = ВидДоговораТО;
		НайденДоговор.ВалютаВзаиморасчетов = ПолучитьНастройку("ВалютаДокументов1С",Справочники.Валюты.ПустаяСсылка());
		//Справочники.Валюты.НайтиПоКоду(ПолучитьНастройку("ВалютаДокументов",1)).Ссылка;
		Организация = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Организация");
		НайденДоговор.Организация = Организация;
		ДатаЗ = Заявка.date_begin;
		НайденДоговор.ДатаНачала =  ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВДату(ДатаЗ);
		НайденДоговор.Записать();
	КонецЕсли;
	Возврат НайденДоговор.Ссылка;
КонецФункции

//ПолучитьДоговорПокупателя(Заявка,Создавать=Ложь) Экспорт
//по присланной структуре заявки получает договор покупателя
&НаСервере
Функция ПолучитьДоговорПокупателя(Заявка,Создавать=Ложь) Экспорт
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	
	Если Заявка.Свойство("ДокументИсточник") и ЭТ_ОбщийМодуль2.ПолучитьНастройку("КлиентыПриоритетЗаказчикаВПлатеже")=1 Тогда		
		Если НЕ Заявка.ДокументИсточник.Метаданные().Реквизиты.Найти("Контрагент") = Неопределено Тогда
			Контрагент = Заявка.ДокументИсточник.Контрагент;
		КонецЕсли;
	КонецЕсли;
	Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		Контрагент = ПолучитьЗаказчикаПоЗаявке(Заявка,Создавать);
	КонецЕсли;
	
	Запрос = Новый Запрос(" 
		|ВЫБРАТЬ 
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка, 
		|	ДоговорыКонтрагентов.Наименование КАК Наименование 
		|ИЗ 
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец.Ссылка = &Контрагент
		|	И ДоговорыКонтрагентов.Номер ПОДОБНО &ДоговорКонтрагентаПрефикс И ДоговорыКонтрагентов.Номер ПОДОБНО &ДоговорКонтрагентаНомер
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора 
		|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления				
		|УПОРЯДОЧИТЬ ПО ДоговорыКонтрагентов.Владелец.Код ВОЗР 
		|"); 
	
		МасНом = СтрРазделить(СтрЗаменить(СокрЛП(Заявка.id_internal),"-"," ")," ",Ложь);
		Префикс = СтрФальш();
		Номер = СтрФальш();
		Если МасНом.Количество()>0 Тогда Префикс = СокрЛП(МасНом[0]); КонецЕсли;
		Если МасНом.Количество()>=1 Тогда Номер = СокрЛП(МасНом[1]); КонецЕсли;
		СтрокаНомера1 = "%"+СокрЛП(Префикс)+"[ -]%";
		СтрокаНомера2 = "%[- ]"+СокрЛП(Номер)+"%";
		Запрос.УстановитьПараметр("Контрагент", Контрагент.Ссылка);	
		Запрос.УстановитьПараметр("ДоговорКонтрагентаПрефикс", СтрокаНомера1);		
		Запрос.УстановитьПараметр("ДоговорКонтрагентаНомер", СтрокаНомера2);		
		Запрос.УстановитьПараметр("ВидДоговора",ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораКлиент"));
		Результат = Запрос.Выполнить().Выбрать();
		НайденДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		Пока Результат.Следующий() Цикл 
			НайденДоговор = Результат.Ссылка;
			Прервать;
		КонецЦикла;  
		Если НайденДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() И Создавать=Истина Тогда
			НайденДоговор = ЭТ_ОбщийМодуль2.СоздатьДоговорПокупателя(Заявка);
		КонецЕсли;
		Возврат НайденДоговор.Ссылка;
КонецФункции

//ПолучитьДоговорТуроператора(Заявка) Экспорт
//по структуре данных Заявка получает договор ТО
&НаСервере
Функция ПолучитьДоговорТуроператора(Заявка) Экспорт
	КВозврату = Новый Массив;
	//Собираем все возможные ИНН по заявке из самой заявки + услуги в заявке + платежи по заявке
	//платежи по заявке будем собирать по номеру заявки (в цикле), а так же по номеру брони в заявке
	// - получаем ИНН из Заявки
	МасИНН = Новый Массив;
	Если Заявка.Свойство("supplier_inn") Тогда
		Если СтрДлина(СокрЛП(Заявка.supplier_inn))>0 Тогда
			МасИНН.Добавить(Заявка.supplier_inn);
		КонецЕсли;		
	КонецЕсли;
	Для Каждого СледУслуга Из Заявка.services Цикл
		Если СледУслуга.Свойство("partner_inn") Тогда
			Если СтрДлина(СокрЛП(СледУслуга.partner_inn))>0 Тогда
				МасИНН.Добавить(СледУслуга.partner_inn);
			КонецЕсли;		
		КонецЕсли;
	КонецЦикла;
	МасНом = СтрРазделить(СтрЗаменить(СокрЛП(Заявка.id_internal),"-"," ")," ",Ложь);
	Префикс = СтрФальш();
	Номер = СтрФальш();
	Если МасНом.Количество()>0 Тогда Префикс = СокрЛП(МасНом[0]); КонецЕсли;
	Если МасНом.Количество()>=1 Тогда Номер = СокрЛП(МасНом[1]); КонецЕсли;
	НомерДляПоиска = "%(%"+Префикс+"[ -][- ]"+Номер+"%)%";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписаниеСРасчетногоСчета.ДоговорКонтрагента.Владелец.ИНН КАК ДоговорКонтрагентаВладелецИНН,
		|	СписаниеСРасчетногоСчета.ДоговорКонтрагента.Номер КАК ДоговорКонтрагентаНомер,
		|	СписаниеСРасчетногоСчета.ДоговорКонтрагента.Наименование КАК ДоговорКонтрагентаНаименование,
		|	СписаниеСРасчетногоСчета.ДоговорКонтрагента.Ссылка КАК ДоговорКонтрагентаСсылка
		|ИЗ
		|	Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
		|ГДЕ
		|	(
		|		(
		|			СписаниеСРасчетногоСчета.ДоговорКонтрагента.Наименование ПОДОБНО &ДоговорКонтрагентаПрефикс 
		|			И СписаниеСРасчетногоСчета.ДоговорКонтрагента.Наименование ПОДОБНО &ДоговорКонтрагентаНомер
		|		)
		|		ИЛИ (СписаниеСРасчетногоСчета.ДоговорКонтрагента.Наименование ПОДОБНО &ДоговорКонтрагентаБронь)
		|		ИЛИ (СписаниеСРасчетногоСчета.Комментарий ПОДОБНО &ДоговорКонтрагентаБронь)
		|	)
		|	И СписаниеСРасчетногоСчета.ДоговорКонтрагента.ВидДоговора В (&ВидДоговора,&ВидДоговораПоставщик)
		|";
	
	СтрокаНомера1 = "%"+СокрЛП(Префикс)+"[ -]%";
	СтрокаНомера2 = "%[- ]"+СокрЛП(Номер)+"%";
		
	Запрос.УстановитьПараметр("ДоговорКонтрагентаПрефикс", СтрокаНомера1);		
	Запрос.УстановитьПараметр("ДоговорКонтрагентаНомер", СтрокаНомера2);		
	
	Запрос.УстановитьПараметр("ВидДоговора",ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораТО"));
	Запрос.УстановитьПараметр("ВидДоговораПоставщик",ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораПоставщик"));
	ДоговорКонтрагентаБронь = ЭТ_ОбщийМодуль2.УдалитьДатуИзСтроки(ЭТ_ОбщийМодуль2.ПолучитьНомерБрони(Заявка.reservation_number));
	Если ДоговорКонтрагентаБронь = "" Тогда ДоговорКонтрагентаБронь=СтрФальш(); КонецЕсли;
	Запрос.УстановитьПараметр("ДоговорКонтрагентаБронь", ДоговорКонтрагентаБронь);		
	РезультатЗапроса = Запрос.Выполнить();
	СледДоговор = РезультатЗапроса.Выбрать();
	СписокДоговоров = Новый Массив;
	Пока СледДоговор.Следующий() Цикл
		
		ДогСтрока = ВырезатьИзСтроки(СледДоговор.ДоговорКонтрагентаНаименование, "(", ")");
		Если ДогСтрока.Количество() > 0 Тогда
			ДогСтрока = ДогСтрока[0];
		Иначе
			ДогСтрока = "";
		КонецЕсли;
		
		НаименованиеДоговораБезПробелов = ВРег(СтрЗаменить(СокрЛП(СледДоговор.ДоговорКонтрагентаНаименование), " ", ""));
		ИскомыйИДВнутренний = ВРег(СтрЗаменить(СокрЛП(Заявка.id_internal), " ", ""));
		ИскомыйНомерБрони = ВРег(СтрЗаменить(
			СокрЛП(ЭТ_ОбщийМодуль2.УдалитьДатуИзСтроки(ЭТ_ОбщийМодуль2.ПолучитьНомерБрони(Заявка.reservation_number))),
			" ",
			""));
		
		ИскомыйПрефиксНомер = ВРег(СтрЗаменить(СокрЛП(Префикс), " ", "") + "-" + СтрЗаменить(СокрЛП(Номер), " ", ""));
		
		СовпалоПоСкобкам = Ложь;
		Если СтрДлина(СокрЛП(ДогСтрока)) > 0 Тогда
			СовпалоПоСкобкам = ВРег(СтрЗаменить(ДогСтрока, " ", "")) = ИскомыйИДВнутренний;
		КонецЕсли;
		
		СовпалоПоНомеруДоговора = Ложь;
		Если СтрДлина(СокрЛП(СледДоговор.ДоговорКонтрагентаНомер)) > 0 Тогда
			СовпалоПоНомеруДоговора = 
				ВРег(СтрЗаменить(СледДоговор.ДоговорКонтрагентаНомер, " ", "")) = ИскомыйНомерБрони;
		КонецЕсли;
		
		СовпалоПоПрефиксНомерВНаименовании = Ложь;
		Если СтрДлина(СокрЛП(Префикс)) > 0 И СтрДлина(СокрЛП(Номер)) > 0 Тогда
			СовпалоПоПрефиксНомерВНаименовании = 
				СтрНайти(НаименованиеДоговораБезПробелов, ИскомыйПрефиксНомер) > 0;
		КонецЕсли;
		
		Если СовпалоПоСкобкам
			ИЛИ СовпалоПоНомеруДоговора
			ИЛИ СовпалоПоПрефиксНомерВНаименовании
		Тогда
			МасИНН.Добавить(СледДоговор.ДоговорКонтрагентаВладелецИНН);
			СписокДоговоров.Добавить(СледДоговор.ДоговорКонтрагентаСсылка.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	МасИНН = ЭТ_ОбщийМодуль2.УдалитьДублиИзМассива(МасИНН);
	Запрос = Новый Запрос(" 
		|ВЫБРАТЬ 
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка, 
		|	ДоговорыКонтрагентов.Наименование КАК Наименование 
		|ИЗ 
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец.ИНН В (&ИНН)
		|	И (
		|		ДоговорыКонтрагентов.Номер ПОДОБНО &ДоговорКонтрагентаНомер
		|		ИЛИ ДоговорыКонтрагентов.Наименование ПОДОБНО &ДоговорКонтрагентаНомер
		|		ИЛИ (ДоговорыКонтрагентов.Номер ПОДОБНО &ДоговорКонтрагентаБронь)
		|		ИЛИ ДоговорыКонтрагентов.Ссылка В (&СписокДоговоров)
		|	  )
		|	И ДоговорыКонтрагентов.ВидДоговора В (&ВидДоговора,&ВидДоговораПоставщик)
		|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления				
		|"); 
	ДоговорКонтрагентаБронь = ЭТ_ОбщийМодуль2.УдалитьДатуИзСтроки(ЭТ_ОбщийМодуль2.ПолучитьНомерБрони(Заявка.reservation_number));
	Если ДоговорКонтрагентаБронь = "" Тогда ДоговорКонтрагентаБронь=СтрФальш(); КонецЕсли;
	Запрос.УстановитьПараметр("ДоговорКонтрагентаБронь", ДоговорКонтрагентаБронь);		
	Запрос.УстановитьПараметр("ДоговорКонтрагентаНомер", НомерДляПоиска);		
	Запрос.УстановитьПараметр("ИНН", МасИНН);	
	Запрос.УстановитьПараметр("ВидДоговора",ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораТО"));
	Запрос.УстановитьПараметр("ВидДоговораПоставщик",ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораПоставщик"));
	Запрос.УстановитьПараметр("СписокДоговоров",СписокДоговоров);
	Результат = Запрос.Выполнить().Выбрать();
	НайденДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Пока Результат.Следующий() Цикл 
		МассивНомеров = Новый Массив;
		СПНомер = ВырезатьИзСтроки(Результат.Наименование,"(",")");
		ШаблонНомера = ЭТ_ОбщийМодуль2.ПолучитьШаблонПоискаЗаявки(ЭТ_ОбщийМодуль2.УдалитьДатуИзСтроки(Результат.Наименование));
		Если СтрДлина(СокрЛП(ШаблонНомера.Префикс))>0 И СтрДлина(СокрЛП(ШаблонНомера.Номер))>0 Тогда
			МассивНомеров.Добавить(ВРег(ШаблонНомера.Префикс + ШаблонНомера.Номер));
		КонецЕсли;		
		Для Каждого СледМассивНомеров Из СПНомер Цикл
			МассивНомеров.Добавить(ВРег(СтрЗаменить(СледМассивНомеров," ","")));
		КонецЦикла;
		МассивНомеров = ЭТ_ОбщийМодуль2.УдалитьДублиИзМассива(МассивНомеров);
		Если ЭТ_ОбщийМодуль2.ЕстьВМассиве(МассивНомеров,Заявка.id_internal,истина) Тогда
			КВозврату.Добавить(Результат.Ссылка.Ссылка);
		КонецЕсли;
	КонецЦикла;  
	//КонецЦикла;  
	Возврат КВозврату;
КонецФункции

//СоздатьДоговорПокупателя(Заявка) Экспорт
//по структуре данных заявки создает договор с покупетелем, если договор уже существует, то возвращает его ссылку
&НаСервере
Функция СоздатьДоговорПокупателя(Заявка) Экспорт
	//Получаем заявку	
	//Заявка = ЭТ_ОбщийМодуль2.Request(Новый Структура("id",КодЗаявки));
	Заказчик = ЭТ_ОбщийМодуль2.User(Новый Структура("id",Заявка.client_id));
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Если Заявка.Свойство("ДокументИсточник") и ЭТ_ОбщийМодуль2.ПолучитьНастройку("КлиентыПриоритетЗаказчикаВПлатеже")=1 Тогда		
		Если НЕ Заявка.ДокументИсточник.Метаданные().Реквизиты.Найти("Контрагент") = Неопределено Тогда
			Контрагент = Заявка.ДокументИсточник.Контрагент;
		КонецЕсли;
	КонецЕсли;
	Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		Контрагент = ПолучитьЗаказчикаПоЗаявке(Заявка);
	КонецЕсли;
	Запрос = Новый Запрос(" 
		|ВЫБРАТЬ 
		|	Ссылка, 
		|	Наименование
		|ИЗ 
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Контрагент
		|	И ДоговорыКонтрагентов.Наименование ПОДОБНО &НомерЗаявкиШаблон
		|");                    
	ШаблонПоиска = ЭТ_ОбщийМодуль2.ПолучитьШаблонПоискаЗаявки(Заявка.id_internal);
	Запрос.УстановитьПараметр("Контрагент", Контрагент.Ссылка);	
	Запрос.УстановитьПараметр("НомерЗаявкиШаблон", "%"+ШаблонПоиска.ПрефиксПоиск+"%"+ШаблонПоиска.Номер+"%");	
	Результат = Запрос.Выполнить().Выбрать();
	НайденДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Пока Результат.Следующий() Цикл
		Если СтрЗаменить(ВРег(СокрЛП(Результат.Ссылка.Номер))," ","") = СтрЗаменить(ВРег(СокрЛП(Заявка.id_internal))," ","") Тогда		
			НайденДоговор = Результат.Ссылка;
			Прервать;
		КонецЕсли;		
	КонецЦикла;  	
	Если НайденДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда    
		ШаблонПоиска = ЭТ_ОбщийМодуль2.ПолучитьШаблонПоискаЗаявки(Заявка.id_internal);
		НайденДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();		
		НайденДоговор.Владелец = Контрагент.Ссылка;
		НайденДоговор.Номер = ШаблонПоиска.ПрефиксПоиск+"-"+ШаблонПоиска.Номер; //СокрЛП(Заявка.id_internal);
		ДатаЗ = Заявка.dat;
		НайденДоговор.Дата = ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВДату(ДатаЗ);
		ДатаЗ = Заявка.dat;
		НайденДоговор.Наименование = СокрЛП(Заявка.id_internal)+" от "+ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВСтроку(ДатаЗ);
		Организация = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Организация");
		НайденДоговор.Организация = Организация;
		ВидДоговора = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораКлиент");
		НайденДоговор.ВидДоговора = ВидДоговора;
		НайденДоговор.ВалютаВзаиморасчетов = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВалютаДокументов1С");
		ДатаЗ = Заявка.date_begin;
		НайденДоговор.ДатаНачала =  ЭТ_ОбщийМодуль2.КонвертацияДатыИзЮниксВДату(ДатаЗ);		
		НайденДоговор.Записать();
	КонецЕсли;
	Возврат НайденДоговор.Ссылка;
КонецФункции

//ИмеютсяДействующиеСсылки(МассивСсылокНаОбъект) Экспорт
//проверяет присланный МассивСсылокНаОбъект на предмет действительности
//если среди присланного массива есть действующие (не удаленные) ссылки, то вернет Истина, иначе Ложь
&НаСервере
Функция ИмеютсяДействующиеСсылки(МассивСсылокНаОбъект) Экспорт
	ТабСсылок = НайтиПоСсылкам(МассивСсылокНаОбъект);
	Для Каждого Ссылка из ТабСсылок Цикл
		Если (Не ЕстьВМассиве(МассивСсылокНаОбъект,Ссылка.Данные)) И (Ссылка.Данные.ПометкаУдаления = Ложь)  Тогда
			Возврат Истина;
			Прервать;				   
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

