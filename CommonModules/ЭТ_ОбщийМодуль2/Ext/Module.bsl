//Status(ПараметрыДата)
//https://api.u-on.ru/{key}/status.{_format} Получение списка статусов / Get list of statuses
&НаСервере
Функция GetStatus(ПараметрыДата) Экспорт
		//id	[0-9]+	integer	ID партнера / ID
		Если НЕ ПараметрыДата.Свойство("id") Тогда Возврат Новый Структура; КонецЕсли;
		Если ПараметрыДата.id<1 Тогда Возврат Новый Структура; КонецЕсли;             
		СписокСтатусов = ВременноеХранилище_Получить("GetStatus","ПолныйНаборДанных",Неопределено,1200);
		Если СписокСтатусов = Неопределено Тогда 
			СтрокаЗапроса = "/status";
			КВозврату = ЭТ_СоединениеЮОН.ОпроавитьГетЗапрос(СтрокаЗапроса);
			Если КВозврату.Свойство("records") Тогда
				Если КВозврату.records.Количество()>0 Тогда
					ВременноеХранилище_Поместить("GetStatus","ПолныйНаборДанных",КВозврату.records);
					СписокСтатусов = КВозврату.records;
				КонецЕсли;
			КонецЕсли;			
		КонецЕсли;	  
		Если СписокСтатусов = Неопределено Тогда Возврат Новый Структура; КонецЕсли;
		Для Каждого СледСтатус Из ?(СписокСтатусов=Неопределено,Новый Структура,СписокСтатусов) Цикл
			Если СледСтатус.id = ПараметрыДата.id Тогда
				Возврат СледСтатус;
			КонецЕсли;					
		КонецЦикла;
		Возврат Новый Структура;
КонецФункции

