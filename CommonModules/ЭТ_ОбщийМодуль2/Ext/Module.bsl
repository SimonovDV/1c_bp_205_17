Функция PaymentCreate(ПараметрыДата) Экспорт
//r_id	integer	true		ID заявки (см.метод /request/{id}) / ID of the application (see method /request/{id})
//type_id	integer	true		Тип платежа (1 - расчеты с клиентами, 2 - расчеты с партнерами) / Payment type (1 - accounts receivable 2 - accounts with partners)
//cio_id	integer	true		Вид платежа (1 - приход, 2 - расход) / Type of payment (1 arrival, 2 - expense)
//reason	string	false		Основание платежа / Basis of payment
//date	datetime	false		Дата платежа, формат: Y-m-d H:i:s, по-умолчанию, ставится текущая дата / Payment date, format: Y-m-d H:i:s, default is the current date
//is_plan	integer	false		Плановый платеж (1 - да, 0 - нет) / Scheduled payment (1 - Yes, 0 - no)
//is_bonus_pay	integer	false		Оплата бонусами (1 - да, 0 - нет) / Payment by bonuses (1 - Yes, 0 - no)
//is_deposit	integer	false		Депозитная операция? (1 - да, 0 - нет), по-умолчанию = 0 / Deposit payment? (1 - Yes, 0 - no), default = 0
//date_plan	datetime	false		Плановая дата платежа, формат: Y-m-d H:i:s / Scheduled payment date, format: Y-m-d H:i:s
//from1c	integer	false		Платеж создан в CRM (= 0) или пришел из 1С (= 1) / The payment is created in CRM (= 0) or 1C (= 1)
//supplier_id	integer	false		ID партнера / туроператора (см.метод /supplier) / ID of the partner / tour operator (see method /supplier)
//client_id	integer	false		ID заказчика (см.метод /user) / ID of client (see method /user)
//cash_id	integer	false		ID кассы (см.метод /cash), по-умолчанию, берется первая касса / ID cash (see method /cash), by default, takes the first cash
//number	string	false		Номер платежа (по-умолчанию, берется следующий порядковый номер) / Payment number (by default, it takes the next sequence number)
//currency_id	integer	false		ID валюты (см.метод /currency) / The currency ID (see method /currency)
//koef	float	false		Курс валюты (по-умолчанию, 1.00) / Currency (default: 1.00)
//price	float	false		Стоимость клиенту / The cost to the client
//note	string	false		Примечание по платежу / Note on payment		
		СписокКлючей = Новый СписокЗначений;
		СписокКлючей = СоздатьСписокКлючей("r_id type_id cio_id reason date is_plan is_bonus_pay is_deposit date_plan from1c supplier_id client_id cash_id number currency_id koef price note");
		СтруктураПараметров = Новый Структура;
		Для Каждого Ключ Из СписокКлючей Цикл
