			Сообщить("Модуль работает в тестовом режиме, операция [RequestUpdate] невыполнена! Передаваемые ПараметрыДата ["+СокрЛП(Формат(ПараметрыДата.id,"ЧГ=0;"))+"]:"); 
			Для Каждого Парам Из СтруктураПараметров Цикл
				Сообщить(Парам);
			КонецЦикла;
			
			Возврат Новый Структура; 
		КонецЕсли;		
		КВозврату = ЭТ_СоединениеЮОН.ОпроавитьПостЗапрос("/request/update/"+СокрЛП(Формат(ПараметрыДата.id,"ЧГ=0;")),СтруктураПараметров);
		
		//КВозврату = ОпроавитьПостЗапрос("/request/update/"+СокрЛП(Строка(id)),СтруктураПараметров);
		Возврат КВозврату;
КонецФункции

//Request(ПараметрыДата) Экспорт
//https://api.u-on.ru/{key}/request/{id}.{_format} Получение данных заявки / Get request data
&НаСервере
Функция Request(ПараметрыДата) Экспорт
		//id	[0-9]+	integer	ID заявки / ID request
		Если НЕ ПараметрыДата.Свойство("id") Тогда Возврат Новый Структура; КонецЕсли;
		Если Число(ПараметрыДата.id)<1 Тогда Возврат Новый Структура; КонецЕсли;
		СтрокаЗапроса = "/request/"+СокрЛП(Формат(ПараметрыДата.id,"ЧГ=0;"));		
		КВозврату = ЭТ_СоединениеЮОН.ОпроавитьГетЗапрос(СтрокаЗапроса);			
		Если КВозврату.Свойство("request") Тогда
			Если КВозврату.request.Количество()>0 Тогда
				Возврат КВозврату.request;
			КонецЕсли;
		КонецЕсли;
		Возврат Новый Структура;
КонецФункции

