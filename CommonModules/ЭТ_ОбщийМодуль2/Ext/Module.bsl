// ===== Работа c объектами 1С

//ДобавитьКомиссиюВРасходы(ДокументОснование) Экспорт
//в СБ создает расходный документ где контрагент банк, а сумма это комиссия банка
&НаСервере
Функция ДобавитьКомиссиюВРасходы(ДокументОснование) Экспорт
	ОтличноеПроведение = Ложь;
	МассивОбхода = Новый Массив;
	ВариантыНомера = ПолучитьВариантыНомера(ПолучитьКодИзСтроки(ДокументОснование.ДоговорКонтрагента.Наименование,ПолучитьНастройку("Префикс")));		
	Для Каждого ВариантНомера Из ВариантыНомера Цикл
		Парам = Новый Структура;
		Парам.Вставить("r_id_internal",ВариантНомера);	
		МассивДанных = ЭТ_ОбщийМодуль2.RequestSearch(Парам);
		Для Каждого СледЭлемент Из МассивДанных Цикл
			Если (НЕ ЕстьВМассиве(МассивОбхода,СледЭлемент.id)) Тогда
				МассивОбхода.Добавить(СледЭлемент.id);
				ТекЗаявка = ЭТ_ОбщийМодуль2.Request(Новый Структура("id",СледЭлемент.id));
				Для Каждого СледТекЗаявка Из ТекЗаявка Цикл
					//проверка на наличие документа в СБ
					Для Каждого СледПлатежка Из СледТекЗаявка.payments Цикл
						ТекСледПлатежка = ЭТ_ОбщийМодуль2.Payment(Новый Структура("id",СледПлатежка.id));
						Если							
							(
								(СокрЛП(ВРег(Строка(СледПлатежка.number))) = СокрЛП(ВРег(Строка(ДокументОснование.Номер))))
								ИЛИ (СтрНайти(СледПлатежка.reason, ДокументОснование.Номер)>0 И СледПлатежка.price = ДокументОснование.СуммаДокумента)
							  ) И ТекСледПлатежка.cio_id = 2 И ТекСледПлатежка.type_id = 2
						Тогда
							//получаем режимы работы
							Если НЕ ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТестовыйРежим",Ложь) Тогда										
								ЭТ_ОбщийМодуль2.PaymentDelete(Новый Структура("id",СледПлатежка.id));
							Иначе
								Сообщить("Модуль работает в тестовом режиме, вызвано событие удаления списания клиента "+ДокументОснование.Номер+", в тестовом режиме удаление не производится!");
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					
					
					
					
					КассаРасчета = ОпределитьКассуРасчета(ДокументОснование.ВидОплаты,Неопределено);
					ВалютаДокументов = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВалютаДокументов");
					Если ВалютаДокументов = Неопределено Тогда ВалютаДокументов = 1; КонецЕсли;
					//определяем партнера
					ПоискПартнерПоЗаявке = ЭТ_ОбщийМодуль2.Supplier(Новый Структура("inn",СокрЛП(ДокументОснование.Эквайер.ИНН)));
					Если ПоискПартнерПоЗаявке.Количество()<1 Тогда
						ПоискПартнерПоЗаявке = ЭТ_ОбщийМодуль2.Supplier(Новый Структура("name",СокрЛП(ДокументОснование.Эквайер.Наименование)));					
					КонецЕсли;
						
					Если ПоискПартнерПоЗаявке.Количество()<1 Тогда
						Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТуроператорыЗапретСозданияВЮОН",Истина)=Ложь Тогда 
							Контакты = Новый Структура;
							Телефон = "";
							ЭлПочта = "";
							Адрес = "";
							ПартнерПоЗаявкеКод = SupplierCreate(Новый Структура("inn,name,phones,email,address,contacts,note",ДокументОснование.Эквайер.ИНН,ДокументОснование.Эквайер.Наименование,Телефон,ЭлПочта,Адрес,"",""));
						Иначе
							ПартнерПоЗаявкеКод = 0;
