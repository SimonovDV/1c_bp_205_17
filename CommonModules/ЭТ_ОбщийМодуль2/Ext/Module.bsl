//СохранитьНастройку(КлючНастроек,Настройки) Экспорт
//сохраняет настройку пользователя
&НаСервере
Процедура СохранитьНастройку(КлючНастроек,Настройки,ИмяПользователя=Неопределено) Экспорт
	КлючОбъекта  = "ЭТ";
	Если ИмяПользователя = Неопределено Тогда
    	ИмяПользователя = ИмяПользователя();
	КонецЕсли;
    ХранилищеОбщихНастроек.Сохранить(КлючОбъекта,  КлючНастроек, Настройки, , ИмяПользователя);
КонецПроцедуры

//ПолучитьНастройку(КлючНастроек,ПоУмолчанию=Неопределено) Экспорт
//получает настройку пользователя по ее ключу
&НаСервере
Функция ПолучитьНастройку(КлючНастроек,ПоУмолчанию=Неопределено,ИмяПользователя=Неопределено) Экспорт
	КлючОбъекта  = "ЭТ";
	Если ИмяПользователя = Неопределено Тогда
    	ИмяПользователя = ИмяПользователя();
	КонецЕсли;
	Настройки = ПоУмолчанию;
    Попытка
        Настройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта,КлючНастроек,,ИмяПользователя);
    Исключение
        Настройки = ПоУмолчанию;
	КонецПопытки;
	
	Если Настройки = Неопределено Тогда
		Настройки = ПоУмолчанию;
	КонецЕсли;
	Возврат Настройки;
КонецФункции

//УдалитьНастройку(КлючНастроек) - Удаляет настройку из памяти
