//POST  https://api.u-on.ru/{key}/service/create.{_format}


&НаСервере
Процедура ВременноеХранилище_Поместить(ТипОбъекта,Ключ,Значение) Экспорт
	Дат = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВременнаяТаблица",Неопределено,"Общий##");
	Если Дат = Неопределено Тогда
		Дат = Новый ТаблицаЗначений;
		Дат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
		Дат.Колонки.Добавить("ТипОбъектаЗн",Новый ОписаниеТипов("Строка"));
		Дат.Колонки.Добавить("Ключ",Новый ОписаниеТипов("Строка"));
		Дат.Колонки.Добавить("Значение");
	Иначе                   
		Для Каждого СтрокаТЧ Из Дат Цикл
			Если СтрокаТЧ.ТипОбъектаЗн = ТипОбъекта И СтрокаТЧ.Ключ = Ключ Тогда
				Дат.Удалить(СтрокаТЧ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	НовСтр = Дат.Добавить();		
	НовСтр.Дата = ТекущаяДата();
	НовСтр.ТипОбъектаЗн = ТипОбъекта;
	НовСтр.Ключ = Ключ;
	НовСтр.Значение = Значение;
	ЭТ_ОбщийМодуль2.СохранитьНастройку("ВременнаяТаблица",Дат,"Общий##");
КонецПроцедуры

