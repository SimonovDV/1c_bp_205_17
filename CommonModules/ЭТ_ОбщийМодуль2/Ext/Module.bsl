	пМин = Формат(Минута(ПараметрДата),"ЧЦ=2; ЧРД=; ЧРГ=; ЧН=00; ЧВН=; ЧГ=");
	пВремя = Прав(СокрЛП(ПараметрДата),8);	
	Возврат пГод+"-"+пМесяц+"-"+пДень+" "+пЧас+":"+пМин; 
