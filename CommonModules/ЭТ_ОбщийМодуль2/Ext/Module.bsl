//Supplier(ПараметрыДата) Экспорт
//https://api.u-on.ru/{key}/supplier/{id}.{_format} Получение партнера / Get partner data
//работает кэширование
&НаСервере
Функция Supplier(ПараметрыДата) Экспорт
		//id	[0-9]+	integer	ID партнера / ID
		ВидПоиска = "";
		
		Если ПараметрыДата.Свойство("id") И СтрДлина(СокрЛП(ВидПоиска))<1 Тогда
			Если ПараметрыДата.id>0 Тогда
				ВидПоиска = "id";
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыДата.Свойство("inn") И СтрДлина(СокрЛП(ВидПоиска))<1 Тогда
			Если СтрДлина(СокрЛП(ПараметрыДата.inn))>0 Тогда
				ВидПоиска = "inn";
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыДата.Свойство("name") И СтрДлина(СокрЛП(ВидПоиска))<1 Тогда
			Если СтрДлина(СокрЛП(ПараметрыДата.name))>0 Тогда
				ВидПоиска = "name";
			КонецЕсли;
		КонецЕсли;
		
		
		
		Если ВидПоиска = "id" Тогда
			СтрокаЗапроса = "/supplier/"+СокрЛП(Формат(ПараметрыДата.id,"ЧГ=0;"));
			КВозврату = ЭТ_СоединениеЮОН.ОпроавитьГетЗапрос(СтрокаЗапроса);			
				Если КВозврату.Количество()>0 Тогда
					Возврат КВозврату;
				КонецЕсли;
		ИначеЕсли ВидПоиска = "inn" ИЛИ ВидПоиска = "name" Тогда    
			Таб = ВременноеХранилище_Получить("Supplier","ПолныйНаборДанных",Неопределено,1200);
			Если Таб = Неопределено Тогда
				Таб = Новый ТаблицаЗначений;
				Таб.Колонки.Добавить("id");
	    		Таб.Колонки.Добавить("inn");
	    		Таб.Колонки.Добавить("name");
	    		Таб.Колонки.Добавить("data");
				следНомер = 1;
				Пока  Истина Цикл
					СледНабор = ЭТ_СоединениеЮОН.ОпроавитьГетЗапрос("/suppliers/"+СокрЛП(Строка(следНомер)));
					Если СледНабор = Ложь Тогда Прервать; КонецЕсли;
					Если СледНабор.Свойство("records") Тогда
						Если СледНабор.records.Количество()<1 Тогда Прервать; КонецЕсли
					Иначе
						Прервать; 
					КонецЕсли;
					Для Каждого СледПартнер Из СледНабор.records Цикл
						Если СледПартнер.Свойство("inn") Тогда ИНН = СледПартнер.inn; Иначе ИНН = ""; КонецЕсли;
						Если СледПартнер.Свойство("name") Тогда Наименование = СледПартнер.name; Иначе Наименование = ""; КонецЕсли;
						Стр = Таб.Добавить();
						Стр.id =  СледПартнер.id;
						Стр.inn =  ИНН;
						Стр.name =  Наименование;
						Стр.data =  СледПартнер;
					КонецЦикла;
					следНомер = следНомер +1;
				КонецЦикла;
				ВременноеХранилище_Поместить("Supplier","ПолныйНаборДанных",Таб);
			КонецЕсли;
			
			
			Отбор = Новый Структура;
    		Отбор.Вставить(ВидПоиска, ПараметрыДата[ВидПоиска]);
    		Строки = Таб.НайтиСтроки(Отбор);
    		Для Каждого Стр Из Строки Цикл
				Возврат Стр.data;
    		КонецЦикла;			
		КонецЕсли;
		Возврат Новый Структура;
КонецФункции

//SupplierCreate(ПараметрыДата) Экспорт
//https://api.u-on.ru/{key}/supplier/create.{_format} Добавление партнера / Add partne
&НаСервере
Функция SupplierCreate(ПараметрыДата) Экспорт
	//name
	//name_en
	СписокКлючей = Новый СписокЗначений;
	СписокКлючей = СоздатьСписокКлючей("name phones email address contacts note inn");
	СтруктураПараметров = Новый Структура;
	Для Каждого Ключ Из СписокКлючей Цикл
		Если ПараметрыДата.Свойство(Ключ.Значение) Тогда
			ЗначениеПараметра = ПараметрыДата[Ключ.Значение];
			СтруктураПараметров.Вставить(Ключ,ЗначениеПараметра);
		КонецЕсли;
	КонецЦикла;
	СтруктураПараметров.Вставить("type_id",ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТуроператорыТипТО"));
	
	Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТестовыйРежим",Ложь) Тогда Сообщить("Модуль работает в тестовом режиме, операция [SupplierCreate] невыполнена! "); Возврат Новый Структура; КонецЕсли;		
	КВозврату = ЭТ_СоединениеЮОН.ОпроавитьПостЗапрос("/supplier/create",СтруктураПараметров);	
	Если КВозврату>0 Тогда 	
		СписокАдресов = ПолучитьНастройку("ТуроператорыУведомленияНовыйВЮОН");
		СписокАдресов = СписокАдресов + " " + СписокАдресовЮриста() + " " + СписокАдресовАдмина();		
		Если ПолучитьНастройку("РежимАдминистратора") Тогда СписокАдресов = СписокАдресовАдмина();	КонецЕсли;
		МассивСпискаАдресов = ЭТ_ОбщийМодуль2.УдалитьДублиИзМассива(СоздатьСписокКлючей(СписокАдресов,Истина));
		Для Каждого СледАдрес Из МассивСпискаАдресов Цикл
			ТемаПисьма = "Автоматическое уведомление о создании Партнера в СБ U-ON";
			Ключи = Новый Структура;
			Ключи.Вставить("name","Наименование");
			Ключи.Вставить("inn","ИНН");
			Ключи.Вставить("phones","Телефон");
			Ключи.Вставить("email","Эл.почта");
			Ключи.Вставить("address","Адрес");
			Ключи.Вставить("contacts","Контакты");
			Ключи.Вставить("note","Примечания");			
			СтрокаДанных = "";
			Для Каждого СледКлюч Из Ключи Цикл
				Если ПараметрыДата.Свойство(СледКлюч.Ключ)	Тогда 
					СтрокаДанных = СтрокаДанных + СледКлюч.Значение + ": " + ПараметрыДата[СледКлюч.Ключ] + "
					|";
				КонецЕсли;				
			КонецЦикла;			
			ТекстПисьма = "Данное письмо создано автоматически модулем ЭТ системы 1С:Предприятие 8
			|Уведомление о сосздании нового партенера в СБ U-ON. Исходные данные:
			|"+СтрокаДанных+"
			|Письмо отправлено в адреса: "+СтрСоединить(МассивСпискаАдресов," ")+"
			|Метка времени: "+Строка(ТекущаяДата())+"
			|ЭТ_ОбщийМодуль2.SupplierCreate";
