//КорректировкаЭлПочтыКонтрагента - Сохраняет адрес эл.почты за контрагентом
Процедура КорректировкаЭлПочтыКонтрагента(Элемент,Адрес) Экспорт
	Адрес = СокрЛП(Адрес);
	СпЭлемент = Элемент.ПолучитьОбъект();
	Если СтрДлина(Адрес)>0 Тогда
		Для Каждого СледСтрока Из СпЭлемент.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид",Справочники.ВидыКонтактнойИнформации.EmailКонтрагенты)) Цикл
			СпЭлемент.КонтактнаяИнформация.Удалить(СледСтрока);
		КонецЦикла;
		СпЭлемент.Записать();
		УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(
			СпЭлемент.ЭтотОбъект,
			УправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(
				СокрЛП(Адрес),
				Справочники.ВидыКонтактнойИнформации.EmailКонтрагенты
			),
			Справочники.ВидыКонтактнойИнформации.EmailКонтрагенты,
			Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты
		);
		СпЭлемент.Записать();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьОсновнойДоговорКонтрагента(Контрагент,ВидДоговора,Организация=Ложь) Экспорт
	Если Организация=Ложь Тогда
		Организация=Справочники.Организации.ОрганизацияПоУмолчанию(ПользователиИнформационнойБазы.ТекущийПользователь());
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Запрос.Текст = "ВЫБРАТЬ
	|	ОсновныеДоговорыКонтрагента.Договор КАК Договор
	|ИЗ
	|	РегистрСведений.ОсновныеДоговорыКонтрагента КАК ОсновныеДоговорыКонтрагента
	|ГДЕ
	|	ОсновныеДоговорыКонтрагента.Организация = &Организация
	|	И ОсновныеДоговорыКонтрагента.Контрагент = &Контрагент
	|	И ОсновныеДоговорыКонтрагента.ВидДоговора = &ВидДоговора
	|";
	РезультатЗапроса  = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.Прямой);
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Договор;
	КонецЦикла;
	Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
КонецФункции


&НаСервере
Функция ПроверитьПризнакБанка(ИНН) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Родитель", ЭТ_ОбщийМодуль2.ПолучитьНастройку("ОсновныеГруппаБанков",Справочники.Контрагенты.ПустаяСсылка()));
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.Текст = "ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Контрагенты.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Родитель = &Родитель
	|	И Контрагенты.ИНН = &ИНН
	|";
	РезультатЗапроса  = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.Прямой);
	Пока Выборка.Следующий() Цикл
		Возврат ?(Выборка.Количество>0,Истина,Ложь);
	КонецЦикла;
	Возврат Ложь;
КонецФункции



//ДобавитьВозвратКлиенту(ПараметрыДата) Экспорт
//по присланным параметрам добавляет платеж клиента
&НаСервере
Функция ДобавитьВозвратКлиенту(ПараметрыДата) Экспорт
	КВозврату = 0;
	КодЗаявки = 0;
	ТекущийПрефикс = ПолучитьНастройку("Префикс");
	//СледНомер = ПараметрыДата.ДоговорКонтрагента.Номер;	
    СледНомер = ПолучитьКодИзСтроки(ПараметрыДата.ДоговорКонтрагента.Номер,ТекущийПрефикс);
	Если СледНомер<1 Тогда
        СледНомер = ПолучитьКодИзСтроки(ПараметрыДата.НазначениеПлатежа,ТекущийПрефикс);
	КонецЕсли;	  
	
	Если СтрДлина(СокрЛП(СледНомер))>0 Тогда
		//поиск платежного поручения (контроль наличия, дублирования)
		МассивОбхода = Новый Массив;
		ВариантыНомера = ПолучитьВариантыНомера(СледНомер);		
		Для Каждого ВариантНомера Из ВариантыНомера Цикл
			Парам = Новый Структура;
			Парам.Вставить("r_id_internal",ВариантНомера);	
			МассивДанных = ЭТ_ОбщийМодуль2.RequestSearch(Парам);
			Для Каждого СледЭлемент Из МассивДанных Цикл
				Если (НЕ ЕстьВМассиве(МассивОбхода,СледЭлемент.id)) Тогда
					МассивОбхода.Добавить(СледЭлемент.id);
					ТекЗаявка = ЭТ_ОбщийМодуль2.Request(Новый Структура("id",СледЭлемент.id));
					Для Каждого СледТекЗаявка Из ТекЗаявка Цикл
						Для Каждого СледПлатежка Из СледТекЗаявка.payments Цикл
							//Для Каждого ТекСледПлатежка
							ТекСледПлатежка = ЭТ_ОбщийМодуль2.Payment(Новый Структура("id",СледПлатежка.id));
							Если ТекСледПлатежка.Количество()>0 Тогда
								Если ВРег(СтрЗаменить(СледПлатежка.number," ","")) = ВРег(СтрЗаменить(ПараметрыДата.Номер," ",""))
									И ТекСледПлатежка.cio_id = 2 
									И ТекСледПлатежка.type_id = 1
								Тогда
									//получаем режимы работы
									Если НЕ ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТестовыйРежим",Ложь) Тогда
										ЭТ_ОбщийМодуль2.PaymentDelete(Новый Структура("id",СледПлатежка.id));
									Иначе
										Сообщить("Модуль работает в тестовом режиме, вызвано событие удаления платежа от туриста "+ПараметрыДата.Номер+", в тестовом режиме удаление не производится!");
									КонецЕсли;
								КонецЕсли;
						КонецЕсли;
						
						КонецЦикла;
					КонецЦикла;
				КонецЕсли;				
			КонецЦикла;
		КонецЦикла;
		
		КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаКлиентНал");
		Если Строка(ТипЗнч(ПараметрыДата.Ссылка))="Операция по платежной карте" Тогда
			КассаРасчета = ЭТ_ОбщийМодуль2.ОпределитьКассуРасчета(ПараметрыДата.ВидОплаты,Новый Структура("КассаЮОН,ПроцентКомиссии,ВРасходы",ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаКлиентКарта"),ЭТ_ОбщийМодуль2.ПолучитьНастройку("КомиссияБанкаКарта"),0)).КассаЮОН;
		ИначеЕсли Строка(ТипЗнч(ПараметрыДата.Ссылка))="Списание с расчетного счета" Тогда	
			//Пытаемся определить счет
			//ПараметрыДата.СчетОрганизации.НомерСчета
			Если СтрНайти(НРег(ПараметрыДата.СтатьяДвиженияДенежныхСредств.Наименование),"покупат")>0 Тогда 				
				КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаКлиентБезнал");
			Иначе				
				КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаТО");
			КонецЕсли;			
			Если КассаРасчета = 0 Тогда
				КассаРасчета = ЭТ_ОбщийМодуль2.ОпределитьКассуПоРасчетномуСчету(ПараметрыДата.СчетОрганизации.НомерСчета, Истина);
			КонецЕсли;
			Если (КассаРасчета = Неопределено) ИЛИ (КассаРасчета = 0) Тогда КассаРасчета = 1; КонецЕсли;
		КонецЕсли;
		
		
		Если КассаРасчета = Неопределено Тогда КассаРасчета = 1; КонецЕсли;
		
		ВалютаДокументов = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВалютаДокументов");
		Если ВалютаДокументов = Неопределено Тогда ВалютаДокументов = 1; КонецЕсли;
		
		
		
		ОтличноеПроведение = Истина;
		ФиксацияОплаты = 0;
		Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТестовыйРежим",Ложь) Тогда
			Сообщить("Модуль работает в тестовом режиме, вызвано событие возврата ДС туристу "+ПараметрыДата.Номер+", в тестовом режиме создание не производится!");
			Возврат Истина;
		КонецЕсли;
		
		Для Каждого СледКодЗаявки Из УдалитьДублиИзМассива(МассивОбхода) Цикл
			Для Каждого СледЗаявка Из ЭТ_ОбщийМодуль2.Request(Новый Структура("id",СледКодЗаявки)) Цикл
				//контроль подготовленных данных
				Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("УведомленияОбОшибкахПлатежейПокупателей",ложь) ИЛИ ЭТ_ОбщийМодуль2.ПолучитьНастройку("ПроводитьПлатежныеДокументыСОшибкамиПокупатели",ложь) Тогда
					ЕстьОшибки = Ложь;
					Контрагент_1С = Ложь;
					//получаем реквизиты документа 1С
					//Если (Строка(ТипЗнч(ПараметрыДата.Ссылка))="Операция по платежной карте")ИЛИ(Строка(ТипЗнч(ПараметрыДата.Ссылка))="Поступление на расчетный счет") Тогда
					Если ПараметрыДата.Метаданные().Реквизиты.Найти("Контрагент")<>Неопределено Тогда
						Контрагент_1С = ПараметрыДата.Контрагент;					
						КонтрагекентСБ = User(Новый Структура("id",СледЗаявка.client_id));					
						СовпадениеКонтрагентов = Ложь;
						Если СокрЛП(Контрагент_1С.ИНН)=СокрЛП(КонтрагекентСБ.u_inn)И СтрДлина(СтрЗаменить(КонтрагекентСБ.u_inn," ",""))>0 Тогда СовпадениеКонтрагентов = Истина; КонецЕсли;
						Если СтрЧислоВхождений(СтрЗаменить(Контрагент_1С.ДокументУдостоверяющийЛичность," ",""),СтрЗаменить(КонтрагекентСБ.u_passport_number," ",""))>0 И СТрдлина(СтрЗаменить(КонтрагекентСБ.u_passport_number," ",""))>0 Тогда СовпадениеКонтрагентов = Истина;  КонецЕсли;
						Если СтрЧислоВхождений(СтрЗаменить(Контрагент_1С.Комментарий," ",""),СтрЗаменить(КонтрагекентСБ.u_passport_number," ",""))>0 И СТрдлина(СтрЗаменить(КонтрагекентСБ.u_passport_number," ",""))>0 Тогда СовпадениеКонтрагентов = Истина; КонецЕсли;
						Если СтрЧислоВхождений(НРег(СтрЗаменить(Контрагент_1С.НаименованиеПолное," ","")),НРег(СтрЗаменить((КонтрагекентСБ.u_surname+КонтрагекентСБ.u_name+КонтрагекентСБ.u_sname)," ","")))>0 И СТрдлина(СтрЗаменить((КонтрагекентСБ.u_surname+КонтрагекентСБ.u_name+КонтрагекентСБ.u_sname)," ",""))>0 Тогда СовпадениеКонтрагентов = Истина; КонецЕсли;
						Если СовпадениеКонтрагентов = Ложь Тогда ЕстьОшибки = Истина; Иначе	ЕстьОшибки = Ложь;	КонецЕсли;
						Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("УведомленияОбОшибкахПлатежейПокупателей",ложь) И  ЕстьОшибки=Истина  Тогда
							Сообщение = "При проведении документа "+ПараметрыДата.Ссылка+" выявлены ошибки: ";
							СписокОшибок = "";
							Если СовпадениеКонтрагентов=Ложь Тогда СписокОшибок = СписокОшибок + " не совпадают контрагенты "; КонецЕсли;						
							Сообщить(Сообщение+СписокОшибок);
							ЭТ_Почта.ОтправитьПисьмо(
								ЭТ_ОбщийМодуль2.ПолучитьКонтактСотрудника(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты,ПользователиКлиентСервер.ТекущийПользователь().ФизическоеЛицо.Ссылка),
								"Ошибка при разнесении платежа клиента "+ПараметрыДата.Ссылка,
								Сообщение+СписокОшибок
								);
						КонецЕсли;
						Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("ПроводитьПлатежныеДокументыСОшибкамиПокупатели",ложь)=Ложь И ЕстьОшибки=Истина  Тогда
							ОтличноеПроведение = Ложь;	
						КонецЕсли;
					Иначе
						Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("УведомленияОбОшибкахПлатежейПокупателей",ложь)=Истина Тогда
							ЭТ_Почта.ОтправитьПисьмо(
								ЭТ_ОбщийМодуль2.ПолучитьКонтактСотрудника(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты,ПользователиКлиентСервер.ТекущийПользователь().ФизическоеЛицо.Ссылка),
								"Не могу выполнить проверку "+ПараметрыДата.Ссылка,
								"Не могу выполнить проверку поступлений по документу "+ПараметрыДата.Ссылка
								);
							Сообщить("Не могу выполнить проверку поступлений по документу "+ПараметрыДата.Ссылка);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
		
		        Если ОтличноеПроведение = Истина Тогда
					ФиксацияОплаты = ФиксацияОплаты + 1;
					Парам = Новый Структура;
					Парам.Вставить("r_id",СледКодЗаявки); //r_id	integer	true		ID заявки (см.метод /request/{id}) / ID of the application (see method /request/{id})
					Парам.Вставить("cash_id",КассаРасчета); //cash_id	integer	false		ID кассы (см.метод /cash), по-умолчанию, берется первая касса / ID cash (see method /cash), by default, takes the first cash
					Парам.Вставить("currency_id",ВалютаДокументов); //currency_id	integer	false		ID валюты (см.метод /currency) / The currency ID (see method /currency)
					Парам.Вставить("type_id",1); //type_id	integer	true		Тип платежа (1 - расчеты с клиентами, 2 - расчеты с партнерами) / Payment type (1 - accounts receivable 2 - accounts with partners)
					Парам.Вставить("cio_id",2); //cio_id	integer	true		Вид платежа (1 - приход, 2 - расход) / Type of payment (1 arrival, 2 - expense)
					Парам.Вставить("reason",СокрЛП(Строка(ПараметрыДата))+" по договору "+ ПараметрыДата.ДоговорКонтрагента.Номер+" от "+Лев(Строка(ПараметрыДата.Дата),10)); //reason	string	false		Основание платежа / Basis of payment
					Парам.Вставить("date",Формат(Год(ПараметрыДата.Дата),"ЧЦ=4; ЧВН=; ЧГ=0")+"-"+Формат(Месяц(ПараметрыДата.Дата),"ЧЦ=2; ЧВН=; ЧГ=0")+"-"+Формат(День(ПараметрыДата.Дата),"ЧЦ=2; ЧВН=; ЧГ=0")+" 00:00:00"); //date	datetime	false		Дата платежа, формат: Y-m-d H:i:s, по-умолчанию, ставится текущая дата / Payment date, format: Y-m-d H:i:s, default is the current date
					Парам.Вставить("is_plan",0); //is_plan	integer	false		Плановый платеж (1 - да, 0 - нет) / Scheduled payment (1 - Yes, 0 - no)
					Парам.Вставить("is_bonus_pay",0); //is_bonus_pay	integer	false		Оплата бонусами (1 - да, 0 - нет) / Payment by bonuses (1 - Yes, 0 - no)
					Парам.Вставить("is_deposit",0); //is_deposit	integer	false		Депозитная операция? (1 - да, 0 - нет), по-умолчанию = 0 / Deposit payment? (1 - Yes, 0 - no), default = 0
					Парам.Вставить("from1c",1); //from1c	integer	false		Платеж создан в CRM (= 0) или пришел из 1С (= 1) / The payment is created in CRM (= 0) or 1C (= 1)
					Парам.Вставить("client_id",СледЗаявка.client_id); //client_id	integer	false		ID заказчика (см.метод /user) / ID of client (see method /user)
					Парам.Вставить("number",ПараметрыДата.Номер); //number	string	false		Номер платежа (по-умолчанию, берется следующий порядковый номер) / Payment number (by default, it takes the next sequence number)
					Парам.Вставить("price",ПараметрыДата.СуммаДокумента); //price	float	false		Стоимость клиенту / The cost to the client
					Парам.Вставить("note",ПараметрыДата.Комментарий); //note	string	false		Примечание по платежу / Note on payment
					//Парам.Вставить("date_plan",	Формат(Год(ПараметрыДата.Дата),"ЧЦ=4; ЧВН=; ЧГ=0")+"-"+Формат(Месяц(ПараметрыДата.Дата),"ЧЦ=2; ЧВН=; ЧГ=0")+"-"+Формат(День(ПараметрыДата.Дата),"ЧЦ=2; ЧВН=; ЧГ=0")+" 00:00:00"); //date_plan	datetime	false		Плановая дата платежа, формат: Y-m-d H:i:s / Scheduled payment date, format: Y-m-d H:i:s
					Парам.Вставить("supplier_id",СледЗаявка.supplier_id); //supplier_id	integer	false		ID партнера / туроператора (см.метод /supplier) / ID of the partner / tour operator (see method /supplier)
					Парам.Вставить("koef",1); //koef	float	false		Курс валюты (по-умолчанию, 1.00) / Currency (default: 1.00)
					Если ЭТ_ОбщийМодуль2.PaymentCreate(Парам)<1 Тогда
						Сообщить("ОШИБКА: Во время сохранения данных в СБ произошел сбой, состояние документа не отображено в СБ.");
						ОтличноеПроведение = Ложь;
					Иначе				
						Сообщить("В СБ зафиксирован возврат Клиенту по заявке "+СледЗаявка.id_internal+" в размере "+Строка(ПараметрыДата.СуммаДокумента));
						НомерЗаявки = "без номера";
						Если СледЗаявка.Свойство("id_internal") Тогда НомерЗаявки = СледЗаявка.id_internal; КонецЕсли;					
						Сообщение="По заявке "+НомерЗаявки+" была произведен возврат в размере "+Формат(ПараметрыДата.СуммаДокумента,"ЧДЦ=2; ЧРД=.; ЧРГ=' '")+" руб. Время события: "+ Формат(ТекущаяДата(),"ДЛФ=DDT");
						УведомитьМенеджераОбОплате(СледКодЗаявки,Сообщение,"Произведен возврат Заказчику");
						ОтличноеПроведение = Истина;
					КонецЕсли;
				КонецЕсли;
				Возврат ОтличноеПроведение;
				Прервать;
			КонецЦикла;
		КонецЦикла;
		
		ТекстСообщения = "Не могу зафиксировать возврат ";		
		Если Строка(ТипЗнч(ПараметрыДата)) = "Возврат наличных" Тогда ТекстСообщения = ТекстСообщения + ПараметрыДата.Комментарий;	КонецЕсли;
		Сообщить(ТекстСообщения);
	КонецЕсли;	
	Возврат Ложь;
КонецФункции


//УдалитьВозвратКлиенту(ПараметрыДата) Экспорт
//удаляет платеж ТО
&НаСервере
Функция УдалитьВозвратКлиенту(ПараметрыДата) Экспорт
	КВозврату = 0;
	КодЗаявки = 0;
	ТекущийПрефикс = ПолучитьНастройку("Префикс");
	МассивОбхода = Новый Массив;
	//СледНомер = ПараметрыДата.ДоговорКонтрагента.Номер;
     СледНомер = ПолучитьКодИзСтроки(ПараметрыДата.ДоговорКонтрагента.Номер,ТекущийПрефикс);
	Если СледНомер<1 Тогда
        СледНомер = ПолучитьКодИзСтроки(ПараметрыДата.НазначениеПлатежа,ТекущийПрефикс);
	КонецЕсли;	  
	
	Если СтрДлина(СокрЛП(СледНомер))>0 Тогда
		//поиск платежного поручения (контроль наличия, дублирования)
		ВариантыНомера = ПолучитьВариантыНомера(СледНомер);		
		//ВариантыНомера = Новый Массив;
		//ВариантыНомера.Добавить(СледНомер);
		//ВариантыНомера.Добавить(ТекущийПрефикс+Формат(СледНомер,"ЧГ=0"));
		//ВариантыНомера.Добавить(СокрЛП(ТекущийПрефикс)+СокрЛП(Формат(СледНомер,"ЧГ=0")));	
		//ВариантыНомера.Добавить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(Формат(СледНомер,"ЧГ=0")),"-"," - "),"  "," "),"  "," "));			
		Для Каждого ВариантНомера Из ВариантыНомера Цикл
			Парам = Новый Структура;
			Парам.Вставить("r_id_internal",ВариантНомера);	
			МассивДанных = ЭТ_ОбщийМодуль2.RequestSearch(Парам);
			Для Каждого СледЭлемент Из МассивДанных Цикл
				Если (НЕ ЕстьВМассиве(МассивОбхода,СледЭлемент.id)) Тогда
					МассивОбхода.Добавить(СледЭлемент.id);
					ТекЗаявка = ЭТ_ОбщийМодуль2.Request(Новый Структура("id",СледЭлемент.id));
					Для Каждого СледТекЗаявка Из ТекЗаявка Цикл
						Для Каждого СледПлатежка Из СледТекЗаявка.payments Цикл
							//Для Каждого ТекСледПлатежка
							ТекСледПлатежка = ЭТ_ОбщийМодуль2.Payment(Новый Структура("id",СледПлатежка.id));
							Если ТекСледПлатежка.Количество()>0 Тогда
								//Если							
								//	(
								//		(СокрЛП(ВРег(Строка(СледПлатежка.number))) = СокрЛП(ВРег(Строка(ПараметрыДата.Номер))))
								//		ИЛИ (СтрНайти(СледПлатежка.reason, ПараметрыДата.ДоговорКонтрагента.Номер)>0 И СледПлатежка.price = ПараметрыДата.СуммаДокумента)
								//	  ) И ТекСледПлатежка.cio_id = 1 И ТекСледПлатежка.type_id = 1 И ВРег(СтрЗаменить(СледПлатежка.number," ","")) = ВРег(СтрЗаменить(ТекСледПлатежка.number," ",""))
								Если ВРег(СтрЗаменить(СледПлатежка.number," ","")) = ВРег(СтрЗаменить(ПараметрыДата.Номер," ","")) 	
									И ТекСледПлатежка.cio_id = 2
									И ТекСледПлатежка.type_id = 1
								Тогда
									//получаем режимы работы
									Если НЕ ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТестовыйРежим",Ложь) Тогда										
										НомерДокумента = ЭТ_ОбщийМодуль2.PaymentDelete(Новый Структура("id",СледПлатежка.id));
										Если НомерДокумента>0 Тогда Сообщить("В СБ удален возврат клиенту "+ТекСледПлатежка.number+" на сумму "+ТекСледПлатежка.price+" руб. заявка "+СледЭлемент.id_internal); КонецЕсли;
									Иначе
										Сообщить("Модуль работает в тестовом режиме, вызвано событие удаления платежа от туриста "+ПараметрыДата.Номер+", в тестовом режиме удаление не производится!");
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЦикла;
				КонецЕсли;				
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ПолучитьИННтуроператора(СтрокаПоиска) Экспорт //СтрокаПоиска - номер заявки строкой
	Квозврату = "";
	ТекущийПрефикс = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Префикс");
	ВариантыНомера = Новый Массив;
	ВариантыНомера.Добавить(СокрЛП(СтрокаПоиска));
	ВариантыНомера.Добавить(ТекущийПрефикс+СтрокаПоиска);
	ВариантыНомера.Добавить(СокрЛП(ТекущийПрефикс)+СокрЛП(СтрокаПоиска));	
	МассивНомеров = Новый Массив;
	Для Каждого ВариантНомера Из ВариантыНомера Цикл
		Парам = Новый Структура;
		Парам.Вставить("r_id_internal",ВариантНомера);	
		МассивДанных = ЭТ_ОбщийМодуль2.RequestSearch(Парам);
		Если МассивДанных.Количество()>0 Тогда		
			Для Каждого СледЭлемент Из МассивДанных Цикл
				МассивНомеров.Добавить(СледЭлемент.id);
			КонецЦикла;
		КонецЕсли;		
	КонецЦикла;
	Для Каждого СледЗаявкаНомер Из ЭТ_ОбщийМодуль2.УдалитьДублиИзМассива(МассивНомеров) Цикл
		ДанныеЗаявки = 	ЭТ_ОбщийМодуль2.Request(Новый Структура("id",СледЗаявкаНомер));
		Если ДанныеЗаявки.Количество()>0 Тогда
			Для Каждого СледЗаявка Из ДанныеЗаявки Цикл
				//Проверяем наличие договора
				Если СледЗаявка.Свойство("id_internal") Тогда
					Квозврату = СледЗаявка.supplier_inn;
				КонецЕсли;
			КонецЦикла;			
		КонецЕсли;		
	КонецЦикла;
	Возврат Квозврату;
КонецФункции


