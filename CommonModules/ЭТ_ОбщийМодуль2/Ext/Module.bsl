//ПолучитьКонтактСотрудника(ТипКонтакта,Сотрудник) Экспорт
//из справочника сотрудников / физ.лиц из контактной информации вытаскивает контакт сотрудника
//ТипКонтакта - перечисление ТипыКонтактнойИнформации, пример: Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты
//Сотрудник - ссылка на справочник физ.лица, пример: ПользователиКлиентСервер.ТекущийПользователь().ФизическоеЛицо.Ссылка
//возврат - строка с информацией
// требует доработки в плане получения информации отличной от адреса эл.почты
&НаСервере
Функция ПолучитьКонтактСотрудника(ТипКонтакта,Сотрудник) Экспорт
	ЭлПочта = "";
	Запрос = Новый Запрос;
	//Запрос.УстановитьПараметр("Ссылка", ПользователиКлиентСервер.ТекущийПользователь().ФизическоеЛицо.Ссылка);
	//Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("Ссылка", Сотрудник);
	Запрос.УстановитьПараметр("Тип", ТипКонтакта);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ФизическиеЛицаКонтактнаяИнформация.АдресЭП КАК АдресЭП
	|ИЗ
	|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|ГДЕ
	|	ФизическиеЛицаКонтактнаяИнформация.Ссылка = &Ссылка
	|	И ФизическиеЛицаКонтактнаяИнформация.Тип = &Тип
	|";
	//|    И КонтрагентыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)";
	РезультатЗапроса  = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.Прямой);
	Пока Выборка.Следующий() Цикл
		ЭлПочта = Выборка.АдресЭП;
	КонецЦикла;
	Возврат ЭлПочта;
КонецФункции

Функция НуженОбмен(ОрганизацияДокумента) Экспорт     
	КВозврату=Ложь;
	ОрганизацияДопуск = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ОрганизацияДопуск","");
	Если СтрДлина(СокрЛП(ОрганизацияДопуск)) <1 Тогда
		КВозврату = Истина;
	ИначеЕсли СтрДлина(СокрЛП(ОрганизацияДокумента.ИНН)) <1 Тогда
		КВозврату = Ложь;
	Иначе
		Если СтрНайти(ОрганизацияДопуск,ОрганизацияДокумента.ИНН)>0 Тогда
			КВозврату = Истина;
		Иначе
			КВозврату = Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат КВозврату;
КонецФункции

