////////////////////////////////////////////////////////////////////////////////
// Функция возвращает настройки подключения к API U-ON.
// Возвращает структуру:
// - Протокол
// - Хост
// - Порт
// - БазовыйПуть
// - БазовыйURL
////////////////////////////////////////////////////////////////////////////////
Функция UON_ПолучитьНастройкиAPI() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("Протокол", "http");
	Настройки.Вставить("Хост", "192.168.1.111");
	Настройки.Вставить("Порт", 80);
	Настройки.Вставить("БазовыйПуть", "/api-uon");
	Настройки.Вставить("БазовыйURL", Настройки.Протокол + "://" + Настройки.Хост + Настройки.БазовыйПуть);
	
	Возврат Настройки;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// Основная функция вызова API U-ON.
// Параметры:
// - Экшен: строка, например "search-ids"
// - Параметры: структура параметров строки запроса, например {"search": "Ivanov"}
//
// Возвращает структуру:
// - Успех
// - КодСостояния
// - Тело
// - JSON
// - Ошибка
// - URL
////////////////////////////////////////////////////////////////////////////////
Функция UON_ВызватьAPI(Экшен, Параметры = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("Тело", "");
	Результат.Вставить("JSON", Неопределено);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("URL", "");
	
	Попытка
		
		Если Параметры = Неопределено Тогда
			Параметры = Новый Структура;
		КонецЕсли;
		
		Экшен = СокрЛП(Строка(Экшен));
		Если ПустаяСтрока(Экшен) Тогда
			Результат.Ошибка = "Не задан экшен";
			Возврат Результат;
		КонецЕсли;
		
		НастройкиAPI = UON_ПолучитьНастройкиAPI();
		Путь = UON_СформироватьПутьЗапроса(Экшен, Параметры, НастройкиAPI.БазовыйПуть);
		
		Результат.URL = НастройкиAPI.Протокол + "://" + НастройкиAPI.Хост + Путь;
		
		Соединение = Новый HTTPСоединение(НастройкиAPI.Хост, НастройкиAPI.Порт);
		
		Запрос = Новый HTTPЗапрос(Путь);
		Запрос.Заголовки.Вставить("Accept", "application/json");
		
		Ответ = Соединение.Получить(Запрос);
		
		Результат.КодСостояния = Ответ.КодСостояния;
		Результат.Тело = Ответ.ПолучитьТелоКакСтроку();
		Результат.Успех = Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300;
		
		Если НЕ ПустаяСтрока(Результат.Тело) Тогда
			Попытка
				Результат.JSON = UON_ПрочитатьJSONИзСтроки(Результат.Тело);
			Исключение
				Результат.Ошибка = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
		
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// Функция формирует относительный путь запроса к API.
// На вход получает экшен, параметры и базовый путь API.
// Пример результата:
// /api-uon/search-ids?search=Ivanov
////////////////////////////////////////////////////////////////////////////////
Функция UON_СформироватьПутьЗапроса(Экшен, Параметры, БазовыйПуть) Экспорт
	
	Экшен = СтрЗаменить(СокрЛП(Экшен), "\", "/");
	
	Путь = БазовыйПуть;
	
	Если Прав(Путь, 1) = "/" Тогда
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЕсли;
	
	Если Лев(Экшен, 1) = "/" Тогда
		Экшен = Сред(Экшен, 2);
	КонецЕсли;
	
	Путь = Путь + "/" + Экшен;
	
	СтрокаПараметров = UON_СформироватьСтрокуЗапроса(Параметры);
	Если НЕ ПустаяСтрока(СтрокаПараметров) Тогда
		Путь = Путь + "?" + СтрокаПараметров;
	КонецЕсли;
	
	Возврат Путь;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// Функция формирует query string из структуры параметров.
// Пример:
// Структура("search", "Ivanov") -> "search=Ivanov"
////////////////////////////////////////////////////////////////////////////////
Функция UON_СформироватьСтрокуЗапроса(Параметры) Экспорт
	
	Если Параметры = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	МассивПар = Новый Массив;
	
	Для Каждого Элемент Из Параметры Цикл
		
		Ключ = СокрЛП(Строка(Элемент.Ключ));
		
		Если ТипЗнч(Элемент.Значение) = Тип("Булево") Тогда
			Значение = ?(Элемент.Значение, "true", "false");
		ИначеЕсли Элемент.Значение = Неопределено Тогда
			Значение = "";
		Иначе
			Значение = Строка(Элемент.Значение);
		КонецЕсли;
		
		МассивПар.Добавить(UON_КодироватьСтрокуURL(Ключ) + "=" + UON_КодироватьСтрокуURL(Значение));
		
	КонецЦикла;
	
	Возврат СтрСоединить(МассивПар, "&");
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// Функция выполняет минимальное URL-кодирование строки для query string.
////////////////////////////////////////////////////////////////////////////////
Функция UON_КодироватьСтрокуURL(ЗначениеСтрокой) Экспорт
	
	ЗначениеСтрокой = Строка(ЗначениеСтрокой);
	
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, "%", "%25");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, " ", "%20");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, "+", "%2B");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, "&", "%26");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, "=", "%3D");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, "?", "%3F");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, "/", "%2F");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, "\", "%5C");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, """", "%22");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, "#", "%23");
	
	Возврат ЗначениеСтрокой;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// Функция читает JSON из строки и возвращает данные 1С.
////////////////////////////////////////////////////////////////////////////////
Функция UON_ПрочитатьJSONИзСтроки(СтрокаJSON) Экспорт
	
	Чтение = Новый ЧтениеJSON;
	
	Попытка
		Чтение.УстановитьСтроку(СтрокаJSON);
		РезультатJSON = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Возврат РезультатJSON;
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
		
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции