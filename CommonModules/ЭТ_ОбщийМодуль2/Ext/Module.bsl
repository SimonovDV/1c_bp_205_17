&НаСервере
Функция КонтрагентЯвляетсяПоставщиком(Знач ИНН,ЗначениеПоУмолчанию = Ложь) Экспорт
	КВозврату = ЗначениеПоУмолчанию;
	Запрос = Новый Запрос;

	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Родитель КАК Родитель,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Контрагенты.Ссылка) КАК СсылкаКоличество
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.Родитель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	Контрагенты.Родитель
		|
		|УПОРЯДОЧИТЬ ПО
		|	СсылкаКоличество";
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КаталогПартнеровСп = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПартнеров");     
		КаталогПоставщиковСп = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КаталогПоставщиков");     
		Если ВыборкаДетальныеЗаписи.Родитель = КаталогПартнеровСп Тогда
			КВозврату = Ложь;
		ИначеЕсли ВыборкаДетальныеЗаписи.Родитель = КаталогПоставщиковСп Тогда
			КВозврату = Истина;
		КонецЕсли;		
	КонецЦикла;	
	
	Возврат КВозврату;	
КонецФункции


// Возвращает значение дополнительного сведения контрагента по идентификатору
// для формул или по наименованию свойства.
//
// Параметры:
//   КонтрагентСсылка      - СправочникСсылка.Контрагенты
//                           Контрагент, для которого требуется получить значение
//                           дополнительного сведения.
//
//   ИмяСвойства           - Строка
//                           Идентификатор свойства или его наименование,
//                           в зависимости от параметра СпособПоискаСвойства.
//
//   ЗначениеПоУмолчанию   - Произвольный
//                           Необязательный параметр. Значение, которое будет
//                           возвращено, если контрагент не передан, имя свойства
//                           не заполнено или свойство не найдено.
//
//   СпособПоискаСвойства  - Строка
//                           Необязательный параметр. Определяет, как искать
//                           свойство в плане видов характеристик
//                           ДополнительныеРеквизитыИСведения.
//                           Возможные значения:
//                           - "ИдентификаторДляФормул" (по умолчанию)
//                           - "Наименование"
//
// Возвращаемое значение:
//   Произвольный
//   Значение дополнительного сведения контрагента.
//
//   Произвольный
//   ЗначениеПоУмолчанию, если контрагент не передан, имя свойства не заполнено
//   или свойство не найдено.
//       
&НаСервере
Функция ПолучитьДопСведениеОбъекта(
	ОбъектСсылка,
	ИмяСвойства,
	ЗначениеПоУмолчанию = Неопределено,
	СпособПоискаСвойства = "ИдентификаторДляФормул") Экспорт

	Если ОбъектСсылка = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ИмяСвойства)) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	СпособПоискаСвойства = СокрЛП(СпособПоискаСвойства);
	Если ПустаяСтрока(СпособПоискаСвойства) Тогда
		СпособПоискаСвойства = "ИдентификаторДляФормул";
	КонецЕсли;
	
	Если СпособПоискаСвойства = "Наименование" Тогда
		СвойствоОбъекта = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.
			НайтиПоРеквизиту("Наименование", ИмяСвойства);
	Иначе
		СвойствоОбъекта = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.
			НайтиПоРеквизиту("ИдентификаторДляФормул", ИмяСвойства);
	КонецЕсли;

	Если СвойствоОбъекта = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;   
	
	КВозврату = УправлениеСвойствами.ЗначениеСвойства(ОбъектСсылка, СвойствоОбъекта);

	Возврат ?(
		КВозврату = Неопределено,
		ЗначениеПоУмолчанию,
		КВозврату
	);
КонецФункции	


// Получение счетов учета для конкретной номенклатуры
&НаСервере
Функция ПолучитьСчетаУчетаНоменклатуры(Номенклатура, Организация = Неопределено, Склад = Неопределено) Экспорт
	
	// Получаем последнее значение из регистра
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Номенклатура", Номенклатура);
	
	Если НЕ Организация = Неопределено Тогда
		СтруктураПоиска.Вставить("Организация", Организация);
	КонецЕсли;
	
	Если НЕ Склад = Неопределено Тогда
		СтруктураПоиска.Вставить("Склад", Склад);
	КонецЕсли;
	
	// Получаем запись регистра
	МенеджерРегистра = РегистрыСведений.СчетаУчетаНоменклатуры;
	ЗаписьРегистра = МенеджерРегистра.ПолучитьПоследнее(, СтруктураПоиска);
	
	// Формируем результат
	Результат = Новый Структура;
	Результат.Вставить("СчетУчета", ЗаписьРегистра.СчетУчета);
	Результат.Вставить("СчетДоходов", ЗаписьРегистра.СчетДоходов);
	Результат.Вставить("СчетРасходов", ЗаписьРегистра.СчетРасходов);
	Результат.Вставить("СчетУчетаНДС", ЗаписьРегистра.СчетУчетаНДС);
	
	Возврат Результат;
	
КонецФункции

