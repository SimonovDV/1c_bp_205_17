//Функция ПроверитьДоговорКонтрагента(Номер,Контрагент,ВидДоговора=Ложь) Экспорт
//ПроверитьДоговорТуриста - проверяет наличие договора туриста по его номеру в системе 1С
//Входящие параметры: Номер - тип строка, номер документа с указанием префикса - так, как оно есть в договоре
//					  Контрагент - тип Справочник.Контрагенты
//Возвращает: 0 - договор не найден
//			  1 - договор на указанном контрагенте
//			  2 - договор на другом контрагенте
Функция ПроверитьДоговорКонтрагента(Ссылка, Уведомления = Истина) Экспорт
	//Объект.ВидДоговораТО=ПолучитьНастройку("ВидДоговораТО"); 
	//Объект.ВидДогговораКлиент=ПолучитьНастройку("ВидДогговораКлиент"); 
	//Объект.УникальностьДоговораКлиента=ПолучитьНастройку("УникальностьДоговораКлиента");
	КВозврату = Новый Структура("КодВозврата,Сообщение,Действие",0,"",Истина);
	ПарВидДоговора = Новый Массив;
	ПарВидДоговора.Добавить(ПолучитьНастройку("ВидДоговораКлиент"));
	ПарВидДоговора.Добавить(ПолучитьНастройку("ВидДоговораТО"));
	Если ЕстьВМассиве(ПарВидДоговора,Ссылка.ВидДоговора) Тогда
		ПарНомер = Ссылка.Номер;
		ПарКонтрагент = Ссылка.Владелец;
		ПарНомер = СтрЗаменить(ПарНомер," ","");
		ПарНомер = СтрЗаменить(ПарНомер,"-","%-%");
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
		                      |	ДоговорыКонтрагентов.Владелец КАК Владелец,
		                      |	ДоговорыКонтрагентов.Наименование КАК Наименование,
		                      |	ДоговорыКонтрагентов.Код КАК Код
		                      |ИЗ
		                      |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		                      |ГДЕ
		                      |	ДоговорыКонтрагентов.Номер ПОДОБНО &НомерЗаявки
		                      |	И ДоговорыКонтрагентов.ВидДоговора В(&ВидДоговора)
		                      |	И НЕ ДоговорыКонтрагентов.Ссылка = &Ссылка
		                      |	И НЕ ДоговорыКонтрагентов.ПометкаУдаления"); 
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("ВидДоговора", Ссылка.ВидДоговора);	
		Запрос.УстановитьПараметр("НомерЗаявки", "%"+СокрЛП(ПарНомер)+"%");
		Результат = Запрос.Выполнить().Выбрать();
		Пока Результат.Следующий() Цикл
			Если (СтрЗаменить(ВРег(СокрЛП(Результат.Ссылка.Номер))," ","") = СтрЗаменить(ВРег(СокрЛП(Ссылка.Номер))," ","")) И (НЕ КВозврату.КодВозврата = 1) Тогда		
				КВозврату.КодВозврата = 2;
				КВозврату.Сообщение = "В системе 1С уже имеется договор с номером "+Ссылка.Номер+", договор принадлежит контрагенту "+Результат.Владелец+".";
			КонецЕсли;		
			Если (СтрЗаменить(ВРег(СокрЛП(Результат.Ссылка.Номер))," ","") = СтрЗаменить(ВРег(СокрЛП(Ссылка.Номер))," ","")) И (Результат.Владелец = Ссылка.Владелец) Тогда		
				КВозврату.КодВозврата = 1;
				КВозврату.Сообщение = "У контрагента "+Ссылка.Владелец.Наименование+" в системе 1С уже имеется договор с номером "+Ссылка.Номер+"."
			КонецЕсли;		
		КонецЦикла;  
		
		Если КВозврату.КодВозврата > 0 И ЭТ_ОбщийМодуль2.ПолучитьНастройку("УникальностьДоговораКлиента",Ложь) Тогда
			КВозврату.Действие = Ложь;
		Иначе
			ЭТ_Почта.УведомлениеАдминистратору("Успешная попытка создать дублирующий ДоговорКонтрагента (донор: "+Результат.Код+").
			|"+КВозврату.Сообщение,"- Дублирующий договор");
		КонецЕсли;
		
		Если Уведомления Тогда
			Если СтрДлина(СокрЛП(КВозврату.Сообщение))>0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = КВозврату.Сообщение;
				Сообщение.Сообщить();
			КонецЕсли;
			Если КВозврату.КодВозврата > 0 И ЭТ_ОбщийМодуль2.ПолучитьНастройку("УникальностьДоговораКлиента",Ложь) Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Сохранение договора не возможно. Установлен контроль уникальности номеров договора.";
				Сообщение.Сообщить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат КВозврату;
КонецФункции

//ОснованиеПлатежаПоШаблону(КодКонтрагента, ПараметрыДата) Экспорт
//по присланному коду 1С контрагента и присланным параметрам (бронь, сумма) формирует
//строку основания платежа, согласно настройкам
&НаСервере
Функция ОснованиеПлатежаПоШаблону(КодКонтрагента, ПараметрыДата) Экспорт
	КВозврату = "";
	Контрагент = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Если НЕ Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		ПлатежкаОснование = ПолучитьНастройку("ПлатежкаОснование",Null);
		Если НЕ ПлатежкаОснование = Null Тогда
			Если ПараметрыДата.Свойство("бронь") Тогда бронь = ПараметрыДата.бронь Иначе бронь = ""; КонецЕсли;
			Если ПараметрыДата.Свойство("сумма") Тогда сумма = ПараметрыДата.сумма Иначе сумма = 0; КонецЕсли;
			Для Каждого СледСтрока Из ПлатежкаОснование Цикл
				Если СледСтрока["Контрагент"] = Контрагент Тогда
					Шаблон = СледСтрока["Шаблон"];
					Шаблон = СтрЗаменить(Шаблон,"[бронь]",СокрЛП(бронь));
					Шаблон = СтрЗаменить(Шаблон,"[сумма]",СокрЛП(Формат(сумма,"ЧДЦ=2; ЧРД=,; ЧН=; ЧГ=0")));
					Если СтрДлина(СокрЛП(Шаблон))>0 Тогда КВозврату = Шаблон; КонецЕсли;
				КонецЕсли;		
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;	
	Возврат КВозврату;	
КонецФункции

//ДатаСозданияСсылки(Ссылка) Экспорт
//по присланной ссылке объекта 1С определяет дату создания объекта
// но по GUID можно определить время и дату
Функция ДатаСозданияСсылки(Ссылка) Экспорт
    ГУИД = Ссылка.УникальныйИдентификатор();
    Строка16 = Сред(ГУИД, 16, 3) + Сред(ГУИД, 10, 4) + Сред(ГУИД, 1, 8);
    Разрядность = СтрДлина(Строка16);
    ЧислоСек = 0;
    Для Позиция = 1 По Разрядность Цикл
        ЧислоСек = ЧислоСек + Найти("123456789abcdef",Сред(Строка16,Позиция,1))*Pow(16,Разрядность - Позиция);
    КонецЦикла;
    ЧислоСек = ЧислоСек / 10000000;
    Возврат Дата(1582, 10, 15, 04, 00, 00) + ЧислоСек;
КонецФункции   

//УведомитьМенеджераОбОплате(КодЗаявки,Сообщение) Экспорт
//по присланному КодЗаявки (код СБ), отправляет менеджеру по заявке письмо с текстом уведомления Сообщение
&НаСервере
Процедура УведомитьМенеджераОбОплате(КодЗаявки,Сообщение,Тема="Поступила оплата от Заказчика") Экспорт	
	//ЭТ_Почта.ОтправитьПисьмо(Адресат,Тема,Содержание, СкрытьУведомление=Ложь)
	Заявка = Request(Новый Структура("id",КодЗаявки));
	
	Если Заявка.Количество()<1 Тогда 
		Сообщение = "Заявка в U-ON не найдена. Не могу уведомить менеджера о поступлении платежа.
		|"+Сообщение;
		Сообщить(Сообщение); 
		ЭТ_Почта.УведомлениеБухгалтерии(Сообщение,"1C - Не могу уведомить менеджера о поступлении платежа.");
		Возврат; 
	КонецЕсли;
	МассивПочты = Новый Массив;
	МасивКодовПользователей = Новый Массив;
	МассивОшибок = Новый Массив;
	Для Каждого СледЗаявка Из Заявка Цикл
		НомерЗаявки = " [номер заявки не указан] ";
		Если СледЗаявка.Свойство("id_internal") Тогда НомерЗаявки=СледЗаявка.id_internal; КонецЕсли;
		ВычКодЗаявки = " [код заявки не указан] ";
		Если СледЗаявка.Свойство("id_system") Тогда ВычКодЗаявки=СледЗаявка.id_system; КонецЕсли;
		Если НЕ СледЗаявка.Свойство("manager_id") Тогда МассивОшибок.Добавить("В заявке "+НомерЗаявки+"("+ВычКодЗаявки+")"+" не указан менеджер."); СледЗаявка.Вставить("manager_id",0); КонецЕсли;		
		Если СледЗаявка.manager_id>0 Тогда МасивКодовПользователей.Добавить(СледЗаявка.manager_id); КонецЕсли;
		СледПользователь = User(Новый Структура("id",СледЗаявка.manager_id));
		Если СледПользователь.Количество()>0 Тогда
			МасФИО = Новый Массив;			
			Если СледПользователь.Свойство("u_surname") Тогда МасФИО.Добавить(СледПользователь.u_surname); КонецЕсли;
			Если СледПользователь.Свойство("u_name") Тогда МасФИО.Добавить(СледПользователь.u_name); КонецЕсли;
			ФИОПользователя = СтрСоединить(МасФИО," ");
			Если СтрДлина(СокрЛП(ФИОПользователя))<1 Тогда ФИОПользователя = " [ФИО пользователя не задано] "; КонецЕсли;
			Если НЕ СледПользователь.Свойство("u_email") Тогда 
				МассивОшибок.Добавить("У пользователя "+ФИОПользователя+" отсутствует адрес эл.почты."); 
			Иначе
				МассивПочты.Добавить(СледПользователь.u_email);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СледКодПользователя Из МасивКодовПользователей Цикл
		ЭТ_ОбщийМодуль2.ChatMessage(Новый Структура("user_id_from,user_id_to,text",ПолучитьНастройку("ПользовательЮОН"),СледКодПользователя,Сообщение));
	КонецЦикла;
	
	Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("УведомлятьМенеджераОбОплатеКлиентаНаПочту",Ложь) = Истина Тогда
		Если МассивПочты.Количество()>0 тогда
			Сообщение = Сообщение+"
			|Сообщение отправлено на эл.почту "+СтрСоединить(МассивПочты,", ")+"
			|";
			ЭТ_Почта.ОтправитьПисьмо(СтрСоединить(МассивПочты," "),Тема,Сообщение);
		КонецЕсли;
		
		Если МассивОшибок.Количество()>0  тогда
			Сообщение = "Не могу уведомить менеджера о поступлении оплаты.
			|Причины: "+СтрСоединить(МассивОшибок,". ")+"
			|";
			ЭТ_Почта.УведомлениеБухгалтерии(Сообщение,"Не могу уведомить менеджера о поступлении оплаты.");		
		КонецЕсли;
	КонецЕсли;
	
	
//user_id_from	integer	true		ID пользователя (кто отправляет) / User ID (sender), см.метод /user.json
//user_id_to	integer	true		ID пользователя (кому отправить) / User ID (receiver), см.метод /user.json
//text	string	true		Сообщение / Text to send

	//ПолучитьНастройку("ПользовательЮОН")
	
		
КонецПроцедуры


//все нижеидущие функции создавались для дальнейшего развития модуля и на текущий момоент не реализованы
// - загрузка валюты (к сожалению СБ не отдает курс валюты ТО)
&НаСервере
Функция ПолучитьКурсыВалютТОНаДату(ИмяПартнераВалюта, ИмяВалюты, ДатаКурса) Экспорт
	КВозврату = 0;
	КурсыВалютСервер = ПолучитьНастройку("КурсыВалютСервер");
	Если СтрДлина(СокрЛП(КурсыВалютСервер))<1 Тогда  Возврат КурсыВалютСервер; КонецЕсли;
	
	ПравильноеНазваниеВалюты = ОпределитьВалютуПоНаименованию(ИмяВалюты);
	ПравильнаяДатаКурса = Формат(ДатаКурса, "ДФ=дд")+"."+Формат(ДатаКурса, "ДФ=ММ")+"."+Формат(ДатаКурса, "ДФ=гггг");
	
	
	Соединение = Новый HTTPСоединение(
	    КурсыВалютСервер, // сервер (хост)
	    80, // порт, по умолчанию для http используется 80, для https 443
	    , // пользователь для доступа к серверу (если он есть)
	    , // пароль для доступа к серверу (если он есть)
	    , // здесь указывается прокси, если он есть
	    10 // таймаут в секундах, 0 или пусто - не устанавливать
	);
	
	СтруктураПараметров = Новый Структура;
	//СтруктураПараметров.Вставить("touroperator",ИмяПартнераВалюта);
	//СтруктураПараметров.Вставить("currency",ПравильноеНазваниеВалюты);
	//СтруктураПараметров.Вставить("date",ПравильнаяДатаКурса);
	
	
	СтруктураПараметров.Вставить("touroperator","partner");
	СтруктураПараметров.Вставить("currency","valuta");
	СтруктураПараметров.Вставить("date","data");
	
	КурсыВалютСсылка = ПолучитьНастройку("КурсыВалютСсылка");
    Запрос = Новый HTTPЗапрос(КурсыВалютСсылка);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураПараметров);
	СтрJSON = ЗаписьJSON.Закрыть();
	
	Запрос.Заголовки.Вставить("Content-type", "application/json");
	Запрос.УстановитьТелоИзСтроки(СтрJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);	
	
	Результат = Соединение.Получить(Запрос);
	Если Результат.КодСостояния>100 и Результат.КодСостояния<300 Тогда
		ЧтениеДСОН = Новый ЧтениеJSON;
		ЧтениеДСОН.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
		МассивДанных = ПрочитатьJSON(ЧтениеДСОН);
		КВозврату = МассивДанных;	
		ЧтениеДСОН.Закрыть();
	Иначе
		Сообщить("ОШИБКА [ОпроавитьГетЗапрос]: "+строка(Результат.КодСостояния)+". Во время получения курсов валют ТО возникла ошибка.",СтатусСообщения.Внимание);
		КВозврату = Ложь;			
	КонецЕсли;
	
	
	
	Возврат КВозврату;
КонецФункции

Функция ОпределитьВалютуПоНаименованию(НаименованиеВалюты) Экспорт
	КВозврату = НаименованиеВалюты;
	СписокВалют = Новый Массив;
	
	МассивНаименований = Новый Массив;
	МассивНаименований.Добавить("USD");
	МассивНаименований.Добавить("$");
	МассивНаименований.Добавить("Доллар США");
	СписокВалют.Добавить(МассивНаименований);
	
	МассивНаименований = Новый Массив;
	МассивНаименований.Добавить("EUR");
	МассивНаименований.Добавить("€");
	МассивНаименований.Добавить("Евро");
	СписокВалют.Добавить(МассивНаименований);
	
	Для Каждого СледСтрока Из СписокВалют Цикл
		Для Каждого СледЗначение Из СледСтрока Цикл
			Если НРег(СокрЛП(СледЗначение)) = НРег(СокрЛП(НаименованиеВалюты)) Тогда
				КВозврату =  СледСтрока[0];
				Прервать;
			КонецЕсли;			
		КонецЦикла;		
	КонецЦикла;
	
	Возврат КВозврату;		
КонецФункции

