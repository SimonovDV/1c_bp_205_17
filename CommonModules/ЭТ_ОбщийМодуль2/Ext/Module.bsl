//ПолучитьПлатежныеДокументыПоЗаявке(Заявка,ВидДоговора) Экспорт
//по присланной структуре заявки и Виду договора получает платежные документы
//выборка ведется из РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто
&НаСервере
Функция ПолучитьПлатежныеДокументыПоЗаявке(Заявка,ВидДоговора) Экспорт
	Запрос = Новый Запрос;
	
	МасСчет = Новый Массив();
	СчРасход = Новый Массив();
	Если ВидДоговора = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораКлиент",Null) Тогда
		МасСчет.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("50.01"));
		МасСчет.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("51"));
		МасСчет.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("52"));
		МасСчет.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("57.03"));
		МасСчет.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01"));
		МасСчет.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02"));
		СчРасход.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01"));
		СчРасход.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02"));
	ИначеЕсли ВидДоговора = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВидДоговораТО",Null) Тогда	
		МасСчет.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.09"));
		МасСчет.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("51"));
		СчРасход.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("51"));
		//Запрос.Текст = "ВЫБРАТЬ 
		//|	ХозрасчетныйДвижения.Регистратор.Ссылка Как ДокументСсылка,
		//|	(ВЫБОР КОГДА ХозрасчетныйДвижения.СчетДт В (&СчРасход) ТОГДА -ХозрасчетныйДвижения.Сумма ИНАЧЕ ХозрасчетныйДвижения.Сумма КОНЕЦ) КАК СуммаДокумента,
		//|	Регистратор.ДоговорКонтрагента КАК ДоговорКонтрагента,
		//|	ХозрасчетныйДвижения.СчетДт КАК Дт, 
		//|	ХозрасчетныйДвижения.СчетКт КАК Кт
