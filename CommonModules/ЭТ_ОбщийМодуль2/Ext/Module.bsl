&НаСервере
Функция SupplierType() Экспорт    
	КВозврату = ВременноеХранилище_Получить("SupplierType","ПолныйНаборДанных",Неопределено,1200);
	Если НЕ КВозврату = Неопределено Тогда Возврат КВозврату; КонецЕсли;	
	СтрокаЗапроса = "/supplier_type";
	КВозврату = ЭТ_СоединениеЮОН.ОпроавитьГетЗапрос(СтрокаЗапроса);			
	Если КВозврату.Свойство("records") Тогда
		Если КВозврату.records.Количество()>0 Тогда
			ВременноеХранилище_Поместить("SupplierType","ПолныйНаборДанных",КВозврату.records);
			Возврат КВозврату.records;
		КонецЕсли;
	КонецЕсли;			
	Возврат Новый Структура;
КонецФункции

