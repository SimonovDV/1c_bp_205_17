	Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТестовыйРежим",Ложь) = Истина Тогда	Сообщить("Модуль работает в тестовом режиме, выполнение операции невозможно!");	Возврат Новый Структура; КонецЕсли;		
	СписокКлючей = Новый СписокЗначений;
		//СписокКлючей = СоздатьСписокКлючей("id r_id_internal r_dat r_dat_begin r_dat_end r_u_id r_ci_id r_co_id r_tour_operator_id r_travel_type_id status_id country_id city_id hotel_id source price price_netto note u_type u_surname u_sname u_name u_surname_en u_name_en u_phone u_phone_mobile u_email u_password u_note u_sex u_address u_passport_number u_passport_date u_passport_taken u_birthday u_zagran_number u_zagran_organization u_zagran_given u_zagran_expire u_company u_address_u string u_fax u_inn u_kpp u_ogrn u_okved u_finance_bank u_finance_rs u_finance_ks u_finance_bik u_finance_okpo u_discount_card_number u_discount_card_bonus utm_source utm_medium utm_campaign utm_content utm_term tourists services payments");
		СписокКлючей = СоздатьСписокКлючей("id date_lead date_request r_cl_id company_id office_id manager_id touroperator_id travel_type_id lead_status_id request_status_id request_cb_status_id visa_id insurance_id source_id reservation_number extended_fields");
		СтруктураПараметров = Новый Структура;
		Для Каждого Ключ Из СписокКлючей Цикл
			Если ПараметрыДата.Свойство(Ключ.Значение) Тогда
				ЗначениеПараметра = ПараметрыДата[Ключ.Значение];
				СтруктураПараметров.Вставить(Ключ,ЗначениеПараметра);
			КонецЕсли;
		КонецЦикла;
		//КВозврату = ОпроавитьПостЗапрос("/request/update",СтруктураПараметров);
		//id = ПараметрыДата.id;
