КонецФункции


&НаСервере
Функция ПолучитьЗаявкуПоНомеру(СтрокаПоиска) Экспорт                
	ШаблонПоиска = ЭТ_ОбщийМодуль2.ПолучитьШаблонПоискаЗаявки(СтрокаПоиска);
	//Врем = ВременноеХранилище_Получить("Заявка",ШаблонПоиска.Номер,Неопределено,800);
	//Если Не Врем = Неопределено Тогда
	//	Возврат Врем;
	//КонецЕсли;
	
	ВариантыНомера = Новый Массив;
	ВариантыНомера.Добавить(ШаблонПоиска.ПрефиксПоиск + " -" + ШаблонПоиска.Номер);
	ВариантыНомера.Добавить(ШаблонПоиска.ПрефиксПоиск + "-" + ШаблонПоиска.Номер);
	ВариантыНомера.Добавить(ШаблонПоиска.ПрефиксПоиск + " - " + ШаблонПоиска.Номер);
	ВариантыНомера.Добавить(ШаблонПоиска.ПрефиксПоиск + "- " + ШаблонПоиска.Номер);
	ВариантыНомера.Добавить(СтрокаПоиска);
	Для Каждого СледНомер Из ВариантыНомера Цикл
		Парам = Новый Структура;           
		Парам.Вставить("r_id_internal",СледНомер);	
		МассивДанных = ЭТ_ОбщийМодуль2.RequestSearch(Парам);		
		Для Каждого СледЭлемент Из МассивДанных Цикл			
		//	ВременноеХранилище_Поместить("Заявка",ШаблонПоиска.Номер,СледЭлемент);
			Возврат СледЭлемент;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура();
КонецФункции


//ДобавитьПлатежКлиента(Параметры) Экспорт
//по присланным параметрам добавляет платеж клиента
&НаСервере
Процедура ЗакрытьЗаявку(НомерЗаявки) Экспорт
	КВозврату = 0;
	КодЗаявки = 0;
	ТекущийПрефикс = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Префикс");
	СледНомер = ЭТ_ОбщийМодуль2.ПолучитьКодИзСтроки(НомерЗаявки,ТекущийПрефикс);
	СледТекЗаявка = ЭТ_ОбщийМодуль2.ПолучитьЗаявкуПоНомеру(СледНомер);
	ЭТ_ОбщийМодуль2.RequestUpdate(Новый Структура("id,request_status_id",СледТекЗаявка.id,6));
	Сообщить("Заявка "+СледТекЗаявка.id_internal+" закрыта");
КонецПроцедуры





&НаСервере
Функция ПолучитьСуммуНДС(Сумма,Дата,Организация) Экспорт	
	КВозврату = Новый Структура("ВидСтавки,Ставка,Сумма");
	//получаем систему налогообложения
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиУчетаНДССрезПоследних.СтавкаНалогообложенияПриУСН КАК СтавкаНалогообложенияПриУСН
		|ИЗ
		|	РегистрСведений.НастройкиУчетаНДС.СрезПоследних(&ДатаСреза) КАК НастройкиУчетаНДССрезПоследних
		|ГДЕ
		|	НастройкиУчетаНДССрезПоследних.Организация = &Организация";	

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаСреза", КонецДня(Дата));
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	КВозврату.Ставка = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.СтавкаНалогообложенияПриУСН = Перечисления.ВидыСтавокНДС["ОбщаяУСН"] Тогда
			КВозврату.ВидСтавки = Перечисления.СтавкиНДС["НДС22"];
			КВозврату.Ставка = 22;
		ИначеЕсли ВыборкаДетальныеЗаписи.СтавкаНалогообложенияПриУСН = Перечисления.ВидыСтавокНДС["ПониженнаяУСН"] Тогда			
			КВозврату.ВидСтавки = Перечисления.СтавкиНДС["НДС5"];
			КВозврату.Ставка = 5;
		ИначеЕсли ВыборкаДетальныеЗаписи.СтавкаНалогообложенияПриУСН = Перечисления.ВидыСтавокНДС["ОбщаяУСНРасчетная"] Тогда			
			КВозврату.ВидСтавки = Перечисления.СтавкиНДС["НДС7"];
			КВозврату.Ставка = 7;
		Иначе
			КВозврату.ВидСтавки = Перечисления.СтавкиНДС["БезНДС"];
			КВозврату.Ставка = 0;			
		КонецЕсли;
	КонецЦикла;
	
	КВозврату.Сумма = Окр(Сумма / (100+КВозврату.Ставка)*КВозврату.Ставка,2,РежимОкругления.Окр15как20);
	//КВозврату.Сумма = Окр(Сумма * КВозврату.Ставка / 100, 2, РежимОкругления.Окр15как20);
	Возврат  КВозврату;
КонецФункции


//ДобавитьПлатежТО(ПараметрыДата) Экспорт
//по присланным параметрам добавляет платеж ТО
&НаСервере
Функция ДобавитьПлатежТО(ПараметрыДата) Экспорт
	КВозврату = 0;
	КодЗаявки = 0;
	ТекущийПрефикс = ПолучитьНастройку("Префикс");
	МассивОбхода = Новый Массив;
	СтрокаПоиска="";
	Для Каждого СледРеквизит Из ПараметрыДата.Метаданные().Реквизиты Цикл
		Если СледРеквизит.Имя = "НазначениеПлатежа" Тогда СтрокаПоиска = СтрокаПоиска + " "+ПараметрыДата.НазначениеПлатежа; КонецЕсли;
		Если СледРеквизит.Имя = "ДоговорКонтрагента" Тогда СтрокаПоиска = СтрокаПоиска + " "+ПараметрыДата.ДоговорКонтрагента.Наименование; КонецЕсли;
		Если СледРеквизит.Имя = "ДокументОснование" Тогда
			Если НЕ ТипЗнч(ПараметрыДата.ДокументОснование)=Тип("Неопределено") Тогда
			СтрокаПоиска = СтрокаПоиска + " "+ПараметрыДата.ДокументОснование.ДоговорКонтрагента.Наименование; 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	//КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаТО");
	Если СтрНайти(НРег(ПараметрыДата.СтатьяДвиженияДенежныхСредств.Наименование),"покупат")>0 Тогда 				
		КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаКлиентБезнал");
	Иначе				
		КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаТО");
	КонецЕсли;
	
	Если КассаРасчета = 0 Тогда
		КассаРасчета = ЭТ_ОбщийМодуль2.ОпределитьКассуПоРасчетномуСчету(ПараметрыДата.СчетОрганизации.НомерСчета, Истина);
	КонецЕсли;

	Если (КассаРасчета = Неопределено) ИЛИ (КассаРасчета = 0) Тогда КассаРасчета = 1; КонецЕсли;
	ВалютаДокументов = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВалютаДокументов");
	Если ВалютаДокументов = Неопределено Тогда ВалютаДокументов = 1; КонецЕсли;
	
	ИмяПартнераВалюта = "";
	ОтличноеПроведение = Истина;   

	
	Для Каждого СледНомер Из ВырезатьИзСтроки(СтрокаПоиска,"(",")") Цикл
		
		Если стрнайти(стрзаменить(СледНомер," ",""),стрзаменить(ТекущийПрефикс," ",""))>0 Тогда		
			СледНомер = СокрЛП(УдалитьДатуИзСтроки(СледНомер));		
			Если СтрДлина(СокрЛП(СледНомер))>0 Тогда		
				СледТекЗаявка = ПолучитьЗаявкуПоНомеру(СледНомер);     
				Если СледТекЗаявка.Количество()<1 Тогда Продолжить; КонецЕсли;
				Для Каждого СледПлатежка Из ?(СледТекЗаявка.Свойство("payments"),СледТекЗаявка.payments,Новый Структура) Цикл
					//Для Каждого ТекСледПлатежка
					//ТекСледПлатежка = ЭТ_ОбщийМодуль2.Payment(Новый Структура("id",СледПлатежка.id));
					//Если ТекСледПлатежка.Количество()>0 Тогда
						Если ВРег(СтрЗаменить(СледПлатежка.number," ","")) = ВРег(СтрЗаменить(ПараметрыДата.Номер," ",""))
							И СледПлатежка.cio_id = 2 И СледПлатежка.type_id = 2
						Тогда
							ЭТ_ОбщийМодуль2.PaymentDelete(Новый Структура("id",СледПлатежка.id));
						КонецЕсли;
					//КонецЕсли;
				КонецЦикла;

				//СледЗаявка = СледТекЗаявка;
				
				//Определяем валюту заявки/услуги
				КодВалюты = ПолучитьНастройку("ВалютаДокументов");
				Если СледТекЗаявка.Свойство("r_calc_partner_currency_id") Тогда КодВалюты = СледТекЗаявка.r_calc_partner_currency_id;	КонецЕсли;
				
				//определяем партнера
				//ПараметрыДата.Контрагент.ИНН - инн в платежном документе
				//Собираем массив вероятных партнеров из заявки
				МассивПартнеровКод = Новый Массив;
				МассивПартнеровИНН = Новый Массив;
				СтруктураПартнеров = Новый Массив;
				ПартнерПоЗаявкеКод = 0;
				
				Если СледТекЗаявка.Свойство("supplier_id") И СледТекЗаявка.Свойство("supplier_inn") Тогда 
					Подмассив = Новый Массив(2);
					Подмассив.Вставить(0,СледТекЗаявка.supplier_id);
					Подмассив.Вставить(1,СледТекЗаявка.supplier_inn);
					СтруктураПартнеров.Добавить(Подмассив);
				КонецЕсли;
				
				Для Каждого СледУслуга Из СледТекЗаявка.services Цикл
					Если СледУслуга.Свойство("partner_id") И СледУслуга.Свойство("partner_inn") Тогда 
						Подмассив = Новый Массив(2);
						Подмассив.Вставить(0,СледУслуга.partner_id);
						Подмассив.Вставить(1,СледУслуга.partner_inn);
						СтруктураПартнеров.Добавить(Подмассив);
					КонецЕсли;
				КонецЦикла;
				
				//перечень собрали, определяем партнера
				Для Каждого СледующийПартнер Из СтруктураПартнеров Цикл
					Если СокрЛП(СледующийПартнер[1]) = СокрЛП(ПараметрыДата.Контрагент.ИНН) И СтрДлина(СокрЛП(СледующийПартнер[1]))>0 И ПартнерПоЗаявкеКод=0 Тогда
						ПартнерПоЗаявкеКод = СледующийПартнер[0];					
					КонецЕсли;				
				КонецЦикла;
				
				Если ПартнерПоЗаявкеКод=0 Тогда
					ПоискПартнерПоЗаявке = ЭТ_ОбщийМодуль2.Supplier(Новый Структура("inn",СокрЛП(ПараметрыДата.Контрагент.ИНН)));
					Если ПоискПартнерПоЗаявке.Количество()<1 Тогда
						ПоискПартнерПоЗаявке = ЭТ_ОбщийМодуль2.Supplier(Новый Структура("name",СокрЛП(ПараметрыДата.Контрагент.Наименование)));					
					КонецЕсли;
						
					Если ПоискПартнерПоЗаявке.Количество()<1 Тогда
						//Контакты = УправлениеКонтактнойИнформациейБП.АдресСтруктурой(ПараметрыДата.Контрагент.Ссылка,Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Юридический адрес"));
						Запрос = Новый Запрос;
						Запрос.Текст = 
							"ВЫБРАТЬ
							|	КонтрагентыКонтактнаяИнформация.Вид.Наименование КАК ВидНаименование,
							|	КонтрагентыКонтактнаяИнформация.Представление КАК Представление
							|ИЗ
							|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
							|ГДЕ
							|	КонтрагентыКонтактнаяИнформация.Ссылка = &Ссылка";
						Запрос.УстановитьПараметр("Ссылка", ПараметрыДата.Контрагент.Ссылка);
						ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
						Контакты = Новый Структура;
						Пока ВыборкаДетальныеЗаписи.Следующий() Цикл Контакты.Вставить(СокрЛП(СтрЗаменить(ВыборкаДетальныеЗаписи.ВидНаименование," ","")),ВыборкаДетальныеЗаписи.Представление);	КонецЦикла;
						Телефон = "";
						Если Контакты.Свойство("Телефон") Тогда Телефон = Контакты.Телефон; КонецЕсли;
						ЭлПочта = "";
						Если Контакты.Свойство("Email") Тогда ЭлПочта = Контакты.Email; КонецЕсли;
						Адрес = "";
						Если Контакты.Свойство("Юридическийадрес") Тогда Адрес = Контакты.Юридическийадрес; 
						ИначеЕсли Контакты.Свойство("Фактическийадрес") Тогда Адрес = Контакты.Фактическийадрес; 
						ИначеЕсли Контакты.Свойство("Почтовыйадрес") Тогда Адрес = Контакты.Почтовыйадрес; 
						КонецЕсли;
						Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТуроператорыЗапретСозданияВЮОН",Истина)=Ложь Тогда 
							ПартнерПоЗаявкеКод = SupplierCreate(Новый Структура("inn,name,phones,email,address,contacts,note",ПараметрыДата.Контрагент.ИНН,ПараметрыДата.Контрагент.Наименование,Телефон,ЭлПочта,Адрес,"",""));
						Иначе
							ПартнерПоЗаявкеКод = 0;
							ОтличноеПроведение = Ложь;
						КонецЕсли;
					Иначе
						ПартнерПоЗаявкеКод = ПоискПартнерПоЗаявке.id;
					КонецЕсли;
					
					//ИЛИ ЭТ_ОбщийМодуль2.ПолучитьНастройку("ПроводитьПлатежныеДокументыСОшибкамиПоставщиков",ложь)
					Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("УведомленияОбОшибкахПлатежейПоставщиков",ложь)=Истина Тогда
						Если СледТекЗаявка.Свойство("id_internal") Тогда
							НомерЗаявки = СледТекЗаявка.id_internal;
						ИначеЕсли СледТекЗаявка.Свойство("id") Тогда
							НомерЗаявки = СледТекЗаявка.id;
						Иначе
							НомерЗаявки = "[не могу определить номер заявки]";
						КонецЕсли;
							
						ТекстСообщения = "В заявке "+НомерЗаявки+" отсутствует партнер "+ПараметрыДата.Контрагент+" "+ СокрЛП(ПараметрыДата.Контрагент.ИНН);					
						Сообщить(ТекстСообщения);
						ЭТ_Почта.ОтправитьПисьмо(
						ЭТ_ОбщийМодуль2.ПолучитьКонтактСотрудника(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты,ПользователиКлиентСервер.ТекущийПользователь().ФизическоеЛицо.Ссылка),
							"Ошибка при разнесении платежа ТО "+ПараметрыДата.Ссылка+" "+НомерЗаявки,
							ТекстСообщения
						);
					КонецЕсли;
					Если ПартнерПоЗаявкеКод>0 Тогда
						ОтличноеПроведение =  ЭТ_ОбщийМодуль2.ПолучитьНастройку("ПроводитьПлатежныеДокументыСОшибкамиПоставщиков",ложь);
					КонецЕсли;				
				КонецЕсли;
				
				НаименованиеВалюты="";
				Для Каждого СледВалюта Из Сurrency() Цикл
					Если СледВалюта.id = КодВалюты Тогда
						НаименованиеВалюты = СледВалюта.name;
						Прервать;
					КонецЕсли;				
				КонецЦикла;
				
				КурсыВалют = ПолучитьКурсыВалютТОНаДату(ИмяПартнераВалюта,НаименованиеВалюты,ПараметрыДата.ДатаВходящегоДокумента);
				Если ОтличноеПроведение = Истина Тогда
					Если НЕ ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТестовыйРежим",Ложь) Тогда
						Парам = Новый Структура;
						Парам.Вставить("r_id",СледТекЗаявка.id); //r_id	integer	true		ID заявки (см.метод /request/{id}) / ID of the application (see method /request/{id})
						Парам.Вставить("type_id",2); //type_id	integer	true		Тип платежа (1 - расчеты с клиентами, 2 - расчеты с партнерами) / Payment type (1 - accounts receivable 2 - accounts with partners)
						Парам.Вставить("cio_id",2); //cio_id	integer	true		Вид платежа (1 - приход, 2 - расход) / Type of payment (1 arrival, 2 - expense)
						Парам.Вставить("reason",ПараметрыДата.НазначениеПлатежа); //reason	string	false		Основание платежа / Basis of payment
						Парам.Вставить("date",Формат(Год(ПараметрыДата.ДатаВходящегоДокумента),"ЧЦ=4; ЧВН=; ЧГ=0")+"-"+Формат(Месяц(ПараметрыДата.ДатаВходящегоДокумента),"ЧЦ=2; ЧВН=; ЧГ=0")+"-"+Формат(День(ПараметрыДата.ДатаВходящегоДокумента),"ЧЦ=2; ЧВН=; ЧГ=0")+" 00:00:00"); //date	datetime	false		Дата платежа, формат: Y-m-d H:i:s, по-умолчанию, ставится текущая дата / Payment date, format: Y-m-d H:i:s, default is the current date
						Парам.Вставить("is_plan",0); //is_plan	integer	false		Плановый платеж (1 - да, 0 - нет) / Scheduled payment (1 - Yes, 0 - no)
						Парам.Вставить("is_bonus_pay",0); //is_bonus_pay	integer	false		Оплата бонусами (1 - да, 0 - нет) / Payment by bonuses (1 - Yes, 0 - no)
						Парам.Вставить("is_deposit",0); //is_deposit	integer	false		Депозитная операция? (1 - да, 0 - нет), по-умолчанию = 0 / Deposit payment? (1 - Yes, 0 - no), default = 0
						//Парам.Вставить("date_plan",	Формат(Год(ПараметрыДата.ДатаВходящегоДокумента),"ЧЦ=4; ЧВН=; ЧГ=0")+"-"+Формат(Месяц(ПараметрыДата.ДатаВходящегоДокумента),"ЧЦ=2; ЧВН=; ЧГ=0")+"-"+Формат(День(ПараметрыДата.ДатаВходящегоДокумента),"ЧЦ=2; ЧВН=; ЧГ=0")+" 00:00:00"); //date_plan	datetime	false		Плановая дата платежа, формат: Y-m-d H:i:s / Scheduled payment date, format: Y-m-d H:i:s
						Парам.Вставить("from1c",0); //from1c	integer	false		Платеж создан в CRM (= 0) или пришел из 1С (= 1) / The payment is created in CRM (= 0) or 1C (= 1)
						Парам.Вставить("supplier_id",ПартнерПоЗаявкеКод); //supplier_id	integer	false		ID партнера / туроператора (см.метод /supplier) / ID of the partner / tour operator (see method /supplier)
						Парам.Вставить("client_id",СледТекЗаявка.client_id); //client_id	integer	false		ID заказчика (см.метод /user) / ID of client (see method /user)
						Парам.Вставить("cash_id",КассаРасчета); //cash_id	integer	false		ID кассы (см.метод /cash), по-умолчанию, берется первая касса / ID cash (see method /cash), by default, takes the first cash
						Парам.Вставить("number",ПараметрыДата.Номер); //number	string	false		Номер платежа (по-умолчанию, берется следующий порядковый номер) / Payment number (by default, it takes the next sequence number)
						Парам.Вставить("currency_id",ВалютаДокументов); //currency_id	integer	false		ID валюты (см.метод /currency) / The currency ID (see method /currency)
						Парам.Вставить("koef",1); //koef	float	false		Курс валюты (по-умолчанию, 1.00) / Currency (default: 1.00)
						Парам.Вставить("price",ПараметрыДата.СуммаДокумента); //price	float	false		Стоимость клиенту / The cost to the client
						Парам.Вставить("note",ПараметрыДата.Комментарий); //note	string	false		Примечание по платежу / Note on payment		
						Если ЭТ_ОбщийМодуль2.PaymentCreate(Парам)<1 Тогда
							Сообщить("ОШИБКА: Во время сохранения данных в СБ произошел сбой, состояние документа не отображено в СБ.");
							ОтличноеПроведение = Ложь;
						Иначе				
							Сообщить("В СБ зафиксирована оплата ТО по заявке "+СледТекЗаявка.id_internal+" в размере "+Строка(ПараметрыДата.СуммаДокумента));
						КонецЕсли;				
					Иначе
						ОтличноеПроведение = Истина;
						Сообщить("Модуль работает в тестовом режиме, вызвано событие создания платежного поручения "+ПараметрыДата.Номер+", в тестовом режиме удаление не производится!");
					КонецЕсли;
				КонецЕсли;
				Возврат ОтличноеПроведение;
				Прервать;
			КонецЕсли;  
		КонецЕсли;  
		
	КонецЦикла;
	
	
	
	//Для Каждого СледКодЗаявки Из УдалитьДублиИзМассива(МассивОбхода) Цикл
	//	Для Каждого СледЗаявка Из ЭТ_ОбщийМодуль2.Request(Новый Структура("id",СледКодЗаявки)) Цикл
	//	КонецЦикла;
	//КонецЦикла;
	Возврат ОтличноеПроведение;
КонецФункции

//ДобавитьПлатежКлиента(ПараметрыДата) Экспорт
//по присланным параметрам добавляет платеж клиента
&НаСервере
Функция ДобавитьПлатежКлиента(ПараметрыДата) Экспорт
	КВозврату = 0;
	КодЗаявки = 0;
	ТекущийПрефикс = ПолучитьНастройку("Префикс");               
	Если СтрДлина(ТекущийПрефикс)<1 Тогда 
		ТекущийПрефикс = "ЭТ18-";
	КонецЕсли;            
	
	НазначениеПлатежа = "";
	
	Если стрДлина(НазначениеПлатежа)<1 И ПараметрыДата.Метаданные().Реквизиты.Найти("НазначениеПлатежа")<>Неопределено Тогда
		Если СтрДлина(СокрЛП(ПараметрыДата.НазначениеПлатежа))>0 Тогда
			НазначениеПлатежа = ПараметрыДата.НазначениеПлатежа;
		КонецЕсли;
	КонецЕсли;
		
	Если стрДлина(НазначениеПлатежа)<1 И ПараметрыДата.Метаданные().Реквизиты.Найти("Основание")<>Неопределено Тогда
		Если СтрДлина(СокрЛП(ПараметрыДата.Основание))>0 Тогда
			НазначениеПлатежа = ПараметрыДата.Основание; 
		КонецЕсли;
	КонецЕсли;
	
	
	Если стрДлина(НазначениеПлатежа)<1 И ПараметрыДата.Метаданные().Реквизиты.Найти("Комментарий")<>Неопределено Тогда
		Если СтрДлина(СокрЛП(Строка(ПараметрыДата.Комментарий)))>0 Тогда
			НазначениеПлатежа = СокрЛП(Строка(ПараметрыДата.Комментарий));		
		КонецЕсли;
	КонецЕсли;

	Если стрДлина(НазначениеПлатежа)<1 И ПараметрыДата.Метаданные().Реквизиты.Найти("ДоговорКонтрагента")<>Неопределено Тогда
		Если СтрДлина(СокрЛП(Строка(ПараметрыДата.ДоговорКонтрагента)))>0 Тогда
			НазначениеПлатежа = СокрЛП(Строка(ПараметрыДата.ДоговорКонтрагента));		
		КонецЕсли;
	КонецЕсли;
	
	
	СледНомер = СтрЗаменить(Формат(СокрЛП(Строка(ПолучитьКодИзСтроки(НазначениеПлатежа,ТекущийПрефикс))),"ЧДЦ=0; ЧРГ=; ЧГ=0")," ","");
	Если СтрДлина(СокрЛП(СледНомер))>0 Тогда
		СледТекЗаявка = ПолучитьЗаявкуПоНомеру(СледНомер);
		//поиск платежного поручения (контроль наличия, дублирования)
		МассивОбхода = Новый Массив;
		СледТекЗаявка = ПолучитьЗаявкуПоНомеру(СледНомер);
		Для Каждого СледПлатежка Из ?(СледТекЗаявка.Свойство("payments"),СледТекЗаявка.payments,Новый Структура()) Цикл
			//ТекСледПлатежка = ЭТ_ОбщийМодуль2.Payment(Новый Структура("id",СледПлатежка.id));
			//Если ТекСледПлатежка.Количество()>0 Тогда
				Если ВРег(СтрЗаменить(СледПлатежка.number," ","")) = ВРег(СтрЗаменить(ПараметрыДата.Номер," ",""))
					И СледПлатежка.cio_id = 1 
					И СледПлатежка.type_id = 1
				Тогда
					ЭТ_ОбщийМодуль2.PaymentDelete(Новый Структура("id",СледПлатежка.id));
				КонецЕсли;
			//КонецЕсли;				
		КонецЦикла;
		
		КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаКлиентНал");
		Если Строка(ТипЗнч(ПараметрыДата.Ссылка))="Операция по платежной карте" Тогда
			КассаРасчета = ЭТ_ОбщийМодуль2.ОпределитьКассуРасчета(ПараметрыДата.ВидОплаты,Новый Структура("КассаЮОН,ПроцентКомиссии,ВРасходы",ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаКлиентКарта"),ЭТ_ОбщийМодуль2.ПолучитьНастройку("КомиссияБанкаКарта"),0)).КассаЮОН;
		ИначеЕсли Строка(ТипЗнч(ПараметрыДата.Ссылка))="Поступление на расчетный счет" Тогда	
			//Пытаемся определить счет
			//ПараметрыДата.СчетОрганизации.НомерСчета
			Если СтрНайти(НРег(ПараметрыДата.СтатьяДвиженияДенежныхСредств.Наименование),"покупат")>0 Тогда 				
				КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаКлиентБезнал");
			Иначе				
				КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаТО");
			КонецЕсли;			
			Если КассаРасчета = 0 Тогда
				КассаРасчета = ЭТ_ОбщийМодуль2.ОпределитьКассуПоРасчетномуСчету(ПараметрыДата.СчетОрганизации.НомерСчета, Истина);
			КонецЕсли;
			Если (КассаРасчета = Неопределено) ИЛИ (КассаРасчета = 0) Тогда КассаРасчета = 1; КонецЕсли;
		КонецЕсли;
		
		
		Если КассаРасчета = Неопределено Тогда КассаРасчета = 1; КонецЕсли;
		
		ВалютаДокументов = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВалютаДокументов");
		Если ВалютаДокументов = Неопределено Тогда ВалютаДокументов = 1; КонецЕсли;
		
		
		
		ОтличноеПроведение = Истина;
		ФиксацияОплаты = 0;
		Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТестовыйРежим",Ложь) Тогда
			Сообщить("Модуль работает в тестовом режиме, вызвано событие создания платежа от туриста "+ПараметрыДата.Номер+", в тестовом режиме создание не производится!");
			Возврат Истина;
		КонецЕсли;

		Для Каждого СледЗаявка Из ЭТ_ОбщийМодуль2.Request(Новый Структура("id",СледТекЗаявка.id)) Цикл    
			СледКодЗаявки = СледЗаявка.id;
			//контроль подготовленных данных
			Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("УведомленияОбОшибкахПлатежейПокупателей",ложь) ИЛИ ЭТ_ОбщийМодуль2.ПолучитьНастройку("ПроводитьПлатежныеДокументыСОшибкамиПокупатели",ложь) Тогда
				ЕстьОшибки = Ложь;
				Контрагент_1С = Ложь;
				//получаем реквизиты документа 1С
				//Если (Строка(ТипЗнч(ПараметрыДата.Ссылка))="Операция по платежной карте")ИЛИ(Строка(ТипЗнч(ПараметрыДата.Ссылка))="Поступление на расчетный счет") Тогда
				Если ПараметрыДата.Метаданные().Реквизиты.Найти("Контрагент")<>Неопределено Тогда
					Контрагент_1С = ПараметрыДата.Контрагент;					
					КонтрагекентСБ = User(Новый Структура("id",СледЗаявка.client_id));
					СовпадениеКонтрагентов = Ложь;
					Если КонтрагекентСБ.Свойство("u_inn") тогда
						Если СокрЛП(Контрагент_1С.ИНН)=СокрЛП(КонтрагекентСБ.u_inn)И СтрДлина(СтрЗаменить(КонтрагекентСБ.u_inn," ",""))>0 Тогда СовпадениеКонтрагентов = Истина; КонецЕсли;
					КонецЕсли;
					Если КонтрагекентСБ.Свойство("u_passport_number") тогда
						Если СтрЧислоВхождений(СтрЗаменить(Контрагент_1С.ДокументУдостоверяющийЛичность," ",""),СтрЗаменить(КонтрагекентСБ.u_passport_number," ",""))>0 И СТрдлина(СтрЗаменить(КонтрагекентСБ.u_passport_number," ",""))>0 Тогда СовпадениеКонтрагентов = Истина;  КонецЕсли;
						Если СтрЧислоВхождений(СтрЗаменить(Контрагент_1С.Комментарий," ",""),СтрЗаменить(КонтрагекентСБ.u_passport_number," ",""))>0 И СТрдлина(СтрЗаменить(КонтрагекентСБ.u_passport_number," ",""))>0 Тогда СовпадениеКонтрагентов = Истина; КонецЕсли;
					КонецЕсли;
					Если КонтрагекентСБ.Свойство("u_surname") и КонтрагекентСБ.Свойство("u_name") и КонтрагекентСБ.Свойство("u_sname")  тогда
						Если СтрЧислоВхождений(НРег(СтрЗаменить(Контрагент_1С.НаименованиеПолное," ","")),НРег(СтрЗаменить((КонтрагекентСБ.u_surname+КонтрагекентСБ.u_name+КонтрагекентСБ.u_sname)," ","")))>0 И СТрдлина(СтрЗаменить((КонтрагекентСБ.u_surname+КонтрагекентСБ.u_name+КонтрагекентСБ.u_sname)," ",""))>0 Тогда СовпадениеКонтрагентов = Истина; КонецЕсли;
					КонецЕсли;					
					Если СовпадениеКонтрагентов = Ложь Тогда ЕстьОшибки = Истина; Иначе	ЕстьОшибки = Ложь;	КонецЕсли;
					Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("УведомленияОбОшибкахПлатежейПокупателей",ложь) И  ЕстьОшибки=Истина  Тогда
						Сообщение = "При проведении документа "+ПараметрыДата.Ссылка+" выявлены ошибки: ";
						СписокОшибок = "";
						Если СовпадениеКонтрагентов=Ложь Тогда СписокОшибок = СписокОшибок + " не совпадают контрагенты "; КонецЕсли;						
						Сообщить(Сообщение+СписокОшибок);
						ЭТ_Почта.ОтправитьПисьмо(
							ЭТ_ОбщийМодуль2.ПолучитьКонтактСотрудника(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты,ПользователиКлиентСервер.ТекущийПользователь().ФизическоеЛицо.Ссылка),
							"Ошибка при разнесении платежа клиента "+ПараметрыДата.Ссылка,
							Сообщение+СписокОшибок
							);
					КонецЕсли;
					Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("ПроводитьПлатежныеДокументыСОшибкамиПокупатели",ложь)=Ложь И ЕстьОшибки=Истина  Тогда
						ОтличноеПроведение = Ложь;	
					КонецЕсли;
				Иначе
					Если ЭТ_ОбщийМодуль2.ПолучитьНастройку("УведомленияОбОшибкахПлатежейПокупателей",ложь)=Истина Тогда
						ЭТ_Почта.ОтправитьПисьмо(
							ЭТ_ОбщийМодуль2.ПолучитьКонтактСотрудника(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты,ПользователиКлиентСервер.ТекущийПользователь().ФизическоеЛицо.Ссылка),
							"Не могу выполнить проверку "+ПараметрыДата.Ссылка,
							"Не могу выполнить проверку поступлений по документу "+ПараметрыДата.Ссылка
							);
						Сообщить("Не могу выполнить проверку поступлений по документу "+ПараметрыДата.Ссылка);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
	
	        Если ОтличноеПроведение = Истина Тогда
				ФиксацияОплаты = ФиксацияОплаты + 1;
				Парам = Новый Структура;
				Парам.Вставить("r_id",СледКодЗаявки); //r_id	integer	true		ID заявки (см.метод /request/{id}) / ID of the application (see method /request/{id})
				Парам.Вставить("cash_id",КассаРасчета); //cash_id	integer	false		ID кассы (см.метод /cash), по-умолчанию, берется первая касса / ID cash (see method /cash), by default, takes the first cash
				Парам.Вставить("currency_id",ВалютаДокументов); //currency_id	integer	false		ID валюты (см.метод /currency) / The currency ID (see method /currency)
				Парам.Вставить("type_id",1); //type_id	integer	true		Тип платежа (1 - расчеты с клиентами, 2 - расчеты с партнерами) / Payment type (1 - accounts receivable 2 - accounts with partners)
				Парам.Вставить("cio_id",1); //cio_id	integer	true		Вид платежа (1 - приход, 2 - расход) / Type of payment (1 arrival, 2 - expense)
				//Парам.Вставить("reason",СокрЛП(Строка(ПараметрыДата))+" по договору "+ НомерДоговора+" от "+Лев(Строка(ПараметрыДата.Дата),10)); //reason	string	false		Основание платежа / Basis of payment
				Парам.Вставить("reason",СокрЛП(Строка(ПараметрыДата))+" по договору "+ ПараметрыДата.ДоговорКонтрагента.Номер+" от "+Лев(Строка(ПараметрыДата.Дата),10)); //reason	string	false		Основание платежа / Basis of payment
				Парам.Вставить("date",Формат(Год(ПараметрыДата.Дата),"ЧЦ=4; ЧВН=; ЧГ=0")+"-"+Формат(Месяц(ПараметрыДата.Дата),"ЧЦ=2; ЧВН=; ЧГ=0")+"-"+Формат(День(ПараметрыДата.Дата),"ЧЦ=2; ЧВН=; ЧГ=0")+" 00:00:00"); //date	datetime	false		Дата платежа, формат: Y-m-d H:i:s, по-умолчанию, ставится текущая дата / Payment date, format: Y-m-d H:i:s, default is the current date
				Парам.Вставить("is_plan",0); //is_plan	integer	false		Плановый платеж (1 - да, 0 - нет) / Scheduled payment (1 - Yes, 0 - no)
				Парам.Вставить("is_bonus_pay",0); //is_bonus_pay	integer	false		Оплата бонусами (1 - да, 0 - нет) / Payment by bonuses (1 - Yes, 0 - no)
				Парам.Вставить("is_deposit",0); //is_deposit	integer	false		Депозитная операция? (1 - да, 0 - нет), по-умолчанию = 0 / Deposit payment? (1 - Yes, 0 - no), default = 0
				Парам.Вставить("from1c",1); //from1c	integer	false		Платеж создан в CRM (= 0) или пришел из 1С (= 1) / The payment is created in CRM (= 0) or 1C (= 1)
				Парам.Вставить("client_id",СледЗаявка.client_id); //client_id	integer	false		ID заказчика (см.метод /user) / ID of client (see method /user)
				Парам.Вставить("number",ПараметрыДата.Номер); //number	string	false		Номер платежа (по-умолчанию, берется следующий порядковый номер) / Payment number (by default, it takes the next sequence number)
				Парам.Вставить("price",ПараметрыДата.СуммаДокумента); //price	float	false		Стоимость клиенту / The cost to the client
				Парам.Вставить("note",ПараметрыДата.Комментарий); //note	string	false		Примечание по платежу / Note on payment
				//Парам.Вставить("date_plan",	Формат(Год(ПараметрыДата.Дата),"ЧЦ=4; ЧВН=; ЧГ=0")+"-"+Формат(Месяц(ПараметрыДата.Дата),"ЧЦ=2; ЧВН=; ЧГ=0")+"-"+Формат(День(ПараметрыДата.Дата),"ЧЦ=2; ЧВН=; ЧГ=0")+" 00:00:00"); //date_plan	datetime	false		Плановая дата платежа, формат: Y-m-d H:i:s / Scheduled payment date, format: Y-m-d H:i:s
				Парам.Вставить("supplier_id",СледЗаявка.supplier_id); //supplier_id	integer	false		ID партнера / туроператора (см.метод /supplier) / ID of the partner / tour operator (see method /supplier)
				Парам.Вставить("koef",1); //koef	float	false		Курс валюты (по-умолчанию, 1.00) / Currency (default: 1.00)
				Если ЭТ_ОбщийМодуль2.PaymentCreate(Парам)<1 Тогда
					Сообщить("ОШИБКА: Во время сохранения данных в СБ произошел сбой, состояние документа не отображено в СБ.");
					ОтличноеПроведение = Ложь;
				Иначе				
					Сообщить("В СБ зафиксирована оплата Клиента по заявке "+СледЗаявка.id_internal+" в размере "+Строка(ПараметрыДата.СуммаДокумента));
					НомерЗаявки = "без номера";
					Если СледЗаявка.Свойство("id_internal") Тогда НомерЗаявки = СледЗаявка.id_internal; КонецЕсли;					
					Сообщение="По заявке "+НомерЗаявки+" была произведена оплата в размере "+Формат(ПараметрыДата.СуммаДокумента,"ЧДЦ=2; ЧРД=.; ЧРГ=' '")+" руб. Время события: "+ Формат(ТекущаяДата(),"ДЛФ=DDT");
					УведомитьМенеджераОбОплате(СледКодЗаявки,Сообщение);
					ОтличноеПроведение = Истина;
				КонецЕсли;
			КонецЕсли;
			Возврат ОтличноеПроведение;
			Прервать;
		КонецЦикла;
		
		ТекстСообщения = "Не могу зафиксировать платеж ";		
		Если Строка(ТипЗнч(ПараметрыДата)) = "Поступление наличных" Тогда ТекстСообщения = ТекстСообщения + ПараметрыДата.Комментарий;	КонецЕсли;
		Сообщить(ТекстСообщения);
	КонецЕсли;	
	Возврат Ложь;
КонецФункции

//УдалитьПлатежТО(ПараметрыДата) Экспорт
//удаляет платеж ТО
&НаСервере
Функция УдалитьПлатежТО(ПараметрыДата) Экспорт
	КВозврату = 0;
	КодЗаявки = 0;
	ТекущийПрефикс = ПолучитьНастройку("Префикс");
	МассивОбхода = Новый Массив;
	ОтличноеПроведение = Ложь;
	Для Каждого СледНомер Из ВырезатьИзСтроки(ПараметрыДата.ДоговорКонтрагента.Наименование+" "+ПараметрыДата.ДоговорКонтрагента.Наименование,"(",")") Цикл
		СледНомер = СокрЛП(УдалитьДатуИзСтроки(СледНомер));		
		Если СтрДлина(СокрЛП(СледНомер))>0 Тогда
			//поиск платежного поручения (контроль наличия, дублирования)
			СледТекЗаявка = ПолучитьЗаявкуПоНомеру(СледНомер);
			Для Каждого СледПлатежка Из СледТекЗаявка.payments Цикл
				//Для Каждого ТекСледПлатежка
				//ТекСледПлатежка = ЭТ_ОбщийМодуль2.Payment(Новый Структура("id",СледПлатежка.id));
				//Если ТекСледПлатежка.Количество()>0 Тогда
					Если ВРег(СтрЗаменить(СледПлатежка.number," ","")) = ВРег(СтрЗаменить(ПараметрыДата.Номер," ","")) 
						И СледПлатежка.cio_id = 2 
						И СледПлатежка.type_id = 2
					Тогда
						НомерДокумента = ЭТ_ОбщийМодуль2.PaymentDelete(Новый Структура("id",СледПлатежка.id));
						Если НомерДокумента>0 Тогда
							Сообщить("В СБ удалено платежное поручение "+СледПлатежка.number+" на сумму "+СледПлатежка.price+" руб. заявка "+СледНомер);
						КонецЕсли;
						ОтличноеПроведение = Истина;
					КонецЕсли;
				//КонецЕсли;
			КонецЦикла; 							
		КонецЕсли;
	КонецЦикла;
	Возврат ОтличноеПроведение;
КонецФункции

//УдалитьПлатежКлиента(ПараметрыДата) Экспорт
//удаляет платеж ТО
&НаСервере
Функция УдалитьПлатежКлиента(ПараметрыДата) Экспорт
	КВозврату = 0;
	КодЗаявки = 0;
	ТекущийПрефикс = ПолучитьНастройку("Префикс");
	СледНомер = ПолучитьКодИзСтроки(ПараметрыДата.ДоговорКонтрагента.Номер,ТекущийПрефикс);
	Если СледНомер<1 Тогда
        СледНомер = ПолучитьКодИзСтроки(ПараметрыДата.НазначениеПлатежа,ТекущийПрефикс);
	КонецЕсли;	  
	
	Если СтрДлина(СокрЛП(СледНомер))>0 Тогда
		//поиск платежного поручения (контроль наличия, дублирования)
		СледТекЗаявка = ЭТ_ОбщийМодуль2.ПолучитьЗаявкуПоНомеру(СледНомер);
		Если СледТекЗаявка.Свойство("payments") Тогда
			Для Каждого СледПлатежка Из СледТекЗаявка.payments Цикл
				Если ВРег(СтрЗаменить(СледПлатежка.number," ","")) = ВРег(СтрЗаменить(ПараметрыДата.Номер," ","")) 	
					И СледПлатежка.cio_id = 1
					И СледПлатежка.type_id = 1
				Тогда
					НомерДокумента = ЭТ_ОбщийМодуль2.PaymentDelete(Новый Структура("id",СледПлатежка.id));
					Если НомерДокумента>0 Тогда Сообщить("В СБ удалено платежное поручение "+СледПлатежка.number+" на сумму "+СледПлатежка.price+" руб. заявка "+СледТекЗаявка.id_internal); КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

//УдалитьСписаниеКлиента(ПараметрыДата) Экспорт
//удаляет списание клиента
&НаСервере
Функция УдалитьСписаниеКлиента(ПараметрыДата) Экспорт
	КВозврату = 0;
	КодЗаявки = 0;
	ТекущийПрефикс = ПолучитьНастройку("Префикс");
	СледНомер = ПолучитьКодИзСтроки(ПараметрыДата.ДоговорКонтрагента.Номер,ТекущийПрефикс);
	Если СледНомер<1 Тогда
        СледНомер = ПолучитьКодИзСтроки(ПараметрыДата.НазначениеПлатежа,ТекущийПрефикс);
	КонецЕсли;	  

	Если СтрДлина(СокрЛП(СледНомер))>0 Тогда
		//поиск платежного поручения (контроль наличия, дублирования)
		СледТекЗаявка = ЭТ_ОбщийМодуль2.ПолучитьЗаявкуПоНомеру(СледНомер);
		Для Каждого СледПлатежка Из СледТекЗаявка.payments Цикл
			ТекСледПлатежка = ЭТ_ОбщийМодуль2.Payment(Новый Структура("id",СледПлатежка.id));
			Если							
				(
					(СокрЛП(ВРег(Строка(СледПлатежка.number))) = СокрЛП(ВРег(Строка(ПараметрыДата.Номер))))
					ИЛИ (СтрНайти(СледПлатежка.reason, ПараметрыДата.ДоговорКонтрагента.Номер)>0 И СледПлатежка.price = ПараметрыДата.СуммаДокумента)
				  ) И ТекСледПлатежка.cio_id = 2// И ТекСледПлатежка.type_id = 1
			Тогда
				//получаем режимы работы
				Если НЕ ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТестовыйРежим",Ложь) Тогда										
					НомерДокумента = ЭТ_ОбщийМодуль2.PaymentDelete(Новый Структура("id",СледПлатежка.id));
					Если НомерДокумента>0 Тогда Сообщить("В СБ удалено списание "+ТекСледПлатежка.number+" на сумму "+ТекСледПлатежка.price+" руб. заявка "+СледТекЗаявка.id_internal); КонецЕсли;
				Иначе
					Сообщить("Модуль работает в тестовом режиме, вызвано событие удаления списания клиента "+ПараметрыДата.Номер+", в тестовом режиме удаление не производится!");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;		
	Возврат Истина;
КонецФункции

//ДобавитьСписаниеКлиента(ПараметрыДата) Экспорт
//добавляет списание клиента
//В качестве параметра указывается любой документ, содержащий ДоговорКонтрагента, по которому нужно провести списание
&НаСервере
Функция ДобавитьСписаниеКлиента(ПараметрыДата) Экспорт
	КВозврату = 0;
	КодЗаявки = 0;
	ТекущийПрефикс = ПолучитьНастройку("Префикс");
	МассивОбхода = Новый Массив;
    СледНомер = ПолучитьКодИзСтроки(ПараметрыДата.ДоговорКонтрагента.Номер,ТекущийПрефикс);
	Если СледНомер<1 Тогда
        СледНомер = ПолучитьКодИзСтроки(ПараметрыДата.НазначениеПлатежа,ТекущийПрефикс);
	КонецЕсли;	  
	
	//поиск платежного поручения (контроль наличия, дублирования)
	ВариантыНомера = ПолучитьВариантыНомера(СледНомер);	
	//ВариантыНомера = Новый Массив;
	//ВариантыНомера.Добавить(Формат(СледНомер,"ЧГ=0"));
	//ВариантыНомера.Добавить(ТекущийПрефикс+Формат(СледНомер,"ЧГ=0"));
	//ВариантыНомера.Добавить(СокрЛП(ТекущийПрефикс)+СокрЛП(Формат(СледНомер,"ЧГ=0")));	
	//ВариантыНомера.Добавить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(Формат(СледНомер,"ЧГ=0")),"-"," - "),"  "," "),"  "," "));		
	Для Каждого ВариантНомера Из ВариантыНомера Цикл
		Парам = Новый Структура;
		Парам.Вставить("r_id_internal",ВариантНомера);	
		МассивДанных = ЭТ_ОбщийМодуль2.RequestSearch(Парам);
		Для Каждого СледЭлемент Из МассивДанных Цикл
			Если (НЕ ЕстьВМассиве(МассивОбхода,СледЭлемент.id)) Тогда
				МассивОбхода.Добавить(СледЭлемент.id);
				ТекЗаявка = ЭТ_ОбщийМодуль2.Request(Новый Структура("id",СледЭлемент.id));
				Для Каждого СледТекЗаявка Из ТекЗаявка Цикл
					Для Каждого СледПлатежка Из СледТекЗаявка.payments Цикл
						//Для Каждого ТекСледПлатежка
						ТекСледПлатежка = ЭТ_ОбщийМодуль2.Payment(Новый Структура("id",СледПлатежка.id));
						//Если							
						//	(
						//		(СокрЛП(ВРег(Строка(СледПлатежка.number))) = СокрЛП(ВРег(Строка(ПараметрыДата.Номер))))
						//		ИЛИ (СтрНайти(СледПлатежка.reason, ПараметрыДата.ДоговорКонтрагента.Номер)>0 И СледПлатежка.price = ПараметрыДата.СуммаДокумента)
						//	  ) И ТекСледПлатежка.cio_id = 2 И ТекСледПлатежка.type_id = 1
						Если							
							(
								(СокрЛП(ВРег(Строка(СледПлатежка.number))) = СокрЛП(ВРег(Строка(ПараметрыДата.Номер))))
								ИЛИ (СтрНайти(СледПлатежка.reason, ПараметрыДата.ДоговорКонтрагента.Номер)>0 И СледПлатежка.price = ПараметрыДата.СуммаДокумента)
							  ) И ТекСледПлатежка.cio_id = 2 И ТекСледПлатежка.type_id = 1
						Тогда
							//получаем режимы работы
							Если НЕ ЭТ_ОбщийМодуль2.ПолучитьНастройку("ТестовыйРежим",Ложь) Тогда										
								ЭТ_ОбщийМодуль2.PaymentDelete(Новый Структура("id",СледПлатежка.id));
							Иначе
								Сообщить("Модуль работает в тестовом режиме, вызвано событие удаления списания клиента "+ПараметрыДата.Номер+", в тестовом режиме удаление не производится!");
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;				
		КонецЦикла;
	КонецЦикла;
	
	
	
	КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаКлиентНал");
	Если Строка(ТипЗнч(ПараметрыДата.Ссылка))="Операция по платежной карте" Тогда
		КассаРасчета = ЭТ_ОбщийМодуль2.ОпределитьКассуРасчета(ПараметрыДата.ВидОплаты,Новый Структура("КассаЮОН,ПроцентКомиссии,ВРасходы",ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаКлиентКарта"),ЭТ_ОбщийМодуль2.ПолучитьНастройку("КомиссияБанкаКарта"),0)).КассаЮОН;
		//КассаРасчета = ЭТ_ОбщийМодуль2.ПолучитьНастройку("КассаКлиентКарта");
