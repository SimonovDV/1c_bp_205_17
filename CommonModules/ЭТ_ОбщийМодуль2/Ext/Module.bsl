		|		ХозрасчетныйДвиженияССубконто.Регистратор.ДоговорКонтрагента.Ссылка В (&Договор)
		|		ИЛИ ХозрасчетныйДвиженияССубконто.СубконтоДт2 В (&Договор)
		|		ИЛИ ХозрасчетныйДвиженияССубконто.СубконтоКт2 В (&Договор)
		|	)
		|	И (
		|		ТИПЗНАЧЕНИЯ(ХозрасчетныйДвиженияССубконто.Регистратор) = ТИП(Документ.ОплатаПлатежнойКартой) 
		|		ИЛИ ТИПЗНАЧЕНИЯ(ХозрасчетныйДвиженияССубконто.Регистратор) = ТИП(Документ.ПоступлениеНаРасчетныйСчет) 
		|		ИЛИ ТИПЗНАЧЕНИЯ(ХозрасчетныйДвиженияССубконто.Регистратор) = ТИП(Документ.СписаниеСРасчетногоСчета) 
		|		ИЛИ ТИПЗНАЧЕНИЯ(ХозрасчетныйДвиженияССубконто.Регистратор) = ТИП(Документ.ПриходныйКассовыйОрдер) 
		|		ИЛИ ТИПЗНАЧЕНИЯ(ХозрасчетныйДвиженияССубконто.Регистратор) = ТИП(Документ.РасходныйКассовыйОрдер) 
		|		ИЛИ ТИПЗНАЧЕНИЯ(ХозрасчетныйДвиженияССубконто.Регистратор) = ТИП(Документ.КорректировкаДолга) 
		|	  )
		|";
	
		
		
