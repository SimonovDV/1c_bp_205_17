&НаСервере
Функция ЗаменитьПараметрыВШаблоне(Шаблон, Параметры) Экспорт
    
    Шаблон = Строка(Шаблон);
    Результат = Шаблон;
    
    Если Параметры = Неопределено Тогда
        Параметры = Новый Структура;
    КонецЕсли;
    
    СоответствиеКлючей = Новый Соответствие;
    ВсеКлючи = "";
    ВсеПары = "";
    
    Для Каждого Парам Из Параметры Цикл
        
        КлючСтрокой = Строка(Парам.Ключ);
        ЗначениеСтрокой = Строка(Парам.Значение);
        
        // Соответствие для обычных подстановок
        СоответствиеКлючей.Вставить(НРег(КлючСтрокой), Парам.Значение);
        
        // {all} – все ключи
        Если НЕ ПустаяСтрока(ВсеКлючи) Тогда
            ВсеКлючи = ВсеКлючи + ", ";
        КонецЕсли;
        ВсеКлючи = ВсеКлючи + КлючСтрокой;
        
        // {allvalue} – только пары с непустым значением
        Если НЕ ПустаяСтрока(ЗначениеСтрокой) Тогда
            Если НЕ ПустаяСтрока(ВсеПары) Тогда
                ВсеПары = ВсеПары + ", ";
            КонецЕсли;
            ВсеПары = ВсеПары + КлючСтрокой + "=" + ЗначениеСтрокой;
        КонецЕсли;
        
    КонецЦикла;
    
    ПозНачало = 1;
    Пока Истина Цикл
        
        ДлинаРезультата = СтрДлина(Результат);
        Если ДлинаРезультата = 0 Тогда
            Прервать;
        КонецЕсли;
        
        Если ПозНачало < 1 Тогда
            ПозНачало = 1;
        КонецЕсли;
        
        Если ПозНачало > ДлинаРезультата Тогда
            Прервать;
        КонецЕсли;
        
        ПозОткрыть = СтрНайти(Результат, "{", НаправлениеПоиска.СНачала, ПозНачало);
        Если ПозОткрыть = 0 Тогда
            Прервать;
        КонецЕсли;
        
        ПозЗакрыть = СтрНайти(Результат, "}", НаправлениеПоиска.СНачала, ПозОткрыть + 1);
        Если ПозЗакрыть = 0 Тогда
            Прервать;
        КонецЕсли;
        
        ДлинаКлюча = ПозЗакрыть - ПозОткрыть - 1;
        Если ДлинаКлюча <= 0 Тогда
            Результат = Лев(Результат, ПозОткрыть - 1) + Сред(Результат, ПозЗакрыть + 1);
            ПозНачало = ПозОткрыть;
            Продолжить;
        КонецЕсли;
        
        Ключ = Сред(Результат, ПозОткрыть + 1, ДлинаКлюча);
        КлючНРег = НРег(Ключ);
        
        Если КлючНРег = "all" Тогда
            Результат = Лев(Результат, ПозОткрыть - 1) + ВсеКлючи + Сред(Результат, ПозЗакрыть + 1);
            ПозНачало = ПозОткрыть + СтрДлина(ВсеКлючи);
            Продолжить;
        КонецЕсли;
        
        Если КлючНРег = "allvalue" Тогда
            Результат = Лев(Результат, ПозОткрыть - 1) + ВсеПары + Сред(Результат, ПозЗакрыть + 1);
            ПозНачало = ПозОткрыть + СтрДлина(ВсеПары);
            Продолжить;
        КонецЕсли;
        
        Значение = СоответствиеКлючей.Получить(КлючНРег);
        
        Если Значение <> Неопределено Тогда
            СтрЗначение = Строка(Значение);
            Результат = Лев(Результат, ПозОткрыть - 1) + СтрЗначение + Сред(Результат, ПозЗакрыть + 1);
            ПозНачало = ПозОткрыть + СтрДлина(СтрЗначение);
        Иначе
            Результат = Лев(Результат, ПозОткрыть - 1) + Сред(Результат, ПозЗакрыть + 1);
            ПозНачало = ПозОткрыть;
        КонецЕсли;
        
    КонецЦикла;
    
    Возврат Результат;
    
КонецФункции

//Возвращает структуру разобранного номера
&НаСервере
Функция ПолучитьШаблонПоискаЗаявки(ЗначениеПоиска) Экспорт
	Префикс = ЭТ_ОбщийМодуль2.ПолучитьНастройку("Префикс","ЭТ18-");
	Номер = ЭТ_ОбщийМодуль2.ОставитьТолькоЦифры(СтрЗаменить(СтрЗаменить(ЗначениеПоиска," ",""),СтрЗаменить(Префикс," ",""),""));	
	Возврат Новый Структура("Префикс,ПрефиксПоиск,Номер",
		Префикс,
		СтрЗаменить(СтрЗаменить(Префикс," ",""),"-",""),
		Номер	
	);
КонецФункции

//СоздатьСписокКлючей(Строка,КакМассив=Ложь) Экспорт
//создает список ключей из полученной строки, ключи могут быть перечислены через пробел, запятую, точку с запятой, слеш
//Строка - строка входящих ключей
//КакМассив - если Истина, то вернет линейный массив ключей, если ложь, то вернет список значений (по умолчанию ложь)
&НаСервере
Функция СоздатьСписокКлючей(Строка,КакМассив=Ложь) Экспорт
	Строка = СтрЗаменить(Строка,","," ");
	Строка = СтрЗаменить(Строка,";"," ");
	Строка = СтрЗаменить(Строка,"/"," ");
	Строка = НРег(Строка);
	Строка = СокрЛП(Строка);
	Если КакМассив Тогда 
		КВозврату = СтрРазделить(Строка," ",Ложь);
	Иначе
		КВозврату = Новый СписокЗначений;
		Для Каждого СледЭлемент Из СтрРазделить(Строка," ",Ложь) Цикл
			КВозврату.Добавить(СледЭлемент,СледЭлемент);
		КонецЦикла;			
	КонецЕсли;
	Возврат КВозврату;
КонецФункции

//ЗаменаHTMLКодов(Знач ВходящаяСтрока) Экспорт
//заменяет во ВходящаяСтрока HTML символы на читаемые
//на текущий момент обрабатывает кавычки &quot;
&НаСервере
Функция ЗаменаHTMLКодов(Знач ВходящаяСтрока) Экспорт
	СоответствиеКодов = Новый Соответствие();
	СоответствиеКодов.Вставить("&quot;", Символ(34));      
	Для каждого ЭлементКод Из СоответствиеКодов Цикл
		ВходящаяСтрока = СтрЗаменить(ВходящаяСтрока, ЭлементКод.Ключ, ЭлементКод.Значение);
	КонецЦикла; 	
	Возврат ВходящаяСтрока;
КонецФункции

//ВырезатьИзСтроки(Стр,Нач,Кон) Экспорт
//Из строки Стр удаляет подстроку, которая начинается с подстроки Нач, и заканчивается подстрокой Кон
&НаСервере
Функция ВырезатьИзСтроки(Стр,Нач,Кон) Экспорт
	КВозврату = Новый Массив;
	Для Каждого СледСтр Из СтрРазделить(Стр,Нач) Цикл
		Если СтрНайти(СледСтр,Кон)>0 Тогда
			КВозврату.Добавить(Лев(СледСтр,СтрНайти(СледСтр,Кон)-1));
		КонецЕсли;		
	КонецЦикла;
	Возврат КВозврату;
КонецФункции

//НайтиМежду(Стр,Нач, Кон) Экспорт
//Из строки Стр возвращает подстроку, которая начинается с подстроки Нач, и заканчивается подстрокой Кон
&НаСервере
Функция НайтиМежду(Стр,Нач, Кон) Экспорт
	Начало = Найти(Стр,Нач);
	Конец =  Найти(Стр,Кон);
	Если Конец = 0 Тогда Конец = СтрДлина(Стр); КонецЕсли;
	Если Начало = 0 Тогда Возврат ""; КонецЕсли;
	Возврат Сред(Стр,Начало,(Конец-Начало)+СтрДлина(Кон));
КонецФункции

//НайтиПоШаблону_СоздатьШаблон(Стр,Строка1, Режим)
//используется совместно с функцией НайтиПоШаблону для создания шаблона
//правила замены символов регламентируются режимом работы функции, подробнее о режимах в описании функции НайтиПоШаблону
&НаСервере
Функция НайтиПоШаблону_СоздатьШаблон(Стр,Строка1, Режим)
	СтрКод="";
	Для Индекс = 0 По СтрДлина(Стр) Цикл
		Если ЭтоЦифра(Сред(Стр, Индекс, 1)) ИЛИ Найти(Строка1,Сред(Стр, Индекс, 1))>0 Тогда
			СтрКод = СтрКод + "1";
		Иначе
			Если ЕстьВМассиве(Новый Массив(1,3),Режим) Тогда
				СтрКод = СтрКод + ВРег(Сред(Стр, Индекс, 1));
			Иначе
				СтрКод = СтрКод + "0";
			КонецЕсли;			
		КонецЕсли;
	КонецЦикла;
	Если ЕстьВМассиве(Новый Массив(3,4),Режим) Тогда	
		Пока Найти(СтрКод,"1")>0 Цикл        
			СтрКод = СтрЗаменить(СтрКод,"11","1");
		КонецЦикла;  
	КонецЕсли;	
	Возврат СтрКод;
КонецФункции

&НаСервере
//НайтиПоШаблону(Стр,Шаблон,Строка1="",Режим=0) Экспорт
//осуществляет поиск в строке Стр по заданному шаблону Шаблон,
//Режимы (0,1 - подходят для поиска даты, 3,4 - подходят для поиска суммы и т.д.):
//	0 - все числовые знаки заменяются 1, все символы 0, производится сравнение и выбирается нужная подстрока
//	1 - все числовые знаки заменяются 1, символы переводятся в один регистр, производится сравнение и выбирается нужная подстрока
//	3 - все числа (не знаки чисел, а числа) заменяются 1, все символы 0, производится сравнение и выбирается нужная подстрока 
//	4 - все числа (не знаки чисел, а числа) заменяются 1, символы переводятся в один регистр, производится сравнение и выбирается нужная подстрока
//Строка1 - набор символов воспринимается как число и сравнение произвозится как число
Функция НайтиПоШаблону(Стр,Шаблон,Строка1="",Режим=0) Экспорт
	КВозврату = "";
	СтрКод=НайтиПоШаблону_СоздатьШаблон(Стр,Строка1,Режим);
	ШаблонКод=НайтиПоШаблону_СоздатьШаблон(Шаблон,Строка1,Режим);
	Если Найти(СтрКод,ШаблонКод)>0 Тогда
		КВозврату = Сред(Стр, Найти(СтрКод,ШаблонКод), СтрДлина(ШаблонКод)-1);
	КонецЕсли;
	Возврат КВозврату;
КонецФункции

//ЕстьВМассиве(Массив,Значение,ИгнорироватьПробелыИРегистр=Ложь) Экспорт
//перебирает Массив, и если в нем встречается Значение вернет Истина, иначе Ложь
//если ИгнорироватьПробелыИРегистр = Истина, то сравнение выполняется без учета пробелов и регистра
//для непростых типов (объекты 1С и т.п.) всегда используется обычное сравнение
Функция ЕстьВМассиве(Массив, Значение, ИгнорироватьПробелыИРегистр = Ложь) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	ЭтоПростойТип = Ложь;
	
	Если ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Неопределено") Тогда
		ЭтоПростойТип = Истина;
	КонецЕсли;
	
	Если НЕ ЭтоПростойТип Тогда
		ИгнорироватьПробелыИРегистр = Ложь;
	КонецЕсли;
	
	Если НЕ ИгнорироватьПробелыИРегистр Тогда
		Для Каждого СледЭл Из Массив Цикл
			Если СледЭл = Значение Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ИскомоеЗначение = НРег(СтрЗаменить(Строка(Значение), " ", ""));
		
		Для Каждого СледЭл Из Массив Цикл
			
			Если ТипЗнч(СледЭл) = Тип("Строка")
				ИЛИ ТипЗнч(СледЭл) = Тип("Число")
				ИЛИ ТипЗнч(СледЭл) = Тип("Дата")
				ИЛИ ТипЗнч(СледЭл) = Тип("Булево")
				ИЛИ ТипЗнч(СледЭл) = Тип("Неопределено") Тогда
				
				Если НРег(СтрЗаменить(Строка(СледЭл), " ", "")) = ИскомоеЗначение Тогда
					Возврат Истина;
				КонецЕсли;
				
			Иначе
				Если СледЭл = Значение Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции


//УдалитьДублиИзМассива(Массив) Экспорт
//из присланного Массив удаляет все дубли, работает методом перебора
Функция УдалитьДублиИзМассива(Массив) Экспорт
	НовыйМассив = Новый Массив;
	Для Каждого СледЭлементМассив Из Массив Цикл
		ЕстьВновомМассиве = Ложь;
		Для Каждого СледЭлементНовыйМассив Из НовыйМассив Цикл
			Если СледЭлементМассив = СледЭлементНовыйМассив Тогда
				ЕстьВновомМассиве = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;		
		Если НЕ ЕстьВновомМассиве Тогда
			НовыйМассив.Добавить(СледЭлементМассив);
		КонецЕсли;		
	КонецЦикла;	
	Возврат НовыйМассив;
КонецФункции

//КонвертацияДатыИзЮниксВСтроку(Пар) Экспорт
//преобразует присланную дату в строку даты Юникс
Функция КонвертацияДатыИзЮниксВСтроку(Пар) Экспорт
	ПарВозврат = "";
	Мас = СтрРазделить(Пар,"-");
	Если Мас.Количество()>2 Тогда
		ПарВозврат = ПарВозврат + Лев(Мас[2],2);
		ПарВозврат = ПарВозврат + "." + Лев(Мас[1],2);
		ПарВозврат = ПарВозврат + "." + Лев(Мас[0],4);
	КонецЕсли;
	Возврат ПарВозврат;
КонецФункции

//КонвертацияДатыИзЮниксВДату(СтроковаяДата) Экспорт
//преобразует присланную строку даты Юникс в дату
Функция КонвертацияДатыИзЮниксВДату(СтроковаяДата) Экспорт
	СтроковаяДата = СтрЗаменить(СтроковаяДата , "-",""); 
	СтроковаяДата = СтрЗаменить(СтроковаяДата , ":",""); 
	СтроковаяДата = СтрЗаменить(СтроковаяДата , " ",""); 
	СтроковаяДата = ЭТ_ОбщийМодуль2.ОставитьТолькоЦифры(СтроковаяДата);
	Если СтрДлина(СтроковаяДата)>0 Тогда
		Возврат Дата(СтроковаяДата);
	Иначе
		Возврат "";
	КонецЕсли;	
КонецФункции

//ПолучитьВариантыНомера(СледНомер)  Экспорт
//возвращает возможные варианты номера для поиска
//из входящего параметра СледНомер формирует массив строк с вариантами номера
//используется для поиска заявок в СБ
&НаСервере
Функция ПолучитьВариантыНомера(Знач СледНомер)  Экспорт
	ТекущийПрефикс = ПолучитьНастройку("Префикс");
	СледНомер = ОставитьТолькоЦифры(СтрЗаменить(СтрЗаменить(СледНомер," ",""),СтрЗаменить(ТекущийПрефикс," ",""),""));
	ВариантыНомера = Новый Массив;
	ВариантыНомера.Добавить(Формат(СледНомер,"ЧГ=0"));
	ВариантыНомера.Добавить(Строка(ТекущийПрефикс)+Строка(Формат(СледНомер,"ЧГ=0")));
	ВариантыНомера.Добавить(СокрЛП(ТекущийПрефикс)+СокрЛП(Формат(СледНомер,"ЧГ=0")));	
	ВариантыНомера.Добавить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(Формат(СледНомер,"ЧГ=0")),"-"," - "),"  "," "),"  "," "));				
	Возврат ВариантыНомера;
КонецФункции
	
//ПолучитьКодИзСтроки(Строка,Преф = "") Экспорт
//разбирает присланную строку Строка, с учетом префикса Преф
//возвращает числовой номер заявки (без префикса), 
//если нет возможности вычислить номер, то возвращается 0
&НаСервере
Функция ПолучитьКодИзСтроки(Строка,Преф = "") Экспорт
	Стр = Строка;
	//Стр = СтрЗаменить(Строка," ","");
	//Преф = СтрЗаменить(Преф," ","");
	КВозврату = "";
	ШаблонСтр = "";
	ЕстьОшибки = Ложь;
	Стр = СтрЗаменить(Стр," ","");
	Преф2 = СтрЗаменить(Преф," ","");
	Если СтрДлина(Преф2) > 0 Тогда
		Индекс = СтрНайти(ВРег(Стр),ВРег(Преф2),НаправлениеПоиска.СКонца);
		Если Индекс > 0 Тогда
			Стр = Прав(Стр,СтрДлина(Стр) - Индекс+1);
		Иначе
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Стр=СтрЗаменить(Стр,Преф2,"");
	СчетНачат = Истина;		
	Для Индекс = 1 По СтрДлина(Стр) Цикл
		Если ЭтоЦифра(Сред(Стр,Индекс,1)) И СчетНачат = Истина Тогда
			КВозврату=КВозврату + Сред(Стр,Индекс,1);
		Иначе
			СчетНачат = Ложь;			
		КонецЕсли;
	КонецЦикла;
	
	Если СтрДлина(КВозврату)<1 Тогда 
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Для Индекс = 0 По СтрДлина(КВозврату) Цикл
		Если НЕ ЭтоЦифра(Сред(КВозврату,Индекс,1)) Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОшибки = Истина Тогда
		КВозврату = 0;
	Иначе
		КВозврату = Число(КВозврату);
	КонецЕсли;
	Возврат КВозврату;
КонецФункции

//ОставитьТолькоЦифры(Строка,Знаки="")Экспорт
//из присланной строки Строка оставляет только цифры и перечисленные в строке Знаки символы
//на выходе строка чисел с допустимыми знаками
//в знаки можно передавать .,- и т.д, можно несколько сразу и без учета местоположения
&НаСервере
Функция ОставитьТолькоЦифры(Строка,Знаки="")Экспорт
	КВозврату = "";
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Если ЭтоЦифра(Сред(Строка,Индекс,1)) ИЛИ СтрНайти(НРег(Знаки),НРег(Сред(Строка,Индекс,1)))>0 Тогда
			КВозврату=КВозврату+Сред(Строка,Индекс,1);
		КонецЕсли;
	КонецЦикла;
	Возврат КВозврату;
КонецФункции

//Пауза(Сек)
//организует условную паузу в секундах, строится на счетчике времени
//приоритетно используется для связи с СБ, там есть интервал обращений
&НаСервере
Процедура Пауза(Сек) Экспорт
	//ВремяНаВходе = Минута(ТекущаяДата())*100+Секунда(ТекущаяДата());
	//Пока Минута(ТекущаяДата())*100+Секунда(ТекущаяДата()) < ВремяНаВходе+Сек Цикл КонецЦикла;
КонецПроцедуры

//ЭтоЦифра(Символ) Экспорт
//если переданный символ является цифрой, вернет истина, иначе ложь
//если в Символ передавать строку длинна которой будет отличной от 1 символа, вернется ложь
&НаСервере
Функция ЭтоЦифра(Символ) Экспорт
	НаборЦифр = "1234567890";
	КВозврату=Ложь;
	Для Индекс = 0 По СтрДлина(НаборЦифр) Цикл
		Если Сред(НаборЦифр,Индекс,1) = Символ Тогда
			КВозврату=Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат КВозврату;
КонецФункции

//ЦифрыВСтрокеНачало(Строка) Экспорт
//вычисляет начальную позицию чисел в строке Строка,
//если числа не найдены вернет ложь
&НаСервере
Функция ЦифрыВСтрокеНачало(Строка) Экспорт
	КВозврату=Ложь;
	Для Индекс = 0 По СтрДлина(Строка) Цикл
		Если ЭтоЦифра(Сред(Строка,Индекс,1)) И КВозврату = Ложь Тогда
			КВозврату=Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат КВозврату;	
КонецФункции

//ЦифрыВСтрокеКонец(Строка)
//вычисляет конечную позицию чисел в строке Строка,
//если числа не найдены вернет ложь
&НаСервере
Функция ЦифрыВСтрокеКонец(Строка) Экспорт
	КВозврату=Ложь;
	Для Индекс = 0 По СтрДлина(Строка) Цикл
		Если ЭтоЦифра(Сред(Строка,Индекс,1)) Тогда
			КВозврату=Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат КВозврату;	
КонецФункции

//ИННизНазвания(Строка)
//из присланной строки Строка
//вычисляет ИНН, умеет отличать ИНН 10 и 12 знаков (проверка на ИП)
&НаСервере
Функция ИННизНазвания(Строка) Экспорт
	Поз=Найти(Строка, "ИНН");
	Если Поз > 0 Тогда
		Строка = Прав(Строка,(СтрДлина(Строка)-Поз+1));
		Начало = ЦифрыВСтрокеНачало(Строка);
		Если НЕ Начало = Ложь Тогда
			Строка = Прав(Строка,(СтрДлина(Строка)-Начало+1));
			Конец = ЦифрыВСтрокеКонец(Строка);
			Строка = Лев(Строка,Конец);
		КонецЕсли;
	Иначе
		МассивШаблоновСравнения = Новый Массив;
		МассивШаблоновСравнения.Добавить(10);
		МассивШаблоновСравнения.Добавить(12);
		МассивВхождений = Новый Массив;
		ПризнакСчета=Ложь;
		Счет=0;
		ТекСтрока="";
		МояСтрока=Строка+" ";
		Для Индекс = 1 По СтрДлина(МояСтрока) Цикл
			Если ЭтоЦифра(Сред(МояСтрока,Индекс,1)) Тогда
				ТекСтрока = ТекСтрока + Сред(МояСтрока,Индекс,1);
			Иначе
				Если СтрДлина(ТекСтрока)>0 Тогда
					Для Каждого ШаблонСравнения Из МассивШаблоновСравнения Цикл
						Если СтрДлина(ТекСтрока) = ШаблонСравнения Тогда
							МассивВхождений.Добавить(ТекСтрока);
						КонецЕсли;
					КонецЦикла;
					ТекСтрока="";
				КонецЕсли;				
			КонецЕсли;
		КонецЦикла;
		
		Если МассивВхождений.Количество() = 1 Тогда 
			Строка = МассивВхождений[0];
		ИначеЕсли НЕ СтрНайти(ВРег(" "+Строка)," ИП ") = 0 Тогда
			Найден=Ложь;
			Для Каждого ТекущийМассивВхождений Из МассивВхождений Цикл
				Если СтрДлина(ТекущийМассивВхождений) = 12 Тогда
					Найден=Истина;
					Строка = ТекущийМассивВхождений;
				КонецЕсли;
				Если Найден = Ложь Тогда
					Строка = МассивВхождений[МассивВхождений.Количество()-1];
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли МассивВхождений.Количество() > 0 Тогда
			Строка = МассивВхождений[МассивВхождений.Количество()-1];
		Иначе
			Строка = "";
		КонецЕсли;
	КонецЕсли;
	Возврат Строка;
КонецФункции

//ПолучитьДатуИзСтроки(Строка) Экспорт
//из присланной строки Строка возвращает найденную дату
&НаСервере
Функция ПолучитьДатуИзСтроки(Строка) Экспорт
	//получаем маску
	Шаблон="";
	ШаблонДаты = "11.11.1111";
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Если ЭтоЦифра(Сред(Строка,Индекс,1)) Тогда
			Шаблон=Шаблон+"1";
		ИначеЕсли Сред(Строка,Индекс,1) = "." Тогда
			Шаблон=Шаблон+".";			
		Иначе
			Шаблон=Шаблон+"X";			
		КонецЕсли;
	КонецЦикла;
	Поз = СтрНайти(Шаблон,ШаблонДаты,НаправлениеПоиска.СКонца);
	КВозврату="";
	Если Поз>0 Тогда
		КВозврату = Сред(Строка, Поз, СтрДлина(ШаблонДаты));
	КонецЕсли;
	Возврат КВозврату;
КонецФункции

//УдалитьДатуИзСтроки(Строка) Экспорт
//из присланной строки Строка вырезает дату и возвращает строку без даты
&НаСервере
Функция УдалитьДатуИзСтроки(Строка) Экспорт
	МасУдал=Новый Массив;
	МасУдал.Добавить("от");
	МасУдал.Добавить("оТ");
	МасУдал.Добавить("ОТ");
	МасУдал.Добавить("От");	
	ДатаСтр = ПолучитьДатуИзСтроки(Строка);	
	СтрокаБезДаты = СтрЗаменить(Строка,ДатаСтр,"");
	Для Каждого Удал Из МасУдал Цикл СтрокаБезДаты = СтрЗаменить(СтрокаБезДаты,Удал,""); КонецЦикла;		
	Возврат СтрокаБезДаты;	
КонецФункции

//ПолучитьНомерБрони(Строка) Экспорт
//из присланной строки Строка возвращает номер брони
&НаСервере
Функция ПолучитьНомерБрони(Строка) Экспорт
	Разделитель="/";
	Поз=СтрНайти(Строка,Разделитель,НаправлениеПоиска.СКонца);
	Бронь=Строка;
	Если Поз>0 Тогда
		Бронь=Лев(Строка,Поз-1);
	КонецЕсли;
	Возврат СокрЛП(Бронь);	
КонецФункции

//ПолучитьНомерСчета(Строка) Экспорт
//из присланной строки Строка возвращает номер счета
&НаСервере
Функция ПолучитьНомерСчета(Строка) Экспорт
	Разделитель="/";
	Поз=СтрНайти(Строка,Разделитель,НаправлениеПоиска.СКонца);
	Счет=Строка;
	Если Поз>0 Тогда
		Счет=Прав(Строка,(СтрДлина(Строка)-Поз));
	КонецЕсли;
	Возврат СокрЛП(Счет);	
КонецФункции


&НаСервере
Функция ПолучитьНомерЗаявки(НомерЗаявки) Экспорт
	КВозврату = "";
	Префикс = СокрЛП(ПолучитьНастройку("Префикс","ЭТ18-")); 
	СтрокаПоиска = ВРег(СокрЛП(НомерЗаявки)); 
	Если СтрНайти(СтрокаПоиска,ВРег(Префикс))=0 Тогда
		СтрокаПоиска = Префикс + СтрокаПоиска;
	КонецЕсли;
	Возврат  ПолучитьКодИзСтроки(СтрокаПоиска,Префикс);;
КонецФункции

//ПолучитьСуммуКомиссииТО
//из полученного договора по СсылкаНаДоговор
//получает сумму комиссии, связано это с тем, что ранее в расширении нельзя было создавать реквизиты в справочнике
//и приходилось хранить данные в строке комментария, сейчас добавил новые поля в справочник ДоговорыКонтрагентов
//КомиссияТО и ДатаНачала
//в данной функции речь про поле КомиссияТО, если данное поле заполнено, то берем данные там, если нет, то читаем 
//строку комментария
&НаСервере
Функция ПолучитьСуммуКомиссииТО(СсылкаНаДоговор)Экспорт  
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СУММА(ЭТ_КомиссияТО.СуммаКомиссии) КАК СуммаКомиссии
		|ИЗ
		|	РегистрСведений.ЭТ_КомиссияТО КАК ЭТ_КомиссияТО
		|ГДЕ
		|	ЭТ_КомиссияТО.ДоговорТО = &ДоговорТО
		|
		|СГРУППИРОВАТЬ ПО
		|	ЭТ_КомиссияТО.ДоговорТО";
	
	Запрос.УстановитьПараметр("ДоговорТО", СсылкаНаДоговор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.СуммаКомиссии;
	КонецЦикла;
	Возврат 0;
КонецФункции

//ПолучитьСуммуКомиссииТО
//из полученного договора по СсылкаНаДоговор
//получает сумму комиссии, связано это с тем, что ранее в расширении нельзя было создавать реквизиты в справочнике
//и приходилось хранить данные в строке комментария, сейчас добавил новые поля в справочник ДоговорыКонтрагентов
//КомиссияТО и ДатаНачала
//в данной функции речь про поле КомиссияТО, если данное поле заполнено, то берем данные там, если нет, то читаем 
//строку комментария
Функция ПолучитьСуммуОплатПоДогоору(СсылкаНаДоговор)Экспорт
	СуммаОплатПоДогоору = 0;
	ПлатежныеДокументы=ЭТ_ОбщийМодуль2.ПолучитьПлатежныеДокументыПоЗаявке(СсылкаНаДоговор,СсылкаНаДоговор.ВидДоговора).Выбрать();		
	Пока ПлатежныеДокументы.Следующий() Цикл 
		Если ПлатежныеДокументы.ДоговорКонтрагента = СсылкаНаДоговор Тогда
			Если НЕ(СтрНайти(Строка(ПлатежныеДокументы.Дт),"62.")=Ложь) Тогда
				СуммаОплатПоДогоору = СуммаОплатПоДогоору - ПлатежныеДокументы.СуммаДокумента;
			Иначе
				СуммаОплатПоДогоору = СуммаОплатПоДогоору + ПлатежныеДокументы.СуммаДокумента;
			КонецЕсли;		
		КонецЕсли;			
	КонецЦикла;
	Возврат СуммаОплатПоДогоору;
КонецФункции


&НаСервере
Функция ПолучитьНаборПараметровИзСтроки(Строка) Экспорт
	КВозврату = Новый Структура;
	Для Каждого СледДанные ИЗ СтрРазделить(Строка,";") Цикл
		СледПара = СтрРазделить(СледДанные,":");
		Имя = "";
		Значение = "";
		Если СледПара.Количество()>1 Тогда
			Имя = ГрупповаяЗамена(СокрЛП(СледПара[0]),"1234567890_йцукенгшщзхъфывапролджэячсмитьбюЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮqwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM","_");
			Значение = СокрЛП(СледПара[1]);
		КонецЕсли;
		Если СтрДлина(Имя)>0 И СтрДлина(Значение)>0 Тогда
			 КВозврату.Вставить(Имя,Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат КВозврату;
КонецФункции

//ГрупповаяЗамена - функция посимвольно перебирает Строка, если символ ВХОДИТ/НЕ ВХОДИТ в Поиск, то он переносится, иначе на его место встает Замена, Если Присутствие = Входит, то проверяется наличие, иначе исключение
Функция ГрупповаяЗамена(Строка,Поиск,Замена,Присутствие=Истина) Экспорт
	КВозврату = "";
	Для Счетчик = 1 По СтрДлина(Строка) Цикл
		Если (СтрНайти(Поиск,Сред(Строка,Счетчик,1))>0 И Присутствие=Истина) ИЛИ (СтрНайти(Поиск,Сред(Строка,Счетчик,1))=0 И Присутствие=Ложь) Тогда
			 КВозврату = КВозврату + Сред(Строка,Счетчик,1);
		 Иначе
			 КВозврату = КВозврату + Замена;			 
		КонецЕсли;
	КонецЦикла;
	Возврат КВозврату;	
КонецФункции


