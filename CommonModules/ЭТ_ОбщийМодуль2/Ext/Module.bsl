Функция ВременноеХранилище_Получить(ТипОбъекта,Ключ,ЗначениеПоУмолчанию=Неопределено,ВремяЖизниСек=0) Экспорт
	//ЭТ_ОбщийМодуль2.УдалитьНастройку("ВременнаяТаблица");
	//ПолучитьНастройку("ВременнаяТаблица",Неопределено,"Общий##");
	Дат = ЭТ_ОбщийМодуль2.ПолучитьНастройку("ВременнаяТаблица",Неопределено,"Общий##");
	Если Не Дат = Неопределено Тогда
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ТипОбъектаЗн", ТипОбъекта);
		ПараметрыОтбора.Вставить("Ключ", Ключ);
		НайденныеСтроки = Дат.НайтиСтроки(ПараметрыОтбора); 		
		Для Каждого СледСтрока Из НайденныеСтроки Цикл
			Если СледСтрока.Дата >= ТекущаяДата() - ВремяЖизниСек Тогда
				Возврат СледСтрока.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;	
КонецФункции

